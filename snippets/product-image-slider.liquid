{%- comment -%}
  Product Image Slider Snippet
  ------------------------------------------------------------------------------
  Renders the horizontal image slider for product media (excluding the first image).

  Usage:
  {% render 'product-image-slider', product: product %}

  Variables:
  - product: The product object.
{%- endcomment -%}
<div class="product-media-wrapper">
  <button class="media-nav prev" aria-label="Previous image">←</button>
  <button class="media-nav next" aria-label="Next image">→</button>

  <div class="product-media-track" id="ProductMediaTrack">
    {% assign hero_image_found = false %}
    {% for media in product.media %}
      <div class="product-media-slide {% if media.media_type == 'image' and hero_image_found == false %}is-hero-slide{% endif %}">
        {% case media.media_type %}
          {% when 'image' %}
            {% if hero_image_found == false
              and section.settings.enable_sprite_sheet
              and section.settings.sprite_sheet_frames > 1
            %}
              {% assign frames = section.settings.sprite_sheet_frames %}
              {% assign frame_aspect = media.aspect_ratio | divided_by: frames %}
              <div
                class="product-media-static-sprite"
                style="--frames: {{ frames }}; --aspect-ratio: {{ frame_aspect }};"
              >
                {{
                  media
                  | image_url: width: media.width
                  | image_tag:
                    loading: 'eager',
                    alt: media.alt,
                    class: 'static-sprite-img',
                    widths: '2000, 3000, 4000, 5000',
                    sizes: 'calc(100vw * 10)'
                }}
              </div>
            {% else %}
              {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: media.alt }}
            {% endif %}
            {% if hero_image_found == false %}
              {% assign hero_image_found = true %}
            {% endif %}
          {% when 'external_video' %}
            {{ media | external_video_tag: class: 'video-slide' }}
          {% when 'video' %}
            {{
              media
              | video_tag:
                controls: true,
                class: 'video-slide',
                image_size: '1200x',
                image_alt: media.alt,
                description: media.alt
            }}
          {% when 'model' %}
            {{
              media
              | model_viewer_tag:
                image_size: '1200x',
                reveal: 'interaction',
                toggleable: true,
                data-model-id: media.id,
                alt: media.alt
            }}
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>
