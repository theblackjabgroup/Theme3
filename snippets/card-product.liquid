{%- comment -%}
  Renders a custom product card matching the collection list card design

  Accepts:
  - card_product: {Object} Product Liquid object (required)
  - show_badge: {Boolean} Show badge on card. Default: true (optional)
  - badge_text: {String} Badge text. Only shown when not blank (optional)
  - overlay_button_text: {String} Overlay button text. Default: 'Love that! (Check it out)' (optional)
  - fallback_description: {String} Fallback text when product has no description. Default: 'Discover our amazing product.' (optional)
  - section_id: {String} The ID of the section that contains this card (optional)
  - quick_add: {String} Quick add mode. Values: 'none', 'standard', 'bulk'. Default: 'none' (optional)
  - quick_add_overlay: {Boolean} When true with quick_add standard, overlay and footer buttons add to cart. Default: false (optional)
  - mobile_add_button_text: {String} Mobile add to cart button text. Default: 'Add to cart' (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
{%- endcomment -%}
{%- comment -%} Card CSS is loaded once at section level (e.g. main-collection-product-grid.liquid). {%- endcomment -%}

{%- if card_product and card_product != empty -%}
  {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}
  {%- liquid
    assign use_quick_add_overlay = false
    if quick_add == 'standard' and quick_add_overlay
      assign use_quick_add_overlay = true
    endif
    assign card_price_current = card_product.price
    assign card_price_compare = blank
    if card_product.compare_at_price > card_product.price
      assign card_price_compare = card_product.compare_at_price
    elsif card_product.compare_at_price_max > card_product.price
      assign card_price_compare = card_product.compare_at_price_max
    endif
  -%}
  {%- assign overlay_btn_text = overlay_button_text | default: 'Love that! (Check it out)' -%}
  {%- if use_quick_add_overlay -%}
    {%- assign overlay_btn_text = overlay_button_text | default: 'Love that! (Buy it)' -%}
  {%- endif -%}
  <div class="custom-product-card-wrapper{% if use_quick_add_overlay %} custom-product-card-wrapper--quick-add-overlay{% endif %}">
    <div class="custom-product-card">
      <a href="{{ card_product.url }}" class="custom-product-card__main-link">
        <div class="custom-product-card__image-container">
          {%- if card_product.featured_media -%}
            <img
              src="{{ card_product.featured_media | image_url: width: 533 }}"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="custom-product-card__image"
              {% unless lazy_load == false %}
                loading="lazy"
              {% endunless %}
              width="533"
              height="{{ 533 | divided_by: card_product.featured_media.aspect_ratio }}"
            >
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'custom-product-card__image placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if show_badge != false and badge_text != blank -%}
          <span class="custom-product-card__badge">
            {{- badge_text | escape -}}
          </span>
        {%- endif -%}

        <div class="custom-product-card__title">{{ card_product.title | truncatewords: 3 }}</div>

        {%- if card_product.description != blank -%}
          <p class="custom-product-card__description">
            {{ card_product.description | strip_html | truncatewords: 12, '....' }}
          </p>
        {%- elsif fallback_description != blank -%}
          <p class="custom-product-card__description">
            {{ fallback_description | strip_html | truncatewords: 12, '....' }}
          </p>
        {%- else -%}
          <p class="custom-product-card__description">
            {{ 'Discover our amazing product.' | strip_html | truncatewords: 12, '....' }}
          </p>
        {%- endif -%}

        <div class="custom-product-card__footer">
          <div class="custom-product-card__price{% if card_price_compare != blank %} custom-product-card__price--sale{% endif %}">
            <span class="custom-product-card__price-current">{{ card_price_current | money }}</span>
            {%- if card_price_compare != blank -%}
              <span class="custom-product-card__price-compare">{{ card_price_compare | money }}</span>
            {%- endif -%}
          </div>
          {%- if use_quick_add_overlay -%}
            <button
              class="custom-product-card__add-to-cart"
              type="button"
              data-quick-add-trigger="{{ product_form_id }}-submit"
              aria-label="{{ mobile_add_button_text | default: 'Add to cart' }}"
            >
              {{ mobile_add_button_text | default: 'Add to cart' }}
            </button>
          {%- else -%}
            <button
              class="custom-product-card__add-to-cart"
              type="button"
              onclick="window.location.href='{{ card_product.url }}'"
            >
              Add to cart
            </button>
          {%- endif -%}
        </div>
      </a>

      <div class="custom-product-card__overlay-clip">
        <div class="custom-product-card__hover-overlay">
          <div class="custom-product-card__hover-content">
            {%- if card_product.description != blank -%}
              <p class="custom-product-card__hover-description">
                {{ card_product.description | strip_html | truncatewords: 12, '....' | upcase }}
              </p>
            {%- elsif fallback_description != blank -%}
              <p class="custom-product-card__hover-description">
                {{
                  fallback_description
                  | default: 'Discover our amazing product.'
                  | strip_html
                  | truncatewords: 12, '....'
                  | upcase
                }}
              </p>
            {%- else -%}
              <p class="custom-product-card__hover-description">
                {{ 'Discover our amazing product.' | strip_html | truncatewords: 12, '....' | upcase }}
              </p>
            {%- endif -%}
            {%- if use_quick_add_overlay -%}
              {%- liquid
                assign quick_add_attrs = 'data-quick-add-trigger="' | append: product_form_id | append: '-submit" aria-label="' | append: overlay_btn_text | escape | append: '"'
              -%}
              {%- render 'global-btn',
                text: overlay_btn_text,
                type: 'button',
                class: 'custom-product-card__hover-button',
                attributes: quick_add_attrs
              -%}
            {%- else -%}
              {%- render 'global-btn',
                url: card_product.url,
                text: overlay_btn_text,
                class: 'custom-product-card__hover-button'
              -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- if quick_add != 'none' and quick_add != blank -%}
      {% if quick_add == 'standard' %}
        <div class="quick-add no-js-hidden custom-product-card__quick-add">
          {%- liquid
            assign qty_rules = false
            if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
              assign qty_rules = true
            endif
          -%}
          {%- if card_product.variants_count > 1 or qty_rules -%}
            <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-haspopup="dialog"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-product-url="{{ card_product.url }}"
              >
                {{ 'products.product.choose_options' | t }}
                {%- render 'loading-spinner' -%}
              </button>
            </modal-opener>
            <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
              <div
                role="dialog"
                aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                aria-modal="true"
                class="quick-add-modal__content global-settings-popup"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ card_product.id }}"
                  type="button"
                  class="quick-add-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </button>
                <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
              </div>
            </quick-add-modal>
          {%- else -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product',
                card_product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ card_product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
                >
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--secondary"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
                >
                  <span>
                    {%- if card_product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="sold-out-message hidden">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          {%- endif -%}
        </div>
      {% elsif quick_add == 'bulk' %}
        {% if card_product.variants_count == 1 %}
          <quick-add-bulk
            data-min="{{ card_product.selected_or_first_available_variant.quantity_rule.min }}"
            id="quick-add-bulk-{{ card_product.selected_or_first_available_variant.id }}-{{ section_id }}"
            class="quick-add-bulk custom-product-card__quick-add"
            data-index="{{ card_product.selected_or_first_available_variant.id }}"
          >
            {% if card_product.selected_or_first_available_variant.available == false %}
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-sold-out-message="true"
                disabled
              >
                <span>{{ 'products.product.sold_out' | t }}</span>
                <span class="sold-out-message hidden">
                  {{ 'products.product.sold_out' | t }}
                </span>
              </button>
            {% else %}
              {% render 'quantity-input', variant: card_product.selected_or_first_available_variant, min: 0 %}
            {% endif %}
          </quick-add-bulk>
        {% else %}
          <div class="quick-add no-js-hidden custom-product-card__quick-add">
            {%- liquid
              assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
              assign qty_rules = false
              if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                assign qty_rules = true
              endif
            -%}
            <modal-opener
              id="QuickBulk-{{ card_product.id }}-{{ section_id }}"
              data-modal="#QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
            >
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-haspopup="dialog"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-product-url="{{ card_product.url }}"
              >
                {{ 'products.product.choose_options' | t }}
                {%- render 'loading-spinner' -%}
              </button>
            </modal-opener>
            <modal-dialog
              id="QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
              class="quick-add-modal"
            >
              <div
                role="dialog"
                aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                aria-modal="true"
                class="quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ card_product.id }}"
                  type="button"
                  class="quick-add-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </button>
                <div
                  id="QuickAddInfo-{{ card_product.id }}"
                  class="quick-add-modal__content-info quick-add-modal__content-info--bulk"
                >
                  <div class="quick-add__content-info__media">
                    <div class="quick-add__info">
                      {%- if card_product.featured_media -%}
                        <div class="quick-add__product-media">
                          <div class="quick-add__product-container global-media-settings">
                            <img
                              srcset="
                                {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                              "
                              src="{{ card_product.featured_media | image_url: width: 533 }}"
                              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                              alt="{{ card_product.featured_media.alt | escape }}"
                              class="motion-reduce"
                              loading="lazy"
                              width="{{ card_product.featured_media.width }}"
                              height="{{ card_product.featured_media.height }}"
                            >
                          </div>
                        </div>
                      {%- endif -%}
                      <a
                        {% if card_product == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ card_product.url }}"
                        {% endif %}
                        class="link product__view-details animate-arrow small-hide medium-hide"
                      >
                        {{ 'products.product.view_full_details' | t -}}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </a>
                    </div>
                    <div class="quick-add-modal__content-info--bulk-details large-up-hide">
                      <a href="{{ card_product.url }}" class="full-unstyled-link">
                        <h3>{{ card_product.title | escape }}</h3>
                      </a>
                      {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                      {%- if card_product.quantity_price_breaks_configured? -%}
                        <div class="card__information-volume-pricing-note">
                          <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                  <div>
                    <div class="quick-add-modal__content-info--bulk-details small-hide medium-hide">
                      <a href="{{ card_product.url }}" class="full-unstyled-link">
                        <h3 class="h2">
                          {{ card_product.title | escape }}
                        </h3>
                      </a>
                      {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                      {%- if card_product.quantity_price_breaks_configured? -%}
                        <div class="card__information-volume-pricing-note">
                          <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                    <bulk-modal
                      id="QuickBulkModal-{{ card_product.id }}-{{ section_id }}"
                      data-url="{{ card_product.url }}"
                      data-section-id="{{ section_id }}"
                      data-product-id="{{ card_product.id }}"
                    >
                    </bulk-modal>
                  </div>
                </div>
              </div>
            </modal-dialog>
          </div>
        {% endif %}
      {% endif %}
    {%- endif -%}
  </div>
{%- endif -%}
