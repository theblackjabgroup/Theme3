{%- comment -%}
  Renders a custom product card matching the collection list card design

  Accepts:
  - card_product: {Object} Product Liquid object (optional when placeholder_* are used)
  - placeholder_title: {String} When set with no card_product, render a placeholder card with this title (optional)
  - placeholder_description: {String} Description for placeholder card (optional)
  - show_badge: {Boolean} Show badge on card. Default: true (optional)
  - badge_text: {String} Badge text. Only shown when not blank (optional)
  - overlay_button_text: {String} Overlay button text. Default: 'Check it out' (optional)
  - fallback_description: {String} Fallback text when product has no description. Default: 'Discover our amazing product.' (optional)
  - section_id: {String} The ID of the section that contains this card (optional)
  - quick_add: {String} Quick add mode. Values: 'none', 'standard', 'bulk'. Default: 'none' (optional)
  - quick_add_overlay: {Boolean} When true with quick_add standard, overlay and footer buttons add to cart. Default: false (optional)
  - mobile_add_button_text: {String} Mobile add to cart button text. Default: 'Add to cart' (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
{%- endcomment -%}
{%- comment -%} Card CSS is loaded once at section level (e.g. main-collection-product-grid.liquid). {%- endcomment -%}

{%- assign is_placeholder = false -%}
{%- if card_product == blank or card_product == empty -%}
  {%- if placeholder_title != blank -%}
    {%- assign is_placeholder = true -%}
  {%- endif -%}
{%- endif -%}

{%- if is_placeholder -%}
  {%- comment -%} Placeholder card with dummy data (same structure as real card) {%- endcomment -%}
  {%- assign placeholder_desc = placeholder_description
    | default: fallback_description
    | default: 'Add a collection in the section settings to display products.'
  -%}
  <div class="custom-product-card-wrapper">
    <div class="custom-product-card">
      <a href="#" class="custom-product-card__main-link" aria-disabled="true" aria-label="{{ placeholder_title | escape }}" onclick="return false;">
        <div class="custom-product-card__image-container">
          {{ 'product-apparel-2' | placeholder_svg_tag: 'custom-product-card__image placeholder-svg' }}
        </div>
        <div class="custom-product-card__content">
          <div class="custom-product-card__title">
            {{ placeholder_title | escape | truncate: 12, '…' }}
          </div>
          <p class="custom-product-card__description">
            {{ placeholder_desc | strip_html | truncate: 80, '…' }}
          </p>
        </div>
      </a>
      <div class="custom-product-card__footer">
        {%- render 'global-btn-2',
          text: '0',
          variant: 'primary',
          hover: false,
          class: 'custom-product-card__price'
        -%}
        <div class="custom-product-card__hover-buttons">
          {%- render 'global-btn',
            text: 'Add to cart',
            type: 'button',
            variant: 'secondary',
            class: 'custom-product-card__atc-btn'
          -%}
          {%- render 'global-btn-2',
            variant: 'primary',
            icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M2 12C4 7 7.5 4 12 4C16.5 4 20 7 22 12C20 17 16.5 20 12 20C7.5 20 4 17 2 12Z" stroke="currentColor" stroke-width="2"/></svg>',
            icon_only: true,
            fit_width: false,
            class: 'custom-product-card__eye-btn',
            hover: false
          -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif card_product and card_product != empty -%}
  {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}
  {%- liquid
    assign use_quick_add_overlay = false
    if quick_add == 'standard' and quick_add_overlay
      assign use_quick_add_overlay = true
    endif
    assign card_price_current = card_product.price
    assign card_price_compare = blank
    assign card_discount_pct = 0
    if card_product.compare_at_price > card_product.price
      assign card_price_compare = card_product.compare_at_price
      assign savings = card_product.compare_at_price | minus: card_product.price
      assign card_discount_pct = savings | times: 100 | divided_by: card_product.compare_at_price
    elsif card_product.compare_at_price_max > card_product.price
      assign card_price_compare = card_product.compare_at_price_max
      assign savings = card_product.compare_at_price_max | minus: card_product.price
      assign card_discount_pct = savings | times: 100 | divided_by: card_product.compare_at_price_max
    endif
  -%}
  <div class="custom-product-card-wrapper{% if use_quick_add_overlay %} custom-product-card-wrapper--quick-add-overlay{% endif %}">
    <div class="custom-product-card">
      <a href="{{ card_product.url }}" class="custom-product-card__main-link" aria-label="{{ card_product.title | escape }}">
        <div class="custom-product-card__image-container">
          {%- if card_price_compare != blank and card_discount_pct > 0 -%}
            <span class="custom-product-card__sale-badge">
              <svg
                class="custom-product-card__sale-badge-icon"
                viewBox="0 0 73 72"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M35.4998 0.192998C35.2716 0.281184 33.9937 1.42531 32.66 2.73551L30.235 5.11767L27.1847 3.84233C23.928 2.48044 23.381 2.36984 22.345 2.86378C21.6431 3.19852 21.1746 4.05584 19.6395 7.81496L18.8248 9.80986L15.2277 9.86009C11.2814 9.91539 11.2098 9.93273 10.3732 11.0364C10.0563 11.4545 10.0274 11.7503 9.98095 15.0406L9.93068 18.5935L6.78384 19.8784C3.04052 21.4069 2.64762 21.7184 2.64762 23.1572C2.64762 23.8877 2.86216 24.542 3.8907 26.95L5.13377 29.86L2.74054 32.2389C1.42413 33.5473 0.267503 34.8246 0.170108 35.0774C-0.0593592 35.6723 -0.0562067 36.5867 0.176745 37.0397C0.27779 37.2362 1.4384 38.4689 2.75597 39.7787L5.15135 42.1604L3.80442 45.2597C2.59553 48.0414 2.46843 48.4309 2.56383 49.0612C2.75481 50.3237 3.27065 50.6987 6.78285 52.1297L9.93068 53.4119L9.98078 56.9684C10.0274 60.2624 10.0563 60.5582 10.3732 60.9763C11.2098 62.08 11.2814 62.0973 15.2277 62.1529L18.8248 62.2035L19.9863 64.9957C20.625 66.5315 21.3183 68.036 21.5267 68.3395C21.9295 68.9259 22.9758 69.5465 23.5615 69.5465C23.9476 69.5465 27.0256 68.3811 29.0816 67.4564L30.3786 66.8731L32.8148 69.2653C35.2612 71.6674 35.7369 72.0011 36.7135 72C37.5132 71.9992 38.104 71.5594 40.5507 69.1439C41.785 67.9256 42.823 66.9287 42.8578 66.9287C42.8925 66.9287 44.2564 67.4942 45.8887 68.1851C49.0481 69.5228 49.7352 69.6636 50.6984 69.1717C51.4113 68.8075 51.6157 68.4503 52.9963 65.1576L54.2089 62.2658L57.7546 62.184C61.7078 62.0929 61.9388 62.0337 62.7183 60.9131C63.1141 60.3437 63.1269 60.2317 63.1785 56.8582L63.2316 53.389L65.7503 52.3627C69.5439 50.8169 69.8175 50.6627 70.1855 49.8635C70.3594 49.4859 70.5014 48.9561 70.5014 48.6862C70.5012 48.4162 69.9477 46.8015 69.2713 45.0982L68.0415 42.001L70.3383 39.6866C73.9094 36.0882 73.9059 35.8838 70.2142 32.2076L67.7961 29.7996L69.0695 26.8586C70.4725 23.6184 70.5984 22.9548 69.9938 21.9902C69.585 21.338 69.0051 21.0303 65.5727 19.6445L63.0425 18.6231V15.324C63.0425 12.2279 63.0196 11.98 62.6691 11.2956C62.4231 10.8151 62.0695 10.4414 61.6321 10.2002C61.0053 9.85436 60.7787 9.83391 57.5459 9.83129L54.1233 9.82867L52.9205 6.97465C51.4984 3.60019 51.2836 3.2247 50.5643 2.8574C49.5603 2.34448 48.9063 2.47749 45.7251 3.84086L42.7599 5.11178L40.409 2.81322C37.625 0.0913965 36.843 -0.325974 35.4998 0.192998Z" fill="var(--sale-badge-bg, #F5A30A)"/>
              </svg>
              <span class="custom-product-card__sale-badge-text">
                <span>{{- card_discount_pct }}%</span>
                <span>off</span>
              </span>
            </span>
          {%- endif -%}
          {%- if card_product.featured_media -%}
            <img
              src="{{ card_product.featured_media | image_url: width: 533 }}"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="custom-product-card__image"
              {% unless lazy_load == false %}
                loading="lazy"
              {% endunless %}
              width="533"
              height="{{ 533 | divided_by: card_product.featured_media.aspect_ratio }}"
            >
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'custom-product-card__image placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="custom-product-card__content">
          {%- if show_badge != false and badge_text != blank -%}
            <span class="custom-product-card__badge">
              {{- badge_text | escape -}}
            </span>
          {%- endif -%}

          <div class="custom-product-card__title">
            {{ card_product.title | truncate: 12, '…' }}
          </div>

          {%- if card_product.description != blank -%}
            <p class="custom-product-card__description">
              {{ card_product.description | strip_html | truncate: 80, '…' }}
            </p>
          {%- elsif fallback_description != blank -%}
            <p class="custom-product-card__description">
              {{ fallback_description | strip_html | truncate: 80, '…' }}
            </p>
          {%- else -%}
            <p class="custom-product-card__description">
              {{ 'Discover our amazing product.' | strip_html | truncate: 80, '…' }}
            </p>
          {%- endif -%}
        </div>
      </a>

      <div class="custom-product-card__footer">
        {%- capture price_text -%}
          {{- card_price_current | money -}}
          {%- if card_price_compare != blank %} <s class="custom-product-card__price-compare">{{ card_price_compare | money }}</s>{% endif -%}
        {%- endcapture -%}
        {%- render 'global-btn-2',
          text: price_text,
          url: card_product.url,
          variant: 'primary',
          hover: false,
          class: 'custom-product-card__price'
        -%}
        <div class="custom-product-card__hover-buttons">
          {%- if use_quick_add_overlay -%}
            {%- liquid
              assign quick_add_attrs = 'data-quick-add-trigger="' | append: product_form_id | append: '-submit"'
            -%}
            {%- render 'global-btn',
              text: 'Add to cart',
              type: 'button',
              variant: 'secondary',
              class: 'custom-product-card__atc-btn',
              attributes: quick_add_attrs
            -%}
          {%- else -%}
            {%- render 'global-btn',
              text: 'Add to cart',
              url: card_product.url,
              variant: 'secondary',
              class: 'custom-product-card__atc-btn'
            -%}
          {%- endif -%}
          {%- liquid
            assign qv_trigger_id = section_id | append: '-' | append: card_product.id
            assign eye_attrs = 'data-quick-view-trigger="' | append: qv_trigger_id | append: '" aria-label="Quick view ' | append: card_product.title | escape | append: '"'
          -%}
          {%- render 'global-btn-2',
            type: 'button',
            variant: 'primary',
            icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M2 12C4 7 7.5 4 12 4C16.5 4 20 7 22 12C20 17 16.5 20 12 20C7.5 20 4 17 2 12Z" stroke="currentColor" stroke-width="2"/></svg>',
            icon_only: true,
            fit_width: false,
            hover: false,
            class: 'custom-product-card__eye-btn',
            attributes: eye_attrs
          -%}
        </div>
      </div>
    </div>

    {%- comment -%} Quick View Modal {%- endcomment -%}
    {%- render 'quick-view-modal', product: card_product, section_id: section_id -%}

    {%- if quick_add != 'none' and quick_add != blank -%}
      {% if quick_add == 'standard' %}
        <div class="quick-add no-js-hidden custom-product-card__quick-add">
          {%- liquid
            assign qty_rules = false
            if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
              assign qty_rules = true
            endif
          -%}
          {%- if card_product.variants_count > 1 or qty_rules -%}
            <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-haspopup="dialog"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-product-url="{{ card_product.url }}"
              >
                {{ 'products.product.choose_options' | t }}
                {%- render 'loading-spinner' -%}
              </button>
            </modal-opener>
            <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
              <div
                role="dialog"
                aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                aria-modal="true"
                class="quick-add-modal__content global-settings-popup"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ card_product.id }}"
                  type="button"
                  class="quick-add-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </button>
                <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
              </div>
            </quick-add-modal>
          {%- else -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product',
                card_product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ card_product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
                >
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--secondary"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
                >
                  <span>
                    {%- if card_product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="sold-out-message hidden">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          {%- endif -%}
        </div>
      {% elsif quick_add == 'bulk' %}
        {% if card_product.variants_count == 1 %}
          <quick-add-bulk
            data-min="{{ card_product.selected_or_first_available_variant.quantity_rule.min }}"
            id="quick-add-bulk-{{ card_product.selected_or_first_available_variant.id }}-{{ section_id }}"
            class="quick-add-bulk custom-product-card__quick-add"
            data-index="{{ card_product.selected_or_first_available_variant.id }}"
          >
            {% if card_product.selected_or_first_available_variant.available == false %}
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-sold-out-message="true"
                disabled
              >
                <span>{{ 'products.product.sold_out' | t }}</span>
                <span class="sold-out-message hidden">
                  {{ 'products.product.sold_out' | t }}
                </span>
              </button>
            {% else %}
              {% render 'quantity-input', variant: card_product.selected_or_first_available_variant, min: 0 %}
            {% endif %}
          </quick-add-bulk>
        {% else %}
          <div class="quick-add no-js-hidden custom-product-card__quick-add">
            {%- liquid
              assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
              assign qty_rules = false
              if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                assign qty_rules = true
              endif
            -%}
            <modal-opener
              id="QuickBulk-{{ card_product.id }}-{{ section_id }}"
              data-modal="#QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
            >
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="quick-add__submit button button--full-width button--secondary"
                aria-haspopup="dialog"
                aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                data-product-url="{{ card_product.url }}"
              >
                {{ 'products.product.choose_options' | t }}
                {%- render 'loading-spinner' -%}
              </button>
            </modal-opener>
            <modal-dialog
              id="QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
              class="quick-add-modal"
            >
              <div
                role="dialog"
                aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                aria-modal="true"
                class="quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ card_product.id }}"
                  type="button"
                  class="quick-add-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </button>
                <div
                  id="QuickAddInfo-{{ card_product.id }}"
                  class="quick-add-modal__content-info quick-add-modal__content-info--bulk"
                >
                  <div class="quick-add__content-info__media">
                    <div class="quick-add__info">
                      {%- if card_product.featured_media -%}
                        <div class="quick-add__product-media">
                          <div class="quick-add__product-container global-media-settings">
                            <img
                              srcset="
                                {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                                {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                              "
                              src="{{ card_product.featured_media | image_url: width: 533 }}"
                              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                              alt="{{ card_product.featured_media.alt | escape }}"
                              class="motion-reduce"
                              loading="lazy"
                              width="{{ card_product.featured_media.width }}"
                              height="{{ card_product.featured_media.height }}"
                            >
                          </div>
                        </div>
                      {%- endif -%}
                      <a
                        {% if card_product == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ card_product.url }}"
                        {% endif %}
                        class="link product__view-details animate-arrow small-hide medium-hide"
                      >
                        {{ 'products.product.view_full_details' | t -}}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </a>
                    </div>
                    <div class="quick-add-modal__content-info--bulk-details large-up-hide">
                      <a href="{{ card_product.url }}" class="full-unstyled-link">
                        <h3>{{ card_product.title | escape }}</h3>
                      </a>
                      {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                      {%- if card_product.quantity_price_breaks_configured? -%}
                        <div class="card__information-volume-pricing-note">
                          <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                  <div>
                    <div class="quick-add-modal__content-info--bulk-details small-hide medium-hide">
                      <a href="{{ card_product.url }}" class="full-unstyled-link">
                        <h3 class="h2">
                          {{ card_product.title | escape }}
                        </h3>
                      </a>
                      {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                      {%- if card_product.quantity_price_breaks_configured? -%}
                        <div class="card__information-volume-pricing-note">
                          <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                    <bulk-modal
                      id="QuickBulkModal-{{ card_product.id }}-{{ section_id }}"
                      data-url="{{ card_product.url }}"
                      data-section-id="{{ section_id }}"
                      data-product-id="{{ card_product.id }}"
                    >
                    </bulk-modal>
                  </div>
                </div>
              </div>
            </modal-dialog>
          </div>
        {% endif %}
      {% endif %}
    {%- endif -%}
  </div>
{%- endif -%}
