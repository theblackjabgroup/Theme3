{%- comment -%}
  Renders a global button with a 3D lift effect.
  Supports four variants: primary, secondary, tertiary, disabled.

  Accepts:
  - text       {String}  Button label (required, default: 'Button')
  - url        {String}  If provided, renders as <a>, otherwise <button>
  - type       {String}  Button type: 'button' | 'submit' (default: 'button')
  - variant    {String}  'primary' | 'secondary' | 'tertiary' | 'disabled' (default: 'primary')
  - class      {String}  Extra CSS classes
  - icon       {String}  SVG markup to prepend inside the button
  - badge      {String}  Badge text/number
  - icon_only  {Boolean} Show icon only, hide text label
  - attributes {String}  Extra HTML attributes (e.g. aria-label, data-*)
  - is_add_to_cart {Boolean} Adds sold-out message + loading spinner internals
{%- endcomment -%}

{%- assign btn_text = text | default: 'Button' -%}
{%- assign btn_variant = variant | default: 'primary' -%}
{%- assign btn_type = type | default: 'button' -%}
{%- assign btn_icon_only = icon_only | default: false -%}

{%- if class != blank -%}
  {%- assign btn_class = 'global-btn global-btn--' | append: btn_variant | append: ' ' | append: class -%}
{%- else -%}
  {%- assign btn_class = 'global-btn global-btn--' | append: btn_variant -%}
{%- endif -%}

{%- if btn_icon_only -%}
  {%- assign btn_class = btn_class | append: ' global-btn--icon-only' -%}
{%- endif -%}

{%- if btn_variant == 'disabled' -%}
  {%- assign is_disabled = true -%}
{%- else -%}
  {%- assign is_disabled = false -%}
{%- endif -%}

{%- if url != blank -%}
  <a
    class="{{ btn_class }}"
    href="{{ url }}"
    data-btn-variant="{{ btn_variant }}"
    {{ attributes }}
  >
    <span class="global-btn__shadow" aria-hidden="true"></span>
    <span class="global-btn__content">
      {%- if icon != blank -%}
        <span class="global-btn__icon">{{ icon }}</span>
      {%- endif -%}
      {%- if btn_text != blank and btn_icon_only != true -%}
        <span class="global-btn__text">{{ btn_text }}</span>
      {%- endif -%}
      {%- if badge != blank and badge != '0' -%}
        <span class="global-btn__badge">{{ badge }}</span>
      {%- endif -%}
    </span>
  </a>
{%- else -%}
  <button
    type="{{ btn_type }}"
    class="{{ btn_class }}"
    data-btn-variant="{{ btn_variant }}"
    {% if is_disabled %}
      disabled aria-disabled="true"
    {% endif %}
    {{ attributes }}
  >
    <span class="global-btn__shadow" aria-hidden="true"></span>
    <span class="global-btn__content">
      {%- if icon != blank -%}
        <span class="global-btn__icon">{{ icon }}</span>
      {%- endif -%}
      {%- if btn_text != blank and btn_icon_only != true -%}
        <span class="global-btn__text">{{ btn_text }}</span>
      {%- endif -%}
      {%- if is_add_to_cart -%}
        <span class="sold-out-message hidden">
          {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
        </span>
      {%- endif -%}
      {%- if badge != blank and badge != '0' -%}
        <span class="global-btn__badge">{{ badge }}</span>
      {%- endif -%}
      {%- if is_add_to_cart -%}
        {%- render 'loading-spinner' -%}
      {%- endif -%}
    </span>
  </button>
{%- endif -%}
