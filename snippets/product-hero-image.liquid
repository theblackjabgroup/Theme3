{%- comment -%}
  Product Hero Image Snippet
  ------------------------------------------------------------------------------
  Renders the floating main product image (first media item).

  Usage:
  {% render 'product-hero-image', product: product, section: section %}

  Variables:
  - product: The product object.
{%- endcomment -%}
<div class="product-hero-section">
  {% assign hero_image = null %}
  {% for media in product.media %}
    {% if media.media_type == 'image' %}
      {% assign hero_image = media %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if hero_image %}
    {% if section.settings.enable_sprite_sheet
      and section.settings.sprite_sheet_frames > 1
      and hero_image.aspect_ratio > 2.0
    %}
      <div
        class="product-hero-sprite-container"
        data-frames="{{ section.settings.sprite_sheet_frames }}"
        style="--frames: {{ section.settings.sprite_sheet_frames }};"
      >
        {{
          hero_image
          | image_url: width: hero_image.width
          | image_tag: class: 'product-hero-sprite-img', loading: 'eager', alt: hero_image.alt
        }}
      </div>
    {% else %}
      {{
        hero_image
        | image_url: width: 1200
        | image_tag: class: 'product-hero-image', loading: 'eager', alt: hero_image.alt
      }}
    {% endif %}
  {% endif %}
</div>
