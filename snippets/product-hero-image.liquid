{%- comment -%}
  Product Hero Image Snippet
  ------------------------------------------------------------------------------
  Renders the floating main product image (first media item).

  Usage:
  {% render 'product-hero-image', product: product %}

  Variables:
  - product: The product object.
{%- endcomment -%}
<div class="product-hero-section">
  {% assign hero_image = null %}
  {% for media in product.media %}
    {% if media.media_type == 'image' %}
      {% assign hero_image = media %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if hero_image %}
    {{
      hero_image
      | image_url: width: 1200
      | image_tag: class: 'product-hero-image', loading: 'eager', alt: hero_image.alt
    }}
  {% endif %}
</div>
