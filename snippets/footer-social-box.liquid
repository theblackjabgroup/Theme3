{%- comment -%}
  Renders one footer social icon box.
  Usage: {% render 'footer-social-box', section: section, index: 1 %}
{%- endcomment -%}
{%- assign i = index -%}
{%- assign image_key = 'social_' | append: i | append: '_image' -%}
{%- assign image_hover_key = 'social_' | append: i | append: '_image_hover' -%}
{%- assign svg_key = 'social_' | append: i | append: '_svg' -%}
{%- assign link_key = 'social_' | append: i | append: '_link' -%}
{%- assign alt_key = 'social_' | append: i | append: '_alt' -%}
{%- assign image = section.settings[image_key] -%}
{%- assign image_hover = section.settings[image_hover_key] -%}
{%- assign svg = section.settings[svg_key] -%}
{%- assign link = section.settings[link_key] -%}
{%- assign alt_setting = section.settings[alt_key] -%}
{%- assign alt_text = alt_setting | default: image.alt | default: 'Social link ' | append: i -%}
{%- assign alt_text_hover = alt_setting | default: image_hover.alt | default: 'Social link ' | append: i -%}
{%- assign has_hover_icon = false -%}
{%- if image != blank and image_hover != blank -%}
  {%- assign has_hover_icon = true -%}
{%- endif -%}

<a
  href="{{ link | default: '#' }}"
  class="social-box{% if has_hover_icon %} social-box--has-hover-icon{% endif %}"
  aria-label="{{ alt_text | escape }}"
>
  {%- if image != blank -%}
    {%- if has_hover_icon -%}
      <span class="social-box__icon-wrap">
        <span class="social-box__icon social-box__icon--default">
          <img
            src="{{ image | image_url: width: 80 }}"
            alt="{{ alt_text | escape }}"
            width="24"
            height="24"
            class="social-box__image"
            loading="lazy"
          >
        </span>
        <span class="social-box__icon social-box__icon--hover">
          <img
            src="{{ image_hover | image_url: width: 80 }}"
            alt="{{ alt_text_hover | escape }}"
            width="24"
            height="24"
            class="social-box__image"
            loading="lazy"
          >
        </span>
      </span>
    {%- else -%}
      <img
        src="{{ image | image_url: width: 80 }}"
        alt="{{ alt_text | escape }}"
        width="24"
        height="24"
        class="social-box__image"
        loading="lazy"
      >
    {%- endif -%}
  {%- elsif svg != blank -%}
    {{ svg }}
  {%- else -%}
    {%- case i -%}
      {%- when 1 -%}
