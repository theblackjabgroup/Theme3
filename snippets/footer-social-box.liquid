{%- comment -%}
  Renders one footer social icon box.
  Usage: {% render 'footer-social-box', block: block %}
  Block type social_icon: image, image_hover, svg, link, alt
{%- endcomment -%}
{%- assign image = block.settings.image -%}
{%- assign image_hover = block.settings.image_hover -%}
{%- assign svg = block.settings.svg -%}
{%- assign link = block.settings.link -%}
{%- assign alt_setting = block.settings.alt -%}
{%- if alt_setting != blank -%}
  {%- assign alt_text = alt_setting -%}
{%- elsif image != blank and image.alt != blank -%}
  {%- assign alt_text = image.alt -%}
{%- else -%}
  {%- assign alt_text = 'Social link' -%}
{%- endif -%}
{%- if alt_setting != blank -%}
  {%- assign alt_text_hover = alt_setting -%}
{%- elsif image_hover != blank and image_hover.alt != blank -%}
  {%- assign alt_text_hover = image_hover.alt -%}
{%- elsif image != blank and image.alt != blank -%}
  {%- assign alt_text_hover = image.alt -%}
{%- else -%}
  {%- assign alt_text_hover = 'Social link' -%}
{%- endif -%}
{%- assign has_hover_icon = false -%}
{%- if image != blank and image_hover != blank -%}
  {%- assign has_hover_icon = true -%}
{%- endif -%}

<a
  href="{{ link | default: '#' }}"
  class="social-box{% if has_hover_icon %} social-box--has-hover-icon{% endif %}"
  aria-label="{{ alt_text | escape }}"
  {% if block != blank %}{{ block.shopify_attributes }}{% endif %}
>
  {%- if image != blank -%}
    {%- if has_hover_icon -%}
      <span class="social-box__icon-wrap">
        <span class="social-box__icon social-box__icon--default">
          <img
            src="{{ image | image_url: width: 80 }}"
            alt="{{ alt_text | escape }}"
            width="24"
            height="24"
            class="social-box__image"
            loading="lazy"
          >
        </span>
        <span class="social-box__icon social-box__icon--hover">
          <img
            src="{{ image_hover | image_url: width: 80 }}"
            alt="{{ alt_text_hover | escape }}"
            width="24"
            height="24"
            class="social-box__image"
            loading="lazy"
          >
        </span>
      </span>
    {%- else -%}
      <img
        src="{{ image | image_url: width: 80 }}"
        alt="{{ alt_text | escape }}"
        width="24"
        height="24"
        class="social-box__image"
        loading="lazy"
      >
    {%- endif -%}
  {%- elsif svg != blank -%}
    <span class="social-box__icon-wrap">
      <span class="social-box__icon social-box__icon--default">{{ svg }}</span>
    </span>
  {%- else -%}
    <span class="social-box__icon-wrap">
      <span class="social-box__icon social-box__icon--default">
        <svg viewBox="0 0 24 24" fill="currentColor" class="social-box__image" aria-hidden="true">
          <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 4-8 4z"/>
        </svg>
      </span>
    </span>
  {%- endif -%}
</a>
