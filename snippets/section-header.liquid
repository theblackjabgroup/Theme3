{% comment %}
  Renders a section header with badge, title, and description.

  Accepts:
  - id: {String} Unique ID for styling
  - badge_text: {String} Badge text
  - title: {String} Section title
  - description: {String} Section description
  - title_alignment: {String} Text alignment (left, center, right)
  - show_badge: {Boolean} Whether to show the badge
  - title_font_size: {Number} Font size in rem or px
  - title_font_weight: {Number} Font weight
  - title_line_height: {Number} Line height
  - title_letter_spacing: {Number} Letter spacing
  - title_text_transform: {String} Text transform
  - title_margin_bottom: {Number} Bottom margin
  - description_font_size: {Number} Font size for description
  - description_font_weight: {Number} Font weight for description
  - description_line_height: {Number} Line height for description
  - description_margin_top: {Number} Top margin for description
  - description_color: {String} Color for description
  - header_padding_top: {Number} Top padding for the header container
  - header_padding_bottom: {Number} Bottom padding for the header container
  - header_padding_horizontal: {Number} Horizontal padding for the header container
  - background_color: {String} Background color for the header container
  - border_radius: {Number} Border radius in px for the header container
  - show_image: {Boolean} Whether to show header image
  - header_image: {Image} Header image object
  - image_alignment: {String} Image alignment (left, center, right)
  - image_width_percent: {Number} Image width percentage on desktop
  - image_width_percent_mobile: {Number} Image width percentage on mobile
  - image_max_width: {Number} Image max width in px
  - image_height: {Number} Image height in px
  - image_height_mobile: {Number} Image height in px on mobile
  - image_object_fit: {String} Image object-fit (cover, contain)
  - image_border_radius: {Number} Border radius in px for image
  - image_margin_top: {Number} Top margin in px for image
  - image_margin_bottom: {Number} Bottom margin in px for image
{% endcomment %}

<div
  class="section-header-snippet section-header-snippet-{{ id }} page-width"
  style="text-align: {{ title_alignment | default: 'center' }};"
>
  {%- if show_badge and badge_text != blank -%}
    <span class="section-header-snippet__badge">{{ badge_text | escape }}</span>
  {%- endif -%}

  {%- if title != blank -%}
    <h1 class="section-header-snippet__title">{{ title | escape }}</h1>
  {%- endif -%}

  {%- if description != blank -%}
    <p class="section-header-snippet__description">{{ description }}</p>
  {%- endif -%}

  {%- if show_image and header_image != blank -%}
    <div class="section-header-snippet__media">
      {{
        header_image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', class: 'section-header-snippet__image', alt: title
        | default: shop.name
      }}
    </div>
  {%- endif -%}
</div>

<style>
  .section-header-snippet-{{ id }} {
    padding-top: {% if header_padding_top == blank or header_padding_top == 0 %}20{% else %}{{ header_padding_top }}{% endif %}px;
    padding-bottom: {% if header_padding_bottom == blank or header_padding_bottom == 0 %}20{% else %}{{ header_padding_bottom }}{% endif %}px;
    padding-left: {% if header_padding_horizontal == blank or header_padding_horizontal == 0 %}20{% else %}{{ header_padding_horizontal }}{% endif %}px;
    padding-right: {% if header_padding_horizontal == blank or header_padding_horizontal == 0 %}20{% else %}{{ header_padding_horizontal }}{% endif %}px;
    background-color: var(--color-card-bg);
    border-radius: {{ border_radius | default: 20 }}px;
    {%- if title_margin_bottom != blank -%}
      margin-bottom: {{ title_margin_bottom }}px;
    {%- endif -%}
  }

  .section-header-snippet-{{ id }} .section-header-snippet__title {
    {%- if title_font_size != blank -%}
      font-size: {{ title_font_size }}{% if title_font_size > 10 %}px{% else %}rem{% endif %};
    {%- endif -%}
    {%- if title_font_weight != blank -%}
      font-weight: {{ title_font_weight }};
    {%- endif -%}
    line-height: {{ title_line_height | default: 1.2 }};
    letter-spacing: {{ title_letter_spacing | default: 0 }}px;
    text-transform: {{ title_text_transform | default: 'none' }};
    margin: 0;
    color: {% if title_text_color != blank %}{{ title_text_color }}{% else %}var(--color-heading){% endif %};
  }

  .section-header-snippet-{{ id }} .section-header-snippet__badge {
    display: inline-block;
    color: {% if badge_text_color != blank %}{{ badge_text_color }}{% else %}var(--color-heading){% endif %};
    border: {{ badge_border_width | default: 1 }}px solid {% if badge_border_color != blank %}{{ badge_border_color }}{% else %}var(--color-heading){% endif %};
    {%- if badge_font_size != blank -%}
      font-size: {{ badge_font_size }}px;
    {%- endif -%}
    {%- if badge_font_weight != blank -%}
      font-weight: {{ badge_font_weight }};
    {%- endif -%}
    {%- if badge_padding_vertical != blank or badge_padding_horizontal != blank -%}
      padding: {{ badge_padding_vertical | default: 4 }}px {{ badge_padding_horizontal | default: 16 }}px;
    {%- endif -%}
    {%- if badge_margin_bottom != blank -%}
      margin-bottom: {{ badge_margin_bottom }}px;
    {%- endif -%}
    background-color: {% if badge_background_color != blank %}{{ badge_background_color }}{% else %}var(--color-card-bg){% endif %};
    border-radius: {{ badge_border_radius | default: 20 }}px;
    {%- if badge_text_transform != blank -%}
      text-transform: {{ badge_text_transform }};
    {%- endif -%}
  }

  .section-header-snippet-{{ id }} .section-header-snippet__description {
    {%- if description_font_size != blank -%}
      font-size: {{ description_font_size }}px;
    {%- endif -%}
    {%- if description_font_weight != blank -%}
      font-weight: {{ description_font_weight }};
    {%- endif -%}
    line-height: {{ description_line_height | default: 1.5 }};
    margin-top: {{ description_margin_top | default: 10 }}px;
    margin-bottom: 0;
    color: {% if description_color != blank %}{{ description_color }}{% else %}var(--color-text){% endif %};
  }

  .section-header-snippet-{{ id }} .section-header-snippet__media {
    width: 100%;
    margin-top: {{ image_margin_top | default: 20 }}px;
    margin-bottom: {{ image_margin_bottom | default: 0 }}px;
    display: flex;
    justify-content:
      {% if image_alignment == 'left' %}
        flex-start
      {% elsif image_alignment == 'right' %}
        flex-end
      {% else %}
        center
      {% endif %};
  }

  .section-header-snippet-{{ id }} .section-header-snippet__image {
    width: {{ image_width_percent | default: 100 }}%;
    max-width: {{ image_max_width | default: 1200 }}px;
    height: {{ image_height | default: 320 }}px;
    object-fit: {{ image_object_fit | default: 'cover' }};
    border-radius: {{ image_border_radius | default: 16 }}px;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .section-header-snippet-{{ id }} .section-header-snippet__title {
      {%- if title_font_size_mobile != blank -%}
        font-size: {{ title_font_size_mobile }}{% if title_font_size_mobile > 10 %}px{% else %}rem{% endif %};
      {%- endif -%}
    }
    .section-header-snippet-{{ id }} .section-header-snippet__description {
      {%- if description_font_size_mobile != blank -%}
        font-size: {{ description_font_size_mobile }}px;
      {%- endif -%}
    }

    .section-header-snippet-{{ id }} .section-header-snippet__image {
      width: {{ image_width_percent_mobile | default: image_width_percent | default: 100 }}%;
      height: {{ image_height_mobile | default: image_height | default: 220 }}px;
    }
  }
</style>
