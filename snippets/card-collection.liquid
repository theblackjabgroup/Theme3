{%- comment -%}
  Renders a custom collection card matching the product card design

  Accepts:
  - collection: {Object} Collection Liquid object (required)
  - show_badge: {Boolean} Show badge on card. Default: true (optional)
  - section_settings: {Object} Section settings (optional)
{%- endcomment -%}

{%- if collection and collection != empty -%}
  {%- assign overlay_btn_text = section_settings.overlay_button_text | default: 'Check it out' -%}
  <div class="custom-collection-card-wrapper">
    <div class="custom-collection-card">
      <a href="{{ collection.url }}" class="custom-collection-card__main-link">
        <div class="custom-collection-card__image-container">
          {%- if collection.featured_image -%}
            <img
              src="{{ collection.featured_image | image_url: width: 533 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              class="custom-collection-card__image"
              loading="lazy"
              width="533"
              height="{{ 533 | divided_by: collection.featured_image.aspect_ratio }}"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'custom-collection-card__image placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="custom-collection-card__content">
          {%- if show_badge != false -%}
            <span class="custom-collection-card__badge">
              {{- collection.all_products_count }}
              {%- if collection.all_products_count == 1 -%}
                item
              {%- else -%}
                items
              {%- endif -%}
            </span>
          {%- endif -%}

          <h3 class="custom-collection-card__title">
            {{ collection.title | escape }}
          </h3>

          {%- if collection.description != blank -%}
            <p class="custom-collection-card__description">
              {{ collection.description | strip_html | truncatewords: 12, '....' }}
            </p>
          {%- endif -%}
        </div>
      </a>

      {%- render 'global-btn',
        url: collection.url,
        text: overlay_btn_text,
        variant: 'secondary',
        fit_width: false,
        class: 'custom-collection-card__hover-button'
      -%}
    </div>
  </div>
{%- endif -%}
