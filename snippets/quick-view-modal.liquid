{%- comment -%}
  Quick View Modal
  Opens from top to center when clicking the eye icon on product cards.

  Accepts:
  - product: {Object} Product object
  - section_id: {String} Section ID
{%- endcomment -%}

{%- assign qv_product_form_id = 'quick-view-form-' | append: section_id | append: '-' | append: product.id -%}

<quick-view-modal id="QuickView-{{ product.id }}" class="quick-view-modal" data-product-id="{{ product.id }}">
  <div class="quick-view-modal__overlay" data-quick-view-close></div>
  <div
    role="dialog"
    aria-label="Quick view: {{ product.title | escape }}"
    aria-modal="true"
    class="quick-view-modal__content"
    tabindex="-1"
  >
    <button
      type="button"
      class="quick-view-modal__close"
      data-quick-view-close
      aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="quick-view-modal__inner">
      <div class="quick-view-modal__media">
        <div class="quick-view-modal__slider" data-quick-view-slider>
          {%- for media in product.media -%}
            <div
              class="quick-view-modal__slide{% if forloop.first %} is-active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
            >
              {%- if media.media_type == 'image' -%}
                <img
                  src="{{ media | image_url: width: 800 }}"
                  alt="{{ media.alt | escape }}"
                  width="800"
                  height="{{ 800 | divided_by: media.aspect_ratio | round }}"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="quick-view-modal__nav">
            {%- render 'global-btn-2',
              text: '←',
              type: 'button',
              variant: 'primary',
              fit_width: false,
              hover: true,
              border_radius: '50%',
              class: 'quick-view-modal__nav-btn quick-view-modal__nav-btn--prev',
              attributes: 'data-quick-view-prev aria-label="Previous image"'
            -%}
            {%- render 'global-btn-2',
              text: '→',
              type: 'button',
              variant: 'primary',
              fit_width: false,
              hover: true,
              border_radius: '100%',
              class: 'quick-view-modal__nav-btn quick-view-modal__nav-btn--next',
              attributes: 'data-quick-view-next aria-label="Next image"'
            -%}
          </div>
        {%- endif -%}
      </div>

      <div class="quick-view-modal__info">
        {%- liquid
          assign qv_badge_text = product.metafields.custom.badge_text
          if qv_badge_text == blank
            assign qv_badge_text = product.type
          endif
          if qv_badge_text == blank
            assign qv_badge_text = product.vendor
          endif
        -%}
        {%- if qv_badge_text != blank -%}
          <span class="quick-view-modal__badge">{{ qv_badge_text }}</span>
        {%- endif -%}

        <h2 class="quick-view-modal__title">{{ product.title }}</h2>

        <div class="quick-view-modal__price">
          <span class="quick-view-modal__price-current">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="quick-view-modal__price-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <p class="quick-view-modal__stock">
          {%- if product.available -%}
            In Stock
          {%- else -%}
            Out of Stock
          {%- endif -%}
        </p>

        {%- if product.has_only_default_variant == false -%}
          <div class="quick-view-modal__variants">
            {%- for option in product.options_with_values -%}
              <div class="quick-view-modal__option" data-option-index="{{ forloop.index0 }}">
                <div class="quick-view-modal__option-values">
                  {%- for value in option.values -%}
                    {%- assign is_selected = false -%}
                    {%- if product.selected_or_first_available_variant.options contains value -%}
                      {%- assign is_selected = true -%}
                    {%- endif -%}
                    {%- capture variant_btn_attrs -%}data-option-value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{%- endcapture -%}
                    {%- if is_selected -%}
                      {%- render 'global-btn-2',
                        text: value,
                        type: 'button',
                        variant: 'secondary',
                        fit_width: false,
                        hover: false,
                        class: 'quick-view-modal__variant-btn is-selected',
                        attributes: variant_btn_attrs
                      -%}
                    {%- else -%}
                      {%- render 'global-btn-2',
                        text: value,
                        type: 'button',
                        variant: 'primary',
                        fit_width: false,
                        hover: true,
                        class: 'quick-view-modal__variant-btn',
                        attributes: variant_btn_attrs
                      -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <span class="quick-view-modal__option-label" data-variant-label data-option-name="{{ option.name }}">
                  {{- product.selected_or_first_available_variant.title -}}
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <product-form class="quick-view-modal__form" data-section-id="{{ section_id }}">
          {%- form 'product',
            product,
            id: qv_product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="product-variant-id"
              data-quick-view-variant-id
              {% if product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
            >

            <div class="quick-view-modal__add-row">
              {%- render 'quantity-selector', item: product.selected_or_first_available_variant, edit_panel: true -%}

              {%- render 'global-btn',
                text: 'Add to cart',
                type: 'submit',
                variant: 'tertiary',
                class: 'quick-view-modal__add-btn',
                is_add_to_cart: true
              -%}
            </div>
          {%- endform -%}
        </product-form>

        <div class="quick-view-modal__pickup">
          <pickup-availability
            class="quick-view-modal__pickup-availability"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            data-fetch-on-connect
          ></pickup-availability>
        </div>
      </div>
    </div>
  </div>
</quick-view-modal>

<script type="application/json" data-quick-view-variants="{{ product.id }}">
  {{ product.variants | json }}
</script>
