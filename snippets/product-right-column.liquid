{%- comment -%}
  Product Right Column Snippet
  ------------------------------------------------------------------------------
  Renders the scrollable right column with image slider and detail blocks.
  Desktop image slider is rendered from the Product Media Gallery block when present.

  Usage:
  {% render 'product-right-column', product: product, section: section %}

  Variables:
  - product: The product object.
  - section: The section object (to iterate over blocks).
{%- endcomment -%}
<div class="product-split-right" style="--block-gap: {{ block_gap | default: 24 }}px;">
  {%- assign accordion_count = 0 -%}
  {%- assign in_content_stack = false -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'product_media' -%}
        {%- if in_content_stack -%}
          </div>
          {%- assign in_content_stack = false -%}
        {%- endif -%}
        <div class="product-media-block-wrapper" {{ block.shopify_attributes }}>
          {% render 'product-image-slider', product: product, section: section, block: block %}
        </div>

      {%- when 'collapsible_tab' -%}
        {%- unless in_content_stack -%}
          <div class="product-content-stack" style="--block-gap: {{ block_gap | default: 24 }}px;">
          {%- assign in_content_stack = true -%}
        {%- endunless -%}
        {%- if accordion_count < 2 -%}
          {% render 'block-accordion', block: block %}
          {%- assign accordion_count = accordion_count | plus: 1 -%}
        {%- endif -%}

      {%- when 'description' -%}
        {%- unless in_content_stack -%}
          <div class="product-content-stack" style="--block-gap: {{ block_gap | default: 24 }}px;">
          {%- assign in_content_stack = true -%}
        {%- endunless -%}
        <div class="product__description" style="
          font-size: {{ block.settings.font_size | default: 18 }}px;
          font-weight: {{ block.settings.font_weight | default: 400 }};
        " {{ block.shopify_attributes }}>{{ product.description }}</div>

      {%- when 'marquee' -%}
        {%- unless in_content_stack -%}
          <div class="product-content-stack" style="--block-gap: {{ block_gap | default: 24 }}px;">
          {%- assign in_content_stack = true -%}
        {%- endunless -%}
        {% render 'block-marquee', block: block %}

      {%- when 'feature_row' -%}
        {%- unless in_content_stack -%}
          <div class="product-content-stack" style="--block-gap: {{ block_gap | default: 24 }}px;">
          {%- assign in_content_stack = true -%}
        {%- endunless -%}
        {% render 'block-feature-row', block: block %}

      {%- when 'icon_strip' -%}
        {%- unless in_content_stack -%}
          <div class="product-content-stack" style="--block-gap: {{ block_gap | default: 24 }}px;">
          {%- assign in_content_stack = true -%}
        {%- endunless -%}
        {% render 'block-icon-strip', block: block %}
    {%- endcase -%}
  {%- endfor -%}
  {%- if in_content_stack -%}
    </div>
  {%- endif -%}
</div>
