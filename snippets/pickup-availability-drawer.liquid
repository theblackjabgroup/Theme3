{%- comment -%}
  Pickup Availability Drawer
  Rendered from theme.liquid (same level as cart-drawer) so CSS variables
  resolve from the root color scheme, matching cart-drawer colours.

  Accepts:
  - product  {Object} The product object
  - variant  {Object} The currently selected variant
{%- endcomment -%}

<style>
  pickup-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 30vw;
    min-width: 360px;
    max-width: 440px;
    height: 95vh;
    z-index: 9999;
    margin: 20px;
    border-radius: 20px;
    overflow: hidden;
    transform: translateX(110%);
    visibility: hidden;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0s linear 1.2s;
    pointer-events: none;
  }

  pickup-drawer.active {
    pointer-events: auto;
    transform: translateX(0);
    visibility: visible;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0s linear 0s;
  }

  .pickup-drawer__wrap {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--color-card-bg);
  }

  /* Overlay sits inside the pickup-drawer element at z-index 0,
     drawer content sits at z-index 2 — identical to cart-drawer */
  .pickup-drawer__overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  body.pickup-drawer-open .pickup-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .pickup-drawer__inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-card-bg);
    position: relative;
    z-index: 2;
    box-shadow: -4px 0 24px color-mix(in srgb, var(--color-text) 5%, transparent);
  }

  /* Page blur — same as cart-drawer */
  body.pickup-drawer-open main,
  body.pickup-drawer-open #MainContent,
  body.pickup-drawer-open footer,
  body.pickup-drawer-open [id^='shopify-section-']:not(pickup-drawer),
  body.pickup-drawer-open .floating-dock-header,
  body.pickup-drawer-open .mobile-header,
  body.pickup-drawer-open header {
    filter: blur(4px);
    transition: filter 0.3s ease;
    pointer-events: none;
  }

  body.pickup-drawer-open pickup-drawer,
  body.pickup-drawer-open pickup-drawer * {
    filter: none !important;
    pointer-events: auto !important;
  }

  /* Header */
  .pickup-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 28px 32px 0;
    flex-shrink: 0;
    gap: 22px;
  }

  .pickup-drawer__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    color: var(--color-heading);
    line-height: 1;
    margin: 0;
  }

  .pickup-drawer__close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-heading);
    padding: 0;
    border-radius: 8px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .pickup-drawer__close:hover {
    background: color-mix(in srgb, var(--color-heading) 10%, transparent);
  }

  .pickup-drawer__close svg {
    width: 24px;
    height: 24px;
  }

  /* Scrollable body */
  .pickup-drawer__scrollable {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 24px 32px 40px;
    gap: 24px;
  }

  .pickup-drawer__divider {
    width: 100%;
    height: 1px;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    flex-shrink: 0;
  }

  /* Product info */
  .pickup-drawer__product-name {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-foreground);
    margin: 0 0 4px;
  }

  .pickup-drawer__product-variant {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: var(--color-foreground);
    margin: 0;
    opacity: 0.6;
  }

  /* Locations */
  .pickup-drawer__locations {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pickup-drawer__location {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pickup-drawer__city {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-foreground);
    margin: 0;
  }

  .pickup-drawer__availability {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .pickup-drawer__check-icon {
    flex-shrink: 0;
    line-height: 0;
    margin-top: 2px;
  }

  .pickup-drawer__availability-text {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: var(--color-foreground);
    margin: 0;
  }

  .pickup-drawer__store-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pickup-drawer__store-name {
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .pickup-drawer__store-address,
  .pickup-drawer__store-phone {
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: var(--color-foreground);
    margin: 0;
    opacity: 0.7;
  }
</style>

<pickup-drawer id="PickupDrawer">
  <div class="pickup-drawer__wrap">
    <div class="pickup-drawer__overlay"></div>
    <div class="pickup-drawer__inner">

      <div class="pickup-drawer__header">
        <h2 class="pickup-drawer__title">Pickup<br>Availability</h2>
        <button class="pickup-drawer__close" id="PickupDrawerClose" aria-label="Close pickup availability">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="pickup-drawer__scrollable">
        <div class="pickup-drawer__divider"></div>

        <div class="pickup-drawer__product">
          <p class="pickup-drawer__product-name" id="PickupDrawerProductName">{{ product.title }}</p>
          {%- if variant.title != 'Default Title' -%}
            <p class="pickup-drawer__product-variant" id="PickupDrawerVariantName">{{ variant.title }}</p>
          {%- endif -%}
        </div>

        <div class="pickup-drawer__divider"></div>

        <div class="pickup-drawer__locations">
          {%- assign store_locations = product.metafields.custom.store_locations -%}
          {%- if store_locations != blank -%}
            {%- for location in store_locations.value -%}
              <div class="pickup-drawer__location">
                <p class="pickup-drawer__city">{{ location.city }}</p>
                <div class="pickup-drawer__availability">
                  <span class="pickup-drawer__check-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="12" fill="var(--btn-tertiary-bg, #F5A30A)"/>
                      <path d="M7 12.5l3.5 3.5 6.5-7" stroke="var(--btn-tertiary-text, #000)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <p class="pickup-drawer__availability-text">{{ location.availability | default: 'Pickup available, usually ready in 24 hours.' }}</p>
                </div>
                <div class="pickup-drawer__store-info">
                  <p class="pickup-drawer__store-name">{{ location.store_name }}</p>
                  <p class="pickup-drawer__store-address">{{ location.address }}</p>
                  {%- if location.phone != blank -%}
                    <p class="pickup-drawer__store-phone">{{ location.phone }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="pickup-drawer__location">
              <p class="pickup-drawer__city">Gurugram</p>
              <div class="pickup-drawer__availability">
                <span class="pickup-drawer__check-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="12" fill="var(--btn-tertiary-bg, #F5A30A)"/>
                    <path d="M7 12.5l3.5 3.5 6.5-7" stroke="var(--btn-tertiary-text, #000)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <p class="pickup-drawer__availability-text">Pickup available, usually ready in 24 hours.</p>
              </div>
              <div class="pickup-drawer__store-info">
                <p class="pickup-drawer__store-name">WeWork</p>
                <p class="pickup-drawer__store-address">122001 Gurugram HR<br>India</p>
                <p class="pickup-drawer__store-phone">+918851154530</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</pickup-drawer>
