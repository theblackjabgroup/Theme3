{%- comment -%}
  Renders a submit button with the share-story-submit styling using a dual-span layer for 3D effect.
  Accepts:
  - text: {String} Button text (required)
  - url: {String} Optional URL. If provided, renders as <a>, otherwise as <button>
  - type: {String} Button type (default: 'button', can be 'submit' for forms)
  - class: {String} Additional CSS classes (default: 'share-story-submit')
  - icon: {String} Optional SVG icon code
  - badge: {String} Optional badge text/number
  - attributes: {String} Optional extra attributes
{%- endcomment -%}

<style>
  .share-story-submit {
    position: relative;
    display: inline-block;
    background: transparent;
    padding: 0;
    border: none;
    cursor: pointer;
    text-decoration: none;
    width: fit-content;
    margin-top: 0;
    text-transform: none;
    z-index: 1;
    -webkit-tap-highlight-color: transparent;
  }

  .share-story-submit * {
    box-sizing: border-box;
  }

  .submit-button__shadow {
    position: absolute;
    top: 2px;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-primary-button-hover-bg);
    border-radius: var(--radius-l);
    z-index: -1;
    transition: transform 0.4s ease;
  }

  .submit-button__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg);
    color: var(--color-primary-button-text);
    border: 1px solid var(--color-primary-button-border);
    padding: 20px;
    border-radius: var(--radius-l);
    font-size: 1.4rem;
    font-weight: 700;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    transition: transform 0.4s ease;
    will-change: transform;
    width: 100%;
    height: 100%;
  }

  .share-story-submit:not([disabled]):hover .submit-button__content {
    transform: translate(0, -2px);
  }

  .share-story-submit:not([disabled]):active .submit-button__content {
    transform: translate(0, 1px);
  }

  .submit-button__icon {
    display: inline-flex;
    align-items: center;
    margin-right: 8px;
  }

  .submit-button__text {
    position: relative;
  }

  .submit-button__badge {
    margin-left: 8px;
    background: var(--color-primary-button-hover-bg);
    color: var(--color-primary-button-text);
    padding: 2px 6px;
    border-radius: 12px;
    font-size: 0.8em;
  }

  .button-card .share-story-submit {
    width: 97%;
  }

  .button-card .share-story-submit .submit-button__content {
    width: 100%;
  }
</style>

{%- assign button_text = text | default: 'Button' -%}
{%- assign button_type = type | default: 'button' -%}
{%- if class != blank -%}
  {%- assign button_class = 'share-story-submit ' | append: class -%}
{%- else -%}
  {%- assign button_class = 'share-story-submit' -%}
{%- endif -%}

{%- if url != blank -%}
  <a class="{{ button_class }}" href="{{ url }}" {{ attributes }}>
    <span class="submit-button__shadow"></span>
    <span class="submit-button__content">
      {%- if icon != blank -%}
        <span class="submit-button__icon">{{ icon }}</span>
      {%- endif -%}
      {%- if button_text != blank -%}
        <span class="submit-button__text">{{ button_text }}</span>
      {%- endif -%}
      {%- if badge != blank and badge != '0' -%}
        <span class="submit-button__badge">{{ badge }}</span>
      {%- endif -%}
    </span>
  </a>
{%- else -%}
  <button type="{{ button_type }}" class="{{ button_class }}" {{ attributes }}>
    <span class="submit-button__shadow"></span>
    <span class="submit-button__content">
      {%- if icon != blank -%}
        <span class="submit-button__icon">{{ icon }}</span>
      {%- endif -%}
      {%- if button_text != blank -%}
        <span class="submit-button__text">{{ button_text }}</span>
      {%- endif -%}
      {%- if is_add_to_cart -%}
        <span class="sold-out-message hidden">
          {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
        </span>
      {%- endif -%}
      {%- if badge != blank and badge != '0' -%}
        <span class="submit-button__badge">{{ badge }}</span>
      {%- endif -%}
      {%- if is_add_to_cart -%}
        {%- render 'loading-spinner' -%}
      {%- endif -%}
    </span>
  </button>
{%- endif -%}
