{%- comment -%}
  Renders a submit button with the share-story-submit styling.
  Accepts:
  - text: {String} Button text (required)
  - url: {String} Optional URL. If provided, renders as <a>, otherwise as <button>
  - type: {String} Button type (default: 'button', can be 'submit' for forms)
  - class: {String} Additional CSS classes (default: 'share-story-submit')
{%- endcomment -%}

<style>
  .bouncy-button-wrapper {
    position: relative;
    display: inline-flex;
    z-index: 1;
    width: fit-content;
  }

  .bouncy-button-shadow {
    position: absolute;
    top: 4px;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-l);
    background-color: var(--color-shadow);
    z-index: -1;
    pointer-events: none;
    transform-origin: center center;
    transition: all 0.3s ease-out;
  }

  .share-story-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg);
    color: white;
    border: 2px solid var(--color-primary-button-border);
    padding: 20px;
    border-radius: var(--radius-l);
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    margin-top: 0;
    text-transform: none;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    transform-origin: center bottom;
    transition: transform 0.3s ease-out;
  }

  .bouncy-button-wrapper:hover .share-story-submit {
    transform: translateY(-6px);
  }

  .bouncy-button-wrapper:active .share-story-submit {
    transform: translateY(4px);
    transition: transform 0.1s ease-out;
  }

  .button-card .share-story-submit {
    padding: 20px !important;
    width: 97%;
  }
</style>

{%- assign button_text = text | default: 'Button' -%}
{%- assign button_type = type | default: 'button' -%}
{%- assign button_class = class | default: 'share-story-submit' -%}

<div class="bouncy-button-wrapper">
  <div class="bouncy-button-shadow">&nbsp;</div>
  {%- if url != blank -%}
    <a class="{{ button_class }}" href="{{ url }}">
      {{ button_text }}
    </a>
  {%- else -%}
    <button type="{{ button_type }}" class="{{ button_class }}">
      {{ button_text }}
    </button>
  {%- endif -%}
</div>
