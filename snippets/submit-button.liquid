{%- comment -%}
  Renders a submit button with the share-story-submit styling.
  Accepts:
  - text: {String} Button text (required)
  - url: {String} Optional URL. If provided, renders as <a>, otherwise as <button>
  - type: {String} Button type (default: 'button', can be 'submit' for forms)
  - class: {String} Additional CSS classes (default: 'share-story-submit')
  - icon: {String} Optional SVG icon code
  - badge: {String} Optional badge text/number
  - attributes: {String} Optional extra attributes
{%- endcomment -%}

<style>
  .share-story-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg);
    color: white;
    border: 2px solid var(--color-primary-button-border);
    padding: 20px;
    border-radius: var(--radius-l);
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    margin-top: 0;
    text-transform: none;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 0 var(--color-shadow);
  }

  .share-story-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--color-shadow);
  }

  .share-story-submit:active {
    animation: bounce-click 0.2s ease;
    box-shadow: 0 0 0 var(--color-shadow);
    transform-origin: center center;
  }

  /* Override for button card context if needed */
  .button-card .share-story-submit {
    padding: 20px !important;
    width: 97%;
  }
</style>

{%- assign button_text = text | default: 'Button' -%}
{%- assign button_type = type | default: 'button' -%}
{%- if class != blank -%}
  {%- assign button_class = 'share-story-submit ' | append: class -%}
{%- else -%}
  {%- assign button_class = 'share-story-submit' -%}
{%- endif -%}

{%- if url != blank -%}
  <a class="{{ button_class }}" href="{{ url }}" {{ attributes }}>
    {%- if icon != blank -%}
      <span class="submit-button__icon">{{ icon }}</span>
    {%- endif -%}
    {%- if button_text != blank -%}
      <span class="submit-button__text">{{ button_text }}</span>
    {%- endif -%}
    {%- if badge != blank and badge != '0' -%}
      <span class="submit-button__badge">{{ badge }}</span>
    {%- endif -%}
  </a>
{%- else -%}
  <button type="{{ button_type }}" class="{{ button_class }}" {{ attributes }}>
    {%- if icon != blank -%}
      <span class="submit-button__icon">{{ icon }}</span>
    {%- endif -%}
    {%- if button_text != blank -%}
      <span class="submit-button__text">{{ button_text }}</span>
    {%- endif -%}
    {%- if badge != blank and badge != '0' -%}
      <span class="submit-button__badge">{{ badge }}</span>
    {%- endif -%}
  </button>
{%- endif -%}
