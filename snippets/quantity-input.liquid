{% comment %}
  Quantity input

  Accepts:
  - variant: {Object} Variant object
  - variant_id: {String} Variant ID (optional)
  - min: {Number} Min (optional)

  Usage:
  {% render 'quantity-input' variant: variant %}
{% endcomment %}

{{ 'component-quantity.css' | asset_url | stylesheet_tag }}

<quantity-input class="quantity cart-quantity{% if is_product_form %} quantity--drawer-style{% endif %}">
  <button class="quantity__button" name="minus" type="button" data-target="decrement-{{ variant.id }}">
    <span class="visually-hidden">
      {{- 'products.product.quantity.decrease' | t: product: variant.title | escape -}}
    </span>
    <span class="svg-wrapper">
      {{- 'minus-icon.svg' | inline_asset_content -}}
    </span>
  </button>
  <input
    class="quantity__input"
    data-quantity-variant-id="{{ variant.id }}"
    type="number"
    readonly
    {% if is_product_form %}
      name="quantity"
      value="1"
      {% if product_form_id %}
        form="{{ product_form_id }}"
      {% endif %}
    {% else %}
      name="updates[{{ variant_id }}]"
      value="{{ cart | item_count_for_variant: variant.id }}"
    {% endif %}
    data-cart-quantity="{{ cart | item_count_for_variant: variant.id }}"
    min="{{ min }}"
    data-min="{{ variant.quantity_rule.min }}"
    {%- liquid
      assign max_quantity = null
      if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
        assign max_quantity = variant.inventory_quantity
      endif
      if variant.quantity_rule.max != null
        if max_quantity == null or variant.quantity_rule.max < max_quantity
          assign max_quantity = variant.quantity_rule.max
        endif
      endif
    -%}
    {% if max_quantity != null %}
      max="{{ max_quantity }}"
      data-max="{{ max_quantity }}"
    {% endif %}
    step="{{ variant.quantity_rule.increment }}"
    aria-label="{{ 'products.product.quantity.input_label' | t: product: variant.title | escape }}"
    id="Quantity-{{ variant.id }}"
    data-index="{{ variant.id }}"
    data-target="quantity-input-{{ variant.id }}"
  >
  <button class="quantity__button" name="plus" type="button" data-target="increment-{{ variant.id }}">
    <span class="visually-hidden">
      {{- 'products.product.quantity.increase' | t: product: variant.title | escape -}}
    </span>
    <span class="svg-wrapper">
      {{- 'plus-icon.svg' | inline_asset_content -}}
    </span>
  </button>
  {%- render 'progress-bar' -%}
</quantity-input>
