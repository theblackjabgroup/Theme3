{%- comment -%}
  Block: Accordion
  ------------------------------------------------------------------------------
  Renders a collapsible accordion tab.

  Usage:
  {% render 'block-accordion', block: block %}

  Variables:
  - block: The block object containing settings (heading, content).
{%- endcomment -%}
<script src="{{ 'component-accordion.js' | asset_url }}" defer="defer"></script>

<accordion-item class="accordion">
  <div class="accordion__summary">
    {{ block.settings.heading }}
    <span class="accordion__icon"></span>
  </div>
  <div class="accordion__wrapper">
    <div class="accordion__content">
      <div class="accordion__inner">
        {{ block.settings.content }}
        {{ block.settings.custom_liquid }}
      </div>
    </div>
  </div>
</accordion-item>
