{%- comment -%}
  Header Button Snippet
  Reusable button component for header navigation

  Parameters:
  - button_text: Text to display on button
  - button_url: URL for the link (optional)
  - button_icon: SVG icon code or image tag (optional)
  - button_icon_is_image: Boolean flag if icon is an image (optional)
  - button_hover_icon: Hover icon SVG code or image tag (optional)
  - button_hover_icon_is_image: Boolean flag if hover icon is an image (optional)
  - button_type: Type of button (link, button, etc.)
  - button_class: Additional CSS classes
  - aria_label: Accessibility label
  - button_badge: Badge text/number to display (optional)
  - skip_nav_class: If true, don't apply header-nav-button class (optional)
  - button_id: Optional ID for the element (e.g. cart-icon-bubble for cart drawer)
{%- endcomment -%}

{%- liquid
  assign button_type = button_type | default: 'link'
  assign button_class = button_class | default: ''
  assign aria_label = aria_label | default: button_text
  assign button_icon_is_image = button_icon_is_image | default: false
  assign button_hover_icon_is_image = button_hover_icon_is_image | default: false
  assign skip_nav_class = skip_nav_class | default: false
  assign button_id = button_id | default: ''
  if button_hover_icon != blank
    assign button_class = button_class | append: ' has-hover-icon'
  endif
  if skip_nav_class == false
    assign base_class = 'header-nav-button'
  else
    assign base_class = ''
  endif
-%}

{%- if button_type == 'link' -%}
  <a
    href="{{ button_url | default: '#' }}"
    class="{{ base_class }} {{ button_class }}"
    {% if button_id != blank %}
      id="{{ button_id }}"
    {% endif %}
    {% if aria_label != blank %}
      aria-label="{{ aria_label }}"
    {% endif %}
    {% if button_class contains 'search' %}
      data-spotlight-search-toggle
    {% endif %}
  >
    {%- if button_icon != blank -%}
      {%- if skip_nav_class -%}
        <span class="header-action-button-icon {% if button_icon_is_image %}header-action-button-icon--image{% endif %}">
          <span class="action-icon-default">{{ button_icon }}</span>
          {%- if button_hover_icon != blank -%}
            <span class="action-icon-hover {% if button_hover_icon_is_image %}header-action-button-icon--image{% endif %}">
              {{- button_hover_icon -}}
            </span>
          {%- endif -%}
        </span>
      {%- else -%}
        <span class="header-nav-button-icon {% if button_icon_is_image %}header-nav-button-icon--image{% endif %}">
          <span class="nav-icon-default">{{ button_icon }}</span>
          {%- if button_hover_icon != blank -%}
            <span class="nav-icon-hover {% if button_hover_icon_is_image %}header-nav-button-icon--image{% endif %}">
              {{- button_hover_icon -}}
            </span>
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endif -%}
    {%- if button_text != blank -%}
      {%- if skip_nav_class -%}
        <span class="header-action-button-text">{{ button_text }}</span>
      {%- else -%}
        <span class="header-nav-button-text">{{ button_text }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if button_badge != blank and button_badge != '0' -%}
      <span class="header-action-button-badge">{{ button_badge }}</span>
    {%- elsif button_class contains 'cart' and cart.item_count > 0 -%}
      <span class="header-action-button-badge">{{ cart.item_count }}</span>
    {%- endif -%}
  </a>
{%- else -%}
  <button
    type="{{ button_type }}"
    class="{{ base_class }} {{ button_class }}"
    {% if button_id != blank %}
      id="{{ button_id }}"
    {% endif %}
    {% if aria_label != blank %}
      aria-label="{{ aria_label }}"
    {% endif %}
    {% if button_url != blank %}
      data-url="{{ button_url }}"
    {% endif %}
    {% if button_class contains 'search' %}
      data-spotlight-search-toggle
    {% endif %}
  >
    {%- if button_icon != blank -%}
      {%- if skip_nav_class -%}
        <span class="header-action-button-icon {% if button_icon_is_image %}header-action-button-icon--image{% endif %}">
          <span class="action-icon-default">{{ button_icon }}</span>
          {%- if button_hover_icon != blank -%}
            <span class="action-icon-hover {% if button_hover_icon_is_image %}header-action-button-icon--image{% endif %}">
              {{- button_hover_icon -}}
            </span>
          {%- endif -%}
        </span>
      {%- else -%}
        <span class="header-nav-button-icon {% if button_icon_is_image %}header-nav-button-icon--image{% endif %}">
          <span class="nav-icon-default">{{ button_icon }}</span>
          {%- if button_hover_icon != blank -%}
            <span class="nav-icon-hover {% if button_hover_icon_is_image %}header-nav-button-icon--image{% endif %}">
              {{- button_hover_icon -}}
            </span>
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endif -%}
    {%- if button_text != blank -%}
      {%- if skip_nav_class -%}
        <span class="header-action-button-text">{{ button_text }}</span>
      {%- else -%}
        <span class="header-nav-button-text">{{ button_text }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if button_badge != blank and button_badge != '0' -%}
      <span class="header-action-button-badge">{{ button_badge }}</span>
    {%- endif -%}
  </button>
{%- endif -%}
