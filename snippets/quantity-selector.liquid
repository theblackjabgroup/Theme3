{% comment %}
  Quantity selector (cart page design)

  Accepts:
  - item: {Object} Cart item with quantity, variant_id, index

  Usage:
  {% render 'quantity-selector', item: item %}
{% endcomment %}
{%- liquid
  assign max_quantity = null
  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
    assign max_quantity = item.variant.inventory_quantity
  endif
  if item.variant.quantity_rule.max != null
    if max_quantity == null or item.variant.quantity_rule.max < max_quantity
      assign max_quantity = item.variant.quantity_rule.max
    endif
  endif
-%}
<div
  class="quantity quantity--drawer-style cart-item__quantity-selector"
  data-item-index="{{ item.index | plus: 1 }}"
  data-variant-id="{{ item.variant_id }}"
>
  <button
    type="button"
    class="quantity__button cart-item__quantity-btn cart-item__quantity-minus"
    name="minus"
    aria-label="{{ 'products.product.quantity.decrease' | t | default: 'Decrease quantity' }}"
  >
    &minus;
  </button>
  <input
    type="number"
    name="updates[]"
    value="{{ item.quantity }}"
    min="0"
    class="quantity__input"
    id="Quantity-{{ item.index | plus: 1 }}"
    data-index="{{ item.index | plus: 1 }}"
    data-variant-id="{{ item.variant_id }}"
    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | default: 'Quantity' }}"
    readonly
    {% if max_quantity != null %}
      max="{{ max_quantity }}"
      data-max="{{ max_quantity }}"
    {% endif %}
  >
  <button
    type="button"
    class="quantity__button cart-item__quantity-btn cart-item__quantity-plus"
    name="plus"
    aria-label="{{ 'products.product.quantity.increase' | t | default: 'Increase quantity' }}"
  >
    &plus;
  </button>
</div>
