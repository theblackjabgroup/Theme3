{%- comment -%}
  Block: Icon Strip
  ------------------------------------------------------------------------------
  Renders a row of up to 4 icons with text headings.

  Usage:
  {% render 'block-icon-strip', block: block %}

  Variables:
  - block: The block object containing settings (icon_1, text_1, etc.).
{%- endcomment -%}
<div class="icon-strip">
  {% for i in (1..4) %}
    {% assign icon_key = 'icon_' | append: i %}
    {% assign text_key = 'text_' | append: i %}
    {% assign icon = block.settings[icon_key] %}
    {% assign text = block.settings[text_key] %}

    {% if icon != blank or text != blank %}
      <div class="icon-strip-item">
        <div class="icon-strip-image-wrapper">
          {% if icon != blank %}
            {{ icon | image_url: width: 100 | image_tag: loading: 'lazy', class: 'icon-strip-image', alt: icon.alt }}
          {% else %}
            {% case i %}
              {% when 1 %}
                <!-- Heart (Love) -->
                <svg
                  class="icon-strip-image"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {% when 2 %}
                <!-- Chat Bubble (Conversation) -->
                <svg
                  class="icon-strip-image"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              {% when 3 %}
                <!-- Sparkle/Star (Magnet/Appeal) -->
                <svg
                  class="icon-strip-image"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {% when 4 %}
                <!-- Globe (Non-Profit/World) -->
                <svg
                  class="icon-strip-image"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
            {% endcase %}
          {% endif %}
        </div>
        {% if text != blank %}
          <span class="icon-strip-text">{{ text }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>
