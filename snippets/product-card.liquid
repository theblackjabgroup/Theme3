          <rect y="7.64" width="44" height="22" rx="8" transform="rotate(-10 0 7.64)" fill="var(--dc-tooltip-bg)" />
          <rect x="0.46" y="7.96" width="43.2" height="21.2" rx="7.6" transform="rotate(-10 0.46 7.96)" stroke="var(--dc-tooltip-bg)" stroke-width="0.8" />
