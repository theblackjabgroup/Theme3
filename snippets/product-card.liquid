9859 12.3996 31.9261 12.5441L32.556 16.116L31.9533 16.2223Z" fill="var(--dc-tooltip-bg)"/>
        </svg>
        <div
          class="dc-tooltip-content"
          style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-10deg); color: var(--dc-tooltip-text, #fff); width: 100%; text-align: center; font-size: 0.8rem; font-weight: bold;"
        >
          <span class="dc-tooltip-val" data-value="{{ current_amount }}">
            {{ current_amount | default: 'Lorem' }}
          </span>
        </div>
      </div>
    </div>

    <div class="dc-bar-track">
      <div class="dc-bar-fill" style="--target-width: {{ percentage }}%;">
        <div class="dc-dot"></div>
      </div>
    </div>

    <div class="dc-ticks">
      <div class="dc-tick"></div>
      <div class="dc-tick"></div>
      <div class="dc-tick"></div>
      <div class="dc-tick"></div>
      <div class="dc-tick"></div>
    </div>

    <div class="dc-goal-label">
      {{ goal_amount }}
      {{ currency_code }}
    </div>
  </div>
</div>
