{%- comment -%}
  Renders a Spotlight-style search modal (macOS Spotlight-like)
  Accepts:
  - input_id: {String} Id for the search input element (required)
{%- endcomment -%}

<div class="spotlight-search-modal" id="spotlight-search-modal" aria-hidden="true">
  <div class="spotlight-search-overlay"></div>
  <div class="spotlight-search-container">
    <div class="spotlight-search-box">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="spotlight-search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- else -%}
        <search-form class="spotlight-search-form">
      {%- endif -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="spotlight-search-form">
        <div class="spotlight-search-input-wrapper">
          <svg class="spotlight-search-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input
            class="spotlight-search-input"
            id="{{ input_id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search' | t }}"
            autofocus
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="spotlight-predictive-search-results"
              aria-controls="spotlight-predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <button
            type="reset"
            class="spotlight-search-reset{% if search.terms == blank %} hidden{% endif %}"
            aria-label="{{ 'general.search.reset' | t }}"
          >
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <input type="hidden" name="options[prefix]" value="last">

        {%- if settings.predictive_search_enabled -%}
          <div class="spotlight-predictive-search" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'spotlight-predictive-search__loading-state' -%}
          </div>
          <span class="spotlight-predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}
    </div>
    <div class="spotlight-search-footer">
      <span class="spotlight-search-hint">Press <kbd>Enter</kbd> to search, <kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  .spotlight-search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    pointer-events: none;
  }

  .spotlight-search-modal[aria-hidden='false'] {
    display: flex;
    pointer-events: all;
  }

  .spotlight-search-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    animation: spotlightFadeIn 0.2s ease-out;
  }

  .spotlight-search-container {
    position: relative;
    width: 100%;
    max-width: 700px;
    top: 25vh;

    margin: 0 auto;
    animation: spotlightSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .spotlight-search-box {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 1px 2px rgba(0, 0, 0, 0.1);
    padding: 20px;
    max-height: 80px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  .spotlight-search-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5) 50%, transparent);
    pointer-events: none;
  }

  .spotlight-search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .spotlight-search-icon {
    width: 24px;
    height: 24px;
    color: #666;
    flex-shrink: 0;
  }

  .spotlight-search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1.5rem;
    font-weight: 400;
    color: #000;
    padding: 0;
    line-height: 1.5;
  }

  .spotlight-search-input::placeholder {
    color: #999;
  }

  .spotlight-search-reset {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    opacity: 0.6;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .spotlight-search-reset:hover {
    opacity: 1;
  }

  .spotlight-search-reset.hidden {
    display: none;
  }

  .spotlight-search-reset svg {
    width: 18px;
    height: 18px;
  }

  .spotlight-search-footer {
    margin-top: 12px;
    text-align: center;
  }

  .spotlight-search-hint {
    font-size: 0.75rem;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .spotlight-search-hint kbd {
    background: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.7rem;
    font-family: monospace;
    color: #333;
  }

  .spotlight-predictive-search {
    margin-top: 16px;
    max-height: 400px;
    overflow-y: auto;
  }

  @keyframes spotlightFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes spotlightSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 768px) {
    .spotlight-search-modal {
      padding-top: 10vh;
    }

    .spotlight-search-container {
      max-width: 90%;
    }

    .spotlight-search-box {
      padding: 16px;
    }

    .spotlight-search-input {
      font-size: 1.25rem;
    }
  }
</style>
