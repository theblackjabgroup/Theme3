{% comment %}
  Custom Cart Drawer - Matches custom cart page design
  Usage: {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<style>
  /* Figma: Bag drawer - warm beige #F5F0E1, dark green #2E473E, pink CTA #E0A8B8 */
  :root {
    --cart-drawer-bg: #e9e6d7;
    --cart-drawer-text: #2e473e;
    --cart-drawer-text-muted: #7a8b7e;
    --cart-drawer-pink: #e0a8b8;
    --cart-drawer-pink-shadow: #2e473e;
    --cart-drawer-card-bg: #e9e6d7;
    --cart-drawer-item-bg: #dcd9ca;
    --cart-drawer-border: #d1cdbc;
  }

  .drawer {
    visibility: hidden;
  }

  cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 30vw;
    min-width: 360px;
    max-width: 440px;
    height: 100vh;
    z-index: 9999;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  cart-drawer.active {
    pointer-events: auto;
    transform: translateX(0);
  }

  cart-drawer.animate {
    visibility: visible;
  }

  .cart-drawer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--cart-drawer-bg);
  }

  body.cart-drawer-open main,
  body.cart-drawer-open #MainContent,
  body.cart-drawer-open footer,
  body.cart-drawer-open [id^='shopify-section-']:not(cart-drawer),
  body.cart-drawer-open .floating-dock-header,
  body.cart-drawer-open .mobile-header,
  body.cart-drawer-open header {
    filter: blur(4px);
    transition: filter 0.3s ease;
    pointer-events: none;
  }

  body.cart-drawer-open cart-drawer,
  body.cart-drawer-open cart-drawer * {
    filter: none !important;
    pointer-events: auto !important;
  }

  .cart-drawer__overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  body.cart-drawer-open .cart-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer__inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--cart-drawer-bg);
    position: relative;
    z-index: 2;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.05);
  }

  /* Scrollable area: header + product list (above subtotal) */
  .drawer__scrollable {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  /* Header: Bag + close X (scrolls with content) */
  .drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background-color: var(--cart-drawer-bg);
    border-bottom: 1px solid var(--cart-drawer-border);
    flex-shrink: 0;
  }

  .drawer__heading {
    font-family: var(--font-heading-family);
    font-size: 64px;
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--cart-drawer-text);
    line-height: 1;
  }

  .drawer__close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--cart-drawer-text);
    padding: 0;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .drawer__close:hover {
    background: var(--cart-drawer-border);
  }

  .drawer__close svg {
    width: 30px;
    height: 30px;
  }

  /* Product list (inside scrollable area) */
  .drawer__contents {
    flex: 1;
    min-height: 0;
    padding: 24px;
  }

  .drawer__cart-items-wrapper {
    margin-bottom: 24px;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Product card: matching beige with subtle border */
  .cart-drawer__item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
  }

  .cart-drawer__item-top {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .cart-drawer__item-image-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .cart-drawer__item-image-container {
    width: 120px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--cart-drawer-item-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .cart-drawer__item-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* 16% off badge - pink, starburst */
  .cart-drawer__item-badge {
    position: absolute;
    top: -10px;
    left: -10px;
    width: 50px;
    height: 50px;
    background: var(--cart-drawer-pink);
    color: var(--cart-drawer-text);
    font-size: 10px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4px;
    line-height: 1;
    z-index: 2;
    clip-path: polygon(
      50% 0%,
      61% 10%,
      75% 5%,
      79% 19%,
      93% 18%,
      90% 32%,
      100% 41%,
      93% 54%,
      98% 68%,
      85% 74%,
      81% 88%,
      68% 87%,
      58% 97%,
      45% 90%,
      32% 96%,
      23% 84%,
      9% 84%,
      12% 70%,
      2% 61%,
      10% 48%,
      3% 34%,
      16% 29%,
      17% 15%,
      31% 18%,
      39% 7%
    );
  }

  .cart-drawer__item-details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-drawer__item-details-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .cart-drawer__item-details-top > div {
    max-width: 150px;
  }

  /* X remove button - right of product name */
  cart-remove-button {
    flex-shrink: 0;
  }

  .cart-drawer__item-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;
    background: transparent;
    color: var(--cart-drawer-text);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cart-drawer__item-remove:hover {
    background: var(--cart-drawer-text);
    color: var(--cart-drawer-bg);
  }

  .cart-drawer__item-remove svg {
    width: 30px;
    height: 30px;
    stroke-width: 2;
  }

  .cart-drawer__item-name {
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--cart-drawer-text);
    text-decoration: none;
    line-height: 1.1;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .cart-drawer__item-name:hover {
    opacity: 0.8;
  }

  .cart-drawer__item-variant {
    font-size: 13px;
    color: var(--cart-drawer-text-muted);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .cart-drawer__item-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
  }

  .cart-drawer__item-price-label {
    font-size: 18px;
    font-weight: 300;
    color: var(--cart-drawer-text);
    min-width: 60px;
  }

  .cart-drawer__item-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 400;
    color: var(--cart-drawer-text);
    font-size: 18px;
  }

  .cart-drawer__item-price s {
    color: var(--cart-drawer-text-muted);
    font-weight: 600;
    font-size: 14px;
    text-decoration: line-through;
  }

  .cart-drawer__item-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
  }

  .cart-drawer__item-qty-label {
    font-size: 18px;
    font-weight: 300;
    color: var(--cart-drawer-text);
    min-width: 60px;
  }

  .cart-drawer__item-qty-value {
    font-size: 18px;
    font-weight: 400;
    color: var(--cart-drawer-text);
  }

  /* Quantity selector: [-] [1] [+] + Edit */
  /* Separator line before quantity selector */
  .cart-drawer__quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--cart-drawer-border);
  }

  .cart-drawer__quantity-selector {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-drawer__quantity-selector .quantity__button {
    width: 38px;
    height: 38px;
    background: #e9e6d7;
    border: 1px solid var(--cart-drawer-text);
    border-radius: 10px;
    cursor: pointer;
    color: var(--cart-drawer-text);
    font-size: 24px;
    font-weight: 400;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 0 var(--cart-drawer-text);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .cart-drawer__quantity-selector .quantity__button:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 var(--cart-drawer-text);
  }

  .cart-drawer__quantity-input {
    width: 38px;
    height: 38px;
    background: var(--cart-drawer-text) !important;
    color: #e9e6d7 !important;
    border: none !important;
    border-radius: 10px;
    text-align: center;
    font-weight: 700 !important;
    font-size: 18px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .cart-drawer__quantity-input::-webkit-outer-spin-button,
  .cart-drawer__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-drawer__edit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 32px;
    background: var(--cart-drawer-bg);
    color: var(--cart-drawer-text);
    border: 1.5px solid var(--cart-drawer-text);
    border-radius: 10px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    font-family: var(--font-heading-family);
    transition: background 0.2s ease, color 0.2s ease;
    height: 38px;
    box-shadow: 0 1px 0 var(--cart-drawer-text);
  }

  .cart-drawer__edit-btn:hover {
    background: var(--cart-drawer-text);
    color: var(--cart-drawer-bg);
  }

  /* Fixed footer: subtotal + checkout + GO TO BAG (does not scroll) */
  .cart-drawer__sidebar {
    flex-shrink: 0;
    padding: 20px 24px 24px;
    border-top: 1px solid var(--cart-drawer-border);
    background-color: var(--cart-drawer-bg);
  }

  .cart-drawer__total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .cart-drawer__total-left {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    gap: 4px;
  }

  .cart-drawer__total-label {
    font-size: 20px;
    font-weight: 900;
    color: var(--cart-drawer-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .cart-drawer__shipping-note {
    font-size: 16px;
    font-weight: 500;
    color: var(--cart-drawer-text);
    line-height: 1.1;
    max-width: 220px;
    margin: 0;
  }

  .cart-drawer__total-value {
    font-size: 28px;
    font-weight: 900;
    color: var(--cart-drawer-text);
    letter-spacing: -0.04em;
    line-height: 0.8;
  }

  /* Proceed To Checkout - pink with 3D shadow */
  .cart-drawer__checkout-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 24px;
    background-color: var(--cart-drawer-pink);
    color: var(--cart-drawer-text);
    border: 2px solid var(--cart-drawer-text);
    border-radius: 16px;
    font-size: 22px;
    font-weight: 900;
    cursor: pointer;
    text-transform: capitalize;
    letter-spacing: -0.02em;
    font-family: var(--font-heading-family);
    line-height: 1;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 8px 0 var(--cart-drawer-text);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    margin-bottom: 24px;
  }

  .cart-drawer__checkout-btn:hover:not(:disabled) {
    transform: translateY(2px);
    box-shadow: 0 6px 0 var(--cart-drawer-text);
  }

  .cart-drawer__checkout-btn:active:not(:disabled) {
    transform: translateY(6px);
    box-shadow: 0 2px 0 var(--cart-drawer-text);
  }

  .cart-drawer__checkout-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .cart-drawer__go-to-bag {
    display: block;
    text-align: center;
    font-size: 18px;
    font-weight: 800;
    color: var(--cart-drawer-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .cart-drawer__go-to-bag:hover {
    text-decoration: underline;
  }

  /* Empty state */
  .drawer__inner-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 40px 24px;
  }

  .cart__empty-text {
    font-family: var(--font-heading-family);
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--cart-drawer-text);
  }

  @media screen and (max-width: 990px) {
    cart-drawer {
      width: 100vw;
      max-width: none;
      min-width: 0;
    }

    .drawer__inner {
      border-radius: 0;
    }
  }

  @media screen and (max-width: 640px) {
    .drawer__header {
      padding: 16px 20px;
    }

    .drawer__heading {
      font-size: 24px;
    }

    .drawer__contents {
      padding: 12px 20px;
    }

    .cart-drawer__item-image-container {
      width: 72px;
      height: 72px;
    }

    .cart-drawer__item-name {
      font-size: 13px;
    }

    .cart-drawer__sidebar {
      padding: 16px 20px 20px;
    }

    .cart-drawer__total-value {
      font-size: 20px;
    }
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__header">
          <h2 class="drawer__heading">Bag</h2>
          <button
            type="button"
            class="drawer__close"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="drawer__inner-empty">
          <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__checkout-btn">
            {{ 'general.continue_shopping' | t }}
          </a>
        </div>
      {%- else -%}
        <div class="drawer__scrollable">
          <div class="drawer__header">
            <h2 class="drawer__heading">Bag</h2>
            <button
              type="button"
              class="drawer__close"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <cart-drawer-items>
            <form
              action="{{ routes.cart_url }}"
              id="CartDrawer-Form"
              class="cart-drawer__form"
              method="post"
            >
              <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
                <div class="drawer__cart-items-wrapper">
                  <div class="cart-drawer__items">
                    {%- for item in cart.items -%}
                      {%- assign has_compare = false -%}
                      {%- assign discount_pct = 0 -%}
                      {%- if item.variant.compare_at_price != blank
                        and item.variant.compare_at_price > item.final_price
                      -%}
                        {%- assign has_compare = true -%}
                        {%- assign savings = item.variant.compare_at_price | minus: item.final_price -%}
                        {%- assign discount_pct = savings | times: 100 | divided_by: item.variant.compare_at_price -%}
                      {%- endif -%}
                      <div class="cart-drawer__item" id="CartDrawer-Item-{{ item.index | plus: 1 }}">
                        <div class="cart-drawer__item-top">
                          <div class="cart-drawer__item-image-wrap">
                            {%- if has_compare and discount_pct > 0 -%}
                              <span class="cart-drawer__item-badge">
                                {{- discount_pct }}%<br>
                                off</span
                              >
                            {%- endif -%}
                            <div class="cart-drawer__item-image-container">
                              {%- if item.image -%}
                                <img
                                  src="{{ item.image | image_url: width: 200 }}"
                                  alt="{{ item.image.alt | escape }}"
                                  class="cart-drawer__item-image"
                                  loading="lazy"
                                  width="100"
                                  height="100"
                                >
                              {%- endif -%}
                            </div>
                          </div>
                          <div class="cart-drawer__item-details">
                            <div class="cart-drawer__item-details-top">
                              <div style="flex: 1;">
                                <a href="{{ item.url }}" class="cart-drawer__item-name">
                                  {{- item.product.title | upcase -}}
                                </a>
                                {%- unless item.product.has_only_default_variant -%}
                                  <div class="cart-drawer__item-variant">{{ item.variant.title }}</div>
                                {%- endunless -%}
                              </div>
                              <cart-remove-button
                                id="Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <a
                                  href="{{ item.url_to_remove }}"
                                  class="cart-drawer__item-remove"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                >
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                  >
                                    <path d="M18 6L6 18M6 6l12 12"/>
                                  </svg>
                                </a>
                              </cart-remove-button>
                            </div>
                            <div class="cart-drawer__item-price-row">
                              <span class="cart-drawer__item-price-label">Price:</span>
                              <span class="cart-drawer__item-price">
                                {%- if has_compare -%}
                                  <s>{{ item.variant.compare_at_price | money_without_trailing_zeros }}</s>
                                {%- endif -%}
                                {{ item.final_price | money_without_trailing_zeros }}
                              </span>
                            </div>
                            <div class="cart-drawer__item-qty-row">
                              <span class="cart-drawer__item-qty-label">Quantity:</span>
                              <span class="cart-drawer__item-qty-value">{{ item.quantity }}</span>
                            </div>
                          </div>
                        </div>
                        <div class="cart-drawer__quantity-row">
                          <quantity-input class="cart-drawer__quantity-selector">
                            <button
                              class="quantity__button"
                              name="minus"
                              type="button"
                              aria-label="{{ 'products.product.quantity.decrease' | t | default: 'Decrease' }}"
                            >
                              <span>−</span>
                            </button>
                            <input
                              class="quantity__input cart-drawer__quantity-input"
                              type="number"
                              name="updates[]"
                              value="{{ item.quantity }}"
                              data-index="{{ item.index | plus: 1 }}"
                              min="0"
                              id="Drawer-quantity-{{ item.index | plus: 1 }}"
                              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | default: 'Quantity' }}"
                            >
                            <button
                              class="quantity__button"
                              name="plus"
                              type="button"
                              aria-label="{{ 'products.product.quantity.increase' | t | default: 'Increase' }}"
                            >
                              <span>+</span>
                            </button>
                          </quantity-input>
                          <a href="{{ item.url }}" class="cart-drawer__edit-btn">Edit</a>
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </form>
          </cart-drawer-items>
        </div>

        <div class="cart-drawer__sidebar">
          <div class="cart-drawer__total-row">
            <div class="cart-drawer__total-left">
              <span class="cart-drawer__total-label">SUBTOTAL</span>
              <p class="cart-drawer__shipping-note">
                Taxes And Shipping<br>
                Calculated At Checkout
              </p>
            </div>
            <span class="cart-drawer__total-value" id="cart-drawer-total">
              {{- cart.total_price | money_without_trailing_zeros -}}
            </span>
          </div>
          <button
            type="submit"
            form="CartDrawer-Form"
            name="checkout"
