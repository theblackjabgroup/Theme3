{% comment %}
  Custom Cart Drawer - Matches custom cart page design
  Usage: {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn-2.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{% comment %} cart-drawer.js is loaded by theme.liquid (idle/on cart click) {% endcomment %}

<style>
  cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 30vw;
    min-width: 360px;
    max-width: 440px;
    height: 100vh;
    z-index: 9999;
    margin: 20px;
    border-radius: 20px;
    overflow: hidden;
    transform: translateX(110%);
    visibility: hidden;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0s linear 1.2s;
    pointer-events: none;
  }

  cart-drawer.active {
    pointer-events: auto;
    transform: translateX(0);
    visibility: visible;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0s linear 0s;
  }



  .cart-drawer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--color-card-bg);
  }

  body.cart-drawer-open main,
  body.cart-drawer-open #MainContent,
  body.cart-drawer-open footer,
  body.cart-drawer-open [id^='shopify-section-']:not([id*='header']):not(cart-drawer) {
    filter: blur(4px);
    transition: filter 0.3s ease;
    pointer-events: none;
  }

  /* Keep header sharp while cart drawer is open */
  body.cart-drawer-open #shopify-section-header,
  body.cart-drawer-open .vertical-sidebar-header,
  body.cart-drawer-open .mobile-header {
    filter: none !important;
  }

  body.cart-drawer-open header {
    pointer-events: none;
  }

  body.cart-drawer-open cart-drawer,
  body.cart-drawer-open cart-drawer * {
    filter: none !important;
    pointer-events: auto !important;
  }

  .cart-drawer__overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  body.cart-drawer-open .cart-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }


  /* overflow: visible so global-btn 3D shadow is not clipped; outer cart-drawer still clips with overflow: hidden */
  .drawer__inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: visible;
    background-color: var(--color-card-bg);
    position: relative;
    z-index: 2;
    box-shadow: -4px 0 24px color-mix(in srgb, var(--color-text) 5%, transparent);
  }

  /* Scrollable area: header + product list (above subtotal) */
  .drawer__scrollable {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  /* Header: Bag + close X (scrolls with content) – match first image */
  .drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background-color: var(--color-card-bg);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    flex-shrink: 0;
  }

  .drawer__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-heading);
    line-height: 1;
  }

  .drawer__close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-heading);
    padding: 0;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .drawer__close:hover {
    background: color-mix(in srgb, var(--color-heading) 10%, transparent);
  }

  .drawer__close svg {
    width: 24px;
    height: 24px;
  }

  /* Product list (inside scrollable area) */
  .drawer__contents {
    flex: 1;
    min-height: 0;
    padding: 24px;
    padding-bottom: 28px; /* room for global-btn 3D shadow below last Edit button */
  }

  .drawer__cart-items-wrapper {
    margin-bottom: 24px;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
  }

  /* Product card: layout + separator to match first image */
  .cart-drawer__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .cart-drawer__item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .cart-drawer__item-top {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .cart-drawer__item-image-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .cart-drawer__item-image-container {
    width: 120px;
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-card-bg) 92%, var(--color-text));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .cart-drawer__item-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Sale badge - sale icon with X% off centered */
  .cart-drawer__item-badge {
    position: absolute;
    top: -10px;
    left: -10px;
    width: {{ settings.sale_badge_size }}px;
    height: {{ settings.sale_badge_size }}px;
    z-index: 2;
  }

  .cart-drawer__item-badge-icon {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--sale-badge-bg, #E0A8B8);
  }

  .cart-drawer__item-badge-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 950;
    color: var(--sale-badge-text, #000000);
    transform: rotate({{ settings.sale_badge_rotation }}deg);
    line-height: 1;
  }

  .cart-drawer__item-badge-text span:first-child {
    font-size: {{ settings.sale_badge_percent_size }}px;
    letter-spacing: -0.02em;
  }

  .cart-drawer__item-badge-text span:last-child {
    font-size: {{ settings.sale_badge_label_size }}px;
    text-transform: uppercase;
    margin-top: 1px;
  }

  .cart-drawer__item-details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-drawer__item-details-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  /* X remove button - right of product name */
  cart-remove-button {
    flex-shrink: 0;
  }

  .cart-drawer__item-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    color: var(--color-heading);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cart-drawer__item-remove:hover {
    background: color-mix(in srgb, var(--color-heading) 12%, transparent);
    color: var(--color-heading);
  }

  .cart-drawer__item-remove svg {
    width: 30px;
    height: 30px;
    stroke-width: 2;
  }

  .cart-drawer__item-name {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.1;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .cart-drawer__item-name:hover {
    opacity: 0.8;
  }

  .cart-drawer__item-variant {
    font-size: 13px;
    color: color-mix(in srgb, var(--color-text) 65%, transparent);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .cart-drawer__item-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-top: 2px;
  }

  .cart-drawer__item-price-label {
    font-size: 18px;
    font-weight: 300;
    color: var(--color-text);
    min-width: 60px;
  }

  .cart-drawer__item-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 400;
    color: var(--color-text);
    font-size: 18px;
  }

  .cart-drawer__item-price s {
    color: color-mix(in srgb, var(--color-text) 65%, transparent);
    font-weight: 600;
    font-size: 14px;
    text-decoration: line-through;
  }

  .cart-drawer__item-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 2px;
  }

  .cart-drawer__item-qty-label {
    font-size: 18px;
    font-weight: 300;
    color: var(--color-text);
    min-width: 60px;
  }

  .cart-drawer__item-qty-value {
    font-size: 18px;
    font-weight: 400;
    color: var(--color-text);
  }

  /* Quantity selector: [-] [1] [+] + Edit – match Figma layout */
  .cart-drawer__quantity-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-drawer__quantity-selector-wrap {
    flex-shrink: 0;
  }

  .cart-drawer__quantity-selector {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Inner snippet root: keep horizontal layout on all pages (component-quantity.css only loads on cart page) */
  .cart-drawer__quantity-selector .quantity,
  .cart-drawer__quantity-selector .cart-item__quantity-selector {
    display: flex;
    align-items: center;
    gap: 6px;
    width: auto;
    min-width: auto;
    border: none;
    background: transparent;
    box-shadow: none;
    padding: 0;
  }

  /* Minus/Plus: tertiary-like 3D (light face, heading border, shadow below) */
  .cart-drawer__quantity-selector .quantity__button,
  .cart-drawer__edit-quantity-row .quantity__button {
    width: 40px;
    height: 40px;
    background-color: var(--btn-primary-bg, var(--color-card-bg));
    border: 1.5px solid var(--color-heading);
    border-radius: 10px;
    cursor: pointer;
    color: var(--color-heading);
    font-size: 22px;
    font-weight: 700;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 0 var(--color-btn-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cart-drawer__quantity-selector .quantity__button:hover:not(:disabled),
  .cart-drawer__edit-quantity-row .quantity__button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 0 var(--color-btn-shadow);
  }

  .cart-drawer__quantity-selector .quantity__button:active:not(:disabled),
  .cart-drawer__edit-quantity-row .quantity__button:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: 0 1px 0 var(--color-btn-shadow);
  }

  .cart-drawer__quantity-selector .quantity__button:disabled,
  .cart-drawer__edit-quantity-row .quantity__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Quantity value [1]: flat (no shadow), editable */
  .cart-drawer__quantity-selector .quantity__input,
  .cart-drawer__quantity-input,
  .cart-drawer__edit-quantity-row .quantity__input {
    width: 40px !important;
    height: 40px !important;
    min-width: 40px;
    min-height: 40px;
    background: var(--color-heading) !important;
    color: var(--color-card-bg) !important;
    border: 1.5px solid var(--color-heading) !important;
    border-radius: 10px;
    text-align: center;
    font-weight: 800 !important;
    font-size: 16px !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: text;
    outline: none;
    pointer-events: auto !important;
    user-select: text;
  }

  .cart-drawer__quantity-selector .quantity__input:focus,
  .cart-drawer__quantity-input:focus,
  .cart-drawer__edit-quantity-row .quantity__input:focus {
    outline: none;
  }

  .cart-drawer__quantity-selector .quantity__input::-webkit-outer-spin-button,
  .cart-drawer__quantity-selector .quantity__input::-webkit-inner-spin-button,
  .cart-drawer__quantity-input::-webkit-outer-spin-button,
  .cart-drawer__quantity-input::-webkit-inner-spin-button,
  .cart-drawer__edit-quantity-row .quantity__input::-webkit-outer-spin-button,
  .cart-drawer__edit-quantity-row .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Edit button: global-btn-2 primary – flex-fill to the right of qty selector */
  .cart-drawer__edit-btn.global-btn-2 {
    flex: 1;
    min-width: 0;
    justify-content: center;
  }

  /* Fixed footer: subtotal + checkout + GO TO BAG (does not scroll) */
  .cart-drawer__sidebar {
    flex-shrink: 0;
    padding: 20px 24px 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    background-color: var(--color-card-bg);
  }

  .cart-drawer__total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }




  .cart-drawer__total-left {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    gap: 4px;
  }

  .cart-drawer__total-label {
    font-size: 20px;
    font-weight: 900;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .cart-drawer__shipping-note {
    font-size: 14px;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
    line-height: 1.2;
    max-width: 220px;
    margin: 0;
  }

  .cart-drawer__total-value {
    font-size: 28px;
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  /* Continue shopping (empty state): global-btn tertiary, full width */
  .drawer__inner-empty .cart-drawer__checkout-btn.global-btn {
    width: 100%;
    display: block;
    margin-bottom: 24px;
  }

  .drawer__inner-empty .cart-drawer__checkout-btn.global-btn .global-btn__content {
    width: 100%;
    justify-content: center;
  }

  /* Proceed To Checkout: global-btn tertiary, full width; keep 3D (no overrides on shadow/transform) */
  .cart-drawer__sidebar {
    overflow: visible;
  }

  .cart-drawer__sidebar .cart-drawer__checkout-btn.global-btn {
    width: 100%;
    display: block;
    margin-bottom: 24px;
    overflow: visible;
  }

  .cart-drawer__sidebar .cart-drawer__checkout-btn.global-btn .global-btn__content {
    width: 100%;
    justify-content: center;
    padding: 16px 24px;
    font-size: 18px;
  }

  .cart-drawer__sidebar .cart-drawer__checkout-btn.global-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .cart-drawer__go-to-bag {
    display: block;
    text-align: center;
    font-size: 16px;
    font-weight: 800;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .cart-drawer__go-to-bag:hover {
    text-decoration: underline;
  }

  /* Empty state */
  .drawer__inner-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 40px 24px;
  }

  .cart__empty-text {
    font-family: var(--font-heading-family);
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--color-text);
  }

  @media screen and (max-width: 1024px) {
    cart-drawer {
      width: 100vw;
      max-width: none;
      min-width: 0;
      top: 0;
      right: 0;
      margin: 0;
      height: 100vh;
      border-radius: 0 0 20px 20px;
      transform: translateY(-100%);
      transition:  transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    cart-drawer.active {
      transform: translateY(0);
      transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .drawer__inner {
      border-radius: 0 0 20px 20px;
    }
  }

  /* Edit panel overlay (replaces list when editing an item) */
  .cart-drawer__edit-panel {
    display: none;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background-color: var(--color-card-bg);
  }

  cart-drawer.editing .cart-drawer__edit-panel {
    display: flex;
  }

  cart-drawer.editing .drawer__scrollable {
    display: none;
  }

  cart-drawer.editing .cart-drawer__sidebar {
    display: none;
  }

  .cart-drawer__edit-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    flex-shrink: 0;
  }

  .cart-drawer__edit-panel-heading {
    font-family: var(--font-heading-family);
    font-size: 64px;
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--color-heading);
    line-height: 1;
  }

  .cart-drawer__edit-panel-close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-heading);
    padding: 0;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .cart-drawer__edit-panel-close:hover {
    background: color-mix(in srgb, var(--color-heading) 12%, transparent);
  }

  .cart-drawer__edit-panel-close svg {
    width: 30px;
    height: 30px;
  }

  .cart-drawer__edit-panel-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 24px;
    padding-bottom: 30px; /* room for Update Cart global-btn 3D shadow */
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-drawer__edit-item-top {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .cart-drawer__edit-item-image-container {
    width: 120px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-card-bg) 92%, var(--color-text));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .cart-drawer__edit-item-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .cart-drawer__edit-item-details {
    flex: 1;
    min-width: 0;
  }

  .cart-drawer__edit-item-name {
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-heading);
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0 0 8px 0;
  }

  .cart-drawer__edit-item-price {
    font-size: 18px;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .cart-drawer__edit-item-price s {
    color: color-mix(in srgb, var(--color-text) 65%, transparent);
    font-size: 14px;
    text-decoration: line-through;
  }

  .cart-drawer__edit-quantity-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .cart-drawer__edit-stock-wrap {
    margin-top: 16px;
    margin-left: -24px;
    margin-right: -24px;
    padding: 16px 24px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .cart-drawer__edit-stock {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .cart-drawer__edit-variants {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .cart-drawer__edit-option-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Variant buttons: global-btn primary (unselected), secondary (selected) */
  .cart-drawer__edit-variant-btn.global-btn {
    min-width: 0;
  }

  .cart-drawer__edit-variant-btn.global-btn .global-btn__content {
    padding: 10px 20px;
    font-size: 14px;
  }

  .cart-drawer__edit-variant-btn--unavailable,
  .cart-drawer__edit-variant-btn:disabled {
    cursor: not-allowed;
    pointer-events: none;
  }

  .cart-drawer__edit-update-wrap {
    margin-top: auto;
    margin-left: -24px;
    margin-right: -24px;
    padding: 24px 24px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    width: auto;
  }

  /* Update Cart: global-btn tertiary, full width */
  .cart-drawer__edit-update-wrap .cart-drawer__edit-update-btn.global-btn {
    width: 100%;
    display: block;
  }

  .cart-drawer__edit-update-wrap .cart-drawer__edit-update-btn.global-btn .global-btn__content {
    width: 100%;
    justify-content: center;
  }

  .cart-drawer__edit-update-wrap .cart-drawer__edit-update-btn.global-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .drawer__header {
      padding: 16px 20px;
    }

    .drawer__heading {
      font-size: 24px;
    }

    .drawer__contents {
      padding: 12px 20px;
    }

    .cart-drawer__item-image-container {
      width: 72px;
      height: 72px;
    }

    .cart-drawer__item-name {
      font-size: 13px;
    }

    .cart-drawer__sidebar {
      padding: 16px 20px 20px;
    }

    .cart-drawer__total-value {
      font-size: 20px;
    }

    .cart-drawer__edit-panel-heading {
      font-size: 32px;
    }

    .cart-drawer__edit-item-image-container {
      width: 72px;
    }

    .cart-drawer__edit-item-name {
      font-size: 16px;
    }
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__header">
          <h2 class="drawer__heading">Bag</h2>
          <button
            type="button"
            class="drawer__close"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
        </div>
        <div class="drawer__inner-empty">
          <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
          {% capture continue_shopping_text %}{{ 'general.continue_shopping' | t }}{% endcapture %}
          {% render 'global-btn',
            text: continue_shopping_text,
            url: routes.all_products_collection_url,
            variant: 'tertiary',
            class: 'cart-drawer__checkout-btn'
          %}
        </div>
      {%- else -%}
        <div class="cart-drawer__edit-panel" id="CartDrawer-EditPanel" aria-hidden="true">
          <div class="cart-drawer__edit-panel-header">
            <h2 class="cart-drawer__edit-panel-heading">Edit</h2>
            <button
              type="button"
              class="cart-drawer__edit-panel-close"
              aria-label="{{ 'accessibility.close' | t }}"
              data-edit-panel-close
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>
          <div class="cart-drawer__edit-panel-body">
            <div class="cart-drawer__edit-item-top">
              <div class="cart-drawer__edit-item-image-container">
                <img class="cart-drawer__edit-item-image" src="" alt="" width="100" height="100" data-edit-image>
              </div>
              <div class="cart-drawer__edit-item-details">
                <h3 class="cart-drawer__edit-item-name" data-edit-name></h3>
                <div class="cart-drawer__edit-item-price" data-edit-price></div>
                <div class="cart-drawer__edit-quantity-row">
                  <div class="cart-drawer__quantity-selector">
                    {% render 'quantity-selector', edit_panel: true, quantity: 1 %}
                  </div>
                </div>
              </div>
            </div>
            <div class="cart-drawer__edit-stock-wrap">
              <div class="cart-drawer__edit-stock" data-edit-stock>In Stock</div>
              <div class="cart-drawer__edit-variants" data-edit-variants></div>
            </div>
            <div class="cart-drawer__edit-update-wrap">
              {% render 'global-btn',
                text: 'Update Cart',
                type: 'button',
                variant: 'tertiary',
                class: 'cart-drawer__edit-update-btn',
                attributes: 'data-edit-update-btn'
              %}
            </div>
          </div>
        </div>

        <div class="drawer__scrollable">
          <div class="drawer__header">
            <h2 class="drawer__heading">Bag</h2>
            <button
              type="button"
              class="drawer__close"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>

          <cart-drawer-items>
            <form
              action="{{ routes.cart_url }}"
              id="CartDrawer-Form"
              class="cart-drawer__form"
              method="post"
            >
              <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
                <div class="drawer__cart-items-wrapper">
                  <div class="cart-drawer__items">
                    {%- for item in cart.items -%}
                      {%- assign has_compare = false -%}
                      {%- assign discount_pct = 0 -%}
                      {%- if item.variant.compare_at_price != blank
                        and item.variant.compare_at_price > item.final_price
                      -%}
                        {%- assign has_compare = true -%}
                        {%- assign savings = item.variant.compare_at_price | minus: item.final_price -%}
                        {%- assign discount_pct = savings | times: 100 | divided_by: item.variant.compare_at_price -%}
                      {%- endif -%}
                      <div
                        class="cart-drawer__item"
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        data-variant-id="{{ item.variant_id }}"
                        data-unit-price="{{ item.final_price }}"
                      >
                        <script
                          type="application/json"
                          id="CartDrawer-EditData-{{ item.index | plus: 1 }}"
                          data-edit-data
                        >
                          {
                            "lineIndex": {{ item.index | plus: 1 }},
                            "variantId": {{ item.variant_id }},
                            "quantity": {{ item.quantity }},
                            "image": {{ item.image | image_url: width: 200 | json }},
                            "title": {{ item.product.title | json }},
                            "price": {{ item.final_price | json }},
                            "priceFormatted": {{ item.final_price | money_without_trailing_zeros | json }},
                            "compareAtPrice": {{ item.variant.compare_at_price | default: 0 | json }},
                            "compareAtPriceFormatted": {% if item.variant.compare_at_price != blank %}{{ item.variant.compare_at_price | money_without_trailing_zeros | json }}{% else %}null{% endif %},
                            "available": {{ item.variant.available | json }},
                            "optionsWithValues": {{ item.product.options_with_values | json }},
                            "variants": [
                              {%- for v in item.product.variants -%}
                                {
                                  "id": {{ v.id }},
                                  "title": {{ v.title | json }},
                                  "options": [{% if v.option1 != blank %}{{ v.option1 | json }}{% endif %}{% if v.option2 != blank %}{% if v.option1 != blank %}, {% endif %}{{ v.option2 | json }}{% endif %}{% if v.option3 != blank %}{% if v.option1 != blank or v.option2 != blank %}, {% endif %}{{ v.option3 | json }}{% endif %}],
                                  "price": {{ v.price }},
                                  "priceFormatted": {{ v.price | money_without_trailing_zeros | json }},
                                  "compareAtPrice": {{ v.compare_at_price | default: 0 }},
                                  "compareAtPriceFormatted": {% if v.compare_at_price != blank %}{{ v.compare_at_price | money_without_trailing_zeros | json }}{% else %}null{% endif %},
                                  "available": {{ v.available | json }},
                                  "inventory_quantity": {{ v.inventory_quantity | default: 0 | json }},
                                  "inventory_management": {{ v.inventory_management | json }},
                                  "inventory_policy": {{ v.inventory_policy | json }},
                                  "quantity_rule_max": {{ v.quantity_rule.max | json }}
                                }{% unless forloop.last %},{% endunless %}
                              {%- endfor -%}
                            ]
                          }
                        </script>
                        <div class="cart-drawer__item-top">
                          <div class="cart-drawer__item-image-wrap">
                            {%- if has_compare and discount_pct > 0 -%}
                              <span class="cart-drawer__item-badge">
                                <svg
                                  class="cart-drawer__item-badge-icon"
                                  viewBox="0 0 73 72"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path fill-rule="evenodd" clip-rule="evenodd" d="M35.4998 0.192998C35.2716 0.281184 33.9937 1.42531 32.66 2.73551L30.235 5.11767L27.1847 3.84233C23.928 2.48044 23.381 2.36984 22.345 2.86378C21.6431 3.19852 21.1746 4.05584 19.6395 7.81496L18.8248 9.80986L15.2277 9.86009C11.2814 9.91539 11.2098 9.93273 10.3732 11.0364C10.0563 11.4545 10.0274 11.7503 9.98095 15.0406L9.93068 18.5935L6.78384 19.8784C3.04052 21.4069 2.64762 21.7184 2.64762 23.1572C2.64762 23.8877 2.86216 24.542 3.8907 26.95L5.13377 29.86L2.74054 32.2389C1.42413 33.5473 0.267503 34.8246 0.170108 35.0774C-0.0593592 35.6723 -0.0562067 36.5867 0.176745 37.0397C0.27779 37.2362 1.4384 38.4689 2.75597 39.7787L5.15135 42.1604L3.80442 45.2597C2.59553 48.0414 2.46843 48.4309 2.56383 49.0612C2.75481 50.3237 3.27065 50.6987 6.78285 52.1297L9.93068 53.4119L9.98078 56.9684C10.0274 60.2624 10.0563 60.5582 10.3732 60.9763C11.2098 62.08 11.2814 62.0973 15.2277 62.1529L18.8248 62.2035L19.9863 64.9957C20.625 66.5315 21.3183 68.036 21.5267 68.3395C21.9295 68.9259 22.9758 69.5465 23.5615 69.5465C23.9476 69.5465 27.0256 68.3811 29.0816 67.4564L30.3786 66.8731L32.8148 69.2653C35.2612 71.6674 35.7369 72.0011 36.7135 72C37.5132 71.9992 38.104 71.5594 40.5507 69.1439C41.785 67.9256 42.823 66.9287 42.8578 66.9287C42.8925 66.9287 44.2564 67.4942 45.8887 68.1851C49.0481 69.5228 49.7352 69.6636 50.6984 69.1717C51.4113 68.8075 51.6157 68.4503 52.9963 65.1576L54.2089 62.2658L57.7546 62.184C61.7078 62.0929 61.9388 62.0337 62.7183 60.9131C63.1141 60.3437 63.1269 60.2317 63.1785 56.8582L63.2316 53.389L65.7503 52.3627C69.5439 50.8169 69.8175 50.6627 70.1855 49.8635C70.3594 49.4859 70.5014 48.9561 70.5014 48.6862C70.5012 48.4162 69.9477 46.8015 69.2713 45.0982L68.0415 42.001L70.3383 39.6866C73.9094 36.0882 73.9059 35.8838 70.2142 32.2076L67.7961 29.7996L69.0695 26.8586C70.4725 23.6184 70.5984 22.9548 69.9938 21.9902C69.585 21.338 69.0051 21.0303 65.5727 19.6445L63.0425 18.6231V15.324C63.0425 12.2279 63.0196 11.98 62.6691 11.2956C62.4231 10.8151 62.0695 10.4414 61.6321 10.2002C61.0053 9.85436 60.7787 9.83391 57.5459 9.83129L54.1233 9.82867L52.9205 6.97465C51.4984 3.60019 51.2836 3.2247 50.5643 2.8574C49.5603 2.34448 48.9063 2.47749 45.7251 3.84086L42.7599 5.11178L40.409 2.81322C37.625 0.0913965 36.843 -0.325974 35.4998 0.192998Z" fill="currentColor"/>
                                </svg>
                                <span class="cart-drawer__item-badge-text">
                                  <span>{{- discount_pct }}%</span>
                                  <span>off</span>
                                </span>
                              </span>
                            {%- endif -%}
                            <div class="cart-drawer__item-image-container">
                              {%- if item.image -%}
                                <img
                                  src="{{ item.image | image_url: width: 200 }}"
                                  alt="{{ item.image.alt | escape }}"
                                  class="cart-drawer__item-image"
                                  loading="lazy"
                                  width="100"
                                  height="100"
                                >
                              {%- endif -%}
                            </div>
                          </div>
                          <div class="cart-drawer__item-details">
                            <div class="cart-drawer__item-details-top">
                              <div style="flex: 1;">
                                <a
                                  href="{{ item.url }}"
                                  class="cart-drawer__item-name"
                                  title="{{ item.product.title | escape }}"
                                >
                                  {{- item.product.title | upcase | truncatewords: 2, '.....' -}}
                                </a>
                                {%- unless item.product.has_only_default_variant -%}
                                  <div class="cart-drawer__item-variant">{{ item.variant.title }}</div>
                                {%- endunless -%}
                              </div>
                              <cart-remove-button
                                id="Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <a
                                  href="{{ item.url_to_remove }}"
                                  class="cart-drawer__item-remove"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                >
                                  {{- 'icon-close.svg' | inline_asset_content -}}
                                </a>
                              </cart-remove-button>
                            </div>
                            <div class="cart-drawer__item-price-row">
                              <span class="cart-drawer__item-price-label">Price:</span>
                              <span class="cart-drawer__item-price">
                                {%- if has_compare -%}
                                  <s>{{ item.variant.compare_at_price | money_without_trailing_zeros }}</s>
                                {%- endif -%}
                                {{ item.final_price | money_without_trailing_zeros }}
                              </span>
                            </div>
                          </div>
                        </div>
                        {%- liquid
                          assign drawer_max_qty = null
                          if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
                            assign drawer_max_qty = item.variant.inventory_quantity
                          endif
                          if item.variant.quantity_rule.max != null
                            if drawer_max_qty == null or item.variant.quantity_rule.max < drawer_max_qty
                              assign drawer_max_qty = item.variant.quantity_rule.max
                            endif
                          endif
                        -%}
                        <div class="cart-drawer__quantity-row">
                          <div class="">
                            {% render 'quantity-selector', item: item, id_prefix: 'Drawer-quantity-' %}
                          </div>
                          {% capture edit_btn_attrs %}data-edit-trigger data-line-index="{{ item.index | plus: 1 }}" aria-label="Edit {{ item.product.title | escape }}"{% endcapture %}
                          {% render 'global-btn-2',
                            text: 'Edit',
                            type: 'button',
                            variant: 'primary',
                            class: 'cart-drawer__edit-btn',
                            attributes: edit_btn_attrs,
                            fit_width: false
                          %}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </form>
          </cart-drawer-items>
        </div>

        <div class="cart-drawer__sidebar">
          <div class="cart-drawer__total-row">
            <div class="cart-drawer__total-left">
              <span class="cart-drawer__total-label">SUBTOTAL</span>
              <p class="cart-drawer__shipping-note">
                Taxes And Shipping<br>
                Calculated At Checkout
              </p>
            </div>
            <span class="cart-drawer__total-value" id="cart-drawer-total">
              {{- cart.total_price | money_without_trailing_zeros -}}
            </span>
          </div>
          {% render 'global-btn',
            text: 'Checkout',
            type: 'submit',
            variant: 'tertiary',
            class: 'cart-drawer__checkout-btn',
            attributes: 'form="CartDrawer-Form" name="checkout" id="CartDrawer-Checkout"'
          %}
          <a href="{{ routes.cart_url }}" class="cart-drawer__go-to-bag">GO TO BAG</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>
