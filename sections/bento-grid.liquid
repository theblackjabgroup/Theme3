{{ 'section-bento-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-scrolling-text.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn-2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-bento-grid.js' | asset_url }}" defer></script>

{%- style -%}
    #bento-hero-{{ section.id }} {

      --bento-hero-pt-m: {{ section.settings.padding_top_mobile   | default: 12 }}px;
      --bento-hero-pb-m: {{ section.settings.padding_bottom_mobile | default: 12 }}px;
      --bento-hero-px-m: {{ section.settings.padding_horizontal_mobile | default: 12 }}px;
  }
{%- endstyle -%}

<section id="bento-hero-{{ section.id }}" class="bento-hero">
  <!--
    ══════════════════════════════════════════
    1. SCROLLING STRIP
    ══════════════════════════════════════════
  -->

  <!--
    ══════════════════════════════════════════
    2. 4 BENTO CARDS
    ══════════════════════════════════════════
  -->
  <div class="bento-grid">
    <!-- Card 1: Blue hero text -->
    <div class="bento-card bento-card--hero">
      <div class="bento-hero-content">
        <div class="bento-hero-texts">
          {%- if section.settings.hero_pill != blank -%}
            <div class="bento-hero-pill">
              <p class="bento-hero-pill-text">{{ section.settings.hero_pill }}</p>
            </div>
          {%- endif -%}

          <h2 class="bento-hero-heading">
            {%- assign heading = section.settings.hero_heading | default: 'BUILT FOR THE MOMENTS IN BETWEEN.' -%}
            {%- assign highlight = section.settings.hero_heading_highlight | default: 'MOMENTS' -%}
            {%- if highlight != blank and heading contains highlight -%}
              {%- assign parts = heading | split: highlight -%}
              {{- parts[0] -}}
              <mark>{{- highlight -}}</mark>
              {{- parts[1] -}}
            {%- else -%}
              {{- heading -}}
            {%- endif -%}
          </h2>

          {%- if section.settings.hero_subtext != blank -%}
            <p class="bento-hero-subtext">{{ section.settings.hero_subtext }}</p>
          {%- endif -%}
        </div>

        <div class="bento-hero-buttons">
          {%- if section.settings.btn1_text != blank -%}
            {%-
              render 'global-btn',
              text: section.settings.btn1_text,
              url: section.settings.btn1_url | default: '#',
              variant: 'tertiary',
              fit_width: false
            -%}
          {%- endif -%}
          {%- if section.settings.btn2_text != blank -%}
            {%-
              render 'global-btn-2',
              text: section.settings.btn2_text,
              url: section.settings.btn2_url | default: '#',
              variant: 'white',
              fit_width: false
            -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Card 2: Centre product image -->
    <div class="bento-card bento-card--image">
      {%- assign hero_product = section.settings.hero_product -%}
      {%- if hero_product != blank and hero_product.featured_image != blank -%}
        {{
          hero_product.featured_image
          | image_url: width: 900
          | image_tag: class: 'bento-product-img', loading: 'eager', alt: hero_product.featured_image.alt
          | default: hero_product.title
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'bento-product-img' }}
      {%- endif -%}

      <!-- Orbit text + arrow -->
      <div class="bento-orbit">
        <svg class="bento-orbit__ring" viewBox="0 0 88 88" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <path id="bento-orbit-path-{{ section.id }}" d="M44,8 A36,36 0 1,1 43.99,8" fill="none"/>
          </defs>
          <text>
            <textPath href="#bento-orbit-path-{{ section.id }}" startOffset="0%">
              {{ section.settings.orbit_text | default: 'KOKO' }} · {{ section.settings.orbit_text | default: 'KOKO' }} · {{ section.settings.orbit_text | default: 'KOKO' }} · {{ section.settings.orbit_text | default: 'KOKO' }} · {{ section.settings.orbit_text | default: 'KOKO' }} ·
            </textPath>
          </text>
        </svg>
        <a href="{{ section.settings.btn1_url | default: '#' }}" class="bento-orbit__arrow" aria-label="Shop now">
          <svg viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Cards 3 + 4: Right column -->
    <div class="bento-col-right">
      <!-- Card 3: Collection -->
      {%- assign col = section.settings.collection -%}
      {%- assign col_url = col.url | default: '#' -%}
      {%- assign col_title = section.settings.collection_title | default: col.title | default: 'Collection' -%}
      <div class="bento-card bento-card--collection">
        <div class="bento-collection-info">
          {%- if section.settings.collection_pill != blank -%}
            <div class="bento-collection-pill">
              <p class="bento-collection-pill-text">{{ section.settings.collection_pill }}</p>
            </div>
          {%- endif -%}

          <a href="{{ col_url }}" class="bento-collection-title">{{ col_title }}</a>

          {%- assign col_desc = section.settings.collection_desc | default: col.description -%}
          {%- if col_desc != blank -%}
            <p class="bento-collection-desc">{{ col_desc | strip_html }}</p>
          {%- endif -%}
        </div>

        {%- if col != blank and col.products_count > 0 -%}
          <div class="bento-collection-images">
            <div class="bento-collection-strip__track">
              {%- for i in (1..2) -%}
                {%- for product in col.products limit: 8 -%}
                  {%- if product.featured_image != blank -%}
                    <div class="bento-collection-img-wrap">
                      {{
                        product.featured_image
                        | image_url: width: 280
                        | image_tag: loading: 'lazy', alt: product.title
                      }}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Card 4: Text -->
      <div class="bento-card bento-card--text">
        <div class="bento-text-inner">
          <div class="bento-text-body">
            {%- if section.settings.text_card_heading != blank -%}
              <h3 class="bento-text-heading">{{ section.settings.text_card_heading }}</h3>
            {%- endif -%}
            {%- if section.settings.text_card_body != blank -%}
              <p class="bento-text-copy">{{ section.settings.text_card_body }}</p>
            {%- endif -%}
          </div>
          <div class="bento-scroll-indicator">
            <div class="bento-scroll-indicator__fill"></div>
          </div>
        </div>
      </div>
    </div>
    <!-- /bento-col-right -->
  </div>
  <!-- /bento-grid -->

  <!--
    ══════════════════════════════════════════
    3. QUOTE RICH TEXT
    ══════════════════════════════════════════
  -->
  {%- if section.settings.quote_heading != blank -%}
    <div class="bento-quote scroll-trigger scroll-trigger--offscreen reveal-up" style="--animation-order: 15;">
      <p class="bento-quote__heading">
        {%- assign q_highlight = section.settings.quote_highlight | default: '' -%}
        {%- if q_highlight != blank and section.settings.quote_heading contains q_highlight -%}
          {%- assign q_parts = section.settings.quote_heading | split: q_highlight -%}
          {{- q_parts[0] -}}
          <mark>{{- q_highlight -}}</mark>
          {{- q_parts[1] -}}
        {%- else -%}
          {{- section.settings.quote_heading -}}
        {%- endif -%}
      </p>
      {%- if section.settings.quote_subtext != blank -%}
        <p class="bento-quote__sub">{{ section.settings.quote_subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bento Hero",
  "tag": "div",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    {
      "type": "header",
      "content": "Scrolling Strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "FREE SHIPPING WORLDWIDE"
    },
    {
      "type": "range",
      "id": "strip_speed",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed (lower = faster)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Hero Card (Blue)"
    },
    {
      "type": "text",
      "id": "hero_pill",
      "label": "Category pill text",
      "default": "Coffee"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "BUILT FOR THE MOMENTS IN BETWEEN."
    },
    {
      "type": "text",
      "id": "hero_heading_highlight",
      "label": "Highlighted word (yellow)",
      "default": "MOMENTS",
      "info": "Must match exactly as it appears in the heading."
    },
    {
      "type": "text",
      "id": "hero_subtext",
      "label": "Subtext",
      "default": "Crafted for slow mornings, long nights, and everything in between."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary button text",
      "default": "SHOP COFFEE"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary button text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Centre Product Card"
    },
    {
      "type": "product",
      "id": "hero_product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "orbit_text",
      "label": "Orbit badge text",
      "default": "KOKO"
    },
    {
      "type": "header",
      "content": "Collection Card (Top Right)"
    },
    {
      "type": "text",
      "id": "collection_pill",
      "label": "Pill label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Title override",
      "info": "Leave blank to use the collection's title."
    },
    {
      "type": "text",
      "id": "collection_desc",
      "label": "Collection description",
      "default": "Layers of cake, cream, and pure happiness."
    },
    {
      "type": "header",
      "content": "Text Card (Bottom Right)"
    },
    {
      "type": "text",
      "id": "text_card_heading",
      "label": "Heading",
      "default": "Brewed for Good Days"
    },
    {
      "type": "textarea",
      "id": "text_card_body",
      "label": "Body text",
      "default": "From your first sip to your last crumb, KOKO is all about feel-good flavors and unforgettable café moments.Every cup is brewed with care, every treat baked with warmth, and every visit slow things down just enough for you to savor it. Bold coffees, smooth lattes, and indulgent sweet treats come together with cozy café vibes to create a space where good conversations, comforting aromas, and beautiful little moments happen every day."
    },
    {
      "type": "header",
      "content": "Quote Banner"
    },
    {
      "type": "text",
      "id": "quote_heading",
      "label": "Quote text",
      "default": "\"A COLD BREW THAT TAKES SHORTCUTS IS JUST COLD COFFEE \""
    },
    {
      "type": "text",
      "id": "quote_highlight",
      "label": "Highlighted phrase (yellow)",
      "default": "COLD COFFEE",
      "info": "Must match exactly as it appears in the quote."
    },
    {
      "type": "text",
      "id": "quote_subtext",
      "label": "Quote subtext",
      "default": "Crafted for slow mornings, long nights, and everything in between."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding (mobile)",
      "default": 12
    }
  ]
}
{% endschema %}
