{{ 'section-bento-grid.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'component-primary-button.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-bento-grid.js' | asset_url }}" defer></script>

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
-%}
<style>
  /* Dynamic styles that require Liquid variables */
  {%- if section.settings.section_background_color != blank and section.settings.section_background_color != 'rgba(0,0,0,0)' -%}
  #bento-grid-{{ section.id }}.bento-grid-container,
  #bento-grid-{{ section.id }}.bento-grid-container.color-{{ scheme.id }} {
    background-color: {{ section.settings.section_background_color }} !important;
  }
  {%- endif -%}

  .bento-grid {
    /* Multiply columns by 10 to allow 0.1 increments */
    grid-template-columns: repeat({{ section.settings.grid_columns | times: 10 }}, 1fr);
    /* Divide row height by 10 to allow 0.1 increments */
    grid-auto-rows: {{ section.settings.row_height | divided_by: 10.0 }}px;
  }

  .bento-block-wrapper {
    padding: {{ section.settings.grid_gap | divided_by: 2 }}px;
  }

  .bento-card,
  .content-card,
  .content-card-inner,
  .tag-card,
  .generic-card,
  .search-card,
  .login-card,
  .video-card,
  .product-card,
  .text-card {
    border-radius: {{ section.settings.card_border_radius }}px !important;
  }

  .content-card-inner,
  .content-card-text-side,
  .content-card-sprite-side {
    background-color: transparent !important;
    border-radius: inherit !important;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .bento-grid {
      grid-auto-rows: {{ section.settings.row_height | times: 0.8 }}px; /* Smaller rows on mobile */
      gap: {{ section.settings.grid_gap | times: 0.7 }}px;
    }

    .bento-block-wrapper {
      padding: {{ section.settings.grid_gap | times: 0.35 }}px;
    }

    {%- for block in section.blocks -%}
      {%- comment -%} Mobile grid has 2 columns, so mobile_column_span should be used directly (not multiplied by 10) {%- endcomment -%}
      {%- if block.settings.mobile_column_span != blank -%}
        {%- assign mobile_col_span = block.settings.mobile_column_span | round -%}
      {%- else -%}
        {%- comment -%} Default to column_span, but scale it for 2-column mobile grid {%- endcomment -%}
        {%- assign desktop_col_span = block.settings.column_span | default: 1.0 -%}
        {%- comment -%} Scale desktop span proportionally: desktop max ~8.0 maps to mobile max 2.0 {%- endcomment -%}
        {%- assign mobile_col_span = desktop_col_span | divided_by: 4.0 | round -%}
      {%- endif -%}
      {%- comment -%} Clamp to valid range: minimum 1, maximum 2 (mobile grid has 2 columns) {%- endcomment -%}
      {%- if mobile_col_span < 1 -%}
        {%- assign mobile_col_span = 1 -%}
      {%- endif -%}
      {%- if mobile_col_span > 2 -%}
        {%- assign mobile_col_span = 2 -%}
      {%- endif -%}
      {%- comment -%} Mobile row span: scale desktop value proportionally for mobile, then multiply by 10 for precision {%- endcomment -%}
      {%- if block.settings.mobile_row_span != blank -%}
        {%- assign mobile_row_span = block.settings.mobile_row_span | times: 10 | round -%}
      {%- else -%}
        {%- comment -%} Default to row_span, but scale it for mobile (mobile rows are smaller) {%- endcomment -%}
        {%- assign desktop_row_span = block.settings.row_span | default: 1.0 -%}
        {%- comment -%} Scale desktop span proportionally: desktop max ~4.3 maps to mobile max ~0.5-1.0, so divide by ~8 {%- endcomment -%}
        {%- assign mobile_row_span_scaled = desktop_row_span | divided_by: 8.0 -%}
        {%- assign mobile_row_span = mobile_row_span_scaled | times: 10 | round -%}
      {%- endif -%}
      {%- comment -%} Clamp to valid range: minimum 1 (0.1 units), maximum 20 (2.0 units) for mobile {%- endcomment -%}
      {%- if mobile_row_span < 1 -%}
        {%- assign mobile_row_span = 1 -%}
      {%- endif -%}
      {%- if mobile_row_span > 20 -%}
        {%- assign mobile_row_span = 20 -%}
      {%- endif -%}
      .bento-block-wrapper[data-block-id="{{ block.id }}"] {
        grid-column: span {{ mobile_col_span }} !important;
        grid-row: span {{ mobile_row_span }} !important;
      }
    {%- endfor -%}
  }

  @media (max-width: 480px) {
    .bento-grid {
      grid-auto-rows: {{ section.settings.row_height | times: 0.7 }}px; /* Even smaller rows on small mobile */
      gap: {{ section.settings.grid_gap | times: 0.6 }}px;
    }

    .bento-block-wrapper {
      padding: {{ section.settings.grid_gap | times: 0.3 }}px;
    }
  }
</style>

<div
  class="bento-grid-container color-{{ scheme.id }}"
  id="bento-grid-{{ section.id }}"
  style="{%- unless section.settings.section_background_color != blank and section.settings.section_background_color != 'rgba(0,0,0,0)' -%}background-color: {{ scheme.settings.background }} !important; {%- endunless -%}color: {{ scheme.settings.text }} !important;"
>
  <div class="bento-grid">
    {%- for block in section.blocks -%}
      {%- comment -%} Calculate the 10x scaled spans for 0.1 precision {%- endcomment -%}
      {%- assign col_span = block.settings.column_span | times: 10 | round -%}
      {%- assign row_span = block.settings.row_span | times: 10 | round -%}

      <div
        class="bento-block-wrapper bento-block-wrapper--{{ block.type }}"
        style="grid-column: span {{ col_span }}; grid-row: span {{ row_span }};"
        data-block-id="{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {%- case block.type -%}
          {%- when 'search_card' -%}
            <div
              class="bento-card search-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}"
              onclick="window.location.href='{{ routes.search_url }}'"
            >
              <svg class="search-icon" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </div>

          {%- when 'login_card' -%}
            <div
              class="bento-card login-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}"
              onclick="window.location.href='{{ routes.account_url }}'"
            >
              <div class="login-content">
                <div class="avatar">
                  {%- if customer -%}
                    {{ customer.first_name | slice: 0 | upcase }}
                  {%- else -%}
                    ?
                  {%- endif -%}
                </div>
                <div class="welcome-text">
                  {%- if customer -%}
                    {%- if block.settings.welcome_text != blank -%}
                      {{ block.settings.welcome_text | replace: '[name]', customer.first_name }}
                    {%- else -%}
                      Hi, {{ customer.first_name }}!
                    {%- endif -%}
                  {%- else -%}
                    {{ block.settings.login_text | default: 'Login' }}
                  {%- endif -%}
                </div>
              </div>
            </div>

          {%- when 'card' -%}
            {%- assign has_image = false -%}
            {%- if block.settings.image != blank or block.settings.external_image_url != blank -%}
              {%- assign has_image = true -%}
            {%- endif -%}
            {%- assign heading_font_size = block.settings.heading_font_size | default: 18 -%}
            {%- assign heading_font_weight = block.settings.heading_font_weight | default: 600 -%}
            {%- assign mobile_heading_font_size = block.settings.mobile_heading_font_size
              | default: heading_font_size
            -%}
            {%- assign mobile_heading_font_weight = block.settings.mobile_heading_font_weight
              | default: heading_font_weight
            -%}
            <div
              class="bento-card generic-card{% if has_image %} has-image{% endif %}"
              style="{% if block.settings.image != blank %} background-image: url('{{ block.settings.image | image_url: width: 1000 }}');{% elsif block.settings.external_image_url != blank %} background-image: url('{{ block.settings.external_image_url }}');{% endif %}{% if block.settings.card_background_color != blank %} background-color: {{ block.settings.card_background_color }};{% endif %} --desktop-heading-font-size: {{ heading_font_size }}px; --desktop-heading-font-weight: {{ heading_font_weight }}; --mobile-heading-font-size: {{ mobile_heading_font_size }}px; --mobile-heading-font-weight: {{ mobile_heading_font_weight }};"
              {% if block.settings.link != blank %}
                onclick="window.location.href='{{ block.settings.link }}'"
              {% endif %}
            >
              {%- if block.settings.heading != blank -%}
                <h3 class="card-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
            </div>

          {%- when 'tag_card' -%}
            {%- assign direction = block.settings.layout_direction | default: 'row' -%}
            {%- assign mobile_direction = block.settings.mobile_layout_direction | default: direction -%}
            {%- assign icon_size = block.settings.icon_size | default: 32 -%}
            {%- assign mobile_icon_size = block.settings.mobile_icon_size | default: icon_size -%}
            {%- assign align = block.settings.content_alignment | default: 'left' -%}
            {%- assign mobile_align = block.settings.mobile_content_alignment | default: align -%}
            {%- assign vertical_align = block.settings.vertical_alignment | default: 'top' -%}
            {%- assign mobile_vertical_align = block.settings.mobile_vertical_alignment | default: vertical_align -%}
            <div
              class="bento-card tag-card tag-card--{{ direction }} tag-card--align-{{ align }} tag-card--valign-{{ vertical_align }}{% if block.settings.card_background_color != blank %} has-custom-background{% endif %}"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}{% if block.settings.card_text_color != blank %} color: {{ block.settings.card_text_color }};{% endif %}"
              data-mobile-direction="{{ mobile_direction }}"
              data-mobile-align="{{ mobile_align }}"
              data-mobile-vertical-align="{{ mobile_vertical_align }}"
              {% if block.settings.card_background_color != blank %}
                data-background-color="{{ block.settings.card_background_color }}"
              {% endif %}
            >
              <div class="tag-card-inner">
                <div class="tag-card-text-group">
                  {%- if block.settings.show_tag and block.settings.tag_text != blank -%}
                    {%- assign tag_style = block.settings.tag_style | default: 'filled' -%}
                    {%- assign tag_font_size = block.settings.tag_font_size | default: 11 -%}
                    {%- assign tag_font_weight = block.settings.tag_font_weight | default: 600 -%}
                    {%- assign mobile_tag_font_size = block.settings.mobile_tag_font_size | default: tag_font_size -%}
                    {%- assign mobile_tag_font_weight = block.settings.mobile_tag_font_weight
                      | default: tag_font_weight
                    -%}
                    <div
                      class="tag-card-tag tag-card-tag--{{ tag_style }}"
                      style="font-size: {{ tag_font_size }}px; font-weight: {{ tag_font_weight }}; --mobile-tag-font-size: {{ mobile_tag_font_size }}px; --mobile-tag-font-weight: {{ mobile_tag_font_weight }};"
                    >
                      {{ block.settings.tag_text }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.show_text and block.settings.main_text != blank -%}
                    {%- assign main_font_size = block.settings.main_text_font_size | default: 16 -%}
                    {%- assign main_font_weight = block.settings.main_text_font_weight | default: 600 -%}
                    {%- assign main_line_height = block.settings.main_text_line_height | default: 1.4 -%}
                    {%- assign mobile_main_font_size = block.settings.mobile_main_text_font_size
                      | default: main_font_size
                    -%}
                    {%- assign mobile_main_font_weight = block.settings.mobile_main_text_font_weight
                      | default: main_font_weight
                    -%}
                    {%- assign mobile_main_line_height = block.settings.mobile_main_text_line_height
                      | default: main_line_height
                    -%}
                    {%- assign main_display_type = block.settings.main_text_display_type | default: 'paragraph' -%}
                    {%- assign words = block.settings.main_text | split: ' ' -%}
                    {%- if main_display_type == 'heading' -%}
                      <h3
                        class="tag-card-main tag-card-main--heading"
                        style="--desktop-main-font-size: {{ main_font_size }}px; --desktop-main-font-weight: {{ main_font_weight }}; --desktop-main-line-height: {{ main_line_height }}; --mobile-main-font-size: {{ mobile_main_font_size }}px; --mobile-main-font-weight: {{ mobile_main_font_weight }}; --mobile-main-line-height: {{ mobile_main_line_height }};"
                      >
                        {%- for word in words -%}
                          <span class="tag-card-word">{{ word }}</span>
                          {%- unless forloop.last %} {% endunless %}
                        {%- endfor -%}
                      </h3>
                    {%- else -%}
                      <div
                        class="tag-card-main"
                        style="--desktop-main-font-size: {{ main_font_size }}px; --desktop-main-font-weight: {{ main_font_weight }}; --desktop-main-line-height: {{ main_line_height }}; --mobile-main-font-size: {{ mobile_main_font_size }}px; --mobile-main-font-weight: {{ mobile_main_font_weight }}; --mobile-main-line-height: {{ mobile_main_line_height }};"
                      >
                        {%- for word in words -%}
                          <span class="tag-card-word">{{ word }}</span>
                          {%- unless forloop.last %} {% endunless %}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                {%- if block.settings.show_icon and block.settings.icon_image != blank -%}
                  <div
                    class="tag-card-icon"
                    style="--desktop-icon-size: {{ icon_size }}px; --mobile-icon-size: {{ mobile_icon_size }}px; width: var(--desktop-icon-size); height: var(--desktop-icon-size);"
                  >
                    <img
                      src="{{ block.settings.icon_image | image_url: width: 160 }}"
                      alt="{{ block.settings.main_text | escape }}"
                      loading="lazy"
                      width="{{ icon_size }}"
                      height="{{ icon_size }}"
                    >
                  </div>
                {%- endif -%}

                {%- if block.settings.show_image_strip -%}
                  {%- assign has_images = false -%}
                  {%- for i in (1..10) -%}
                    {%- assign image_key = 'strip_image_' | append: i -%}
                    {%- if block.settings[image_key] != blank -%}
                      {%- assign has_images = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if has_images -%}
                    <div class="tag-card-image-strip">
                      <div class="tag-card-image-strip-track">
                        {%- comment -%} First set of images {%- endcomment -%}
                        {%- for i in (1..10) -%}
                          {%- assign image_key = 'strip_image_' | append: i -%}
                          {%- if block.settings[image_key] != blank -%}
                            <div class="tag-card-image-strip-item">
                              {{
                                block.settings[image_key]
                                | image_url: width: 160
                                | image_tag: loading: 'lazy', alt: ''
                              }}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
                        {%- for i in (1..10) -%}
                          {%- assign image_key = 'strip_image_' | append: i -%}
                          {%- if block.settings[image_key] != blank -%}
                            <div class="tag-card-image-strip-item">
                              {{
                                block.settings[image_key]
                                | image_url: width: 160
                                | image_tag: loading: 'lazy', alt: ''
                              }}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>

          {%- when 'content_card' -%}
            {%- assign direction = block.settings.layout_direction | default: 'column' -%}
            {%- assign mobile_direction = block.settings.mobile_layout_direction | default: direction -%}
            {%- assign bg_pos_h = block.settings.background_position_horizontal | default: 'center' -%}
            {%- assign bg_size = block.settings.background_size | default: 'cover' -%}
            {%- assign enable_spritesheet = block.settings.enable_spritesheet_animation -%}
            {%- assign sprite_frames = block.settings.sprite_frames | default: 8 -%}
            {%- assign sprite_duration = block.settings.sprite_animation_duration | default: 1.0 -%}
            {%- assign sprite_direction = block.settings.sprite_direction | default: 'horizontal' -%}
            {%- assign sprite_frames_minus_one = sprite_frames | minus: 1 -%}
            {%- assign tag_font_size = block.settings.tag_font_size | default: 11 -%}
            {%- assign tag_font_weight = block.settings.tag_font_weight | default: 600 -%}
            {%- assign mobile_tag_font_size = block.settings.mobile_tag_font_size | default: tag_font_size -%}
            {%- assign mobile_tag_font_weight = block.settings.mobile_tag_font_weight | default: tag_font_weight -%}
            {%- assign main_text_font_size = block.settings.main_text_font_size | default: 28 -%}
            {%- assign main_text_font_weight = block.settings.main_text_font_weight | default: 600 -%}
            {%- assign main_text_line_height = block.settings.main_text_line_height | default: 1.1 -%}
            {%- assign mobile_main_text_font_size = block.settings.mobile_main_text_font_size
              | default: main_text_font_size
            -%}
            {%- assign mobile_main_text_font_weight = block.settings.mobile_main_text_font_weight
              | default: main_text_font_weight
            -%}
            {%- assign mobile_main_text_line_height = block.settings.mobile_main_text_line_height
              | default: main_text_line_height
            -%}
            {%- assign align = block.settings.content_alignment | default: 'left' -%}
            {%- assign mobile_align = block.settings.mobile_content_alignment | default: align -%}
            {%- assign vertical_align = block.settings.vertical_alignment | default: 'top' -%}
            {%- assign mobile_vertical_align = block.settings.mobile_vertical_alignment | default: vertical_align -%}
            {%- assign sprite_scale = block.settings.sprite_scale | default: 100 -%}
            {%- assign mobile_sprite_scale = block.settings.mobile_sprite_scale | default: sprite_scale -%}
            {%- assign sprite_y_offset = block.settings.sprite_y_offset | default: 0 -%}
            {%- assign mobile_sprite_y_offset = block.settings.mobile_sprite_y_offset | default: sprite_y_offset -%}
            {%- assign sprite_x_offset = block.settings.sprite_x_offset | default: 0 -%}
            {%- assign mobile_sprite_x_offset = block.settings.mobile_sprite_x_offset | default: sprite_x_offset -%}
            {%- assign sprite_rotation = block.settings.sprite_rotation | default: 0 -%}
            {%- assign mobile_sprite_rotation = block.settings.mobile_sprite_rotation | default: sprite_rotation -%}
            {%- assign sprite_canvas_size = block.settings.sprite_canvas_size | default: 40 -%}
            {%- assign mobile_sprite_canvas_size = block.settings.mobile_sprite_canvas_size
              | default: sprite_canvas_size
            -%}
            {%- assign sprite_vertical_alignment = block.settings.sprite_vertical_alignment | default: '50%' -%}
            {%- assign mobile_sprite_vertical_alignment = block.settings.mobile_sprite_vertical_alignment
              | default: sprite_vertical_alignment
            -%}
            <div
              class="bento-card content-card content-card--{{ direction }} content-card--align-{{ align }} content-card--valign-{{ vertical_align }}{% if enable_spritesheet %} has-spritesheet{% if sprite_direction == 'vertical' %}-vertical{% endif %}{% endif %}{% if block.settings.enable_3d_effect %} enable-3d{% endif %}"
              data-mobile-direction="{{ mobile_direction }}"
              data-mobile-align="{{ mobile_align }}"
              data-mobile-vertical-align="{{ mobile_vertical_align }}"
              style="
                {% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}
                --desktop-tag-font-size: {{ tag_font_size }}px;
                --desktop-tag-font-weight: {{ tag_font_weight }};
                --mobile-tag-font-size: {{ mobile_tag_font_size }}px;
                --mobile-tag-font-weight: {{ mobile_tag_font_weight }};
                --desktop-main-text-font-size: {{ main_text_font_size }}px;
                --desktop-main-text-font-weight: {{ main_text_font_weight }};
                --desktop-main-text-line-height: {{ main_text_line_height }};
                --mobile-main-text-font-size: {{ mobile_main_text_font_size }}px;
                --mobile-main-text-font-weight: {{ mobile_main_text_font_weight }};
                --mobile-main-text-line-height: {{ mobile_main_text_line_height }};
                --desktop-sprite-canvas-size: {{ sprite_canvas_size }}%;
                --desktop-sprite-vertical-alignment: {{ sprite_vertical_alignment }};
                --desktop-sprite-scale: {{ sprite_scale | divided_by: 100.0 }};
                --desktop-sprite-y-offset: {{ sprite_y_offset }}px;
                --desktop-sprite-x-offset: {{ sprite_x_offset }}px;
                --desktop-sprite-rotation: {{ sprite_rotation }}deg;
                --mobile-sprite-canvas-size: {{ mobile_sprite_canvas_size }}%;
                --mobile-sprite-vertical-alignment: {{ mobile_sprite_vertical_alignment }};
                --mobile-sprite-scale: {{ mobile_sprite_scale | divided_by: 100.0 }};
                --mobile-sprite-y-offset: {{ mobile_sprite_y_offset }}px;
                --mobile-sprite-x-offset: {{ mobile_sprite_x_offset }}px;
                --mobile-sprite-rotation: {{ mobile_sprite_rotation }}deg;
              "
              {% if block.settings.link != blank %}
                onclick="window.location.href='{{ block.settings.link }}'"
              {% endif %}
            >
              <div class="content-card-inner">
                <div class="content-card-text-side">
                  <div class="content-card-line"></div>
                  <div class="content-card-text-content">
                    {%- if block.settings.show_tag and block.settings.tag_text != blank -%}
                      <div
                        class="tag-card-tag tag-card-tag--{{ block.settings.tag_style | default: 'filled' }} content-card-tag"
                      >
                        {{ block.settings.tag_text }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.main_text != blank -%}
                      {%- assign main_text_words = block.settings.main_text | split: ' ' -%}
                      <div class="content-card-main-text">
                        {%- for word in main_text_words -%}
                          <span class="content-card-word">{{ word }}</span>
                          {%- unless forloop.last %} {% endunless -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
                <div
                  class="content-card-sprite-side"
                  style="
                    flex: 0 0 var(--desktop-sprite-canvas-size);
                    transform: scale(var(--desktop-sprite-scale)) translate(var(--desktop-sprite-x-offset), var(--desktop-sprite-y-offset)) rotate(var(--desktop-sprite-rotation));
                    z-index: 10;
                    background-color: transparent;
                    {% if block.settings.image != blank %}
                      background-image: url('{{ block.settings.image | image_url: width: 1920 }}');
                    {% elsif 'spritesheet-prejudice.png' != blank %}
                      background-image: url('{{ 'spritesheet-prejudice.png' | asset_url }}');
                    {% endif %}
                    {% unless enable_spritesheet %}
                      background-position: {{ bg_pos_h }} {{ sprite_vertical_alignment }};
                      background-size: {{ bg_size }};
                    {% endunless %}
                    {% if enable_spritesheet %}
                      background-position: {% if sprite_direction == 'vertical' %}50% 0%{% else %}0% {{ sprite_vertical_alignment }}{% endif %};
                      background-repeat: no-repeat;
                      --sprite-frames: {{ sprite_frames }};
                      --sprite-animation-duration: {{ sprite_duration }}s;
                      --sprite-animation-timing: steps({{ sprite_frames_minus_one }});
                    {% endif %}
                  "
                ></div>
              </div>
            </div>

          {%- when 'button_card' -%}
            {%- assign label = block.settings.label | default: 'Button' -%}
            <div
              class="bento-card button-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}"
            >
              {% render 'primary-button', text: label, link: block.settings.link %}
            </div>

          {%- when 'text_card' -%}
            {%- assign align = block.settings.content_alignment | default: 'left' -%}
            {%- assign vertical_align = block.settings.vertical_alignment | default: 'top' -%}
            {%- assign button_align = block.settings.button_alignment | default: 'left' -%}
            {%- assign heading_size = block.settings.heading_font_size | default: 24 -%}
            {%- assign heading_weight = block.settings.heading_font_weight | default: 600 -%}
            {%- assign mobile_heading_size = block.settings.mobile_heading_font_size | default: heading_size -%}
            {%- assign mobile_heading_weight = block.settings.mobile_heading_font_weight | default: heading_weight -%}
            {%- assign para_size = block.settings.paragraph_font_size | default: 16 -%}
            {%- assign para_weight = block.settings.paragraph_font_weight | default: 400 -%}
            {%- assign para_line_height = block.settings.paragraph_line_height | default: 1.5 -%}
            {%- assign mobile_para_size = block.settings.mobile_paragraph_font_size | default: para_size -%}
            {%- assign mobile_para_weight = block.settings.mobile_paragraph_font_weight | default: para_weight -%}
            {%- assign mobile_para_line_height = block.settings.mobile_paragraph_line_height
              | default: para_line_height
            -%}
            {%- assign button_size = block.settings.button_font_size | default: 14 -%}
            {%- assign button_weight = block.settings.button_font_weight | default: 600 -%}
            {%- assign mobile_button_size = block.settings.mobile_button_font_size | default: button_size -%}
            {%- assign mobile_button_weight = block.settings.mobile_button_font_weight | default: button_weight -%}
            <div
              class="bento-card text-card text-card--align-{{ align }} text-card--valign-{{ vertical_align }}"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %} --desktop-heading-font-size: {{ heading_size }}px; --desktop-heading-font-weight: {{ heading_weight }}; --mobile-heading-font-size: {{ mobile_heading_size }}px; --mobile-heading-font-weight: {{ mobile_heading_weight }}; --desktop-paragraph-font-size: {{ para_size }}px; --desktop-paragraph-font-weight: {{ para_weight }}; --desktop-paragraph-line-height: {{ para_line_height }}; --mobile-paragraph-font-size: {{ mobile_para_size }}px; --mobile-paragraph-font-weight: {{ mobile_para_weight }}; --mobile-paragraph-line-height: {{ mobile_para_line_height }}; --desktop-button-font-size: {{ button_size }}px; --desktop-button-font-weight: {{ button_weight }}; --mobile-button-font-size: {{ mobile_button_size }}px; --mobile-button-font-weight: {{ mobile_button_weight }};"
            >
              <div class="text-card-inner">
                {%- if block.settings.enable_svg and block.settings.svg_icon != blank -%}
                  <div class="text-card-svg">
                    <img
                      src="{{ block.settings.svg_icon | image_url: width: 80 }}"
                      alt=""
                      class="text-card-svg-icon"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}

                {%- if block.settings.enable_heading and block.settings.heading != blank -%}
                  <h3 class="text-card-heading">
                    {{ block.settings.heading }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.paragraph != blank -%}
                  <div class="text-card-paragraph">
                    {{ block.settings.paragraph }}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_text != blank -%}
                  <div class="text-card-button-wrapper text-card-button--align-{{ button_align }}">
                    {%- if block.settings.button_link != blank -%}
                      <a
                        href="{{ block.settings.button_link }}"
                        class="text-card-button"
                      >
                        {{- block.settings.button_text -}}
                      </a>
                    {%- else -%}
                      <button
                        type="button"
                        class="text-card-button"
                      >
                        {{ block.settings.button_text }}
                      </button>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'product_card' -%}
            {%- assign product = block.settings.product -%}
            {%- assign align = block.settings.content_alignment | default: 'left' -%}
            {%- assign vertical_align = block.settings.vertical_alignment | default: 'top' -%}
            {%- assign title_font_size = block.settings.title_font_size | default: 38 -%}
            {%- assign title_font_weight = block.settings.title_font_weight | default: 600 -%}
            {%- assign mobile_title_font_size = block.settings.mobile_title_font_size | default: title_font_size -%}
            {%- assign mobile_title_font_weight = block.settings.mobile_title_font_weight
              | default: title_font_weight
            -%}
            <div
              class="bento-card product-card product-card--align-{{ align }} product-card--valign-{{ vertical_align }}"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %} --desktop-title-font-size: {{ title_font_size }}px; --desktop-title-font-weight: {{ title_font_weight }}; --mobile-title-font-size: {{ mobile_title_font_size }}px; --mobile-title-font-weight: {{ mobile_title_font_weight }};"
              {% if product != blank and product.url != blank %}
                onclick="window.location.href='{{ product.url }}'"
              {% endif %}
            >
              <div class="product-card-inner">
                <div class="product-card-content">
                  {%- if block.settings.show_tag and block.settings.tag_text != blank -%}
                    {%- assign tag_style = block.settings.tag_style | default: 'filled' -%}
                    {%- assign tag_font_size = block.settings.tag_font_size | default: 11 -%}
                    {%- assign tag_font_weight = block.settings.tag_font_weight | default: 600 -%}
                    <div
                      class="product-card-tag tag-card-tag tag-card-tag--{{ tag_style }}"
                      style="font-size: {{ tag_font_size }}px; font-weight: {{ tag_font_weight }};"
                    >
                      {{ block.settings.tag_text }}
                    </div>
                  {%- endif -%}

                  {%- if product != blank and product.title != blank -%}
                    <div class="product-card-title">{{ product.title }}</div>
                  {%- elsif product == blank -%}
                    <div class="product-card-title">Product Name</div>
                  {%- endif -%}

                  {%- if product != blank and product.featured_image != blank -%}
                    <div class="product-card-image-wrapper">
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', alt: product.title, class: 'product-card-image'
                      }}
                    </div>
                  {%- elsif block.settings.default_product_image != blank -%}
                    <div class="product-card-image-wrapper">
                      {{
                        block.settings.default_product_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          alt: 'Product',
                          class: 'product-card-image',
                          width: 600,
                          height: 600
                      }}
                    </div>
                  {%- else -%}
                    <div class="product-card-image-wrapper">
                      <img
                        src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-1_large.png?v=1530129113"
                        alt="Product placeholder"
                        class="product-card-image"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>

          {%- when 'video_card' -%}
            <div
              class="bento-card video-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %}"
            >
              {%- assign has_video = false -%}
              {%- case block.settings.video_source -%}
                {%- when 'shopify' -%}
                  {%- if block.settings.video != blank -%}
                    {%- assign has_video = true -%}
                    {{
                      block.settings.video
                      | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false
                    }}
                  {%- endif -%}
                {%- when 'youtube' -%}
                  {%- if block.settings.youtube_url != blank -%}
                    {%- assign has_video = true -%}
                    {%- assign yt_url = block.settings.youtube_url -%}
                    {%- assign yt_id = '' -%}

                    {%- if yt_url contains 'youtu.be/' -%}
                      {%- assign yt_id = yt_url | split: '/' | last | split: '?' | first -%}
                    {%- elsif yt_url contains 'watch?v=' -%}
                      {%- assign yt_id = yt_url | split: 'v=' | last | split: '&' | first -%}
                    {%- endif -%}

                    {%- if yt_id != '' -%}
                      {%- assign embed_url = 'https://www.youtube.com/embed/' | append: yt_id -%}
                    {%- else -%}
                      {%- assign embed_url = yt_url -%}
                    {%- endif -%}

                    <iframe
                      src="{{ embed_url }}?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1&loop=1{% if yt_id != '' %}&playlist={{ yt_id }}{% endif %}"
                      title="Video"
                      frameborder="0"
                      allow="autoplay; encrypted-media; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {%- endif -%}
              {%- endcase -%}

              {%- if has_video == false -%}
                <div class="video-placeholder-text">Add video here</div>
              {%- endif -%}

              {%- if block.settings.marquee_text != blank -%}
                <div
                  class="video-marquee"
                  style="{% if block.settings.scrolling_text_background_color != blank %}background-color: {{ block.settings.scrolling_text_background_color }} !important;{% endif %}{% if block.settings.scrolling_text_text_color != blank %} --marquee-text-color: {{ block.settings.scrolling_text_text_color }};{% endif %}"
                >
                  <div class="video-marquee-track">
                    <span class="video-marquee-item">{{ block.settings.marquee_text }}</span>
                    <img
                      src="{% if block.settings.marquee_separator_image != blank %}{{ block.settings.marquee_separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                      alt=""
                      class="video-marquee-separator"
                      aria-hidden="true"
                      width="40"
                      height="40"
                    >
                    <span class="video-marquee-item" aria-hidden="true">{{ block.settings.marquee_text }}</span>
                    <img
                      src="{% if block.settings.marquee_separator_image != blank %}{{ block.settings.marquee_separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                      alt=""
                      class="video-marquee-separator"
                      aria-hidden="true"
                      width="40"
                      height="40"
                    >
                    <span class="video-marquee-item" aria-hidden="true">{{ block.settings.marquee_text }}</span>
                    <img
                      src="{% if block.settings.marquee_separator_image != blank %}{{ block.settings.marquee_separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                      alt=""
                      class="video-marquee-separator"
                      aria-hidden="true"
                      width="40"
                      height="40"
                    >
                    <span class="video-marquee-item" aria-hidden="true">{{ block.settings.marquee_text }}</span>
                    <img
                      src="{% if block.settings.marquee_separator_image != blank %}{{ block.settings.marquee_separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                      alt=""
                      class="video-marquee-separator"
                      aria-hidden="true"
                      width="40"
                      height="40"
                    >
                  </div>
                </div>
              {%- endif -%}
            </div>

          {%- when 'scrolling_text_card' -%}
            {%- assign font_size = block.settings.font_size | default: 24 -%}
            {%- assign font_weight = block.settings.font_weight | default: 700 -%}
            {%- assign mobile_font_size = block.settings.mobile_font_size | default: font_size -%}
            {%- assign mobile_font_weight = block.settings.mobile_font_weight | default: font_weight -%}
            <div
              class="bento-card scrolling-text-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %} --desktop-font-size: {{ font_size }}px; --desktop-font-weight: {{ font_weight }}; --mobile-font-size: {{ mobile_font_size }}px; --mobile-font-weight: {{ mobile_font_weight }};"
            >
              <div class="marquee-track">
                <span class="marquee-item">{{ block.settings.text }}</span>
                <img
                  src="{% if block.settings.separator_image != blank %}{{ block.settings.separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                  alt=""
                  class="marquee-separator"
                  aria-hidden="true"
                  width="40"
                  height="40"
                >
                <span class="marquee-item" aria-hidden="true">{{ block.settings.text }}</span>
                <img
                  src="{% if block.settings.separator_image != blank %}{{ block.settings.separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                  alt=""
                  class="marquee-separator"
                  aria-hidden="true"
                  width="40"
                  height="40"
                >
                <span class="marquee-item" aria-hidden="true">{{ block.settings.text }}</span>
                <img
                  src="{% if block.settings.separator_image != blank %}{{ block.settings.separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                  alt=""
                  class="marquee-separator"
                  aria-hidden="true"
                  width="40"
                  height="40"
                >
                <span class="marquee-item" aria-hidden="true">{{ block.settings.text }}</span>
                <img
                  src="{% if block.settings.separator_image != blank %}{{ block.settings.separator_image | image_url: width: 40 }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_large.png?v=1530129132{% endif %}"
                  alt=""
                  class="marquee-separator"
                  aria-hidden="true"
                  width="40"
                  height="40"
                >
              </div>
            </div>

          {%- when 'toggle_card' -%}
            {%- assign toggle_size = block.settings.toggle_size | default: 60 -%}
            {%- assign mobile_toggle_size = block.settings.mobile_toggle_size | default: toggle_size -%}
            {%- assign icon_size = block.settings.icon_size | default: 24 -%}
            {%- assign mobile_icon_size = block.settings.mobile_icon_size | default: icon_size -%}
            {%- assign toggle_bg_color = block.settings.toggle_bg_color | default: '#f0f0f0' -%}
            {%- assign toggle_active_bg_color = block.settings.toggle_active_bg_color | default: '#1a1a1a' -%}
            {%- assign toggle_knob_color = block.settings.toggle_knob_color | default: '#ffffff' -%}
            {%- assign sun_color = block.settings.sun_color | default: '#ffa500' -%}
            {%- assign moon_color = block.settings.moon_color | default: '#ffffff' -%}
            <div
              class="bento-card toggle-card"
              style="{% if block.settings.card_background_color != blank %}background-color: {{ block.settings.card_background_color }};{% endif %} --toggle-size: {{ toggle_size }}px; --mobile-toggle-size: {{ mobile_toggle_size }}px; --icon-size: {{ icon_size }}px; --mobile-icon-size: {{ mobile_icon_size }}px; --toggle-bg: {{ toggle_bg_color }}; --toggle-active-bg: {{ toggle_active_bg_color }}; --toggle-knob: {{ toggle_knob_color }}; --sun-color: {{ sun_color }}; --moon-color: {{ moon_color }};"
              data-toggle-card
            >
              <div class="toggle-switch-wrapper">
                <label class="toggle-switch" for="toggle-{{ block.id }}">
                  <input
                    type="checkbox"
                    id="toggle-{{ block.id }}"
                    class="toggle-input"
                    data-toggle-input
                    aria-label="Toggle switch"
                  >
                  <span class="toggle-slider">
                    <span class="toggle-icon toggle-icon-sun">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                      </svg>
                    </span>
                    <span class="toggle-icon toggle-icon-moon">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                      </svg>
                    </span>
                  </span>
                </label>
              </div>
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bento Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "info": "Custom background color for the section. If not set, the color scheme background will be used."
    },
    {
      "type": "header",
      "content": "Grid Layout Settings"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Grid Columns",
      "default": 8,
      "info": "Number of columns in the grid"
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Row Height",
      "default": 100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Generic Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        },
        {
          "type": "text",
          "id": "external_image_url",
          "label": "Or use external image URL",
          "info": "Enter full URL of image (e.g., https://example.com/image.jpg)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "card_background_color",
          "label": "Card Background Color",
          "default": "#ffffff",
          "info": "Background color for this card"
        },
        {
          "type": "select",
          "id": "card_shape",
          "label": "Card Shape",
          "options": [
            {
              "value": "rectangle",
              "label": "Rectangle"
            },
            {
              "value": "square",
              "label": "Square"
            }
          ],
          "default": "rectangle"
        },
        {
          "type": "header",
          "content": "Heading Typography"
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Heading font size",
          "default": 18
        },
        {
          "type": "select",
          "id": "heading_font_weight",
          "label": "Heading font weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "600"
        },
        {
          "type": "header",
          "content": "Mobile Typography"
        },
        {
          "type": "range",
          "id": "mobile_heading_font_size",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Mobile Heading font size",
          "default": 14,
          "info": "Heading font size on mobile devices"
        },
        {
          "type": "select",
          "id": "mobile_heading_font_weight",
          "label": "Mobile Heading font weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "600"
        },
        {
          "type": "header",
          "content": "Desktop Layout"
        },
        {
          "type": "range",
          "id": "column_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Column Span",
          "default": 2
        },
        {
          "type": "range",
          "id": "row_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Row Span",
          "default": 2
        },
        {
          "type": "header",
          "content": "Mobile Layout"
        },
        {
          "type": "range",
          "id": "mobile_column_span",
          "min": 0.1,
          "max": 2,
          "step": 0.1,
          "label": "Mobile Column Span",
          "default": 2,
          "info": "Column span on mobile devices (max 2 columns on mobile grid)"
        },
        {
          "type": "range",
          "id": "mobile_row_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Mobile Row Span",
          "default": 1
        }
      ]
    },
    {
      "type": "search_card",
      "name": "Search",
      "settings": [
        {
          "type": "color",
          "id": "card_background_color",
          "label": "Card Background Color",
          "default": "#ffffff",
          "info": "Background color for this card"
        },
        {
          "type": "header",
          "content": "Desktop Layout"
        },
        {
          "type": "range",
          "id": "column_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Column Span",
          "default": 1
        },
        {
          "type": "range",
          "id": "row_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Row Span",
          "default": 1
        },
        {
          "type": "header",
          "content": "Mobile Layout"
        },
        {
          "type": "range",
          "id": "mobile_column_span",
          "min": 0.1,
          "max": 2,
          "step": 0.1,
          "label": "Mobile Column Span",
          "default": 1,
          "info": "Column span on mobile devices (max 2 columns on mobile grid)"
        },
        {
          "type": "range",
          "id": "mobile_row_span",
          "min": 0.1,
          "max": 6,
          "step": 0.1,
          "label": "Mobile Row Span",
          "default": 1
        }
      ]
    },
    {
      "type": "login_card",
      "name": "Login/Welcome",
      "settings": [
        {
