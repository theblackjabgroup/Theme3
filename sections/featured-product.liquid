{%- liquid
  assign featured_product = section.settings.product
  assign selected_variant = featured_product.selected_or_first_available_variant
  assign product_form_id = 'FeaturedProductForm-' | append: section.id
  assign product_title = section.settings.title_text
  assign product_description = section.settings.description_text
  assign product_price = selected_variant.price

  if featured_product != blank
    if product_title == blank
      assign product_title = featured_product.title
    endif

    if product_description == blank
      assign product_description = featured_product.description | strip_html | truncatewords: 28
    endif
  endif

  assign rating_value = 4.8
  assign rating_count = 124

  if featured_product != blank and featured_product.metafields.reviews.rating.value != blank
    assign rating_value = featured_product.metafields.reviews.rating.value.rating | default: rating_value
    assign rating_count = featured_product.metafields.reviews.rating_count | default: rating_count
  endif

  assign add_to_cart_attributes = ''
  if featured_product == blank or selected_variant == blank or selected_variant.available == false
    assign add_to_cart_attributes = 'disabled aria-disabled="true"'
  endif
-%}

{{ 'section-featured-product.css' | asset_url | stylesheet_tag }}

<section class="featured color-{{ section.settings.color_scheme }} {% if section.settings.secondary_background %}background-secondary{% else %}gradient{% endif %}">
  <div class="section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">
    <div class="featured__grid">
      <article class="featured__primary">
        <div class="featured__product scroll-trigger reveal-left" style="--animation-order: 1;">
          <span class="featured__pill">{{ section.settings.product_pill_label }}</span>

          <h2 class="featured__title">{{ product_title | default: 'ARCTIC COLD BREW' }}</h2>

          <p class="featured__price">
            {%- if featured_product != blank and product_price != blank -%}
              {{ product_price | money }}
            {%- else -%}
              {{ 3299 | money }}
            {%- endif -%}
          </p>

          <div class="featured__rating" aria-label="Rated {{ rating_value }} out of 5">
            <span class="featured__stars" aria-hidden="true">★★★★★</span>
            <span class="featured__reviews">{{ rating_value }} ({{ rating_count }} reviews)</span>
          </div>

          <p class="featured__description">
            {{
              product_description
              | default: 'Bold, smooth, and clean. A bright cold brew designed for long days, late nights, and everything in between.'
            }}
          </p>

          <div class="featured__actions">
            {%- if featured_product != blank and selected_variant != blank -%}
              {% form 'product', featured_product, id: product_form_id %}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                {% render
                  'global-btn',
                  text: 'Add to cart',
                  type: 'submit',
                  variant: 'tertiary',
                  fit_width: false,
                  attributes: add_to_cart_attributes
                %}
              {% endform %}
            {%- else -%}
              {% render 'global-btn', text: 'Add to cart', variant: 'tertiary', fit_width: false, attributes: add_to_cart_attributes %}
            {%- endif -%}

            <a
              class="featured__details-link"
              href="{% if featured_product != blank %}{{ featured_product.url }}{% else %}#{% endif %}"
            >
              View full details
            </a>
          </div>
        </div>

        <div class="featured__media scroll-trigger reveal-scale" style="--animation-order: 2;">
          <div class="featured__slider" data-featured-slider>
            {%- render 'global-btn-2',
              text: '←',
              type: 'button',
              fit_width: false,
              class: 'featured__arrow featured__arrow--prev',
              attributes: 'aria-label="Previous image"',
              border_radius: '50%',
              no_border: true
            -%}

            <div class="featured__slider-track">
              {%- if featured_product != blank and featured_product.media.size > 0 -%}
                {%- for media in featured_product.media -%}
                  {%- if media.media_type == 'image' -%}
                    <div class="featured__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                      {{
                        media
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 540, 720, 960, 1200',
                          sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 34vw',
                          class: 'featured__slide-image',
                          alt: media.alt
                      }}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <div class="featured__slide is-active" data-slide-index="0">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'featured__slide-image featured__slide-image--placeholder' }}
                </div>
              {%- endif -%}
            </div>

            {%- render 'global-btn-2',
              text: '→',
              type: 'button',
              fit_width: false,
              class: 'featured__arrow featured__arrow--next',
              attributes: 'aria-label="Next image"',
              border_radius: '50%',
              no_border: true
            -%}
          </div>
        </div>
      </article>

      <aside class="featured__promo scroll-trigger reveal-up" style="--animation-order: 3;">
        <span class="featured__pill">{{ section.settings.promo_pill_label }}</span>

        <h3 class="featured__promo-title">{{ section.settings.promo_heading | default: '6 BLENDS\n1 STANDARDS' | newline_to_br }}</h3>

        <p class="featured__promo-description">
          {{
            section.settings.promo_description
            | default: 'Discover the complete lineup crafted for consistency, character, and everyday brewing rituals.'
          }}
        </p>

        {% render
          'global-btn',
          text: 'View collection',
          url: section.settings.promo_collection.url | default: '#',
          variant: 'tertiary',
          fit_width: false
        %}
      </aside>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root || !root.classList.contains('featured')) return;

    const slider = root.querySelector('[data-featured-slider]');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll('.featured__slide'));
    const prev = slider.querySelector('.featured__arrow--prev');
    const next = slider.querySelector('.featured__arrow--next');
    if (slides.length <= 1 || !prev || !next) {
      if (prev) prev.hidden = true;
      if (next) next.hidden = true;
      return;
    }

    let activeIndex = slides.findIndex((slide) => slide.classList.contains('is-active'));
    if (activeIndex < 0) activeIndex = 0;

    const showSlide = (index) => {
      const normalized = (index + slides.length) % slides.length;
      slides[activeIndex]?.classList.remove('is-active');
      slides[normalized].classList.add('is-active');
      activeIndex = normalized;
    };

    prev.addEventListener('click', () => showSlide(activeIndex - 1));
    next.addEventListener('click', () => showSlide(activeIndex + 1));
  })();
</script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top  }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --featured-title-size: {{ section.settings.title_font_size | default: 48 }}px;
    --featured-title-weight: {{ section.settings.title_font_weight | default: 600 }};
    --featured-title-letter-spacing: {{ section.settings.title_letter_spacing | default: -2 }}px;
    --featured-price-size: {{ section.settings.price_font_size | default: 32 }}px;
    --featured-price-weight: {{ section.settings.price_font_weight | default: 900 }};
    --featured-price-letter-spacing: {{ section.settings.price_letter_spacing | default: -2 }}px;
    --featured-atc-width: {{ section.settings.atc_width | default: 278 }}px;
    --featured-atc-height: {{ section.settings.atc_height | default: 44 }}px;
    --featured-atc-radius: {{ section.settings.atc_radius | default: 12 }}px;
    --featured-gap-lg: {{ section.settings.spacing_lg | default: 24 }}px;
    --featured-gap-md: {{ section.settings.spacing_md | default: 16 }}px;
    --featured-gap-sm: {{ section.settings.spacing_sm | default: 8 }}px;
    --featured-product-min-width: {{ section.settings.product_col_min_width | default: 479 }}px;
    --featured-arrow-width: {{ section.settings.arrow_width | default: 40 }}px;
    --featured-arrow-height: {{ section.settings.arrow_height | default: 39 }}px;
    --featured-arrow-offset: {{ section.settings.arrow_offset | default: 0 }}px;
    --featured-promo-padding-top: {{ section.settings.promo_padding_top | default: 120 }}px;
    --featured-promo-pill-padding-y: {{ section.settings.promo_pill_padding_y | default: 6 }}px;
    --featured-promo-pill-padding-x: {{ section.settings.promo_pill_padding_x | default: 16 }}px;
    --featured-promo-pill-radius: {{ section.settings.promo_pill_radius | default: 55 }}px;
    --featured-vc-width: {{ section.settings.vc_width | default: 226 }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "collection",
      "id": "promo_collection",
      "label": "Promo collection"
    },
    {
      "type": "text",
      "id": "product_pill_label",
      "label": "Product pill label",
      "default": "New"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title",
      "default": "ARCTIC COLD BREW"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description",
      "default": "Bold, smooth, and clean. A bright cold brew designed for long days, late nights, and everything in between."
    },
    {
      "type": "text",
      "id": "promo_pill_label",
      "label": "Promo pill label",
      "default": "LIMITED COLLECTION"
    },
    {
      "type": "textarea",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "6 BLENDS\n1 STANDARDS"
    },
    {
      "type": "textarea",
      "id": "promo_description",
      "label": "Promo description",
      "default": "Discover the complete lineup crafted for consistency, character, and everyday brewing rituals."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
