{{ 'component-global-btn.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn-2.css' | asset_url | stylesheet_tag }}
{{ 'section-password-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-content.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign password_scheme_ref = section.settings.color_scheme
  assign password_scheme_id = password_scheme_ref.id | default: password_scheme_ref | append: ''
  assign password_scheme_obj = null
  for s in settings.color_schemes
    assign sid = s.id | append: ''
    if sid == password_scheme_id or s.id == password_scheme_ref
      assign password_scheme_obj = s
      break
    endif
  endfor
  assign password_dark_scheme_id = null
  assign password_dark_scheme_obj = null
  if section.settings.dark_mode_color_scheme != blank
    assign password_dark_ref = section.settings.dark_mode_color_scheme
    assign password_dark_scheme_id = password_dark_ref.id | default: password_dark_ref | append: ''
    for s in settings.color_schemes
      assign sid = s.id | append: ''
      if sid == password_dark_scheme_id or s.id == password_dark_ref
        assign password_dark_scheme_obj = s
        break
      endif
    endfor
  endif
-%}

{%- style -%}
  .password-page-outer {
    --logo-width: {{ section.settings.logo_width }}px;
    --input-border-radius: {{ section.settings.input_border_radius }}px;
    --button-border-radius: {{ section.settings.button_border_radius }}px;
    --modal-border-radius: {{ section.settings.modal_border_radius }}px;
    --modal-max-width: {{ section.settings.modal_width }}px;

    /* Design-matched color variables – matches Opening Soon reference */
    --color-bg: #F7F5FA;
    --color-background: #F7F5FA;
    --color-heading: #264BD7;
    --color-headings: #264BD7;
    --color-text: #333333;
    --color-card-bg: #EBEBEB;
    --color-input-bg: #ffffff;
    --color-input-border: #000000;
    --color-input-text: #333333;

    /* Background Colors */
    --countdown-bg: var(--color-card-bg);
    --countdown-text: var(--color-heading);
    --countdown-label: #7C7C7C;
    --countdown-separator: var(--color-heading);
    --countdown-number-size-desktop: {{ section.settings.countdown_number_font_size_desktop }}px;
    --countdown-number-size-mobile: {{ section.settings.countdown_number_font_size_mobile }}px;
    --countdown-number-weight: {{ section.settings.countdown_number_font_weight }};
    --countdown-label-size-desktop: {{ section.settings.countdown_label_font_size_desktop }}px;
    --countdown-label-size-mobile: {{ section.settings.countdown_label_font_size_mobile }}px;
    --countdown-label-weight: {{ section.settings.countdown_label_font_weight }};
    --countdown-separator-size-desktop: {{ section.settings.countdown_separator_font_size_desktop }}px;
    --countdown-separator-size-mobile: {{ section.settings.countdown_separator_font_size_mobile }}px;
    --countdown-separator-weight: {{ section.settings.countdown_separator_font_weight }};
    --modal-bg: var(--color-card-bg);
    --modal-backdrop: rgba(0,0,0,0.5);
    --newsletter-input-bg: var(--color-input-bg);
    --newsletter-input-placeholder: #7C7C7C;
    --password-footer-color: var(--color-text);

    /* Button Colors – design defaults (section settings can override in theme editor) */
    --button-primary-bg: {{ section.settings.button_primary_background | default: '#264BD7' }};
    --button-primary-text: {{ section.settings.button_primary_text | default: '#FFFFFF' }};
    --button-primary-border: {{ section.settings.button_primary_border | default: '#000000' }};
    --button-newsletter-bg: {{ section.settings.button_newsletter_background | default: '#F9B234' }};
    --button-newsletter-text: {{ section.settings.button_newsletter_text | default: '#FFFFFF' }};
    --button-newsletter-border: {{ section.settings.button_newsletter_border | default: '#000000' }};
    --button-shadow: {{ section.settings.button_shadow | default: '#000000' }};
    --btn-tertiary-bg: #F9B234;
    --btn-tertiary-text: #FFFFFF;
    --btn-tertiary-border: #000000;
    --btn-secondary-bg: #264BD7;
    --btn-secondary-text: #FFFFFF;
    --btn-secondary-border: #000000;

    /* Layout Gaps */
    --section-gap-desktop: {{ section.settings.desktop_gap }}px;
    --section-gap-mobile: {{ section.settings.mobile_gap }}px;

    /* Typography */
    --heading-font-size-desktop: {{ section.settings.heading_font_size_desktop }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --heading-font-weight: {{ section.settings.heading_font_weight }};
    --subheading-font-size-desktop: {{ section.settings.subheading_font_size_desktop }}px;
    --subheading-font-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
    --subheading-font-weight: {{ section.settings.subheading_font_weight }};
    --input-font-size-desktop: {{ section.settings.input_font_size_desktop }}px;
    --input-font-size-mobile: {{ section.settings.input_font_size_mobile }}px;
    --input-font-weight: {{ section.settings.input_font_weight }};
    --modal-heading-font-size-desktop: {{ section.settings.modal_heading_font_size_desktop }}px;
    --modal-heading-font-size-mobile: {{ section.settings.modal_heading_font_size_mobile }}px;
    --modal-heading-font-weight: {{ section.settings.modal_heading_font_weight }};
  }

  .field__input, .password-modal .field { border-radius: var(--input-border-radius); }
  .submit-button__content, .submit-button__shadow { border-radius: var(--button-border-radius); }

  .newsletter-submit-btn.global-btn-2::before {
    left: -2px;
    right: -2px;
    top: -2px;
    bottom: -2px;
  }

  .password-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--section-gap-desktop);
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .password-page {
      gap: var(--section-gap-mobile);
    }
  }
{%- endstyle -%}

{%- if password_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .password-page-outer,
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .password-content-section,
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .password-modal-content {
      --color-bg: {{ password_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ password_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ password_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ password_scheme_obj.settings.color_card_text | default: password_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ password_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ password_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ password_scheme_obj.settings.color_text }} !important;
      --color-link: {{ password_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ password_scheme_obj.settings.color_link_hover }} !important;
      --color-input-bg: {{ password_scheme_obj.settings.color_input_bg }} !important;
      --color-input-text: {{ password_scheme_obj.settings.color_input_text }} !important;
      --color-input-border: {{ password_scheme_obj.settings.color_input_border }} !important;
      --btn-primary-bg: {{ password_scheme_obj.settings.btn_primary_bg }} !important;
      --btn-primary-text: {{ password_scheme_obj.settings.btn_primary_text }} !important;
      --btn-primary-border: {{ password_scheme_obj.settings.btn_primary_border }} !important;
      --btn-primary-shadow: {{ password_scheme_obj.settings.btn_primary_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}
{%- if password_dark_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"][data-active-scheme="color-{{ password_dark_scheme_id }}"] #shopify-section-{{ section.id }} .password-page-outer,
    html[data-global-theme-active="true"][data-active-scheme="color-{{ password_dark_scheme_id }}"] #shopify-section-{{ section.id }} .password-content-section,
    html[data-global-theme-active="true"][data-active-scheme="color-{{ password_dark_scheme_id }}"] #shopify-section-{{ section.id }} .password-modal-content {
      --color-bg: {{ password_dark_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ password_dark_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ password_dark_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ password_dark_scheme_obj.settings.color_card_text | default: password_dark_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ password_dark_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ password_dark_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ password_dark_scheme_obj.settings.color_text }} !important;
      --color-link: {{ password_dark_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ password_dark_scheme_obj.settings.color_link_hover }} !important;
      --color-input-bg: {{ password_dark_scheme_obj.settings.color_input_bg }} !important;
      --color-input-text: {{ password_dark_scheme_obj.settings.color_input_text }} !important;
      --color-input-border: {{ password_dark_scheme_obj.settings.color_input_border }} !important;
      --btn-primary-bg: {{ password_dark_scheme_obj.settings.btn_primary_bg }} !important;
      --btn-primary-text: {{ password_dark_scheme_obj.settings.btn_primary_text }} !important;
      --btn-primary-border: {{ password_dark_scheme_obj.settings.btn_primary_border }} !important;
      --btn-primary-shadow: {{ password_dark_scheme_obj.settings.btn_primary_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}

<div class="password-page-outer color-{{ section.settings.color_scheme }}">
  <div class="password-content-section">
    <div class="password-page">
      <div class="password-logo-container">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: section.settings.logo.width
            | image_tag: class: 'password-logo', loading: 'eager', width: section.settings.logo_width
          }}
        {%- else -%}
          <h1 class="h2 password-logo-text">{{ shop.name }}</h1>
        {%- endif -%}
      </div>

      {%- if section.settings.heading != blank -%}
        <h2 class="password-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_countdown -%}
        {%- capture target_date -%}{{ section.settings.year }}-{{ section.settings.month | prepend: '0' | slice: -2, 2 }}-{{ section.settings.day | prepend: '0' | slice: -2, 2 }}T{{ section.settings.hour | prepend: '0' | slice: -2, 2 }}:{{ section.settings.minute | prepend: '0' | slice: -2, 2 }}:00{%- endcapture -%}
        <div
          class="password-countdown"
          data-date="{{ target_date }}"
        >
          <div class="countdown-block">
            <span class="countdown-number" data-days>00</span>
            <span class="countdown-label">DAYS</span>
          </div>
          <div class="countdown-separator">:</div>
          <div class="countdown-block">
            <span class="countdown-number" data-hours>00</span>
            <span class="countdown-label">HOURS</span>
          </div>
          <div class="countdown-separator">:</div>
          <div class="countdown-block">
            <span class="countdown-number" data-minutes>00</span>
            <span class="countdown-label">MINUTES</span>
          </div>
          <div class="countdown-separator">:</div>
          <div class="countdown-block">
            <span class="countdown-number" data-seconds>00</span>
            <span class="countdown-label">SECONDS</span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="password-newsletter">
          {% form 'customer', class: 'password-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {{ 'newsletter.success' | t }}
              </div>
            {%- else -%}
              <div class="field">
                <div class="newsletter-input-wrapper">
                  <input
                    id="PasswordNewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input newsletter-input-content"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="PasswordNewsletter-error--{{ section.id }}"
                    {% endif %}
                    placeholder="Email Address"
                    required
                  >
                </div>
                <label class="field__label visually-hidden" for="PasswordNewsletterForm--{{ section.id }}">
                  Email Address
                </label>
                {%- capture subscribe_icon -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                {%- endcapture -%}
                {% render 'global-btn-2',
                  type: 'submit',
                  variant: 'secondary',
                  class: 'newsletter-submit-btn',
                  icon: subscribe_icon,
                  icon_only: true,
                  fit_width: false,
                  border_radius: '50%'
                %}
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="PasswordNewsletter-error--{{ section.id }}">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </small>
              {%- endif -%}
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

      <div class="password-login-trigger">
        {% render 'global-btn',
          text: 'ENTER USING PASSWORD',
          type: 'button',
          variant: 'secondary',
          class: 'password-trigger-btn',
          fit_width: true,
          attributes: 'onclick="window.PasswordModal.open()"'
        %}
      </div>

      {%- if section.settings.footer_text != blank -%}
        <div class="password-footer-text">
          {{ section.settings.footer_text }}
        </div>
      {%- endif -%}
      <div class="password-admin-link">
        <small class="password__footer-login password__footer-text">
          {{- 'general.password_page.admin_link_html' | t -}}
        </small>
      </div>
    </div>
  </div>

  <div id="PasswordModal" class="password-modal hidden">
    <div class="password-modal-content color-{{ section.settings.color_scheme }} gradient">
      <div class="password-modal-header">
        <h2 class="password-modal-heading">
          Enter Password To<br>
          Get The First Look
        </h2>
      </div>

      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}
          <div id="PasswordLoginForm-password-error" role="status" class="password-error-message">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="form__message">{{ 'general.password_page.login_form_error' | t }}</span>
          </div>
        {%- endif -%}
        <div class="password-field field{% if form.errors %} password-field--error{% endif %}">
          <input
            type="password"
            name="password"
            id="Password"
            class="field__input"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {%- endif -%}
            placeholder="Enter Password"
          >
          <button type="button" class="password-toggle-btn" onclick="window.PasswordModal.toggleVisibility()">
            {%- if section.settings.password_icon_image != blank -%}
              {{
                section.settings.password_icon_image
                | image_url: width: 48
                | image_tag: class: 'password-toggle-icon', loading: 'lazy', alt: ''
              }}
            {%- elsif section.settings.password_icon == 'eye' -%}
              {%- render 'icon-accordion', icon: 'eye' -%}
            {%- elsif section.settings.password_icon == 'lock' -%}
              {%- render 'icon-accordion', icon: 'lock' -%}
            {%- else -%}
              <svg
                class="icon icon-eye"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
              </svg>
            {%- endif -%}
          </button>
          <label class="field__label visually-hidden" for="Password">Enter Password</label>
        </div>
        <button name="commit" class="password-button share-story-submit">
          <span class="submit-button__shadow"></span>
          <span class="submit-button__content">Unlock</span>
        </button>
      {%- endform -%}
    </div>
    <div class="password-modal-backdrop" onclick="window.PasswordModal.close()"></div>
  </div>
</div>

