      "label": "Desktop Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_font_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Typography: Subheading / Footer"
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "subheading_font_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Typography: Inputs & Buttons"
    },
    {
      "type": "range",
      "id": "input_font_size_desktop",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_font_size_mobile",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_font_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Typography: Modal Heading"
    },
    {
      "type": "range",
      "id": "modal_heading_font_size_desktop",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "modal_heading_font_size_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 32
