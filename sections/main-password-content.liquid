{{ 'section-password-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-content.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .password-content-section {
    --logo-width: {{ section.settings.logo_width }}px;
    --input-border-radius: {{ section.settings.input_border_radius }}px;
    --button-border-radius: {{ section.settings.button_border_radius }}px;
    --modal-border-radius: {{ section.settings.modal_border_radius }}px;

    /* Layout Gaps */
    --section-gap-desktop: {{ section.settings.desktop_gap }}px;
    --section-gap-mobile: {{ section.settings.mobile_gap }}px;

    /* Typography */
    /* Main Heading */
    --heading-font-size-desktop: {{ section.settings.heading_font_size_desktop }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    /* Subheading / Footer */
    --subheading-font-size-desktop: {{ section.settings.subheading_font_size_desktop }}px;
    --subheading-font-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
    --subheading-font-weight: {{ section.settings.subheading_font_weight }};

    /* Input / Button */
    --input-font-size-desktop: {{ section.settings.input_font_size_desktop }}px;
    --input-font-size-mobile: {{ section.settings.input_font_size_mobile }}px;
    --input-font-weight: {{ section.settings.input_font_weight }};

    /* Modal Heading */
    --modal-heading-font-size-desktop: {{ section.settings.modal_heading_font_size_desktop }}px;
    --modal-heading-font-size-mobile: {{ section.settings.modal_heading_font_size_mobile }}px;
    --modal-heading-font-weight: {{ section.settings.modal_heading_font_weight }};
  }

  .field__input, .password-modal .field { border-radius: var(--input-border-radius); }
  .submit-button__content, .submit-button__shadow { border-radius: var(--button-border-radius); }
  .password-modal-content { border-radius: var(--modal-border-radius); }

  .newsletter-input-shadow { border-radius: var(--input-border-radius); }

  .password-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--section-gap-desktop);
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .password-page {
      gap: var(--section-gap-mobile);
    }
  }
{%- endstyle -%}

<div class="password-content-section color-{{ section.settings.color_scheme }}">
  <div class="password-page">
    <div class="password-logo-container">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo.width
          | image_tag: class: 'password-logo', loading: 'eager', width: section.settings.logo_width
        }}
      {%- else -%}
        <h1 class="h2 password-logo-text">{{ shop.name }}</h1>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="password-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.show_countdown -%}
      {%- capture target_date -%}{{ section.settings.year }}-{{ section.settings.month | prepend: '0' | slice: -2, 2 }}-{{ section.settings.day | prepend: '0' | slice: -2, 2 }}T{{ section.settings.hour | prepend: '0' | slice: -2, 2 }}:{{ section.settings.minute | prepend: '0' | slice: -2, 2 }}:00{%- endcapture -%}
      <div
        class="password-countdown"
        data-date="{{ target_date }}"
      >
        <div class="countdown-block">
          <span class="countdown-number" data-days>00</span>
          <span class="countdown-label">DAYS</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-block">
          <span class="countdown-number" data-hours>00</span>
          <span class="countdown-label">HOURS</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-block">
          <span class="countdown-number" data-minutes>00</span>
          <span class="countdown-label">MINUTES</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-block">
          <span class="countdown-number" data-seconds>00</span>
          <span class="countdown-label">SECONDS</span>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="password-newsletter">
        {% form 'customer', class: 'password-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{ 'newsletter.success' | t }}
            </div>
          {%- else -%}
            <div class="field">
              <div class="newsletter-input-wrapper">
                <span class="newsletter-input-shadow"></span>
                <input
                  id="PasswordNewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input newsletter-input-content"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="PasswordNewsletter-error--{{ section.id }}"
                  {% endif %}
                  placeholder="Email Address"
                  required
                >
              </div>
              <label class="field__label visually-hidden" for="PasswordNewsletterForm--{{ section.id }}">
                Email Address
              </label>
              <button
                type="submit"
                class="newsletter-submit-btn share-story-submit"
                name="commit"
              >
                <span class="submit-button__shadow"></span>
                <span class="submit-button__content">Subscribe</span>
              </button>
            </div>
            {%- if form.errors -%}
              <small class="newsletter-form__message form__message" id="PasswordNewsletter-error--{{ section.id }}">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </small>
            {%- endif -%}
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}

    <div class="password-login-trigger">
      <button class="password-trigger-btn share-story-submit" onclick="window.PasswordModal.open()">
        <span class="submit-button__shadow"></span>
        <span class="submit-button__content">ENTER USING PASSWORD</span>
      </button>
    </div>

    {%- if section.settings.footer_text != blank -%}
      <div class="password-footer-text">
        {{ section.settings.footer_text }}
      </div>
    {%- endif -%}
    <div class="password-admin-link">
      <small class="password__footer-login password__footer-text">
        {{- 'general.password_page.admin_link_html' | t -}}
      </small>
    </div>
  </div>

  <div id="PasswordModal" class="password-modal hidden">
    <div class="password-modal-content color-{{ section.settings.color_scheme }} gradient">
      <div class="password-modal-header">
        <h2 class="password-modal-heading">
          Enter Password To<br>
          Get The First Look
        </h2>
      </div>

      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}
          <div id="PasswordLoginForm-password-error" role="status" class="password-error-message">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="form__message">{{ 'general.password_page.login_form_error' | t }}</span>
          </div>
        {%- endif -%}
        <div class="password-field field{% if form.errors %} password-field--error{% endif %}">
          <input
            type="password"
            name="password"
            id="Password"
            class="field__input"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {%- endif -%}
            placeholder="Enter Password"
          >
          <button type="button" class="password-toggle-btn" onclick="window.PasswordModal.toggleVisibility()">
            <svg
              class="icon icon-eye"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
          <label class="field__label visually-hidden" for="Password">Enter Password</label>
        </div>
        <button name="commit" class="password-button share-story-submit">
          <span class="submit-button__shadow"></span>
          <span class="submit-button__content">Unlock</span>
        </button>
      {%- endform -%}
    </div>
    <div class="password-modal-backdrop" onclick="window.PasswordModal.close()"></div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Vertical Gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Vertical Gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 150
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OPENING SOON"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "BE THE FIRST TO KNOW WHEN WE LAUNCH."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter",
      "default": true
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show Countdown",
      "default": true
    },
    {
      "type": "number",
      "id": "year",
      "label": "Year",
      "default": 2026
    },
    {
      "type": "select",
      "id": "month",
      "label": "Month",
      "options": [
        { "value": "1", "label": "January" },
        { "value": "2", "label": "February" },
        { "value": "3", "label": "March" },
        { "value": "4", "label": "April" },
        { "value": "5", "label": "May" },
        { "value": "6", "label": "June" },
        { "value": "7", "label": "July" },
        { "value": "8", "label": "August" },
        { "value": "9", "label": "September" },
        { "value": "10", "label": "October" },
        { "value": "11", "label": "November" },
        { "value": "12", "label": "December" }
      ],
      "default": "1"
    },
    {
      "type": "number",
      "id": "day",
      "label": "Day",
      "default": 1,
      "info": "1-31"
    },
    {
      "type": "range",
      "id": "hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "label": "Hour (0-23)",
      "default": 0
    },
    {
      "type": "range",
      "id": "minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "label": "Minute (0-59)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Customization"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Input Box Border Radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "modal_border_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Modal Border Radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography: Main Heading"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 24,
      "max": 100,
      "step": 1,
