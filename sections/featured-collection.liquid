{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'section-featured-collection.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} .fc3d-card .custom-product-card .share-story-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg, #365330);
    color: white;
    border: 2px solid var(--color-primary-button-border, #365330);
    padding: 16px 20px;
    border-radius: var(--card-hover-button-border-radius, 12px);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    box-shadow: 0 4px 0 0 var(--color-shadow, rgba(0,0,0,0.15));
    transition: all 0.2s ease;
    margin-top: 8px;
    text-transform: none;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .fc3d-card .custom-product-card .share-story-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 0 var(--color-shadow, rgba(0,0,0,0.15));
  }
{%- endstyle -%}

{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections | first
  endif
  assign products_to_show = section.settings.products_to_show | default: 9
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign background_image = section.settings.background_image
  assign background_image_url = background_image | image_url: width: 2000
-%}

<section
  class="fc3d color-{{ scheme.id }}{% if background_image != blank %} fc3d--has-background{% endif %}"
  data-fc3d-section
  data-section-id="{{ section.id }}"
  style="{% if background_image != blank %}background-image: url('{{ background_image_url }}'); background-size: {{ section.settings.background_image_size }}; background-position: {{ section.settings.background_image_position }}; background-repeat: {{ section.settings.background_image_repeat }};{% else %}background-color: {{ scheme.settings.background }};{% endif %} color: {{ scheme.settings.text }};"
>
  <div class="fc3d__container">
    <div class="fc3d__header">
      {%- if section.settings.title != blank -%}
        <h2 class="fc3d__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.show_shop_all and featured_collection != blank and featured_collection.url != blank -%}
        {%- render 'submit-button',
          text: section.settings.shop_all_label | default: 'Shop all',
          url: section.settings.shop_all_link | default: featured_collection.url,
          class: 'fc3d__shop-all'
        -%}
      {%- endif -%}
    </div>

    <div class="fc3d__viewport" data-fc3d-viewport>
      <div class="fc3d__rail" data-fc3d-rail role="list">
        {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
          {%- comment -%} First set: custom product cards {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            <div class="fc3d-card fc3d-card--custom" data-fc3d-card role="listitem">
              <div class="fc3d-card__custom">
                {%-
                  render 'card-product',
                  card_product: product,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  lazy_load: forloop.index > 3,
                  show_badge: section.settings.show_card_badge,
                  badge_text: section.settings.card_badge_text,
                  overlay_button_text: section.settings.overlay_button_text,
                  fallback_description: section.settings.fallback_description
                -%}
              </div>
            </div>
          {%- endfor -%}
          {%- comment -%} Duplicate set for infinite loop {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            <div class="fc3d-card fc3d-card--custom" data-fc3d-card data-fc3d-card-clone role="listitem">
              <div class="fc3d-card__custom">
                {%-
                  render 'card-product',
                  card_product: product,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  lazy_load: true,
                  show_badge: section.settings.show_card_badge,
                  badge_text: section.settings.card_badge_text,
                  overlay_button_text: section.settings.overlay_button_text,
                  fallback_description: section.settings.fallback_description
                -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Placeholder when no collection or no products {%- endcomment -%}
          {%- for i in (1..products_to_show) -%}
            <div class="fc3d-card fc3d-card--custom fc3d-card--placeholder" data-fc3d-card role="listitem">
              <div class="fc3d-card__custom">
                <div class="fc3d-card__placeholder">
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'fc3d-card__placeholder-svg' }}
                  <div class="fc3d-card__placeholder-title">Product {{ i }}</div>
                  <p class="fc3d-card__placeholder-text">Add a collection in the section settings. By default the first collection is used.</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
          {%- for i in (1..products_to_show) -%}
            <div class="fc3d-card fc3d-card--custom fc3d-card--placeholder" data-fc3d-card data-fc3d-card-clone role="listitem">
              <div class="fc3d-card__custom">
                <div class="fc3d-card__placeholder">
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'fc3d-card__placeholder-svg' }}
                  <div class="fc3d-card__placeholder-title">Product {{ i }}</div>
                  <p class="fc3d-card__placeholder-text">Add a collection in the section settings. By default the first collection is used.</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="fc3d__controls" style="gap: {{ section.settings.nav_button_spacing | default: 16 }}px;">
      <button 
        class="fc3d__nav fc3d__nav--prev" 
        type="button" 
        data-fc3d-prev 
        aria-label="Previous"
        style="
          width: {{ section.settings.nav_button_width | default: 64 }}px;
          height: {{ section.settings.nav_button_height | default: 56 }}px;
          padding: {{ section.settings.nav_button_padding | default: 0 }}px;
          font-size: {{ section.settings.nav_button_font_size | default: 24 }}px;
          {% if section.settings.nav_button_prev_image != blank %}
            background-image: url('{{ section.settings.nav_button_prev_image | image_url: width: 200 }}');
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
          {% endif %}
        "
      >
        {% if section.settings.nav_button_prev_image == blank %}
          <span aria-hidden="true" style="font-size: {{ section.settings.nav_button_font_size | default: 24 }}px;">←</span>
        {% endif %}
      </button>
      <button 
        class="fc3d__nav fc3d__nav--next" 
        type="button" 
        data-fc3d-next 
        aria-label="Next"
        style="
          width: {{ section.settings.nav_button_width | default: 64 }}px;
          height: {{ section.settings.nav_button_height | default: 56 }}px;
          padding: {{ section.settings.nav_button_padding | default: 0 }}px;
          font-size: {{ section.settings.nav_button_font_size | default: 24 }}px;
          {% if section.settings.nav_button_next_image != blank %}
            background-image: url('{{ section.settings.nav_button_next_image | image_url: width: 200 }}');
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
          {% endif %}
        "
      >
        {% if section.settings.nav_button_next_image == blank %}
          <span aria-hidden="true" style="font-size: {{ section.settings.nav_button_font_size | default: 24 }}px;">→</span>
        {% endif %}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to use the first collection in your store."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 9,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop all link",
      "default": true
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link",
      "info": "Optional. When set, used for the Shop all button. Otherwise uses the collection URL."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_card_badge",
      "label": "Show badge on cards",
      "default": false
    },
    {
      "type": "text",
      "id": "card_badge_text",
      "label": "Badge text",
      "info": "Shown on all cards when badge is enabled"
    },
    {
      "type": "text",
      "id": "overlay_button_text",
      "label": "Overlay button text",
      "default": "Love that! (Check it out)"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "info": "Used when a product has no description"
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Background image size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "Background image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "top left",
          "label": "Top left"
        },
        {
          "value": "top right",
          "label": "Top right"
        },
        {
          "value": "bottom left",
          "label": "Bottom left"
        },
        {
          "value": "bottom right",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_image_repeat",
      "label": "Background image repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
          "label": "Repeat horizontally"
        },
        {
          "value": "repeat-y",
          "label": "Repeat vertically"
        }
      ],
      "default": "no-repeat"
    },
    {
      "type": "header",
      "content": "Navigation Buttons"
    },
    {
      "type": "range",
      "id": "nav_button_spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Button spacing",
      "default": 16,
      "info": "Space between previous and next buttons"
    },
    {
      "type": "range",
      "id": "nav_button_width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Button width",
      "default": 64
    },
    {
      "type": "range",
      "id": "nav_button_height",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Button height",
      "default": 56
    },
    {
      "type": "range",
      "id": "nav_button_padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button padding",
      "default": 0,
      "info": "Internal padding inside the button"
    },
    {
      "type": "range",
      "id": "nav_button_font_size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 24,
      "info": "Font size for arrow icons (if not using custom images)"
    },
    {
      "type": "image_picker",
      "id": "nav_button_prev_image",
      "label": "Previous button image",
      "info": "Upload a custom image for the previous button. If not set, default arrow will be used."
    },
    {
      "type": "image_picker",
      "id": "nav_button_next_image",
      "label": "Next button image",
      "info": "Upload a custom image for the next button. If not set, default arrow will be used."
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
