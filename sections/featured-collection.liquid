{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-featured-collection.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 9
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign background_image = section.settings.background_image
  assign background_image_url = background_image | image_url: width: 2000
-%}

<section
  class="fc3d color-{{ scheme.id }}{% if background_image != blank %} fc3d--has-background{% endif %}"
  data-fc3d-section
  data-section-id="{{ section.id }}"
  style="{% if background_image != blank %}background-image: url('{{ background_image_url }}'); background-size: {{ section.settings.background_image_size }}; background-position: {{ section.settings.background_image_position }}; background-repeat: {{ section.settings.background_image_repeat }};{% else %}background-color: {{ scheme.settings.background }};{% endif %} color: {{ scheme.settings.text }};"
>
  <div class="fc3d__container">
    <div class="fc3d__header">
      {%- if section.settings.title != blank -%}
        <h2 class="fc3d__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.show_shop_all and featured_collection != blank and featured_collection.url != blank -%}
        {%- render 'primary-button',
          text: section.settings.shop_all_label | default: 'Shop all',
          link: featured_collection.url,
          class: 'fc3d__shop-all'
        -%}
      {%- endif -%}
    </div>

    <div class="fc3d__viewport" data-fc3d-viewport>
      <div class="fc3d__rail" data-fc3d-rail role="list">
        {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
          {%- comment -%} First set of cards {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            {%- assign product_image = product.featured_image | default: product.images.first -%}
            {%- assign image_url = product_image | image_url: width: 800 -%}
            <div class="fc3d-card" data-fc3d-card role="listitem">
              <div class="fc3d-card__inner">
                <div class="fc3d-card__face fc3d-card__face--front">
                  <a
                    class="fc3d-card__link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                    {%- if image_url != blank -%}
                      style="background-image: url('{{ image_url }}');"
                    {%- endif -%}
                  >
                    <!-- Main content -->
                    <div class="fc3d-card__content">
                      <div class="fc3d-card__title">{{ product.title }}</div>
                    </div>
                  </a>
                </div>

                <div class="fc3d-card__face fc3d-card__face--back">
                  <a
                    class="fc3d-card__link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                    {%- if image_url != blank -%}
                      style="background-image: url('{{ image_url }}');"
                    {%- endif -%}
                  >
                    <div class="fc3d-card__back-content">
                      <div class="fc3d-card__back-title">{{ product.title }}</div>
                      <div class="fc3d-card__back-price">{{ product.price | money }}</div>
                      {%- if product.description != blank -%}
                        <div class="fc3d-card__back-text">{{ product.description | strip_html | truncate: 120 }}</div>
                      {%- endif -%}
                      <div class="fc3d-card__back-cta">View product</div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          {%- endfor -%}
          {%- comment -%} Duplicate set for infinite loop {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            {%- assign product_image = product.featured_image | default: product.images.first -%}
            {%- assign image_url = product_image | image_url: width: 800 -%}
            <div class="fc3d-card" data-fc3d-card data-fc3d-card-clone role="listitem">
              <div class="fc3d-card__inner">
                <div class="fc3d-card__face fc3d-card__face--front">
                  <a
                    class="fc3d-card__link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                    {%- if image_url != blank -%}
                      style="background-image: url('{{ image_url }}');"
                    {%- endif -%}
                  >
                    <!-- Main content -->
                    <div class="fc3d-card__content">
                      <div class="fc3d-card__title">{{ product.title }}</div>
                    </div>
                  </a>
                </div>

                <div class="fc3d-card__face fc3d-card__face--back">
                  <a
                    class="fc3d-card__link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                    {%- if image_url != blank -%}
                      style="background-image: url('{{ image_url }}');"
                    {%- endif -%}
                  >
                    <div class="fc3d-card__back-content">
                      <div class="fc3d-card__back-title">{{ product.title }}</div>
                      <div class="fc3d-card__back-price">{{ product.price | money }}</div>
                      {%- if product.description != blank -%}
                        <div class="fc3d-card__back-text">{{ product.description | strip_html | truncate: 120 }}</div>
                      {%- endif -%}
                      <div class="fc3d-card__back-cta">View product</div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} First set of placeholder cards {%- endcomment -%}
          {%- for i in (1..products_to_show) -%}
            {%- assign placeholder_title = 'Name of the product' -%}
            <div class="fc3d-card" data-fc3d-card role="listitem">
              <div class="fc3d-card__inner">
                <div class="fc3d-card__face fc3d-card__face--front">
                  <div class="fc3d-card__link" role="link" aria-label="Placeholder product">
                    <!-- Main content -->
                    <div class="fc3d-card__content">
                      <div class="fc3d-card__title">{{ placeholder_title }}</div>
                    </div>
                  </div>
                </div>

                <div class="fc3d-card__face fc3d-card__face--back">
                  <div class="fc3d-card__link" role="link" aria-label="Placeholder product">
                    <div class="fc3d-card__back-content">
                      <div class="fc3d-card__back-title">Back side content</div>
                      <div class="fc3d-card__back-text">
                        Add a collection in the section settings to show real products.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
          {%- comment -%} Duplicate set for infinite loop {%- endcomment -%}
          {%- for i in (1..products_to_show) -%}
            {%- assign placeholder_title = 'Name of the product' -%}
            <div class="fc3d-card" data-fc3d-card data-fc3d-card-clone role="listitem">
              <div class="fc3d-card__inner">
                <div class="fc3d-card__face fc3d-card__face--front">
                  <div class="fc3d-card__link" role="link" aria-label="Placeholder product">
                    <!-- Main content -->
                    <div class="fc3d-card__content">
                      <div class="fc3d-card__title">{{ placeholder_title }}</div>
                    </div>
                  </div>
                </div>

                <div class="fc3d-card__face fc3d-card__face--back">
                  <div class="fc3d-card__link" role="link" aria-label="Placeholder product">
                    <div class="fc3d-card__back-content">
                      <div class="fc3d-card__back-title">Back side content</div>
                      <div class="fc3d-card__back-text">
                        Add a collection in the section settings to show real products.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="fc3d__controls">
      <button class="fc3d__nav fc3d__nav--prev" type="button" data-fc3d-prev aria-label="Previous">
        <span aria-hidden="true">←</span>
      </button>
      <button class="fc3d__nav fc3d__nav--next" type="button" data-fc3d-next aria-label="Next">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 9,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop all link",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Background image size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "Background image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "top left",
          "label": "Top left"
        },
        {
          "value": "top right",
          "label": "Top right"
        },
        {
          "value": "bottom left",
          "label": "Bottom left"
        },
        {
          "value": "bottom right",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_image_repeat",
      "label": "Background image repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
          "label": "Repeat horizontally"
        },
        {
          "value": "repeat-y",
          "label": "Repeat vertically"
        }
      ],
      "default": "no-repeat"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
