{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-featured-collection.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  /* Featured collection cards: use global product card settings (match product grid) */
  #shopify-section-{{ section.id }} .custom-product-card {
    --card-padding-top: 0px;
    --card-padding-horizontal: 20px;
    --card-padding-bottom: 20px;
    --card-text-align: center;
    --card-align-items: center;
    --card-image-height: 300px;
    --card-image-margin-bottom: 16px;
    --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size | default: 14 }}px;
    --card-hover-description-font-weight: {{ settings.product_card_hover_description_font_weight | default: 400 }};
    --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size | default: 12 }}px;
    --card-hover-button-font-weight: {{ settings.product_card_hover_button_font_weight | default: 600 }};
    --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical | default: 10 }}px;
    --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal | default: 20 }}px;
    --card-hover-content-gap: {{ settings.product_card_hover_content_gap | default: 10 }}px;
    --card-hover-button-border-radius: {{ settings.product_card_hover_button_border_radius | default: 20 }}px;
    --card-price-button-border-radius: {{ settings.product_card_price_button_border_radius | default: 12 }}px;
    --card-price-font-size: {{ settings.product_card_price_font_size | default: 16 }}px;
    --card-price-font-weight: {{ settings.product_card_price_font_weight | default: 700 }};
    --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical | default: 10 }}px;
    --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal | default: 18 }}px;
    --card-price-border-width: {{ settings.product_card_price_border_width | default: 1 }}px;
    --card-price-border-radius: {{ settings.product_card_price_border_radius | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .custom-product-card__title {
    font-size: {{ settings.product_card_title_font_size | default: 24 }}px !important;
    font-weight: {{ settings.product_card_title_font_weight | default: 900 }};
    line-height: {{ settings.product_card_title_line_height | default: 1 }};
    margin-top: {{ settings.product_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_title_margin_bottom | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .custom-product-card__description {
    font-size: {{ settings.product_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_description_font_weight | default: 400 }};
    line-height: {{ settings.product_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.product_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_description_margin_bottom | default: 0 }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-product-card {
      --card-padding-top: 10px;
      --card-padding-horizontal: 16px;
      --card-padding-bottom: 28px;
      --card-image-height: 300px;
      --card-image-margin-bottom: 16px;
      --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size_mobile | default: 12 }}px;
      --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size_mobile | default: 12 }}px;
      --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical_mobile | default: 8 }}px;
      --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal_mobile | default: 16 }}px;
      --card-hover-content-gap: {{ settings.product_card_hover_content_gap_mobile | default: 8 }}px;
      --card-price-font-size: {{ settings.product_card_price_font_size_mobile | default: 14 }}px;
      --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical_mobile | default: 8 }}px;
      --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal_mobile | default: 14 }}px;
    }

    #shopify-section-{{ section.id }} .custom-product-card__title {
      font-size: {{ settings.product_card_title_font_size_mobile | default: 24 }}px !important;
      line-height: {{ settings.product_card_title_line_height | default: 1 }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections | first
  endif
  assign products_to_show = section.settings.products_to_show | default: 9
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign background_image = section.settings.background_image
  assign background_image_url = background_image | image_url: width: 2000
-%}

<section
  class="fc3d color-{{ scheme.id }}{% if background_image != blank %} fc3d--has-background{% endif %}"
  data-fc3d-section
  data-section-id="{{ section.id }}"
  style="{% if background_image != blank %}background-image: url('{{ background_image_url }}'); background-size: {{ section.settings.background_image_size }}; background-position: {{ section.settings.background_image_position }}; background-repeat: {{ section.settings.background_image_repeat }};{% else %}background-color: {{ scheme.settings.background }};{% endif %} color: {{ scheme.settings.text }};"
>
  <div class="fc3d__container">
    <div class="fc3d__header">
      {%- if section.settings.title != blank -%}
        <h2 class="fc3d__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.show_shop_all and featured_collection != blank and featured_collection.url != blank -%}
        {%-
          render 'global-btn',
          text: section.settings.shop_all_label | default: 'Shop all',
          url: section.settings.shop_all_link | default: featured_collection.url,
          fit_width: false,
          class: 'fc3d__shop-all'
        -%}
      {%- endif -%}
    </div>

    <div class="fc3d__viewport" data-fc3d-viewport>
      <div class="fc3d__rail" data-fc3d-rail role="list">
        {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
          {%- comment -%} First set: custom product cards {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            <div class="fc3d-card fc3d-card--custom" data-fc3d-card role="listitem">
              <div class="fc3d-card__custom">
                {%-
                  render 'card-product',
                  card_product: product,
                  section_id: section.id,
                  quick_add: 'none',
                  lazy_load: forloop.index > 3
                -%}
              </div>
            </div>
          {%- endfor -%}
          {%- comment -%} Duplicate set for infinite loop {%- endcomment -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            <div class="fc3d-card fc3d-card--custom" data-fc3d-card data-fc3d-card-clone role="listitem">
              <div class="fc3d-card__custom">
                {%- render 'card-product',
                  card_product: product,
                  section_id: section.id,
                  quick_add: 'none',
                  lazy_load: true
                -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default placeholder cards using card-product snippet with dummy data {%- endcomment -%}
          {%- assign placeholder_description_text = 'sections.featured_collection.placeholder_description' | t | default: 'Add a collection in the section settings. By default the first collection is used.' -%}
          {%- for i in (1..products_to_show) -%}
            <div class="fc3d-card fc3d-card--custom fc3d-card--placeholder" data-fc3d-card role="listitem">
              <div class="fc3d-card__custom">
                {%- capture placeholder_card_title -%}{{ 'sections.featured_collection.placeholder_title' | t | default: 'Product' }} {{ i }}{%- endcapture -%}
                {%- render 'card-product',
                  card_product: nil,
                  placeholder_title: placeholder_card_title,
                  placeholder_description: placeholder_description_text,
                  section_id: section.id,
                  quick_add: 'none',
                  lazy_load: forloop.index > 3,
                  show_badge: false,
                  fallback_description: placeholder_description_text
                -%}
              </div>
            </div>
          {%- endfor -%}
          {%- for i in (1..products_to_show) -%}
            <div
              class="fc3d-card fc3d-card--custom fc3d-card--placeholder"
              data-fc3d-card
              data-fc3d-card-clone
              role="listitem"
            >
              <div class="fc3d-card__custom">
                {%- capture placeholder_card_title -%}{{ 'sections.featured_collection.placeholder_title' | t | default: 'Product' }} {{ i }}{%- endcapture -%}
                {%- render 'card-product',
                  card_product: nil,
                  placeholder_title: placeholder_card_title,
                  placeholder_description: placeholder_description_text,
                  section_id: section.id,
                  quick_add: 'none',
                  lazy_load: true,
                  show_badge: false,
                  fallback_description: placeholder_description_text
                -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="fc3d__controls" style="gap: {{ section.settings.nav_button_spacing | default: 16 }}px;">
      {% render 'global-btn-2',
        text: '←',
        type: 'button',
        fit_width: false,
        class: 'fc3d__nav fc3d__nav--prev',
        attributes: 'data-fc3d-prev aria-label="Previous"'
      %}
      {% render 'global-btn-2',
        text: '→',
        type: 'button',
        fit_width: false,
        class: 'fc3d__nav fc3d__nav--next',
        attributes: 'data-fc3d-next aria-label="Next"'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "default": "scheme-4",
      "info": "When the theme toggle is in dark mode, use this scheme for this section."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to use the first collection in your store."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 9,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop all link",
      "default": true
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link",
      "info": "Optional. When set, used for the Shop all button. Otherwise uses the collection URL."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "header",
      "content": "Cards · Content & text"
    },
    {
      "type": "checkbox",
      "id": "show_card_badge",
      "label": "Show badge on cards",
      "default": false
    },
    {
      "type": "text",
      "id": "card_badge_text",
      "label": "Badge text",
      "info": "Shown on all cards when badge is enabled"
    },
    {
      "type": "text",
      "id": "overlay_button_text",
      "label": "Overlay button text",
      "default": "Check it out"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "info": "Used when a product has no description"
    },
    {
      "type": "header",
      "content": "Section · Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Background image size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "Background image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "top left",
          "label": "Top left"
        },
        {
          "value": "top right",
          "label": "Top right"
        },
        {
          "value": "bottom left",
          "label": "Bottom left"
        },
        {
          "value": "bottom right",
          "label": "Bottom right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_image_repeat",
      "label": "Background image repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
          "label": "Repeat horizontally"
        },
        {
          "value": "repeat-y",
          "label": "Repeat vertically"
        }
      ],
      "default": "no-repeat"
    },
    {
      "type": "header",
      "content": "Carousel · Navigation buttons"
    },
    {
      "type": "range",
      "id": "nav_button_spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Button spacing",
      "default": 16,
      "info": "Space between previous and next buttons"
    },
    {
      "type": "range",
      "id": "nav_button_width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Button width",
      "default": 64
    },
    {
      "type": "range",
      "id": "nav_button_height",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Button height",
      "default": 56
    },
    {
      "type": "range",
      "id": "nav_button_padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button padding",
      "default": 0,
      "info": "Internal padding inside the button"
    },
    {
      "type": "range",
      "id": "nav_button_font_size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 24,
      "info": "Font size for arrow icons (if not using custom images)"
    },
    {
      "type": "image_picker",
      "id": "nav_button_prev_image",
      "label": "Previous button image",
      "info": "Upload a custom image for the previous button. If not set, default arrow will be used."
    },
    {
      "type": "image_picker",
      "id": "nav_button_next_image",
      "label": "Next button image",
      "info": "Upload a custom image for the next button. If not set, default arrow will be used."
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
