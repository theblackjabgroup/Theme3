{{ 'section-related-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .related-products {
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px;
    --margin-horizontal: {{ section.settings.margin_horizontal }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .related-products {
      --margin-top: {{ section.settings.margin_top_mobile }}px;
      --margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      --margin-horizontal: {{ section.settings.margin_horizontal_mobile }}px;
    }
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  #related-products-{{ section.id }} .custom-product-card {
    --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size | default: 14 }}px;
    --card-hover-description-font-weight: {{ settings.product_card_hover_description_font_weight | default: 400 }};
    --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size | default: 12 }}px;
    --card-hover-button-font-weight: {{ settings.product_card_hover_button_font_weight | default: 600 }};
    --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical | default: 10 }}px;
    --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal | default: 20 }}px;
    --card-hover-content-gap: {{ settings.product_card_hover_content_gap | default: 10 }}px;
    --card-hover-button-border-radius: {{ settings.product_card_hover_button_border_radius | default: 20 }}px;
    --card-price-button-border-radius: {{ settings.product_card_price_button_border_radius | default: 12 }}px;
    --card-price-font-size: {{ settings.product_card_price_font_size | default: 16 }}px;
    --card-price-font-weight: {{ settings.product_card_price_font_weight | default: 700 }};
    --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical | default: 10 }}px;
    --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal | default: 18 }}px;
    --card-price-border-width: {{ settings.product_card_price_border_width | default: 1 }}px;
    --card-price-border-radius: {{ settings.product_card_price_border_radius | default: 12 }}px;
  }

  #related-products-{{ section.id }} .custom-product-card__title {
    font-size: {{ settings.product_card_title_font_size | default: 24 }}px !important;
    font-weight: {{ settings.product_card_title_font_weight | default: 900 }};
    line-height: {{ settings.product_card_title_line_height | default: 1 }};
    margin-top: {{ settings.product_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_title_margin_bottom | default: 12 }}px;
  }

  #related-products-{{ section.id }} .custom-product-card__badge {
    font-size: {{ settings.product_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_badge_font_weight | default: 700 }};
    padding: {{ settings.product_card_badge_padding_vertical | default: 4 }}px {{ settings.product_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.product_card_badge_margin_bottom | default: 10 }}px;
  }
{%- endstyle -%}

<div class="related-products color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="">
    {%- liquid
      assign header_button_text = ''
      assign header_button_link = ''
      for block in section.blocks
        if block.type == 'header'
          assign header_button_text = block.settings.button_text
          assign header_button_link = block.settings.button_link
        endif
      endfor
    -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'header' -%}
          <div
            class="related-products-header-banner"
            {{ block.shopify_attributes }}
            style="background-color: var(--color-card-bg); border-radius: {{ block.settings.border_radius }}px;"
          >
            <div class="related-products-header-content">
              {%- if block.settings.heading != blank -%}
                <h2 class="related-products-header__title">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                {%- render 'global-btn',
                  text: block.settings.button_text,
                  url: block.settings.button_link,
                  variant: 'primary',
                  fit_width: false,
                  class: 'related-products-header__button related-products-header__button--desktop'
                -%}
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}

    <product-recommendations
      class="related-products-wrapper"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
    >
      {%- if recommendations.products_count > 0 -%}
        <div class="related-products-container">
          <div
            id="related-products-{{ section.id }}"
            data-id="{{ section.id }}"
          >
            {%- for product_item in recommendations.products limit: section.settings.products_to_show -%}
              <div class="grid__item">
                {%- render 'card-product',
                  card_product: product_item,
                  show_badge: section.settings.show_badge,
                  badge_text: section.settings.badge_text,
                  overlay_button_text: section.settings.overlay_button_text,
                  mobile_add_button_text: section.settings.mobile_add_button_text,
                  fallback_description: section.settings.fallback_description,
                  section_id: section.id,
                  lazy_load: true,
                  quick_add: 'standard',
                  quick_add_overlay: true
                -%}
              </div>
            {%- endfor -%}
          </div>

          <div class="scroll-nav">
            {%- capture prev_arrow_icon -%}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endcapture -%}
            {%- render 'global-btn',
              icon: prev_arrow_icon,
              icon_only: true,
              variant: 'primary',
              type: 'button',
              class: 'scroll-nav-button scroll-prev',
              attributes: 'aria-label="Previous products"',
              fit_width: false
            -%}
            {%- capture next_arrow_icon -%}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endcapture -%}
            {%- render 'global-btn',
              icon: next_arrow_icon,
              icon_only: true,
              variant: 'primary',
              type: 'button',
              class: 'scroll-nav-button scroll-next',
              attributes: 'aria-label="Next products"',
              fit_width: false
            -%}
          </div>
        </div>

        {%- if header_button_text != blank -%}
          {%- render 'global-btn',
            text: header_button_text,
            url: header_button_link,
            variant: 'primary',
            fit_width: false,
            class: 'related-products-header__button related-products-header__button--mobile'
          -%}
        {%- endif -%}
      {%- endif -%}
    </product-recommendations>
  </div>
</div>

<script>
  (function () {
    if (window.__relatedProductsQuickAddRegistered) return;
    window.__relatedProductsQuickAddRegistered = true;

    function handleQuickAddTrigger(e) {
      const trigger = e.target.closest('[data-quick-add-trigger]');
      if (!trigger) return;
      if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      e.stopPropagation();
      const targetId = trigger.getAttribute('data-quick-add-trigger');
      const target = targetId ? document.getElementById(targetId) : null;
      if (target) target.click();
    }
    document.addEventListener('click', handleQuickAddTrigger, true);
    document.addEventListener('keydown', handleQuickAddTrigger, true);
  })();
</script>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "header",
      "name": "Header",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "RELATED PRODUCTS"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "VIEW ALL"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Border Radius",
          "default": 12
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "MATCHA"
    },
    {
      "type": "text",
      "id": "overlay_button_text",
      "label": "Overlay Button Text (Desktop)",
      "default": "Love that! (Buy it)"
    },
    {
      "type": "text",
      "id": "mobile_add_button_text",
      "label": "Add to Cart Button Text (Mobile)",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "fallback_description",
      "label": "Fallback Description",
      "default": "Discover our amazing product.",
      "info": "This text will be displayed when a product has no description. Used in both card description and hover overlay."
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Margin (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Margin (Desktop)",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Margin (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Margin (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 40
    }
  ]
}
{% endschema %}
