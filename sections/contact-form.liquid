{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign contact_scheme_ref = section.settings.color_scheme
  assign contact_scheme_id = contact_scheme_ref.id | default: contact_scheme_ref | append: ''
  assign contact_scheme_obj = null
  for s in settings.color_schemes
    assign sid = s.id | append: ''
    if sid == contact_scheme_id or s.id == contact_scheme_ref
      assign contact_scheme_obj = s
      break
    endif
  endfor
  assign contact_dark_scheme_id = null
  assign contact_dark_scheme_obj = null
  if section.settings.dark_mode_color_scheme != blank
    assign contact_dark_ref = section.settings.dark_mode_color_scheme
    assign contact_dark_scheme_id = contact_dark_ref.id | default: contact_dark_ref | append: ''
    for s in settings.color_schemes
      assign sid = s.id | append: ''
      if sid == contact_dark_scheme_id or s.id == contact_dark_ref
        assign contact_dark_scheme_obj = s
        break
      endif
    endfor
  endif
-%}

{%- assign use_google_maps = false -%}
{%- if section.settings.map_provider == 'google' and section.settings.google_maps_api_key != blank -%}
  {%- assign use_google_maps = true -%}
{%- endif -%}
{%- capture newline -%}
{%- endcapture -%}
{%- assign map_address = section.settings.contact_address | strip | replace: newline, ', ' -%}


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .contact-page-{{ section.id }} {
    --contact-accent: var(--color-link);
    --contact-bg: var(--color-bg);
    --contact-left-card-bg: var(--color-bg);
    --contact-card-bg: var(--color-card-bg);
    --contact-text: var(--color-text);
    --contact-placeholder: {{ section.settings.placeholder_color | default: '#888' }};
    --contact-map-height-min: {{ section.settings.map_height_min | default: 260 }}px;
    --contact-card-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    --contact-card-padding: {{ section.settings.card_padding | default: 20 }}px;
    --contact-card-padding-mobile: {{ section.settings.card_padding_mobile | default: 16 }}px;
    --contact-form-card-padding: {{ section.settings.form_card_padding | default: 32 }}px;
    --contact-input-padding-y: {{ section.settings.input_padding_vertical | default: 14 }}px;
    --contact-input-padding-x: {{ section.settings.input_padding_horizontal | default: 18 }}px;
    --contact-detail-icon-size: {{ section.settings.detail_icon_size | default: 40 }}px;
    --contact-detail-icon-radius: {{ section.settings.detail_icon_radius | default: 14 }}px;
    --contact-form-field-gap: {{ section.settings.form_field_gap | default: 16 }}px;
    --contact-heading-size: {{ section.settings.heading_font_size | default: 22 }}px;
    --contact-body-size: {{ section.settings.body_font_size | default: 16 }}px;
    --contact-greeting-title-size: {{ section.settings.greeting_title_size | default: 28 }}px;
    --contact-greeting-subtitle-size: {{ section.settings.greeting_subtitle_size | default: 18 }}px;
    --contact-detail-text-size: {{ section.settings.detail_text_size | default: 15 }}px;
  }
{%- endstyle -%}

{%- comment -%} Contact: apply color scheme vars when theme toggle is active so section respects light/dark mode {%- endcomment -%}
{%- if contact_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .contact-page {
      --color-bg: {{ contact_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ contact_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ contact_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ contact_scheme_obj.settings.color_card_text | default: contact_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ contact_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ contact_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ contact_scheme_obj.settings.color_text }} !important;
      --color-link: {{ contact_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ contact_scheme_obj.settings.color_link_hover }} !important;
      --color-input-border: {{ contact_scheme_obj.settings.color_input_border }} !important;
      --color-btn-shadow: {{ contact_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}
{%- if contact_dark_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"][data-active-scheme="color-{{ contact_dark_scheme_id }}"] #shopify-section-{{ section.id }} .contact-page {
      --color-bg: {{ contact_dark_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ contact_dark_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ contact_dark_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ contact_dark_scheme_obj.settings.color_card_text | default: contact_dark_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ contact_dark_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ contact_dark_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ contact_dark_scheme_obj.settings.color_text }} !important;
      --color-link: {{ contact_dark_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ contact_dark_scheme_obj.settings.color_link_hover }} !important;
      --color-input-border: {{ contact_dark_scheme_obj.settings.color_input_border }} !important;
      --color-btn-shadow: {{ contact_dark_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}

<div class="contact-page contact-page-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="contact-page__inner ">
    <div class="contact-page__grid">
      {%- comment -%} Left: single card = Map (top, rounded top corners) + Contact details (bottom) {%- endcomment -%}
      <div class="contact-page__left">
        <div class="contact-page__left-card">
          {%- if map_address != blank -%}
            {%- if use_google_maps -%}
              <div
                class="contact-page__map contact-page__map--google contact-page__map-placeholder"
                id="contact-map-google-{{ section.id }}"
                data-address="{{ map_address | escape }}"
                data-api-key="{{ section.settings.google_maps_api_key | strip | escape }}"
                data-map-title="{{ 'sections.contact-form.map_title' | t | default: 'Location map' | escape }}"
              ></div>
            {%- else -%}
              <div
                id="contact-map-{{ section.id }}"
                class="contact-page__map"
                data-address="{{ map_address | escape }}"
                data-zoom="{{ section.settings.map_zoom | default: 13 }}"
              ></div>
            {%- endif -%}
          {%- else -%}
            <div class="contact-page__map contact-page__map--empty" aria-hidden="true">
              <p class="contact-page__map-empty-text">
                {{
                  'sections.contact-form.map_no_address'
                  | t
                  | default: 'Add your address in Contact details to show the map.'
                }}
              </p>
            </div>
          {%- endif -%}
          <div class="contact-page__details-wrap">
            {%- if section.settings.contact_email != blank -%}
              <div class="contact-page__detail">
                <span class="contact-page__detail-icon" aria-hidden="true">
                  {%- if section.settings.icon_email != blank -%}
                    <img
                      class="contact-page__detail-icon-img"
                      src="{{ section.settings.icon_email | image_url: width: 80 }}"
                      width="20"
                      height="20"
                      alt=""
                      loading="lazy"
                    >
                  {%- else -%}
                    {{- 'icon-send.svg' | inline_asset_content -}}
                  {%- endif -%}
                </span>
                <a href="mailto:{{ section.settings.contact_email | strip }}" class="contact-page__detail-text">
                  {{- section.settings.contact_email -}}
                </a>
              </div>
            {%- endif -%}
            {%- if section.settings.contact_phone != blank -%}
              <div class="contact-page__detail">
                <span class="contact-page__detail-icon" aria-hidden="true">
                  {%- if section.settings.icon_phone != blank -%}
                    <img
                      class="contact-page__detail-icon-img"
                      src="{{ section.settings.icon_phone | image_url: width: 80 }}"
                      width="20"
                      height="20"
                      alt=""
                      loading="lazy"
                    >
                  {%- else -%}
                    {{- 'icon-call.svg' | inline_asset_content -}}
                  {%- endif -%}
                </span>
                <a
                  href="tel:{{ section.settings.contact_phone | strip | replace: ' ', '' }}"
                  class="contact-page__detail-text"
                >
                  {{- section.settings.contact_phone -}}
                </a>
              </div>
            {%- endif -%}
            {%- if section.settings.contact_address != blank -%}
              <div class="contact-page__detail">
                <span class="contact-page__detail-icon" aria-hidden="true">
                  {%- if section.settings.icon_address != blank -%}
                    <img
                      class="contact-page__detail-icon-img"
                      src="{{ section.settings.icon_address | image_url: width: 80 }}"
                      width="20"
                      height="20"
                      alt=""
                      loading="lazy"
                    >
                  {%- else -%}
                    {{- 'icon-location.svg' | inline_asset_content -}}
                  {%- endif -%}
                </span>
                <span class="contact-page__detail-text contact-page__detail-text--multiline">
                  {{- section.settings.contact_address | newline_to_br -}}
                </span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Right: Form {%- endcomment -%}
      <div class="contact-page__right">
        <div class="contact-page__card contact-page__form-card">
          {%- if section.settings.greeting_title != blank or section.settings.greeting_subtitle != blank -%}
            <div class="contact-page__greeting">
              {%- if section.settings.greeting_title != blank -%}
                <h2 class="contact-page__greeting-title">{{ section.settings.greeting_title }}</h2>
              {%- endif -%}
              {%- if section.settings.greeting_subtitle != blank -%}
                <p class="contact-page__greeting-subtitle">{{ section.settings.greeting_subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- form 'contact', id: 'ContactForm', class: 'contact-page__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="contact-page__form-status contact-page__form-status--success" tabindex="-1" autofocus>
                {{- 'icon-tick.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.post_success' | t }}
              </p>
            {%- elsif form.errors -%}
              <div
                class="contact-page__form-status contact-page__form-status--error"
                role="alert"
                tabindex="-1"
                autofocus
              >
                {{- 'icon-about.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
                <ul class="contact-page__form-errors">
                  <li>
                    <a href="#ContactForm-email">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </a>
                  </li>
                </ul>
              </div>
            {%- endif -%}

            <div class="contact-page__field">
              <div class="contact-page__input-3d">
                <span class="contact-page__input-shadow" aria-hidden="true"></span>
                <input
                  type="text"
                  id="ContactForm-name"
                  class="contact-page__input"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ section.settings.placeholder_name | default: "I'm..." }}"
                  aria-label="{{ section.settings.placeholder_name | default: "I'm..." }}"
                >
              </div>
            </div>
            <div class="contact-page__field">
              <div class="contact-page__input-3d">
                <span class="contact-page__input-shadow" aria-hidden="true"></span>
                <input
                  type="email"
                  id="ContactForm-email"
                  class="contact-page__input"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ section.settings.placeholder_email | default: 'Here is my Email...' }}"
                  aria-label="{{ section.settings.placeholder_email | default: 'Here is my Email...' }}"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>
            </div>
            <div class="contact-page__field">
              <div class="contact-page__input-3d">
                <span class="contact-page__input-shadow" aria-hidden="true"></span>
                <input
                  type="tel"
                  id="ContactForm-phone"
                  class="contact-page__input"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  autocomplete="tel"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ section.settings.placeholder_phone | default: 'Here is my Contact Number...' }}"
                  aria-label="{{ section.settings.placeholder_phone | default: 'Here is my Contact Number...' }}"
                >
              </div>
            </div>
            <div class="contact-page__field">
              <div class="contact-page__input-3d contact-page__input-3d--textarea">
                <span class="contact-page__input-shadow" aria-hidden="true"></span>
                <textarea
                  id="ContactForm-body"
                  class="contact-page__input contact-page__textarea"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  rows="5"
                  placeholder="{{ section.settings.placeholder_message | default: 'My message for KOKO is...' }}"
                  aria-label="{{ section.settings.placeholder_message | default: 'My message for KOKO is...' }}"
                >{{- form.body -}}</textarea>
              </div>
            </div>
            <div class="contact-page__submit">
              {%- render 'global-btn', text: section.settings.button_text | default: 'Send', type: 'submit', class: 'contact-page__submit-btn', fit_width: false -%}
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if map_address != blank -%}
  {%- if use_google_maps -%}
    <script>
      (function () {
        var wrap = document.getElementById('contact-map-google-{{ section.id }}');
        if (!wrap || !wrap.dataset.address || !wrap.dataset.apiKey) return;
        var iframe = document.createElement('iframe');
        iframe.className = 'contact-page__map-iframe';
        iframe.setAttribute(
          'src',
          'https://www.google.com/maps/embed/v1/place?key=' +
            encodeURIComponent(wrap.dataset.apiKey) +
            '&q=' +
            encodeURIComponent(wrap.dataset.address)
        );
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
        iframe.setAttribute('title', wrap.dataset.mapTitle || 'Location map');
        wrap.appendChild(iframe);
      })();
    </script>
  {%- else -%}
    <style>
      #contact-map-{{ section.id }} {
        position: relative;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
        overflow: hidden;
      }

      .osm-map-container {
        position: relative;
        width: 100%;
        height: 100%;
        background: #e0e0e0;
      }

      .osm-tile-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .osm-tile {
        position: absolute;
        background: #e0e0e0;
        border: 1px solid #d0d0d0;
        background-size: cover;
        background-position: center;
      }

      .osm-marker {
        position: absolute;
        transform: translate(-50%, -100%);
        cursor: pointer;
        z-index: 10;
      }

      .osm-marker-icon {
        width: 32px;
        height: 40px;
        background: #FF6B6B;
        border: 2px solid white;
        border-radius: 50% 50% 50% 0%;
        transform: rotate(-45deg);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .osm-marker-icon::after {
        content: '';
        width: 8px;
        height: 8px;
        background: white;
        border-radius: 50%;
        transform: rotate(45deg);
      }

      .osm-attribution {
        position: absolute;
        bottom: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.8);
        padding: 4px 6px;
        font-size: 11px;
        z-index: 5;
        border-radius: 2px;
      }

      .osm-attribution a {
        color: #0078a8;
        text-decoration: none;
      }

      .osm-attribution a:hover {
        text-decoration: underline;
      }
    </style>

    <script defer>
      (function () {
        var mapEl = document.getElementById('contact-map-{{ section.id }}');
        if (!mapEl || !mapEl.dataset.address) return;

        var address = mapEl.dataset.address;
        var zoom = parseInt(mapEl.dataset.zoom, 10) || 13;
        var fallbackLat = 40.7484;
        var fallbackLon = -73.9857;

        // Constrain zoom level
        zoom = Math.max(1, Math.min(18, zoom));

        function deg2tileFractional(lat, lon, z) {
          var n = Math.pow(2, z);
          var x = (lon + 180) / 360 * n;
          var y = (1 - Math.log(Math.tan(lat * Math.PI / 180) + 1 / Math.cos(lat * Math.PI / 180)) / Math.PI) / 2 * n;
          return { x: x, y: y };
        }

        function getMapExtent(lat, lon, z, width, height) {
          var tileSize = 256;
          var tile = deg2tileFractional(lat, lon, z);
          var centerX = tile.x;
          var centerY = tile.y;

          var tilesX = Math.ceil(width / tileSize) + 2;
          var tilesY = Math.ceil(height / tileSize) + 2;

          var startX = Math.floor(centerX - tilesX / 2);
          var startY = Math.floor(centerY - tilesY / 2);
          var endX = startX + tilesX;
          var endY = startY + tilesY;

          return { startX: startX, startY: startY, endX: endX, endY: endY, centerX: centerX, centerY: centerY, tileSize: tileSize };
        }

        function initSimpleMap(lat, lon) {
          mapEl.innerHTML = '';
          var container = document.createElement('div');
          container.className = 'osm-map-container';
          container.style.width = '100%';
          container.style.height = '100%';

          var width = mapEl.offsetWidth || 400;
          var height = mapEl.offsetHeight || 300;

          var extent = getMapExtent(lat, lon, zoom, width, height);

          var tileLayer = document.createElement('div');
          tileLayer.className = 'osm-tile-layer';
          tileLayer.style.width = width + 'px';
          tileLayer.style.height = height + 'px';

          // Load visible tiles
          for (var x = extent.startX; x < extent.endX; x++) {
            for (var y = extent.startY; y < extent.endY; y++) {
              var tileUrl = 'https://tile.openstreetmap.org/' + zoom + '/' + x + '/' + y + '.png';
              var tile = document.createElement('div');
              tile.className = 'osm-tile';
              tile.style.backgroundImage = 'url(' + tileUrl + ')';

              var pixelX = (x - extent.centerX) * 256 + width / 2;
              var pixelY = (y - extent.centerY) * 256 + height / 2;

              tile.style.left = pixelX + 'px';
              tile.style.top = pixelY + 'px';
              tile.style.width = '256px';
              tile.style.height = '256px';

              tileLayer.appendChild(tile);
            }
          }

          // Add marker
          var markerPixelX = width / 2;
          var markerPixelY = height / 2;

          var marker = document.createElement('div');
          marker.className = 'osm-marker';
          marker.style.left = markerPixelX + 'px';
          marker.style.top = markerPixelY + 'px';

          var markerIcon = document.createElement('div');
          markerIcon.className = 'osm-marker-icon';
          marker.appendChild(markerIcon);

          // Add attribution
          var attribution = document.createElement('div');
          attribution.className = 'osm-attribution';
          attribution.innerHTML = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>';

          container.appendChild(tileLayer);
          container.appendChild(marker);
          container.appendChild(attribution);
          mapEl.appendChild(container);
        }

        // Fetch coordinates using Komoot Photon API
        fetch('https://photon.komoot.io/api/?q=' + encodeURIComponent(address) + '&limit=1')
          .then(function (r) {
            return r.json();
          })
          .then(function (data) {
            var lat = fallbackLat;
            var lon = fallbackLon;
            if (data && data.features && data.features.length > 0) {
              var coords = data.features[0].geometry.coordinates;
              if (coords && coords.length >= 2) {
                lon = parseFloat(coords[0]);
                lat = parseFloat(coords[1]);
              }
            }
            initSimpleMap(lat, lon);
          })
          .catch(function () {
            initSimpleMap(fallbackLat, fallbackLon);
          });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "paragraph",
      "content": "Map location is taken from the Address field in Contact details below. Enter your business address there to show it on the map."
    },
    {
      "type": "range",
      "id": "map_zoom",
      "min": 1,
      "max": 18,
      "step": 1,
      "label": "Map zoom level (OpenStreetMap)",
      "default": 13,
      "info": "Zoom level after the address is found. Ignored for Google Maps."
    },
    {
      "type": "select",
      "id": "map_provider",
      "label": "Map provider",
      "options": [
        {
          "value": "openstreetmap",
          "label": "OpenStreetMap (Leaflet)"
        },
        {
          "value": "google",
          "label": "Google Maps"
        }
      ],
      "default": "openstreetmap",
      "info": "Google Maps requires an API key with Maps Embed API enabled."
    },
    {
      "type": "text",
      "id": "google_maps_api_key",
      "label": "Google Maps API key",
      "info": "Required when using Google Maps. Create a key in Google Cloud Console and enable 'Maps Embed API'."
    },
    {
      "type": "header",
      "content": "Contact details (left card)"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "koko@gmail.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "1235822572"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Address",
      "default": "350 5th Ave, New York, NY 10118, USA"
    },
    {
      "type": "header",
      "content": "Contact detail icons"
    },
    {
      "type": "paragraph",
      "content": "Upload custom icons for email, phone, and address. Leave blank to use the default icons."
    },
    {
      "type": "image_picker",
      "id": "icon_email",
      "label": "Email icon"
    },
    {
      "type": "image_picker",
      "id": "icon_phone",
      "label": "Phone icon"
    },
    {
      "type": "image_picker",
      "id": "icon_address",
      "label": "Address icon"
    },
    {
      "type": "header",
      "content": "Form (right card)"
    },
    {
      "type": "text",
      "id": "greeting_title",
      "label": "Greeting title",
      "default": "Hello!"
    },
