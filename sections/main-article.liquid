    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
    {%- for block in section.blocks -%}
      {%- if block.type == 'section_header' -%}
        {%- render 'section-header',
          id: block.id,
          show_badge: block.settings.show_badge,
          badge_text: block.settings.badge_text,
          title: article.title,
          description: block.settings.header_box_description,
          title_alignment: block.settings.title_alignment,
          title_font_size: block.settings.title_font_size,
          title_font_weight: block.settings.title_font_weight,
          title_line_height: block.settings.title_line_height,
          title_letter_spacing: block.settings.title_letter_spacing,
          title_text_transform: block.settings.title_text_transform,
          title_margin_bottom: block.settings.title_margin_bottom,
          header_padding_top: block.settings.header_padding_top,
          header_padding_bottom: block.settings.header_padding_bottom,
          header_padding_horizontal: block.settings.header_padding_horizontal,
          badge_font_size: block.settings.header_badge_font_size,
          badge_font_weight: block.settings.header_badge_font_weight,
          badge_padding_vertical: block.settings.header_badge_padding_vertical,
          badge_padding_horizontal: block.settings.header_badge_padding_horizontal,
          badge_margin_bottom: block.settings.header_badge_margin_bottom,
          badge_text_color: block.settings.header_badge_text_color,
          badge_border_color: block.settings.header_badge_border_color,
          badge_border_width: block.settings.header_badge_border_width,
          badge_border_radius: block.settings.header_badge_border_radius,
          badge_text_transform: block.settings.header_badge_text_transform,
          description_font_size: block.settings.header_description_font_size,
          description_font_weight: block.settings.header_description_font_weight,
          description_line_height: block.settings.header_description_line_height,
          description_margin_top: block.settings.header_description_margin_top,
          title_font_size_mobile: block.settings.title_font_size_mobile,
          description_font_size_mobile: block.settings.header_description_font_size_mobile,
          border_radius: block.settings.header_border_radius
        -%}
      {%- endif -%}

      {%- if block.type == 'heading' and has_section_header == false -%}
        <header class="article-header" {{ block.shopify_attributes }}>
          {%- if block.settings.show_category_pill -%}
            <span class="article-category-pill">{{ block.settings.category_pill_text }}</span>
          {%- endif -%}
          <h1 class="article-template__title article-title" itemprop="headline">{{ article.title | escape }}</h1>
        </header>
      {%- endif -%}
    {%- endfor -%}

    <div class="article-grid{% unless has_sidebar %} article-grid--no-sidebar{% endunless %}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image_and_socials' -%}
          <aside class="article-sidebar" {{ block.shopify_attributes }}>
            <!-- Brand / Article Image Circle -->
            <div class="article-brand-circle">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 300 }}"
                  alt="{{ article.image.alt | escape }}"
                  class="article-brand-circle__img"
                  loading="eager"
                  height="100"
                  width="100"
                >
              {%- else -%}
                <span class="article-brand-circle__fallback">{{ shop.name | truncate: 4, '' | upcase }}</span>
              {%- endif -%}
            </div>

            <div class="article-sidebar__meta">
              {%- if block.settings.show_author or block.settings.show_date -%}
                <div class="article-meta-group">
                  {%- if block.settings.show_author -%}
                    <span class="article-meta-label">BY {{ article.author | upcase }}</span>
                  {%- endif -%}
                  {%- if block.settings.show_date -%}
                    <span class="article-meta-value">{{ article.published_at | date: '%-d %B %Y' | upcase }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.show_tags and article.tags.size > 0 -%}
                <div class="article-meta-group">
                  <span class="article-meta-label">TAGS</span>
                  <div class="article-tags-container">
                    {%- for tag in article.tags -%}
                      <span class="tag-pill">{{ tag | upcase }}</span>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if block.settings.show_share -%}
                <div class="article-meta-group">
                  <span class="article-meta-label">SHARE</span>
                  <div class="custom-share-icons">
                    {%- if block.settings.link_instagram != blank -%}
                      <a
                        href="{{ block.settings.link_instagram }}"
                        class="custom-share-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                      >
                        {%- if block.settings.icon_instagram != blank -%}
                          {{
                            block.settings.icon_instagram
                            | image_url: width: 40
                            | image_tag: class: 'custom-share-icon', loading: 'lazy'
                          }}
                        {%- else -%}
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.link_facebook != blank -%}
                      <a
                        href="{{ block.settings.link_facebook }}"
                        class="custom-share-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                      >
                        {%- if block.settings.icon_facebook != blank -%}
                          {{
                            block.settings.icon_facebook
                            | image_url: width: 40
                            | image_tag: class: 'custom-share-icon', loading: 'lazy'
                          }}
                        {%- else -%}
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.link_twitter != blank -%}
                      <a
                        href="{{ block.settings.link_twitter }}"
                        class="custom-share-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="X / Twitter"
                      >
                        {%- if block.settings.icon_twitter != blank -%}
                          {{
                            block.settings.icon_twitter
                            | image_url: width: 40
                            | image_tag: class: 'custom-share-icon', loading: 'lazy'
                          }}
                        {%- else -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.link_whatsapp != blank -%}
                      <a
                        href="{{ block.settings.link_whatsapp }}"
                        class="custom-share-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp"
                      >
                        {%- if block.settings.icon_whatsapp != blank -%}
                          {{
                            block.settings.icon_whatsapp
                            | image_url: width: 40
                            | image_tag: class: 'custom-share-icon', loading: 'lazy'
                          }}
                        {%- else -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.link_telegram != blank -%}
                      <a
                        href="{{ block.settings.link_telegram }}"
                        class="custom-share-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Telegram"
                      >
                        {%- if block.settings.icon_telegram != blank -%}
                          {{
                            block.settings.icon_telegram
                            | image_url: width: 40
                            | image_tag: class: 'custom-share-icon', loading: 'lazy'
                          }}
                        {%- else -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if block.settings.show_read_time -%}
                <div class="article-meta-group--read-time">
                  <span class="article-read-time-pill">{{ article_read_minutes }} MIN READ</span>
                </div>
              {%- endif -%}
            </div>
          </aside>
        {%- endif -%}
      {%- endfor -%}

      <div class="article-right-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'content' -%}
            <div class="article-content article-content-card rte" itemprop="articleBody" {{ block.shopify_attributes }}>
              {{ article.content }}
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="article-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="   --narrow">
                  {% render block %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'author_card' -%}
            <div class="article-author-card" {{ block.shopify_attributes }}>
              <div class="article-author-avatar">
                {{- article.author | slice: 0, 2 | upcase -}}
              </div>
              <div class="article-author-info">
                <div class="article-author-meta">
                  <span class="article-author-label">WRITTEN BY</span>
                  <span class="article-author-name">{{ article.author }}</span>
                  {%- if block.settings.author_role != blank -%}
                    <span class="article-author-role">{{ block.settings.author_role }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.author_bio != blank -%}
                  <p class="article-author-bio">{{ block.settings.author_bio }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'comment_box' and blog.comments_enabled? -%}
            <div class="article-template__comment-wrapper background-secondary" {{ block.shopify_attributes }}>
              <div id="comments" class="   --narrow">
                {% form 'new_comment', article %}
                  {%- liquid
                    assign post_message = 'blogs.article.success'
                    if blog.moderated? and comment.status == 'unapproved'
                      assign post_message = 'blogs.article.success_moderated'
                    endif
                  -%}
                  <!-- STYLED COMMENT CARD -->
                  <div class="article-comment-card">
                    <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
                    {%- if form.errors -%}
                      <div class="form__message" role="alert">
                        <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                          {{ 'templates.contact.form.error_heading' | t }}
                        </h3>
                      </div>
                      <ul class="form-status-list caption-large">
                        {%- for field in form.errors -%}
                          <li>
                            <a href="#CommentForm-{{ field }}" class="link">
                              {%- if form.errors.translated_fields[field] contains 'author' -%}
                                {{ 'blogs.article.name' | t }}
                              {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                                {{ 'blogs.article.message' | t }}
                              {%- else -%}
                                {{ form.errors.translated_fields[field] }}
                              {%- endif -%}
                              {{ form.errors.messages[field] }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- elsif form.posted_successfully? -%}
                      <div class="form-status-list form__message" role="status">
                        <h3 class="form-status" tabindex="-1" autofocus>
                          {{ post_message | t }}
                        </h3>
                      </div>
                    {%- endif -%}

                    <div class="article-comment-field">
                      <input
                        type="text"
                        name="comment[author]"
                        id="CommentForm-author"
                        class="article-comment-input"
                        autocomplete="name"
                        value="{{ form.author }}"
                        aria-required="true"
                        required
                        {% if form.errors contains 'author' %}
                          aria-invalid="true"
                          aria-describedby="CommentForm-author-error"
                        {% endif %}
                        placeholder="{{ 'blogs.article.name' | t }}"
                      >
                      {%- if form.errors contains 'author' -%}
                        <small id="CommentForm-author-error">
                          <span class="form__message">
                            {%- render 'icon-error' -%}
                            {{ 'blogs.article.name' | t }}
                            {{ form.errors.messages.author }}.
                          </span>
                        </small>
                      {%- endif -%}
                    </div>

                    <div class="article-comment-field">
                      <input
                        type="email"
                        name="comment[email]"
                        id="CommentForm-email"
                        autocomplete="email"
                        class="article-comment-input"
                        value="{{ form.email }}"
                        aria-required="true"
                        required
                        {% if form.errors contains 'email' %}
                          aria-invalid="true"
                          aria-describedby="CommentForm-email-error"
                        {% endif %}
                        placeholder="{{ 'blogs.article.email' | t }}"
                      >
                      {%- if form.errors contains 'email' -%}
                        <small id="CommentForm-email-error">
                          <span class="form__message">
                            {%- render 'icon-error' -%}
                            {{ 'blogs.article.email' | t }}
                            {{ form.errors.messages.email }}.
                          </span>
                        </small>
                      {%- endif -%}
                    </div>

                    <div class="article-comment-field">
                      <textarea
                        rows="5"
                        name="comment[body]"
                        id="CommentForm-body"
                        class="article-comment-textarea"
                        aria-required="true"
                        required
                        {% if form.errors contains 'body' %}
                          aria-invalid="true"
                          aria-describedby="CommentForm-body-error"
                        {% endif %}
                        placeholder="{{ 'blogs.article.message' | t }}"
                      >{{ form.body }}</textarea>
                      {%- if form.errors contains 'body' -%}
                        <small id="CommentForm-body-error">
                          <span class="form__message">
                            {%- render 'icon-error' -%}
                            {{ 'blogs.article.message' | t }}
                            {{ form.errors.messages.body }}.
                          </span>
                        </small>
                      {%- endif -%}
                    </div>

                    <div class="article-comment-submit-row">
                      {%- assign button_text = 'blogs.article.post' | t -%}
                      {% render 'global-btn',
                        text: button_text,
                        type: 'submit',
                        variant: 'secondary',
                        fit_width: false,
                        class: 'share-story-submit'
                      %}
                      <p class="article-comment-moderation-note">{{ 'blogs.article.moderated' | t }}</p>
                    </div>
                  </div>
                {% endform %}

                <!-- STYLED COMMENTS LIST CARD -->
                <div class="article-comment-card article-comments-list-card">
                  <p class="article-comments-count">{{ article.comments_count }} COMMENTS</p>
                  {%- assign anchor_id = '#Comments-' | append: article.id -%}
                  {% paginate article.comments by 2 %}
                    <div class="article-template__comments" id="Comments-{{ article.id }}" tabindex="-1">
                      {%- if comment.status == 'pending' and comment.content -%}
                        <article id="{{ comment.id }}" class="article-posted-comment-card">
                          <div class="article-posted-comment-body">{{ comment.content }}</div>
                          <footer class="article-posted-comment-footer">
                            <span class="article-posted-comment-author">{{ comment.author | upcase }}</span>
                          </footer>
                        </article>
                      {%- endif -%}
                      {%- for comment in article.comments -%}
                        <article id="{{ comment.id }}" class="article-posted-comment-card">
                          <div class="article-posted-comment-body">{{ comment.content }}</div>
                          <footer class="article-posted-comment-footer">
                            <span class="article-posted-comment-author">{{ comment.author | upcase }}</span>
                            <span class="article-posted-comment-date">
                              {{- comment.created_at | date: '%B %-d, %Y' | upcase -}}
                            </span>
                          </footer>
                        </article>
                      {%- endfor -%}
                    </div>
                  {% endpaginate %}
                  <div class="article-comments-footer">
                    {%-
                      render 'global-btn',
                      text: 'SEE ALL COMMENTS',
                      url: article.url | append: '#Comments-' | append: article.id,
                      variant: 'secondary',
                      fit_width: false
                    -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </article>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

