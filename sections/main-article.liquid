{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Dynamic Design Overrides */
  .article-category-pill {
    border: 1px solid {{ section.settings.pill_color }};
    color: {{ section.settings.pill_color }};
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header">
      {%- if section.settings.show_category_pill and article.tags.size > 0 -%}
        <span class="article-category-pill">{{ article.tags.first }}</span>
      {%- endif -%}
      <h1 class="article-template__title article-title" itemprop="headline">{{ article.title | escape }}</h1>
    </header>

    <div class="article-grid">
      <aside class="article-sidebar">
        {%- if article.image -%}
          <div class="article-image-wrapper">
            <img
              srcset="
                {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                {{ article.image | image_url: width: 1100 }} 1100w
              "
              sizes="(min-width: 990px) 350px, 100vw"
              src="{{ article.image | image_url: width: 750 }}"
              loading="eager"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              alt="{{ article.image.alt | escape }}"
              class="article-image"
            >
          </div>
        {%- endif -%}

        {%- if section.settings.show_author or section.settings.show_date -%}
          <div class="article-meta-group">
            <span class="article-meta-label">
              {%- if section.settings.show_author -%}BY {{ article.author | upcase }}{%- endif -%}
            </span>
            {%- if section.settings.show_date -%}
              <span class="article-meta-value">{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_tags and article.tags.size > 0 -%}
          <div class="article-meta-group">
            <span class="article-meta-label">TAGS</span>
            <div class="article-tags-container">
              {%- for tag in article.tags -%}
                <span class="article-meta-value">{{ tag | upcase }}</span>
                {%- unless forloop.last -%}
                  <span class="article-meta-value">,</span>
                {%- endunless %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          <div class="article-meta-group">
            <span class="article-meta-label">SHARE</span>
            <div class="custom-share-icons">
              {%- if section.settings.link_instagram != blank -%}
                <a
                  href="{{ section.settings.link_instagram }}"
                  class="custom-share-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  {%- if section.settings.icon_instagram != blank -%}
                    {{
                      section.settings.icon_instagram
                      | image_url: width: 40
                      | image_tag: class: 'custom-share-icon', loading: 'lazy'
                    }}
                  {%- else -%}
                    <svg
                      class="custom-share-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}

              {%- if section.settings.link_facebook != blank -%}
                <a
                  href="{{ section.settings.link_facebook }}"
                  class="custom-share-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                >
                  {%- if section.settings.icon_facebook != blank -%}
                    {{
                      section.settings.icon_facebook
                      | image_url: width: 40
                      | image_tag: class: 'custom-share-icon', loading: 'lazy'
                    }}
                  {%- else -%}
                    <svg
                      class="custom-share-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}

              {%- if section.settings.link_twitter != blank -%}
                <a
                  href="{{ section.settings.link_twitter }}"
                  class="custom-share-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Twitter"
                >
                  {%- if section.settings.icon_twitter != blank -%}
                    {{
                      section.settings.icon_twitter
                      | image_url: width: 40
                      | image_tag: class: 'custom-share-icon', loading: 'lazy'
                    }}
                  {%- else -%}
                    <svg
                      class="custom-share-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 4l11.733 16h8.05L12.206 4H4z"></path>
                      <path d="M4 20l6.768-9.024L4 4h2.95l4.897 6.643L16.275 4H20l-6.837 9.07L20 20h-3.013l-5.186-7.005L7.042 20H4z"></path>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}

              {%- if section.settings.link_whatsapp != blank -%}
                <a
                  href="{{ section.settings.link_whatsapp }}"
                  class="custom-share-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="WhatsApp"
                >
                  {%- if section.settings.icon_whatsapp != blank -%}
                    {{
                      section.settings.icon_whatsapp
                      | image_url: width: 40
                      | image_tag: class: 'custom-share-icon', loading: 'lazy'
                    }}
                  {%- else -%}
                    <svg
                      class="custom-share-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}

              {%- if section.settings.link_telegram != blank -%}
                <a
                  href="{{ section.settings.link_telegram }}"
                  class="custom-share-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Telegram"
                >
                  {%- if section.settings.icon_telegram != blank -%}
                    {{
                      section.settings.icon_telegram
                      | image_url: width: 40
                      | image_tag: class: 'custom-share-icon', loading: 'lazy'
                    }}
                  {%- else -%}
                    <svg
                      class="custom-share-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="22" y1="2" x2="11" y2="13"></line>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </aside>

      <div class="article-right-column">
        <div class="article-content rte" itemprop="articleBody">
          {{ article.content }}
        </div>

        <div class="article-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="page-width page-width--narrow">
                  {% render block %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- if blog.comments_enabled? -%}
          <div class="article-template__comment-wrapper background-secondary">
            <div id="comments" class="page-width page-width--narrow">
              {%- if article.comments_count > 0 -%}
                {%- assign anchor_id = '#Comments-' | append: article.id -%}
                <h4 id="Comments-{{ article.id }}" tabindex="-1">
                  {{ 'blogs.article.comments' | t: count: article.comments_count }}
                </h4>
                {% paginate article.comments by 5 %}
                  <div class="article-template__comments">
                    {%- if comment.status == 'pending' and comment.content -%}
                      <article
                        id="{{ comment.id }}"
                        class="article-template__comments-comment article-posted-comment-card"
                      >
                        {{ comment.content }}
                        <footer class="right">
                          <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                        </footer>
                      </article>
                    {%- endif -%}
                    {%- for comment in article.comments -%}
                      <article
                        id="{{ comment.id }}"
                        class="article-template__comments-comment article-posted-comment-card"
                      >
                        {{ comment.content }}
                        <footer class="right">
                          <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                          <span class="caption-with-letter-spacing">
                            {{- comment.created_at | time_tag: format: 'date' -}}
                          </span>
                        </footer>
                      </article>
                    {%- endfor -%}
                    {% render 'pagination', paginate: paginate, anchor: anchor_id %}
                  </div>
                {% endpaginate %}
              {%- endif -%}

              {% form 'new_comment', article %}
                {%- liquid
                  assign post_message = 'blogs.article.success'
                  if blog.moderated? and comment.status == 'unapproved'
                    assign post_message = 'blogs.article.success_moderated'
                  endif
                -%}
                <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
                {%- if form.errors -%}
                  <div class="form__message" role="alert">
                    <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                      {{ 'templates.contact.form.error_heading' | t }}
                    </h3>
                  </div>
                  <ul class="form-status-list caption-large">
                    {%- for field in form.errors -%}
                      <li>
                        <a href="#CommentForm-{{ field }}" class="link">
                          {%- if form.errors.translated_fields[field] contains 'author' -%}
                            {{ 'blogs.article.name' | t }}
                          {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                            {{ 'blogs.article.message' | t }}
                          {%- else -%}
                            {{ form.errors.translated_fields[field] }}
                          {%- endif -%}
                          {{ form.errors.messages[field] }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif form.posted_successfully? -%}
                  <div class="form-status-list form__message" role="status">
                    <h3 class="form-status" tabindex="-1" autofocus>
                      {{ post_message | t }}
                    </h3>
                  </div>
                {%- endif -%}

                <!-- STYLED COMMENT CARD -->
                <div class="article-comment-card">
                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-author"
                      data-text="{{ 'blogs.article.name' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.name' | t }}*</span>
                    </label>
                    <input
                      type="text"
                      name="comment[author]"
                      id="CommentForm-author"
                      class="article-comment-input"
                      autocomplete="name"
                      value="{{ form.author }}"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.name' | t }}"
                    >
                  </div>

                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-email"
                      data-text="{{ 'blogs.article.email' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.email' | t }}*</span>
                    </label>
                    <input
                      type="email"
                      name="comment[email]"
                      id="CommentForm-email"
                      autocomplete="email"
                      class="article-comment-input"
                      value="{{ form.email }}"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.email' | t }}"
                    >
                  </div>

                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-body"
                      data-text="{{ 'blogs.article.message' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.message' | t }}*</span>
                    </label>
                    <textarea
                      rows="5"
                      name="comment[body]"
                      id="CommentForm-body"
                      class="article-comment-textarea"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.message' | t }}"
                    >{{ form.body }}</textarea>
                  </div>

                  {%- if blog.moderated? -%}
                    <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
                  {%- endif -%}

                  {%- assign button_text = 'blogs.article.post' | t -%}
                  {% render 'submit-button', text: button_text, type: 'submit', class: 'share-story-submit' %}
                </div>
              {% endform %}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </article>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Article Header"
    },
    {
      "type": "checkbox",
      "id": "show_category_pill",
      "label": "Show category pill",
      "default": true
    },
    {
      "type": "color",
      "id": "pill_color",
      "label": "Category Pill Color",
      "default": "#ff5500"
    },
    {
      "type": "header",
      "content": "Article Sidebar"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "header",
      "content": "Share Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Media Icons"
    },
    {
      "type": "paragraph",
      "content": "Add links and custom icons for social media platforms."
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "image_picker",
      "id": "icon_instagram",
      "label": "Instagram Icon"
    },
    {
      "type": "url",
      "id": "link_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "header",
      "content": "Facebook"
    },
    {
      "type": "image_picker",
      "id": "icon_facebook",
      "label": "Facebook Icon"
    },
    {
      "type": "url",
      "id": "link_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "header",
      "content": "Twitter"
    },
    {
      "type": "image_picker",
      "id": "icon_twitter",
      "label": "Twitter Icon"
    },
    {
      "type": "url",
      "id": "link_twitter",
      "label": "Twitter Link"
    },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    {
      "type": "image_picker",
      "id": "icon_whatsapp",
      "label": "WhatsApp Icon"
    },
    {
      "type": "url",
      "id": "link_whatsapp",
      "label": "WhatsApp Link"
    },
    {
      "type": "header",
      "content": "Telegram"
    },
    {
      "type": "image_picker",
      "id": "icon_telegram",
      "label": "Telegram Icon"
    },
    {
      "type": "url",
      "id": "link_telegram",
      "label": "Telegram Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
