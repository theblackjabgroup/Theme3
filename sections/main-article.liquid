{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_sidebar = false
  assign has_section_header = false
  for block in section.blocks
    if block.type == 'image_and_socials'
      assign has_sidebar = true
    endif
    if block.type == 'section_header'
      assign has_section_header = true
    endif
  endfor

  assign article_word_count = article.content | strip_html | split: ' ' | size
  assign article_read_minutes = article_word_count | divided_by: 200
  if article_read_minutes < 1
    assign article_read_minutes = 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_mobile_top }}px;
    padding-bottom: {{ section.settings.padding_mobile_bottom }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ section.settings.margin_mobile_left }}px;
    margin-right: {{ section.settings.margin_mobile_right }}px;
    width: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      margin-left: {{ section.settings.margin_horizontal }}px;
      margin-right: {{ section.settings.margin_horizontal }}px;
      width: auto;
    }
  }

  /* Dynamic Design Overrides - per block type */
  {%- for block in section.blocks -%}
    {%- if block.type == 'section_header' -%}
  #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} {
    padding-top: {{ block.settings.header_padding_top | default: 20 }}px;
    padding-bottom: {{ block.settings.header_padding_bottom | default: 20 }}px;
    padding-left: {{ block.settings.header_padding_horizontal | default: 20 }}px;
    padding-right: {{ block.settings.header_padding_horizontal | default: 20 }}px;
    border-radius: {{ block.settings.header_border_radius | default: 20 }}px;
  }
  #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} .section-header-snippet__title {
    font-size: {{ block.settings.title_font_size | default: 3.2 }}rem;
    font-weight: {{ block.settings.title_font_weight | default: 700 }};
    line-height: {{ block.settings.title_line_height | default: 1.2 }};
    letter-spacing: {{ block.settings.title_letter_spacing | default: 0 }}px;
    text-transform: {{ block.settings.title_text_transform | default: 'none' }};
    margin-bottom: {{ block.settings.title_margin_bottom | default: 20 }}px;
  }
  #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} .section-header-snippet__badge {
    font-size: {{ block.settings.header_badge_font_size | default: 14 }}px;
    font-weight: {{ block.settings.header_badge_font_weight | default: 600 }};
    padding: {{ block.settings.header_badge_padding_vertical | default: 4 }}px {{ block.settings.header_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ block.settings.header_badge_margin_bottom | default: 14 }}px;
    border-width: {{ block.settings.header_badge_border_width | default: 1 }}px;
    border-radius: {{ block.settings.header_badge_border_radius | default: 20 }}px;
    text-transform: {{ block.settings.header_badge_text_transform | default: 'uppercase' }};
  }
  #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} .section-header-snippet__description {
    font-size: {{ block.settings.header_description_font_size | default: 16 }}px;
    font-weight: {{ block.settings.header_description_font_weight | default: 400 }};
    line-height: {{ block.settings.header_description_line_height | default: 1.5 }};
    margin-top: {{ block.settings.header_description_margin_top | default: 10 }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} .section-header-snippet__title {
      font-size: {{ block.settings.title_font_size_mobile | default: 2.5 }}rem;
    }
    #shopify-section-{{ section.id }} .section-header-snippet-{{ block.id }} .section-header-snippet__description {
      font-size: {{ block.settings.header_description_font_size_mobile | default: 14 }}px;
    }
  }
    {%- elsif block.type == 'heading' -%}
  #shopify-section-{{ section.id }} .article-category-pill {
    border: 1px solid var(--color-link);
    color: var(--color-link);
    font-size: {{ block.settings.tag_font_size_mobile }}px;
    font-weight: {{ block.settings.tag_font_weight_mobile }};
    line-height: {{ block.settings.tag_line_height_mobile | divided_by: 100.0 }};
    border-radius: {{ block.settings.tag_border_radius_mobile }}px;
    padding: {{ block.settings.tag_padding_vertical_mobile }}px {{ block.settings.tag_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} .article-header {
    border-radius: {{ block.settings.card_border_radius_mobile }}px;
    padding: {{ block.settings.card_padding_vertical_mobile }}px {{ block.settings.card_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} .article-title {
    font-size: {{ block.settings.card_font_size_mobile }}px;
    font-weight: {{ block.settings.card_font_weight_mobile }};
    line-height: {{ block.settings.card_line_height_mobile | divided_by: 100.0 }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .article-category-pill {
      font-size: {{ block.settings.tag_font_size_desktop }}px;
      font-weight: {{ block.settings.tag_font_weight_desktop }};
      line-height: {{ block.settings.tag_line_height_desktop | divided_by: 100.0 }};
      border-radius: {{ block.settings.tag_border_radius_desktop }}px;
      padding: {{ block.settings.tag_padding_vertical_desktop }}px {{ block.settings.tag_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-header {
      border-radius: {{ block.settings.card_border_radius_desktop }}px;
      padding: {{ block.settings.card_padding_vertical_desktop }}px {{ block.settings.card_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-title {
      font-size: {{ block.settings.card_font_size_desktop }}px;
      font-weight: {{ block.settings.card_font_weight_desktop }};
      line-height: {{ block.settings.card_line_height_desktop | divided_by: 100.0 }};
    }
  }
    {%- elsif block.type == 'image_and_socials' -%}
  #shopify-section-{{ section.id }} .article-sidebar {
    border-radius: {{ block.settings.card_border_radius_mobile }}px;
    padding: {{ block.settings.card_padding_vertical_mobile }}px {{ block.settings.card_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} .article-sidebar .article-image-wrapper {
    border-radius: {{ block.settings.image_border_radius_mobile }}px;
  }
  #shopify-section-{{ section.id }} .article-sidebar .article-meta-label {
    font-size: {{ block.settings.label_font_size_mobile }}px;
    font-weight: {{ block.settings.label_font_weight_mobile }};
    line-height: {{ block.settings.label_line_height_mobile | divided_by: 100.0 }};
    text-align: {{ block.settings.label_alignment_mobile }};
  }
  #shopify-section-{{ section.id }} .article-sidebar .article-meta-value {
    font-size: {{ block.settings.value_font_size_mobile }}px;
    font-weight: {{ block.settings.value_font_weight_mobile }};
    line-height: {{ block.settings.value_line_height_mobile | divided_by: 100.0 }};
    text-align: {{ block.settings.value_alignment_mobile }};
  }
  #shopify-section-{{ section.id }} .article-sidebar .tag-pill {
    border-radius: {{ block.settings.tag_border_radius_mobile | default: 24 }}px;
    border-color: #f8f3f8;
    color: #f8f3f8;
    background: transparent;
  }
  #shopify-section-{{ section.id }} .article-sidebar .tag-pill:hover {
    background: rgba(248, 243, 248, 0.15);
    color: #f8f3f8;
  }
  #shopify-section-{{ section.id }} .article-sidebar .article-meta-group {
    display: flex;
    flex-direction: column;
    align-items: {% if block.settings.value_alignment_mobile == 'left' %}flex-start{% elsif block.settings.value_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %};
  }
  #shopify-section-{{ section.id }} .article-sidebar .article-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  #shopify-section-{{ section.id }} .article-sidebar .custom-share-icons {
    gap: {{ block.settings.social_icon_gap_mobile }}px;
    justify-content: {% if block.settings.value_alignment_mobile == 'left' %}flex-start{% elsif block.settings.value_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %};
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-label {
      text-align: {{ block.settings.label_alignment_mobile }};
      align-self: {% if block.settings.label_alignment_mobile == 'left' %}flex-start{% elsif block.settings.label_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %} !important;
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-value {
      text-align: {{ block.settings.value_alignment_mobile }};
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-group {
      align-items: {% if block.settings.value_alignment_mobile == 'left' %}flex-start{% elsif block.settings.value_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %} !important;
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    #shopify-section-{{ section.id }} .article-sidebar .custom-share-icons {
      justify-content: {% if block.settings.value_alignment_mobile == 'left' %}flex-start{% elsif block.settings.value_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %} !important;
    }
  }
  #shopify-section-{{ section.id }} .article-sidebar .custom-share-link {
    {%- if block.settings.social_icon_show_bg_mobile -%}background: var(--color-card-bg);{%- else -%}background: transparent;{%- endif -%}
    border-radius: {{ block.settings.social_icon_border_radius_mobile }}px;
    color: var(--color-text);
    padding: {{ block.settings.social_icon_padding_vertical_mobile }}px {{ block.settings.social_icon_padding_horizontal_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .article-sidebar {
      border-radius: {{ block.settings.card_border_radius_desktop }}px;
      padding: {{ block.settings.card_padding_vertical_desktop }}px {{ block.settings.card_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-image-wrapper {
      border-radius: {{ block.settings.image_border_radius_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-label {
      font-size: {{ block.settings.label_font_size_desktop }}px;
      font-weight: {{ block.settings.label_font_weight_desktop }};
      line-height: {{ block.settings.label_line_height_desktop | divided_by: 100.0 }};
      text-align: {{ block.settings.label_alignment_desktop }};
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-value {
      font-size: {{ block.settings.value_font_size_desktop }}px;
      font-weight: {{ block.settings.value_font_weight_desktop }};
      line-height: {{ block.settings.value_line_height_desktop | divided_by: 100.0 }};
      text-align: {{ block.settings.value_alignment_desktop }};
    }
    #shopify-section-{{ section.id }} .article-sidebar .tag-pill {
      border-radius: {{ block.settings.tag_border_radius_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-group {
      display: flex;
      flex-direction: column;
      align-items: {% if block.settings.value_alignment_desktop == 'left' %}flex-start{% elsif block.settings.value_alignment_desktop == 'right' %}flex-end{% else %}center{% endif %};
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-meta-label {
      align-self: {% if block.settings.label_alignment_desktop == 'left' %}flex-start{% elsif block.settings.label_alignment_desktop == 'right' %}flex-end{% else %}center{% endif %};
    }
    #shopify-section-{{ section.id }} .article-sidebar .article-tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    #shopify-section-{{ section.id }} .article-sidebar .custom-share-icons {
      gap: {{ block.settings.social_icon_gap_desktop }}px;
      justify-content: {% if block.settings.value_alignment_desktop == 'left' %}flex-start{% elsif block.settings.value_alignment_desktop == 'right' %}flex-end{% else %}center{% endif %};
    }
    #shopify-section-{{ section.id }} .article-sidebar .custom-share-link {
      {%- if block.settings.social_icon_show_bg_desktop -%}background: var(--color-card-bg);{%- else -%}background: transparent;{%- endif -%}
      border-radius: {{ block.settings.social_icon_border_radius_desktop }}px;
      color: var(--color-text);
      padding: {{ block.settings.social_icon_padding_vertical_desktop }}px {{ block.settings.social_icon_padding_horizontal_desktop }}px;
    }
  }
    {%- elsif block.type == 'content' -%}
  #shopify-section-{{ section.id }} .article-content.article-content-card {
    font-size: {{ block.settings.font_size_mobile }}px;
    font-weight: {{ block.settings.font_weight_mobile }};
    line-height: {{ block.settings.line_height_mobile | divided_by: 100.0 }};
    border-radius: {{ block.settings.card_border_radius_mobile }}px;
    padding: {{ block.settings.card_padding_vertical_mobile }}px {{ block.settings.card_padding_horizontal_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .article-content.article-content-card {
      font-size: {{ block.settings.font_size_desktop }}px;
      font-weight: {{ block.settings.font_weight_desktop }};
      line-height: {{ block.settings.line_height_desktop | divided_by: 100.0 }};
      border-radius: {{ block.settings.card_border_radius_desktop }}px;
      padding: {{ block.settings.card_padding_vertical_desktop }}px {{ block.settings.card_padding_horizontal_desktop }}px;
    }
  }
    {%- elsif block.type == 'comment_box' -%}
  #shopify-section-{{ section.id }} #comments .article-comment-card {
    border-radius: {{ block.settings.card_border_radius_mobile }}px;
    padding: {{ block.settings.card_padding_vertical_mobile }}px {{ block.settings.card_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} .article-posted-comment-card {
    border-radius: {{ block.settings.box_border_radius_mobile }}px;
    padding: {{ block.settings.box_padding_vertical_mobile }}px {{ block.settings.box_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} #comments form .article-comment-input,
  #shopify-section-{{ section.id }} #comments form .article-comment-textarea {
    border-radius: {{ block.settings.input_border_radius_mobile }}px;
    padding: {{ block.settings.input_padding_vertical_mobile }}px {{ block.settings.input_padding_horizontal_mobile }}px;
  }
  #shopify-section-{{ section.id }} #comments form .article-comment-card h3,
  #shopify-section-{{ section.id }} #comments form .article-comment-input,
  #shopify-section-{{ section.id }} #comments form .article-comment-textarea {
    font-size: {{ block.settings.comment_box_font_size_mobile }}px;
    font-weight: {{ block.settings.comment_box_font_weight_mobile }};
    line-height: {{ block.settings.comment_box_line_height_mobile | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} #comments form .article-comment-input::placeholder,
  #shopify-section-{{ section.id }} #comments form .article-comment-textarea::placeholder {
    font-size: {{ block.settings.comment_box_font_size_mobile }}px;
    font-weight: {{ block.settings.comment_box_font_weight_mobile }};
  }
  #shopify-section-{{ section.id }} .article-posted-comment-card,
  #shopify-section-{{ section.id }} .article-posted-comment-card footer {
    font-size: {{ block.settings.comments_font_size_mobile }}px;
    font-weight: {{ block.settings.comments_font_weight_mobile }};
    line-height: {{ block.settings.comments_line_height_mobile | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} #comments .article-comment-card h4 {
    font-size: {{ block.settings.comments_font_size_mobile }}px;
    font-weight: {{ block.settings.comments_font_weight_mobile }};
    line-height: {{ block.settings.comments_line_height_mobile | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} #comments form .article-comment-card .share-story-submit,
  #shopify-section-{{ section.id }} #comments form .article-comment-card .share-story-submit .submit-button__content {
    font-size: {{ block.settings.button_font_size_mobile }}px;
    font-weight: {{ block.settings.button_font_weight_mobile }};
    line-height: {{ block.settings.button_line_height_mobile | divided_by: 100.0 }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} #comments .article-comment-card {
      border-radius: {{ block.settings.card_border_radius_desktop }}px;
      padding: {{ block.settings.card_padding_vertical_desktop }}px {{ block.settings.card_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} .article-posted-comment-card {
      border-radius: {{ block.settings.box_border_radius_desktop }}px;
      padding: {{ block.settings.box_padding_vertical_desktop }}px {{ block.settings.box_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} #comments form .article-comment-input,
    #shopify-section-{{ section.id }} #comments form .article-comment-textarea {
      border-radius: {{ block.settings.input_border_radius_desktop }}px;
      padding: {{ block.settings.input_padding_vertical_desktop }}px {{ block.settings.input_padding_horizontal_desktop }}px;
    }
    #shopify-section-{{ section.id }} #comments form .article-comment-card h3,
    #shopify-section-{{ section.id }} #comments form .article-comment-input,
    #shopify-section-{{ section.id }} #comments form .article-comment-textarea {
      font-size: {{ block.settings.comment_box_font_size_desktop }}px;
      font-weight: {{ block.settings.comment_box_font_weight_desktop }};
      line-height: {{ block.settings.comment_box_line_height_desktop | divided_by: 100.0 }};
    }
    #shopify-section-{{ section.id }} #comments form .article-comment-input::placeholder,
    #shopify-section-{{ section.id }} #comments form .article-comment-textarea::placeholder {
      font-size: {{ block.settings.comment_box_font_size_desktop }}px;
      font-weight: {{ block.settings.comment_box_font_weight_desktop }};
    }
    #shopify-section-{{ section.id }} .article-posted-comment-card,
    #shopify-section-{{ section.id }} .article-posted-comment-card footer {
      font-size: {{ block.settings.comments_font_size_desktop }}px;
      font-weight: {{ block.settings.comments_font_weight_desktop }};
      line-height: {{ block.settings.comments_line_height_desktop | divided_by: 100.0 }};
    }
    #shopify-section-{{ section.id }} #comments .article-comment-card h4 {
      font-size: {{ block.settings.comments_font_size_desktop }}px;
      font-weight: {{ block.settings.comments_font_weight_desktop }};
      line-height: {{ block.settings.comments_line_height_desktop | divided_by: 100.0 }};
    }
    #shopify-section-{{ section.id }} #comments form .article-comment-card .share-story-submit,
    #shopify-section-{{ section.id }} #comments form .article-comment-card .share-story-submit .submit-button__content {
      font-size: {{ block.settings.button_font_size_desktop }}px;
      font-weight: {{ block.settings.button_font_weight_desktop }};
      line-height: {{ block.settings.button_line_height_desktop | divided_by: 100.0 }};
    }
