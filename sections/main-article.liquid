{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Dynamic Design Overrides */
  .article-category-pill {
    border: 1px solid {{ section.settings.pill_color }};
    color: {{ section.settings.pill_color }};
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
    <header class="article-header">
      {%- if section.settings.show_category_pill and article.tags.size > 0 -%}
        <span class="article-category-pill">{{ article.tags.first }}</span>
      {%- endif -%}
      <h1 class="article-template__title article-title" itemprop="headline">{{ article.title | escape }}</h1>
    </header>

    <div class="article-grid">
      <aside class="article-sidebar">
        {%- if article.image -%}
          <div class="article-image-wrapper">
            <img
              srcset="
                {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                {{ article.image | image_url: width: 1100 }} 1100w
              "
              sizes="(min-width: 990px) 350px, 100vw"
              src="{{ article.image | image_url: width: 750 }}"
              loading="eager"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              alt="{{ article.image.alt | escape }}"
              class="article-image"
            >
          </div>
        {%- endif -%}

        {%- if section.settings.show_author or section.settings.show_date -%}
          <div class="article-meta-group">
            <span class="article-meta-label">
              {%- if section.settings.show_author -%}BY {{ article.author | upcase }}{%- endif -%}
            </span>
            {%- if section.settings.show_date -%}
              <span class="article-meta-value">{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_tags and article.tags.size > 0 -%}
          <div class="article-meta-group">
            <span class="article-meta-label">TAGS</span>
            <div class="article-tags-container">
              {%- for tag in article.tags -%}
                <span class="article-meta-value">{{ tag | upcase }}</span>
                {%- unless forloop.last -%}
                  <span class="article-meta-value">,</span>
                {%- endunless %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          <div class="article-meta-group">
            <span class="article-meta-label">SHARE</span>
            <div
              class="custom-share-icons"
              data-article-id="{{ article.id }}"
              data-article-url="{{ shop.url | append: article.url }}"
              data-article-title="{{ article.title | escape }}"
            >
              <!-- Like / Thumbs Up -->
              <button type="button" class="custom-share-link" data-action="like" aria-label="Like">
                {%- if section.settings.icon_like != blank -%}
                  {{
                    section.settings.icon_like
                    | image_url: width: 40
                    | image_tag: class: 'custom-share-icon', loading: 'lazy'
                  }}
                {%- else -%}
                  <svg
                    class="custom-share-icon"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                  </svg>
                {%- endif -%}
              </button>

              <!-- Send / Paper Plane -->
              <button type="button" class="custom-share-link" data-action="share" aria-label="Share">
                {%- if section.settings.icon_send != blank -%}
                  {{
                    section.settings.icon_send
                    | image_url: width: 40
                    | image_tag: class: 'custom-share-icon', loading: 'lazy'
                  }}
                {%- else -%}
                  <svg
                    class="custom-share-icon"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                {%- endif -%}
              </button>

              <!-- Comment / Chat Bubble -->
              <a
                href="#comments"
                class="custom-share-link"
                data-action="comment"
                aria-label="Comment"
              >
                {%- if section.settings.icon_comment != blank -%}
                  {{
                    section.settings.icon_comment
                    | image_url: width: 40
                    | image_tag: class: 'custom-share-icon', loading: 'lazy'
                  }}
                {%- else -%}
                  <svg
                    class="custom-share-icon"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                {%- endif -%}
              </a>

              <!-- Bookmark -->
              <button type="button" class="custom-share-link" data-action="save" aria-label="Bookmark">
                {%- if section.settings.icon_bookmark != blank -%}
                  {{
                    section.settings.icon_bookmark
                    | image_url: width: 40
                    | image_tag: class: 'custom-share-icon', loading: 'lazy'
                  }}
                {%- else -%}
                  <svg
                    class="custom-share-icon"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                {%- endif -%}
              </button>
            </div>
          </div>
        {%- endif -%}
      </aside>

      <div class="article-right-column">
        <div class="article-content rte" itemprop="articleBody">
          {{ article.content }}
        </div>

        {%- if blog.comments_enabled? -%}
          <div class="article-template__comment-wrapper background-secondary">
            <div id="comments" class="page-width page-width--narrow">
              {%- if article.comments_count > 0 -%}
                {%- assign anchor_id = '#Comments-' | append: article.id -%}
                <h4 id="Comments-{{ article.id }}" tabindex="-1">
                  {{ 'blogs.article.comments' | t: count: article.comments_count }}
                </h4>
                {% paginate article.comments by 5 %}
                  <div class="article-template__comments">
                    {%- if comment.status == 'pending' and comment.content -%}
                      <article
                        id="{{ comment.id }}"
                        class="article-template__comments-comment article-posted-comment-card"
                      >
                        {{ comment.content }}
                        <footer class="right">
                          <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                        </footer>
                      </article>
                    {%- endif -%}
                    {%- for comment in article.comments -%}
                      <article
                        id="{{ comment.id }}"
                        class="article-template__comments-comment article-posted-comment-card"
                      >
                        {{ comment.content }}
                        <footer class="right">
                          <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                          <span class="caption-with-letter-spacing">
                            {{- comment.created_at | time_tag: format: 'date' -}}
                          </span>
                        </footer>
                      </article>
                    {%- endfor -%}
                    {% render 'pagination', paginate: paginate, anchor: anchor_id %}
                  </div>
                {% endpaginate %}
              {%- endif -%}

              {% form 'new_comment', article %}
                {%- liquid
                  assign post_message = 'blogs.article.success'
                  if blog.moderated? and comment.status == 'unapproved'
                    assign post_message = 'blogs.article.success_moderated'
                  endif
                -%}
                <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
                {%- if form.errors -%}
                  <div class="form__message" role="alert">
                    <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                      {{ 'templates.contact.form.error_heading' | t }}
                    </h3>
                  </div>
                  <ul class="form-status-list caption-large">
                    {%- for field in form.errors -%}
                      <li>
                        <a href="#CommentForm-{{ field }}" class="link">
                          {%- if form.errors.translated_fields[field] contains 'author' -%}
                            {{ 'blogs.article.name' | t }}
                          {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                            {{ 'blogs.article.message' | t }}
                          {%- else -%}
                            {{ form.errors.translated_fields[field] }}
                          {%- endif -%}
                          {{ form.errors.messages[field] }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif form.posted_successfully? -%}
                  <div class="form-status-list form__message" role="status">
                    <h3 class="form-status" tabindex="-1" autofocus>
                      {{ post_message | t }}
                    </h3>
                  </div>
                {%- endif -%}

                <!-- STYLED COMMENT CARD -->
                <div class="article-comment-card">
                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-author"
                      data-text="{{ 'blogs.article.name' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.name' | t }}*</span>
                    </label>
                    <input
                      type="text"
                      name="comment[author]"
                      id="CommentForm-author"
                      class="article-comment-input"
                      autocomplete="name"
                      value="{{ form.author }}"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.name' | t }}"
                    >
                  </div>

                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-email"
                      data-text="{{ 'blogs.article.email' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.email' | t }}*</span>
                    </label>
                    <input
                      type="email"
                      name="comment[email]"
                      id="CommentForm-email"
                      autocomplete="email"
                      class="article-comment-input"
                      value="{{ form.email }}"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.email' | t }}"
                    >
                  </div>

                  <div class="article-comment-field">
                    <label
                      class="article-comment-label"
                      for="CommentForm-body"
                      data-text="{{ 'blogs.article.message' | t }}*"
                    >
                      <span class="article-comment-label-text">{{ 'blogs.article.message' | t }}*</span>
                    </label>
                    <textarea
                      rows="5"
                      name="comment[body]"
                      id="CommentForm-body"
                      class="article-comment-textarea"
                      aria-required="true"
                      required
                      placeholder="{{ 'blogs.article.message' | t }}"
                    >{{ form.body }}</textarea>
                  </div>

                  {%- if blog.moderated? -%}
                    <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
                  {%- endif -%}

                  {%- assign button_text = 'blogs.article.post' | t -%}
                  {% render 'submit-button', text: button_text, type: 'submit', class: 'share-story-submit' %}
                </div>
              {% endform %}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </article>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.custom-share-icons');
    if (!container) return;

    const articleId = container.dataset.articleId;
    const articleUrl = container.dataset.articleUrl;
    const articleTitle = container.dataset.articleTitle;

    // Load persisted States
    const storageKeyLike = `article-liked-${articleId}`;
    const storageKeySave = `article-saved-${articleId}`;

    const likeBtn = container.querySelector('[data-action="like"]');
    const saveBtn = container.querySelector('[data-action="save"]');
    const shareBtn = container.querySelector('[data-action="share"]');
    const commentLink = container.querySelector('[data-action="comment"]');

    // Initialize States
    if (likeBtn && localStorage.getItem(storageKeyLike) === 'true') {
      likeBtn.classList.add('active');
    }
    if (saveBtn && localStorage.getItem(storageKeySave) === 'true') {
      saveBtn.classList.add('active');
    }

    // Like Action
    if (likeBtn) {
      likeBtn.addEventListener('click', () => {
        const isActive = likeBtn.classList.toggle('active');
        localStorage.setItem(storageKeyLike, isActive);
      });
    }

    // Save Action
    if (saveBtn) {
      saveBtn.addEventListener('click', () => {
        const isActive = saveBtn.classList.toggle('active');
        localStorage.setItem(storageKeySave, isActive);
      });
    }

    // Share Action
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: articleTitle,
              url: articleUrl,
            });
          } catch (err) {
            console.log('Error sharing:', err);
          }
        } else {
          // Fallback to clipboard
          navigator.clipboard
            .writeText(articleUrl)
            .then(() => {
              alert('Link copied to clipboard!');
            })
            .catch((err) => {
              console.error('Failed to copy:', err);
            });
        }
      });
    }

    // Comment Action (scroll to comments)
    if (commentLink) {
      commentLink.addEventListener('click', (event) => {
        event.preventDefault(); // Prevent default anchor behavior
        const commentsSection = document.getElementById('comments');
        if (commentsSection) {
          commentsSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  });
</script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Article Header"
    },
    {
      "type": "checkbox",
      "id": "show_category_pill",
      "label": "Show category pill",
      "default": true
    },
    {
      "type": "color",
      "id": "pill_color",
      "label": "Category Pill Color",
      "default": "#ff5500"
    },
    {
      "type": "header",
      "content": "Article Sidebar"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "header",
      "content": "Share Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "icon_like",
      "label": "Like Icon Image",
      "info": "Upload a png/jpg to replace the default icon"
    },
    {
      "type": "image_picker",
      "id": "icon_send",
      "label": "Share Icon Image",
      "info": "Upload a png/jpg to replace the default icon"
    },
    {
      "type": "image_picker",
      "id": "icon_comment",
      "label": "Comment Icon Image",
      "info": "Upload a png/jpg to replace the default icon"
    },
    {
      "type": "image_picker",
      "id": "icon_bookmark",
      "label": "Bookmark Icon Image",
      "info": "Upload a png/jpg to replace the default icon"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
