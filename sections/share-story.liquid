{{ 'section-share-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    --share-story-input-height: {{ section.settings.input_height_mobile }}px;
    --share-story-input-width: {{ section.settings.input_width_mobile }}%;
    --share-story-label-font-size: {{ section.settings.label_font_size_mobile }}px;
    --share-story-label-font-weight: {{ section.settings.label_font_weight_mobile }};
    --share-story-label-line-height: {{ section.settings.label_line_height_mobile | divided_by: 100.0 }};
    --share-story-placeholder-font-size: {{ section.settings.placeholder_font_size_mobile }}px;
    --share-story-placeholder-font-weight: {{ section.settings.placeholder_font_weight_mobile }};
    --share-story-placeholder-line-height: {{ section.settings.placeholder_line_height_mobile | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .share-story-wrapper {
    gap: var(--bento-gap, 16px);
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .share-story-wrapper {
      gap: var(--bento-gap, 16px);
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      --share-story-input-height: {{ section.settings.input_height_desktop }}px;
      --share-story-input-width: {{ section.settings.input_width_desktop }}%;
      --share-story-label-font-size: {{ section.settings.label_font_size_desktop }}px;
      --share-story-label-font-weight: {{ section.settings.label_font_weight_desktop }};
      --share-story-label-line-height: {{ section.settings.label_line_height_desktop | divided_by: 100.0 }};
      --share-story-placeholder-font-size: {{ section.settings.placeholder_font_size_desktop }}px;
      --share-story-placeholder-font-weight: {{ section.settings.placeholder_font_weight_desktop }};
      --share-story-placeholder-line-height: {{ section.settings.placeholder_line_height_desktop | divided_by: 100.0 }};
    }
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'profile_card' -%}
      #shopify-section-{{ section.id }} .share-story-left {
        border-radius: {{ block.settings.card_border_radius_mobile }}px;
        padding: var(--page-layout-padding);
      }
      #shopify-section-{{ section.id }} .share-story-left .share-story-badge {
        font-size: {{ block.settings.tag_font_size_mobile }}px;
        font-weight: {{ block.settings.tag_font_weight_mobile }};
        line-height: {{ block.settings.tag_line_height_mobile | divided_by: 100.0 }};
        border-radius: {{ block.settings.tag_border_radius_mobile }}px;
        padding: {{ block.settings.tag_padding_vertical_mobile }}px {{ block.settings.tag_padding_horizontal_mobile }}px;
      }
      #shopify-section-{{ section.id }} .share-story-left .share-story-title {
        font-size: {{ block.settings.title_font_size_mobile }}px;
        font-weight: {{ block.settings.title_font_weight_mobile }};
        line-height: {{ block.settings.title_line_height_mobile | divided_by: 100.0 }};
      }
      #shopify-section-{{ section.id }} .share-story-left .share-story-subtitle {
        font-size: {{ block.settings.description_font_size_mobile }}px;
        font-weight: {{ block.settings.description_font_weight_mobile }};
        line-height: {{ block.settings.description_line_height_mobile | divided_by: 100.0 }};
      }
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .share-story-left {
          border-radius: {{ block.settings.card_border_radius_desktop }}px;
          padding: var(--page-layout-padding);
        }
        #shopify-section-{{ section.id }} .share-story-left .share-story-badge {
          font-size: {{ block.settings.tag_font_size_desktop }}px;
          font-weight: {{ block.settings.tag_font_weight_desktop }};
          line-height: {{ block.settings.tag_line_height_desktop | divided_by: 100.0 }};
          border-radius: {{ block.settings.tag_border_radius_desktop }}px;
          padding: {{ block.settings.tag_padding_vertical_desktop }}px {{ block.settings.tag_padding_horizontal_desktop }}px;
        }
        #shopify-section-{{ section.id }} .share-story-left .share-story-title {
          font-size: {{ block.settings.title_font_size_desktop }}px;
          font-weight: {{ block.settings.title_font_weight_desktop }};
          line-height: {{ block.settings.title_line_height_desktop | divided_by: 100.0 }};
        }
        #shopify-section-{{ section.id }} .share-story-left .share-story-subtitle {
          font-size: {{ block.settings.description_font_size_desktop }}px;
          font-weight: {{ block.settings.description_font_weight_desktop }};
          line-height: {{ block.settings.description_line_height_desktop | divided_by: 100.0 }};
        }
      }
    {%- elsif block.type == 'story_card' -%}
      #shopify-section-{{ section.id }} .share-story-right {
        border-radius: {{ block.settings.card_border_radius_mobile }}px;
        padding: var(--page-layout-padding);
      }
      #shopify-section-{{ section.id }} .share-story-right .share-story-title {
        font-size: {{ block.settings.title_font_size_mobile }}px;
        font-weight: {{ block.settings.title_font_weight_mobile }};
        line-height: {{ block.settings.title_line_height_mobile | divided_by: 100.0 }};
      }
      #shopify-section-{{ section.id }} .share-story-right .share-story-disclaimer {
        font-size: {{ block.settings.disclaimer_font_size_mobile }}px;
        font-weight: {{ block.settings.disclaimer_font_weight_mobile }};
        line-height: {{ block.settings.disclaimer_line_height_mobile | divided_by: 100.0 }};
      }
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .share-story-right {
          border-radius: {{ block.settings.card_border_radius_desktop }}px;
          padding: var(--page-layout-padding);
        }
        #shopify-section-{{ section.id }} .share-story-right .share-story-title {
