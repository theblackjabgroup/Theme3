{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'main-collection-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  /* Submit button styles for hover overlay button */
  .section-{{ section.id }}-padding .share-story-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg);
    color: white;
    border: 2px solid var(--color-primary-button-border);
    padding: 20px;
    border-radius: 100px;
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    box-shadow: 0px 4px 0px 0px var(--color-shadow);
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    margin-top: 5px;
    text-transform: none;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .section-{{ section.id }}-padding .share-story-submit:hover {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px 0px var(--color-shadow);
  }

  /* Section Level Settings */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    padding-left: {{ section.settings.section_padding_horizontal_mobile }}px;
    padding-right: {{ section.settings.section_padding_horizontal_mobile }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.min_height != blank and section.settings.min_height > 0 %}
      min-height: {{ section.settings.min_height }}vh;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-left: {{ section.settings.section_padding_horizontal }}px;
      padding-right: {{ section.settings.section_padding_horizontal }}px;
    }
  }

  /* Header Settings */
  .product-grid-header {
    text-align: {{ section.settings.title_alignment | default: 'center' }};
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .product-grid-header__badge {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid #ff4d4d;
    border-radius: 100px;
    color: #ff4d4d;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .product-grid-header__title {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.title_font_size }}rem;
    font-weight: 900;
    margin: 0 0 2rem 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-grid-header__description {
    font-size: 1.6rem;
    line-height: 1.6;
    color: #4a4a4a;
    margin: 0;
    font-family: var(--font-body-family);
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
      padding-left: {{ section.settings.section_padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.section_padding_horizontal_mobile }}px;
    }

    .product-grid-header__title {
      font-size: {{ section.settings.title_font_size_mobile }}rem;
    }
  }

  #product-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  #product-grid-{{ section.id }} .grid__item {
    display: flex;
    height: 100%;
    align-items: stretch;
  }

  #product-grid-{{ section.id }} .custom-collection-card-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    flex: 1;
  }

  /* Card Styles - Matching Collection List Design */
  #product-grid-{{ section.id }} .custom-collection-card {
    padding: {{ section.settings.card_padding_top | default: 0 }}px {{ section.settings.card_padding_horizontal | default: 24 }}px {{ section.settings.card_padding_bottom | default: 24 }}px;
    text-align: {{ section.settings.card_text_alignment | default: 'center' }};
    align-items: {{ section.settings.card_content_alignment | default: 'center' }};
    height: 100%;
    flex: 1;
  }

  #product-grid-{{ section.id }} .custom-collection-card__image-container {
    height: {{ section.settings.image_height | default: 250 }}px;
    margin-bottom: {{ section.settings.image_margin_bottom }}px;
  }

  /* Card Typography & Spacing Variables - Using Product Card Theme Settings */
  #product-grid-{{ section.id }} .custom-collection-card__title {
    font-size: {{ settings.product_card_title_font_size | default: 32 }}px;
    font-weight: {{ settings.product_card_title_font_weight | default: 900 }};
    line-height: {{ settings.product_card_title_line_height | default: 1 }};
    margin-top: {{ settings.product_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_title_margin_bottom | default: 12 }}px;
  }

  #product-grid-{{ section.id }} .custom-collection-card__description {
    font-size: {{ settings.product_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_description_font_weight | default: 400 }};
    line-height: {{ settings.product_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.product_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_description_margin_bottom | default: 20 }}px;
  }

  #product-grid-{{ section.id }} .custom-collection-card__badge {
    font-size: {{ settings.product_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_badge_font_weight | default: 700 }};
    padding: {{ settings.product_card_badge_padding_vertical | default: 4 }}px {{ settings.product_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.product_card_badge_margin_bottom | default: 10 }}px;
    {% if settings.product_card_badge_background_color != blank %}
      background-color: {{ settings.product_card_badge_background_color }};
    {% endif %}
    {% if settings.product_card_badge_text_color != blank %}
      color: {{ settings.product_card_badge_text_color }};
    {% endif %}
    {% if settings.product_card_badge_border_color != blank %}
      border-color: {{ settings.product_card_badge_border_color }};
    {% endif %}
    {% if settings.product_card_badge_border_width != blank %}
      border-width: {{ settings.product_card_badge_border_width }}px;
    {% endif %}
    {% if settings.product_card_badge_border_radius != blank %}
      border-radius: {{ settings.product_card_badge_border_radius }}px;
    {% endif %}
    {% if settings.product_card_badge_text_transform != blank %}
      text-transform: {{ settings.product_card_badge_text_transform }};
    {% endif %}
  }

  #product-grid-{{ section.id }} .custom-collection-card__hover-description {
    font-size: {{ settings.product_card_hover_description_font_size | default: 14 }}px;
    font-weight: {{ settings.product_card_hover_description_font_weight | default: 400 }};
  }

  #product-grid-{{ section.id }} .custom-collection-card__hover-button {
    /* Submit button snippet styles take precedence, these are overrides if needed */
    {% if settings.product_card_hover_button_font_size != blank %}
      font-size: {{ settings.product_card_hover_button_font_size }}px !important;
    {% endif %}
    {% if settings.product_card_hover_button_font_weight != blank %}
      font-weight: {{ settings.product_card_hover_button_font_weight }} !important;
    {% endif %}
    {% if settings.product_card_hover_button_padding_vertical != blank or settings.product_card_hover_button_padding_horizontal != blank %}
      padding: {{ settings.product_card_hover_button_padding_vertical | default: 10 }}px {{ settings.product_card_hover_button_padding_horizontal | default: 20 }}px !important;
    {% endif %}
  }

  #product-grid-{{ section.id }} .custom-collection-card__hover-content {
    gap: {{ settings.product_card_hover_content_gap | default: 10 }}px;
  }

  @media screen and (max-width: 1200px) {
    #product-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 2 }}, 1fr);
    }
  }

  @media screen and (max-width: 900px) {
    #product-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile | default: 16 }}px;
    }

    #product-grid-{{ section.id }} .custom-collection-card {
      padding: {{ section.settings.card_padding_top_mobile | default: 0 }}px {{ section.settings.card_padding_horizontal_mobile | default: 16 }}px {{ section.settings.card_padding_bottom_mobile | default: 20 }}px;
    }

    #product-grid-{{ section.id }} .custom-collection-card__image-container {
      height: {{ section.settings.image_height_mobile | default: 200 }}px;
      margin-bottom: {{ section.settings.image_margin_bottom_mobile }}px;
    }

    #product-grid-{{ section.id }} .custom-collection-card__title {
      {% if settings.product_card_title_font_size_mobile != blank %}
        font-size: {{ settings.product_card_title_font_size_mobile }}px;
      {% endif %}
      {% if settings.product_card_title_margin_top_mobile != blank %}
        margin-top: {{ settings.product_card_title_margin_top_mobile }}px;
      {% endif %}
      {% if settings.product_card_title_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.product_card_title_margin_bottom_mobile }}px;
      {% endif %}
    }

    #product-grid-{{ section.id }} .custom-collection-card__description {
      {% if settings.product_card_description_font_size_mobile != blank %}
        font-size: {{ settings.product_card_description_font_size_mobile }}px;
      {% endif %}
      {% if settings.product_card_description_margin_top_mobile != blank %}
        margin-top: {{ settings.product_card_description_margin_top_mobile }}px;
      {% endif %}
      {% if settings.product_card_description_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.product_card_description_margin_bottom_mobile }}px;
      {% endif %}
    }

    #product-grid-{{ section.id }} .custom-collection-card__badge {
      {% if settings.product_card_badge_font_size_mobile != blank %}
        font-size: {{ settings.product_card_badge_font_size_mobile }}px;
      {% endif %}
      {% if settings.product_card_badge_padding_vertical_mobile != blank %}
        padding-top: {{ settings.product_card_badge_padding_vertical_mobile }}px;
        padding-bottom: {{ settings.product_card_badge_padding_vertical_mobile }}px;
      {% endif %}
      {% if settings.product_card_badge_padding_horizontal_mobile != blank %}
        padding-left: {{ settings.product_card_badge_padding_horizontal_mobile }}px;
        padding-right: {{ settings.product_card_badge_padding_horizontal_mobile }}px;
      {% endif %}
      {% if settings.product_card_badge_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.product_card_badge_margin_bottom_mobile }}px;
      {% endif %}
    }

    #product-grid-{{ section.id }} .custom-collection-card__hover-description {
      {% if settings.product_card_hover_description_font_size_mobile != blank %}
        font-size: {{ settings.product_card_hover_description_font_size_mobile }}px;
      {% endif %}
    }

    #product-grid-{{ section.id }} .custom-collection-card__hover-button {
      {% if settings.product_card_hover_button_font_size_mobile != blank %}
        font-size: {{ settings.product_card_hover_button_font_size_mobile }}px !important;
      {% endif %}
      {% if settings.product_card_hover_button_padding_vertical_mobile != blank or settings.product_card_hover_button_padding_horizontal_mobile != blank %}
        padding: {{ settings.product_card_hover_button_padding_vertical_mobile | default: 8 }}px {{ settings.product_card_hover_button_padding_horizontal_mobile | default: 16 }}px !important;
      {% endif %}
    }

    #product-grid-{{ section.id }} .custom-collection-card__hover-content {
      {% if settings.product_card_hover_content_gap_mobile != blank %}
        gap: {{ settings.product_card_hover_content_gap_mobile }}px;
      {% endif %}
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_title != false -%}
    <div class="product-grid-header page-width">
      {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
        <span class="product-grid-header__badge">{{ section.settings.badge_text | escape }}</span>
      {%- elsif section.settings.header_badge != blank -%}
        <span class="product-grid-header__badge">{{ section.settings.header_badge | escape }}</span>
      {%- endif -%}
      <h1 class="product-grid-header__title">
        {{ section.settings.title | default: section.settings.header_title | default: collection.title | escape }}
      </h1>
      {%- if section.settings.header_description != blank or collection.description != blank -%}
        <p class="product-grid-header__description">
          {{ section.settings.header_description | default: collection.description | strip_html }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {% comment %} Redundant sorting removed per user request {% endcomment %}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div
            class="collection collection--empty page-width"
            id="product-grid-{{ section.id }}"
            data-id="{{ section.id }}"
          >
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid-{{ section.id }}"
              data-id="{{ section.id }}"
              class="grid product-grid {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}"
            >
              {%- for product in collection.products -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%
                    render 'card-product-custom',
                    card_product: product,
                    section_id: section.id,
                    quick_add: section.settings.quick_add,
                    lazy_load: forloop.index > 2,
                    show_badge: section.settings.show_card_badge,
                    badge_text: section.settings.card_badge_text,
                    overlay_button_text: section.settings.overlay_button_text,
                    fallback_description: section.settings.fallback_description
                  %}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Section Title",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Products",
      "info": "Leave blank to use collection title"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (rem)",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "default": 8
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Title Bottom Margin (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 65
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge in Header",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Header Badge Text",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "header_badge",
      "label": "Header Badge Text (Legacy)",
      "info": "Deprecated - use 'Header Badge Text' above"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title Override (Legacy)",
      "info": "Deprecated - use 'Section Title' above"
    },
    {
      "type": "textarea",
      "id": "header_description",
      "label": "Header Description Override",
      "info": "Leave blank to use collection description"
    },
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Section Padding Horizontal (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Section Height (vh)",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "info": "Set to 0 to disable"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns (Tablet)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Columns (Mobile)"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid Gap - Mobile (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "paragraph",
      "content": "Card typography and spacing settings are available in Theme Settings > Product cards"
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "card_content_alignment",
      "label": "Card Content Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_padding_top",
      "label": "Card Padding Top (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding_bottom",
      "label": "Card Padding Bottom (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding_horizontal",
      "label": "Card Padding Horizontal (px)",
