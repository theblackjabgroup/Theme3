{%- style -%}
  /* Submit button styles for hover overlay button */
  /* Section Level Settings */
  .section-{{ section.id }}-padding {
    --collection-filter-tag-bg: var(--btn-primary-bg);
    --collection-filter-tag-text-color: var(--btn-primary-text);
    --collection-filter-tag-border: var(--btn-primary-border);
    --collection-filter-tag-border-width: 0px;
    --collection-filter-tag-border-radius: 10px;
    --collection-filter-tag-font-size: 15px;
    --collection-filter-tag-font-weight: 700;
    --collection-filter-tag-text-transform: uppercase;
    --collection-filter-tag-letter-spacing: 0em;
    --collection-filter-tag-padding-vertical: 6px;
    --collection-filter-tag-padding-horizontal: 12px;
    --collection-filter-tag-gap: 8px;
    --collection-filter-tag-close-icon-size: 10px;
    background-color: var(--color-bg);
    /* Fixed minimum height now controlled by CSS only (no section setting) */
  }




  #product-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: var(--bento-gap);
    list-style: none;
    margin: 0;
    align-items: stretch;
  }

  #product-grid-{{ section.id }} .grid__item {
    display: flex;
    height: 100%;
    align-items: stretch;
  }

  #product-grid-{{ section.id }} .custom-product-card {
    --card-padding-top: 0px;
    --card-padding-horizontal: 20px;
    --card-padding-bottom: 20px;
    --card-text-align: center;
    --card-align-items: center;
    --card-image-height: 300px;
    --card-image-margin-bottom: 16px;
    --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size | default: 14 }}px;
    --card-hover-description-font-weight: {{ settings.product_card_hover_description_font_weight | default: 400 }};
    --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size | default: 12 }}px;
    --card-hover-button-font-weight: {{ settings.product_card_hover_button_font_weight | default: 600 }};
    --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical | default: 10 }}px;
    --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal | default: 20 }}px;
    --card-hover-content-gap: {{ settings.product_card_hover_content_gap | default: 10 }}px;
    --card-hover-button-border-radius: {{ settings.product_card_hover_button_border_radius | default: 20 }}px;
    --card-price-button-border-radius: {{ settings.product_card_price_button_border_radius | default: 12 }}px;
    --card-price-font-size: {{ settings.product_card_price_font_size | default: 16 }}px;
    --card-price-font-weight: {{ settings.product_card_price_font_weight | default: 700 }};
    --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical | default: 10 }}px;
    --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal | default: 18 }}px;
    --card-price-border-width: {{ settings.product_card_price_border_width | default: 1 }}px;
    --card-price-border-radius: {{ settings.product_card_price_border_radius | default: 12 }}px;
    transition: all 0.3s ease;
  }

  /* Typography & Spacing Overrides from Theme Settings */
  #product-grid-{{ section.id }} .custom-product-card__title {
    font-size: {{ settings.product_card_title_font_size | default: 24 }}px !important;
    font-weight: {{ settings.product_card_title_font_weight | default: 900 }};
    line-height: {{ settings.product_card_title_line_height | default: 1 }};
    margin-top: {{ settings.product_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_title_margin_bottom | default: 12 }}px;
  }

  #product-grid-{{ section.id }} .custom-product-card__description {
    font-size: {{ settings.product_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_description_font_weight | default: 400 }};
    line-height: {{ settings.product_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.product_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_description_margin_bottom | default: 0 }}px;
  }

  #product-grid-{{ section.id }} .custom-product-card__badge {
    font-size: {{ settings.product_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_badge_font_weight | default: 700 }};
    padding: {{ settings.product_card_badge_padding_vertical | default: 4 }}px {{ settings.product_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.product_card_badge_margin_bottom | default: 10 }}px;
    color: var(--color-heading);
    border-color: var(--color-heading);
  }

  /* Hover State Synchronization - Matching perfect design */

  #product-grid-{{ section.id }} .custom-product-card:hover .custom-product-card__hover-overlay {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 1024px) {
    #product-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 2 }}, 1fr);
    }
  }

  @media screen and (max-width: 989px) {
    #product-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile | default: 9 }}px;
    }

    #product-grid-{{ section.id }} .custom-product-card {
      --card-padding-top: 10px;
      --card-padding-horizontal: 16px;
      --card-padding-bottom: 28px;
      --card-image-height: 300px;
      --card-image-margin-bottom: 16px;
      --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size_mobile | default: 12 }}px;
      --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size_mobile | default: 12 }}px;
      --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical_mobile | default: 8 }}px;
      --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal_mobile | default: 16 }}px;
      --card-hover-content-gap: {{ settings.product_card_hover_content_gap_mobile | default: 8 }}px;
      --card-price-font-size: {{ settings.product_card_price_font_size_mobile | default: 14 }}px;
      --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical_mobile | default: 8 }}px;
      --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal_mobile | default: 14 }}px;
    }

    #product-grid-{{ section.id }} .custom-product-card__title {
      font-size: {{ settings.product_card_title_font_size_mobile | default: 24 }}px !important;
    }
  }

  /* Product grid: section header (snippet) — mobile spec */
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding > .section-header-snippet {
      padding-top: 24px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .section-{{ section.id }}-padding > .section-header-snippet .section-header-snippet__badge {
      font-size: 10px;
      font-weight: 400;
      border-radius: 24px;
      margin-bottom: 16px;
    }

    .section-{{ section.id }}-padding > .section-header-snippet .section-header-snippet__title {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: -2px;
    }

    .section-{{ section.id }}-padding > .section-header-snippet .section-header-snippet__description {
      margin-top: 16px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- liquid
    assign has_header_block = false
    for block in section.blocks
      if block.type == 'header'
        assign has_header_block = true
        break
      endif
    endfor
  -%}
  {%- if has_header_block -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'header' -%}
        {%- liquid
          assign header_title = block.settings.title | default: collection.title | default: 'Products'
          assign header_description = block.settings.header_description | default: collection.description | strip_html | default: 'Shop our collection.'
          assign resolved_header_image = block.settings.header_image
          if resolved_header_image == blank and block.settings.show_header_image
            assign resolved_header_image = collection.image
          endif
        -%}
        {% render 'section-header',
          id: block.id,
          show_badge: block.settings.show_badge,
          badge_text: block.settings.badge_text,
          title: header_title,
          description: header_description,
          title_alignment: block.settings.title_alignment,
          title_font_size: block.settings.title_font_size,
          title_font_weight: block.settings.title_font_weight,
          title_line_height: block.settings.title_line_height,
          title_letter_spacing: block.settings.title_letter_spacing,
          title_text_transform: block.settings.title_text_transform,
          title_margin_bottom: block.settings.title_margin_bottom,
          header_padding_top: block.settings.header_padding_top,
          header_padding_bottom: block.settings.header_padding_bottom,
          header_padding_horizontal: block.settings.header_padding_horizontal,
          badge_font_size: block.settings.header_badge_font_size,
          badge_font_weight: block.settings.header_badge_font_weight,
          badge_padding_vertical: block.settings.header_badge_padding_vertical,
          badge_padding_horizontal: block.settings.header_badge_padding_horizontal,
          badge_margin_bottom: block.settings.header_badge_margin_bottom,
          badge_border_width: block.settings.header_badge_border_width,
          badge_border_radius: block.settings.header_badge_border_radius,
          badge_text_transform: block.settings.header_badge_text_transform,
          description_font_size: block.settings.header_description_font_size,
          description_font_weight: block.settings.header_description_font_weight,
          description_line_height: block.settings.header_description_line_height,
          description_margin_top: block.settings.header_description_margin_top,
          title_font_size_mobile: block.settings.title_font_size_mobile,
          description_font_size_mobile: block.settings.header_description_font_size_mobile,
          border_radius: block.settings.header_border_radius,
          show_image: block.settings.show_header_image,
          header_image: resolved_header_image,
          image_alignment: block.settings.header_image_alignment,
          image_width_percent: block.settings.header_image_width_percent,
          image_width_percent_mobile: block.settings.header_image_width_percent_mobile,
          image_max_width: block.settings.header_image_max_width,
          image_height: block.settings.header_image_height,
          image_height_mobile: block.settings.header_image_height_mobile,
          image_object_fit: block.settings.header_image_object_fit,
          image_border_radius: block.settings.header_image_border_radius,
          image_margin_top: block.settings.header_image_margin_top,
          image_margin_bottom: block.settings.header_image_margin_bottom
        %}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} No header block: render a simple default header using collection data and section spacing {%- endcomment -%}
    {%- liquid
      assign default_header_title = collection.title | default: 'Products'
      assign default_header_description = collection.description | strip_html | default: 'Shop our collection.'
    -%}
    {%- if default_header_title != blank or default_header_description != blank -%}
      {% render 'section-header',
        id: section.id,
        show_badge: false,
        badge_text: '',
        title: default_header_title,
        description: default_header_description,
        header_padding_top: 20,
        header_padding_bottom: 20,
        header_padding_horizontal: 20
      %}
    {%- endif -%}
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign price_filter_gte_cents = blank
      assign price_filter_lte_cents = blank
      for filter in collection.filters
        if filter.type == 'price_range'
          if filter.min_value.value != null
            assign price_filter_gte_cents = filter.min_value.value
          endif
          if filter.max_value.value != null
            assign price_filter_lte_cents = filter.max_value.value
          endif
          break
        endif
      endfor

      assign visible_products_count = 0
      for product in collection.products
        assign product_visible = true
        if price_filter_gte_cents != blank and product.price_min < price_filter_gte_cents
          assign product_visible = false
        endif
        if price_filter_lte_cents != blank and product.price_min > price_filter_lte_cents
          assign product_visible = false
        endif
        if product_visible
          assign visible_products_count = visible_products_count | plus: 1
        endif
      endfor
    -%}

    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {% comment %} Redundant sorting removed per user request {% endcomment %}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical  {% endif %}">
      {{ 'facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %}  {% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate,
            top_bar_menu: section.settings.facets_top_bar_menu,
            facets_top_bar_links: section.blocks
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 or visible_products_count == 0 -%}
          <div
            class="collection collection--empty collection--empty-custom"
            id="product-grid-{{ section.id }}"
            data-id="{{ section.id }}"
          >
            <div class="collection-empty-card">
              <h2 class="collection-empty-heading">{{ 'sections.collection_template.empty' | t }}</h2>
              <p class="collection-empty-subtext">{{ 'sections.collection_template.use_fewer_filters_html' | t: class: 'collection-empty-link', link: collection.url }}</p>
              {%- assign _go_home_text = 'general.continue_shopping' | t -%}
              {%- render 'global-btn',
                text: _go_home_text,
                url: routes.root_url,
                variant: 'secondary',
                class: 'collection-empty-btn',
                border_radius: '12px'
              -%}
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %}  {% endif %}"
          >
            <ul
              id="product-grid-{{ section.id }}"
              data-id="{{ section.id }}"
              class="grid product-grid"
            >
              {%- assign visible_index = 0 -%}
              {%- for product in collection.products -%}
                {%- liquid
                  assign product_visible = true
                  if price_filter_gte_cents != blank and product.price_min < price_filter_gte_cents
                    assign product_visible = false
                  endif
                  if price_filter_lte_cents != blank and product.price_min > price_filter_lte_cents
                    assign product_visible = false
                  endif
                -%}
                {%- if product_visible -%}
                  {%- assign visible_index = visible_index | plus: 1 -%}
                  <li
                    class="grid__item{% if visible_index > 8 %} product-grid__see-more-hidden{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {%
                      render 'card-product',
                      card_product: product,
                      section_id: section.id,
                      quick_add: 'none',
                      lazy_load: forloop.index > 2
                    %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if visible_index > 8 -%}
              <div class="product-grid__see-more-wrap">
                <button
                  type="button"
                  class="product-grid__see-more"
                  data-product-grid-see-more
                  aria-controls="product-grid-{{ section.id }}"
                >
                  See More
                </button>
              </div>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>

<script>
  (function () {
    // Delegated "See More" handler — survives FacetFiltersForm AJAX re-renders because
    // it is attached to the document rather than to the (replaced) ProductGridContainer.
    if (document._productGridSeeMoreDelegated) return;
    document._productGridSeeMoreDelegated = true;

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-product-grid-see-more]');
      if (!btn) return;
      var gridId = btn.getAttribute('aria-controls');
      var grid = gridId ? document.getElementById(gridId) : null;
      if (grid) {
        grid.querySelectorAll('.product-grid__see-more-hidden').forEach(function (el) {
          el.classList.remove('product-grid__see-more-hidden');
        });
      }
      var wrap = btn.parentElement;
      if (wrap) wrap.remove();
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "disabled_on": {
    "groups": ["header", "footer"],
    "templates": ["index"]
  },
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "default": "scheme-4",
      "info": "When the theme toggle is in dark mode, use this scheme for this section."
    },

    {
      "type": "header",
      "content": "Grid · Products per row"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns (Tablet)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Columns (Mobile)"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap (px)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid Gap - Mobile (px)",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 9
    },
    {
      "type": "header",
      "content": "Filters · Layout & behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    {
      "type": "link_list",
      "id": "facets_top_bar_menu",
      "label": "Facets top bar menu",
      "info": "When set, shows up to 6 links with dots in the top bar when no filters are active. Leave blank to show only the collection title."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Section Header",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Section Title (Override)",
          "info": "Leave blank to use collection title."
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Badge"
        },
        {
          "type": "textarea",
          "id": "header_description",
          "label": "Description (Override)",
          "info": "Leave blank to use collection description."
        },
        {
          "type": "select",
          "id": "title_alignment",
          "label": "Title Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "label": "Title Font Size (rem)",
          "min": 1,
          "max": 10,
          "step": 0.1,
          "default": 3.2
        },
        {
          "type": "range",
          "id": "title_font_weight",
          "label": "Title Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 700
        },
        {
          "type": "range",
          "id": "title_line_height",
          "label": "Title Line Height",
          "min": 0.8,
          "max": 2,
          "step": 0.1,
          "default": 1.2
        },
        {
          "type": "range",
          "id": "title_letter_spacing",
          "label": "Title Letter Spacing (px)",
          "min": -5,
          "max": 10,
          "step": 1,
          "default": 0
        },
        {
          "type": "select",
          "id": "title_text_transform",
          "label": "Title Text Transform",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "title_margin_bottom",
          "label": "Title Bottom Margin (px)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 20
        },
        {
          "type": "range",
