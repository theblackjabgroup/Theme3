          "label": "Orbit speed",
          "default": 20
        },
        {
          "type": "header",
          "content": "Orbit (mobile)"
        },
        {
          "type": "range",
          "id": "circle_width_mobile",
          "min": 36,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Circle width (mobile)",
          "default": 48
        },
        {
          "type": "range",
          "id": "circle_height_mobile",
          "min": 36,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Circle height (mobile)",
          "default": 48
        },
        {
          "type": "range",
          "id": "orbit_font_size_mobile",
          "min": 6,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Orbit text size (mobile)",
          "default": 10
        },
        {
          "type": "range",
          "id": "orbit_text_gap_mobile",
          "min": 0,
          "max": 20,
          "step": 2,
          "unit": "px",
          "label": "Gap between orbit text (mobile)",
          "default": 8
        },
        {
          "type": "range",
          "id": "orbit_speed_mobile",
          "min": 5,
          "max": 60,
          "step": 1,
          "unit": "s",
          "label": "Orbit speed (mobile)",
          "default": 20
        },
        {
          "type": "header",
          "content": "Strip"
        },
        {
          "type": "color",
          "id": "strip_bg",
          "label": "Strip background",
          "default": "transparent"
        },
        {
          "type": "range",
          "id": "strip_border_radius",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Strip border radius",
          "default": 0
        },
        {
          "type": "range",
          "id": "strip_border_radius_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
