{{ 'section-scrolling-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .marquee-scroll {
    --section-gap: {{ section.settings.vertical_gap }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-left: {{ section.settings.margin_left }}px;
    --section-margin-right: {{ section.settings.margin_right }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .marquee-scroll {
      --section-margin-left: {{ section.settings.margin_left_mobile | default: section.settings.margin_left }}px !important;
      --section-margin-right: {{ section.settings.margin_right_mobile | default: section.settings.margin_right }}px !important;
    }
  }
  {%- for block in section.blocks -%}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .marquee-scroll__strip[data-block-id="{{ block.id }}"] {
      --text-font-size: {{ block.settings.text_size_mobile | default: block.settings.text_size }}px !important;
      --text-font-weight: {{ block.settings.text_weight_mobile | default: block.settings.text_weight }} !important;
      --pill-height: {{ block.settings.pill_height_mobile | default: block.settings.pill_height }}px !important;
      --pill-width: {{ block.settings.pill_width_mobile | default: block.settings.pill_width }}px !important;
      --pill-border-radius: {{ block.settings.pill_border_radius_mobile | default: block.settings.pill_border_radius }}px !important;
      --strip-border-radius: {{ block.settings.strip_border_radius_mobile | default: block.settings.strip_border_radius }}px !important;
      --circle-width: {{ block.settings.circle_width_mobile | default: block.settings.circle_width }}px !important;
      --circle-height: {{ block.settings.circle_height_mobile | default: block.settings.circle_height }}px !important;
      --orbit-font-size: {{ block.settings.orbit_font_size_mobile | default: block.settings.orbit_font_size }}px !important;
      --orbit-text-gap: {{ block.settings.orbit_text_gap_mobile | default: block.settings.orbit_text_gap }}px !important;
      --orbit-speed: {{ block.settings.orbit_speed_mobile | default: block.settings.orbit_speed }}s !important;
    }
  }
  {%- endfor -%}
{%- endstyle -%}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
-%}

<div class="marquee-scroll color-{{ scheme.id }}" id="shopify-section-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign scroll_dir = 'normal'
      if block.settings.direction == 'right'
        assign scroll_dir = 'reverse'
      endif
      assign orbit_dir = 'normal'
      if block.settings.orbit_direction == 'counterclockwise'
        assign orbit_dir = 'reverse'
      endif
    -%}

    <div
      class="marquee-scroll__strip{% if block.settings.pause_on_hover %} marquee-scroll__strip--pause-on-hover{% endif %}"
      {{ block.shopify_attributes }}
      data-block-id="{{ block.id }}"
      style="
        --marquee-speed: {{ block.settings.speed }}s;
        --marquee-direction: {{ scroll_dir }};
        --marquee-bg: {{ block.settings.strip_bg }};
        --strip-border-radius: {{ block.settings.strip_border_radius }}px;
        --marquee-padding: {{ block.settings.strip_padding }}px;
        --text-font-size: {{ block.settings.text_size }}px;
        --text-font-weight: {{ block.settings.text_weight }};
        --pill-bg: {{ block.settings.pill_bg }};
        --pill-color: {{ block.settings.pill_color }};
        --pill-height: {{ block.settings.pill_height }}px;
        --pill-width: {{ block.settings.pill_width }}px;
        --pill-border-radius: {{ block.settings.pill_border_radius }}px;
        --item-gap: {{ block.settings.item_gap }}px;
        --orbit-speed: {{ block.settings.orbit_speed }}s;
        --orbit-direction: {{ orbit_dir }};
        --orbit-font-size: {{ block.settings.orbit_font_size }}px;
        --orbit-text-gap: {{ block.settings.orbit_text_gap | default: 4 }}px;
        --orbit-color: {{ block.settings.orbit_text_color }};
        --circle-width: {{ block.settings.circle_width }}px;
        --circle-height: {{ block.settings.circle_height }}px;
        --circle-bg: {{ block.settings.circle_bg }};
      "
    >
      <div class="marquee-scroll__track">
        <div class="marquee-scroll__content">
        {%- for i in (1..12) -%}
          <div class="marquee-scroll__group">
            <span class="marquee-scroll__orbit">
              <span class="marquee-scroll__orbit-ring">
                <svg class="marquee-scroll__orbit-svg" viewBox="0 0 120 120" aria-hidden="true">
                  <defs>
                    <path id="orbit-path-{{ block.id }}-{{ i }}" d="M 18,60 A 42,42 0 0 1 102,60 A 42,42 0 0 1 18,60" fill="none" />
                  </defs>
                  <g class="marquee-scroll__orbit-track">
                    <text>
                      <textPath href="#orbit-path-{{ block.id }}-{{ i }}">
                        {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }}
                      </textPath>
                    </text>
                  </g>
                </svg>
              </span>
              <span class="marquee-scroll__orbit-center">
                {%- if block.settings.circle_icon != blank -%}
                  {{
                    block.settings.circle_icon
                    | image_url: width: 96
                    | image_tag: class: 'marquee-scroll__icon', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <span class="marquee-scroll__icon-placeholder"></span>
                {%- endif -%}
              </span>
            </span>

            <span class="marquee-scroll__pill">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
        </div>
        <div class="marquee-scroll__content" aria-hidden="true">
        {%- for i in (1..12) -%}
          <div class="marquee-scroll__group">
            <span class="marquee-scroll__orbit">
              <span class="marquee-scroll__orbit-ring">
                <svg class="marquee-scroll__orbit-svg" viewBox="0 0 120 120" aria-hidden="true">
                  <defs>
                    <path id="orbit-path-dup-{{ block.id }}-{{ i }}" d="M 18,60 A 42,42 0 0 1 102,60 A 42,42 0 0 1 18,60" fill="none" />
                  </defs>
                  <g class="marquee-scroll__orbit-track">
                    <text>
                      <textPath href="#orbit-path-dup-{{ block.id }}-{{ i }}">
                        {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }} {{ block.settings.orbit_text }}
                      </textPath>
                    </text>
                  </g>
                </svg>
              </span>
              <span class="marquee-scroll__orbit-center">
                {%- if block.settings.circle_icon != blank -%}
                  {{
                    block.settings.circle_icon
                    | image_url: width: 96
                    | image_tag: class: 'marquee-scroll__icon', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <span class="marquee-scroll__icon-placeholder"></span>
                {%- endif -%}
              </span>
            </span>
            <span class="marquee-scroll__pill">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Scrolling Text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Left margin",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Right margin",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_left_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Left margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_right_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Right margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between strips",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "scrolling_strip",
      "name": "Scrolling Strip",
      "settings": [
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>kokō</p>"
        },
        {
          "type": "range",
          "id": "text_size",
          "min": 14,
          "max": 48,
          "step": 2,
          "unit": "px",
          "label": "Text size",
          "default": 24
        },
        {
          "type": "select",
          "id": "text_weight",
          "label": "Text weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "600", "label": "Semi bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "700"
        },
        {
          "type": "color",
          "id": "pill_bg",
          "label": "Pill background",
          "default": "#2E473E"
        },
        {
          "type": "color",
          "id": "pill_color",
          "label": "Pill text color",
          "default": "#E8E4DC"
        },
        {
          "type": "range",
          "id": "pill_height",
          "min": 24,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Pill height",
          "default": 44
        },
        {
          "type": "range",
          "id": "pill_width",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "Pill min width",
          "default": 0,
          "info": "0 = auto (fits text)"
        },
        {
          "type": "range",
          "id": "pill_border_radius",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Pill border radius",
          "default": 14
        },
        {
          "type": "header",
          "content": "Mobile (pill)"
        },
        {
          "type": "range",
          "id": "text_size_mobile",
          "min": 12,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Text size (mobile)",
          "default": 20
        },
        {
          "type": "select",
          "id": "text_weight_mobile",
          "label": "Text weight (mobile)",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "600", "label": "Semi bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "700"
        },
        {
          "type": "range",
          "id": "pill_height_mobile",
          "min": 24,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Pill height (mobile)",
          "default": 36
        },
        {
          "type": "range",
          "id": "pill_width_mobile",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "Pill min width (mobile)",
          "default": 0,
          "info": "0 = auto (fits text)"
        },
        {
          "type": "range",
          "id": "pill_border_radius_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Pill border radius (mobile)",
          "default": 14
        },
        {
          "type": "header",
          "content": "Orbit icon"
        },
        {
          "type": "image_picker",
          "id": "circle_icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "orbit_text",
          "label": "Orbit text",
          "default": "KOKO"
        },
        {
          "type": "range",
          "id": "circle_width",
          "min": 48,
          "max": 120,
          "step": 4,
          "unit": "px",
          "label": "Circle width",
          "default": 56
        },
        {
          "type": "range",
          "id": "circle_height",
          "min": 48,
          "max": 120,
          "step": 4,
          "unit": "px",
          "label": "Circle height",
          "default": 56
        },
        {
          "type": "color",
          "id": "circle_bg",
          "label": "Circle background",
          "default": "#E0A8B8"
        },
        {
          "type": "color",
          "id": "orbit_text_color",
          "label": "Orbit text color",
          "default": "#2E473E"
        },
        {
          "type": "range",
          "id": "orbit_font_size",
          "min": 6,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Orbit text size",
          "default": 10
        },
        {
          "type": "range",
