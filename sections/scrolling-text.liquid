{{ 'section-scrolling-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .marquee-scroll {
    --section-gap: {{ section.settings.vertical_gap }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-left: {{ section.settings.margin_left }}px;
    --section-margin-right: {{ section.settings.margin_right }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .marquee-scroll {
      {%- assign ml = section.settings.margin_left_mobile -%}
      {%- if ml == nil -%}{%- assign ml = section.settings.margin_left -%}{%- endif -%}
      --section-margin-left: {{ ml }}px !important;
      {%- assign mr = section.settings.margin_right_mobile -%}
      {%- if mr == nil -%}{%- assign mr = section.settings.margin_right -%}{%- endif -%}
      --section-margin-right: {{ mr }}px !important;
    }
  }
  {%- for block in section.blocks -%}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .marquee-scroll__strip[data-block-id="{{ block.id }}"] {
      --text-font-size: {{ block.settings.text_size_mobile | default: block.settings.text_size }}px !important;
      --text-font-weight: {{ block.settings.text_weight_mobile | default: block.settings.text_weight }} !important;
      --pill-height: {{ block.settings.pill_height_mobile | default: block.settings.pill_height }}px !important;
      --pill-width: {{ block.settings.pill_width_mobile | default: block.settings.pill_width }}px !important;
      --pill-border-radius: {{ block.settings.pill_border_radius_mobile | default: block.settings.pill_border_radius }}px !important;
      --strip-border-radius: {{ block.settings.strip_border_radius_mobile | default: block.settings.strip_border_radius }}px !important;
      --circle-width: {{ block.settings.circle_width_mobile | default: block.settings.circle_width }}px !important;
      --circle-height: {{ block.settings.circle_height_mobile | default: block.settings.circle_height }}px !important;
      --icon-width: {{ block.settings.icon_width_mobile | default: block.settings.icon_width | default: 58 }}% !important;
      --icon-height: {{ block.settings.icon_height_mobile | default: block.settings.icon_height | default: 58 }}% !important;
      --orbit-font-size: {{ block.settings.orbit_font_size_mobile | default: block.settings.orbit_font_size }}px !important;
      --orbit-text-gap: {{ block.settings.orbit_text_gap_mobile | default: block.settings.orbit_text_gap }}px !important;
      --orbit-speed: {{ block.settings.orbit_speed_mobile | default: block.settings.orbit_speed }}s !important;
      --orbit-text-transform: {{ block.settings.orbit_text_transform_mobile | default: block.settings.orbit_text_transform }} !important;
    }
  }
  {%- endfor -%}
{%- endstyle -%}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
-%}

<div class="marquee-scroll color-{{ scheme.id }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign scroll_dir = 'normal'
      if block.settings.direction == 'right'
        assign scroll_dir = 'reverse'
      endif
      assign orbit_dir = 'normal'
      if block.settings.orbit_direction == 'counterclockwise'
        assign orbit_dir = 'reverse'
      endif

      assign orbit_gap = block.settings.orbit_text_gap
      if orbit_gap == null
        assign orbit_gap = 8
      endif
    -%}

    {% render 'scrolling-text-item',
      id: block.id,
      shopify_attributes: block.shopify_attributes,
      speed: block.settings.speed,
      direction: scroll_dir,
      pause_on_hover: block.settings.pause_on_hover,
      bg_color: block.settings.strip_bg,
      border_radius: block.settings.strip_border_radius,
      padding: block.settings.strip_padding,
      text_size: block.settings.text_size,
      text_weight: block.settings.text_weight,
      pill_bg: 'var(--btn-secondary-bg)',
      pill_color: 'var(--btn-secondary-text)',
      pill_height: block.settings.pill_height,
      pill_width: block.settings.pill_width,
      pill_radius: block.settings.pill_border_radius,
      item_gap: block.settings.item_gap,
      orbit_speed: block.settings.orbit_speed,
      orbit_direction: orbit_dir,
      orbit_font_size: block.settings.orbit_font_size,
      orbit_text_gap: orbit_gap,
      orbit_color: 'var(--btn-secondary-text)',
      orbit_text_transform: block.settings.orbit_text_transform,
      circle_width: block.settings.circle_width,
      circle_height: block.settings.circle_height,
      circle_bg: 'var(--btn-tertiary-bg)',
      icon_width: block.settings.icon_width,
      icon_height: block.settings.icon_height,
      circle_icon: block.settings.circle_icon,
      orbit_text: block.settings.orbit_text,
      text: block.settings.text
    %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Scrolling Text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Left margin",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Right margin",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_left_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Left margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_right_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Right margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between strips",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "scrolling_strip",
      "name": "Scrolling Strip",
      "settings": [
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>kokō</p>"
        },
        {
          "type": "range",
          "id": "text_size",
          "min": 14,
          "max": 48,
          "step": 2,
          "unit": "px",
          "label": "Text size",
          "default": 24
        },
        {
          "type": "select",
          "id": "text_weight",
          "label": "Text weight",
          "options": [
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "700"
        },
        {
          "type": "color",
          "id": "pill_bg",
          "label": "Pill background",
          "default": "#2E473E"
        },
        {
          "type": "color",
          "id": "pill_color",
          "label": "Pill text color",
          "default": "#E8E4DC"
        },
        {
          "type": "range",
          "id": "pill_height",
          "min": 24,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Pill height",
          "default": 44
        },
        {
          "type": "range",
          "id": "pill_width",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "Pill min width",
          "default": 0,
          "info": "0 = auto (fits text)"
        },
        {
          "type": "range",
          "id": "pill_border_radius",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Pill border radius",
          "default": 14
        },
        {
          "type": "header",
          "content": "Mobile (pill)"
        },
        {
          "type": "range",
          "id": "text_size_mobile",
          "min": 12,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Text size (mobile)",
          "default": 20
        },
        {
          "type": "select",
          "id": "text_weight_mobile",
          "label": "Text weight (mobile)",
          "options": [
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
