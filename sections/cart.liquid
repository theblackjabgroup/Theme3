{{ 'component-quantity.css' | asset_url | stylesheet_tag }}
{%- style -%}
  :root {
    --cart-bg: #d2cdc4;
    --cart-card-bg: #e5e1da;
    --cart-text: #273827;
    --cart-green: #365330;
    --cart-pink: #e0a8b8;
    --cart-border: #273827;
    --cart-shadow: #273827;
  }

  .custom-cart-section {
    padding: 20px;
    font-family: var(--font-body-family);
    background-color: var(--cart-bg);
    min-height: 100vh;
    color: var(--cart-text);
  }

  .cart-layout-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Header Section */
  .cart-header-section {
    text-align: center;
    margin-bottom: 20px;
  }

  .cart-title-box {
    background-color: var(--cart-card-bg);
    border-radius: 20px;
    padding: 40px;
    margin: 0 auto;
  }

  .cart-title-text {
    font-family: var(--font-heading-family);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 900;
    color: var(--cart-green);
    margin: 0 0 15px 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cart-subtitle-text {
    font-size: 18px;
    color: var(--cart-green);
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.4;
  }

  /* Grid Layout */
  .cart-grid {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .cart-items-column {
    flex: 1;
  }

  .cart-summary-column {
    width: 400px;
    flex-shrink: 0;
    position: sticky;
    top: 40px;
  }

  /* Items Header */
  .cart-items-header-row {
    display: flex;
    padding: 20px 40px;
    background-color: var(--cart-card-bg);
    border-radius: 20px;
    margin-bottom: 20px;
    font-weight: 800;
    font-size: 14px;
    color: var(--cart-green);
  }

  .header-label-product {
    flex: 1;
  }
  .header-label-quantity {
    width: 150px;
    text-align: center;
  }
  .header-label-total {
    width: 100px;
    text-align: right;
  }

  /* Item Card */
  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-item-card {
    background-color: var(--cart-card-bg);
    border-radius: 20px;
    overflow: hidden;
  }

  .cart-item-card__inner {
    display: flex;
    padding: 25px;
    align-items: center;
    gap: 30px;
  }

  .cart-item-card__image-wrap {
    position: relative;
    width: 180px;
    flex-shrink: 0;
  }

  .cart-item-card__image-container {
    background-color: #d8d4c7;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
  }

  .cart-item-card__image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Sale badge - sale icon with X% off centered */
  .cart-item-card__badge {
    position: absolute;
    top: -15px;
    left: -15px;
    width: 60px;
    height: 60px;
    z-index: 2;
  }

  .cart-item-card__badge-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cart-item-card__badge-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 10px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--cart-green);
    padding: 4px;
  }

  .cart-item-card__info {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 20px;
  }

  /* First row: product name, variant, quantity, price – full width */
  .cart-item-card__top-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
    flex-basis: 100%;
    min-width: 0;
  }

  .cart-item-card__details {
    flex: 1;
    min-width: 0;
    max-width: 200px;
  }

  .cart-item-card__name {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 22px;
    font-weight: 900;
    color: var(--cart-green);
    text-decoration: none;
    line-height: 1.1;
    margin-bottom: 5px;
  }

  .cart-item-card__variant {
    font-size: 13px;
    color: var(--cart-green);
    opacity: 0.7;
    display: block;
    margin-bottom: 15px;
  }

  /* Separator above Edit/Remove – full width under quantity and price */
  .cart-item-card__actions-separator {
    flex-basis: 100%;
    width: 100%;

    border-top: 1px solid #d2cdc4;
    order: 10;
  }

  /* Buttons handling – Edit and Remove match */
  .cart-item-card__actions {
    flex-basis: 100%;
    width: 100%;
    display: flex;
    gap: 10px;
    order: 11;
  }

  /* Same size and shape for both buttons – full width, same height */
  .cart-item-card__actions .cart-item-action-btn {
    flex: 1;
    min-width: 0;
  }

  .cart-item-action-btn .submit-button__content {
    padding: 12px 26px !important;
    font-size: 15px !important;
    border-radius: 14px !important;
  }

  .cart-item-action-btn .submit-button__shadow {
    top: 2px !important;
    border-radius: 14px !important;
  }

  .cart-item-action-btn:hover .submit-button__content {
    transform: translateY(-2px) !important;
  }

  /* Quantity selector (snippet) – using snippet defaults */
  .cart-item-card__quantity {
    display: flex;
    align-items: center;
  }

  .cart-item-card__total {
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    text-align: right;
    font-size: 20px;
    font-weight: 900;
    color: var(--cart-green);
    white-space: nowrap;
  }

  .cart-item-card__total .cart-item-card__current-price,
  .cart-item-card__total .cart-item-card__old-price {
    white-space: nowrap;
  }

  /* Summary Card */
  .cart-summary-card {
    background-color: var(--cart-card-bg);
    border-radius: 20px;
    padding: 30px;
  }

  .cart-summary-header {
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .continue-shopping-text {
    font-size: 14px;
    font-weight: 800;
    color: var(--cart-green);
    text-decoration: none;
  }

  .continue-shopping-text:hover {
    text-decoration: underline;
  }

  /* Continue Shopping – icon-only button (right of text) */
  .continue-shopping-btn .submit-button__content {
    background-color: var(--cart-card-bg) !important;
    color: var(--cart-green) !important;
    border: 1px solid var(--cart-border) !important;
    padding: 10px !important;
    font-size: 0 !important;
    border-radius: 14px !important;
    width: 42px;
    height: 42px;
    box-sizing: border-box;
  }

  .continue-shopping-btn .submit-button__shadow {
    background-color: var(--cart-shadow) !important;
    border-radius: 14px !important;
    top: 2px !important;
  }

  .continue-shopping-btn .submit-button__text {
    display: none !important;
  }

  .continue-shopping-btn .submit-button__icon {
    margin: 0;
  }

  .continue-shopping-btn .submit-button__icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .cart-summary__note {
    margin-bottom: 30px;
  }

  .cart-summary__note label {
    display: block;
    font-size: 16px;
    font-weight: 700;
    color: var(--cart-green);
    margin-bottom: 10px;
  }

  /* Order note – 3D same as submit button */
  .cart-note-input-wrap {
    position: relative;
    display: block;
  }

  .cart-note-input__shadow {
    position: absolute;
    top: 4px;
    left: 0;
    width: 100%;
    height: 95%;
    background-color: var(--cart-shadow);
    border-radius: 14px;
    z-index: 0;
    pointer-events: none;
  }

  .cart-note-input {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 120px;
    box-sizing: border-box;
    background-color: var(--cart-card-bg);
    border: 1px solid var(--cart-border);
    border-radius: 14px;
    padding: 15px;
    font-family: inherit;
    font-size: 14px;
    color: var(--cart-text);
    resize: none;
  }

  .cart-note-input::placeholder {
    color: var(--cart-green);
    opacity: 0.7;
  }

  .cart-note-input:focus {
    outline: none;
    box-shadow: none;
  }

  .cart-summary__totals {
    padding-top: 25px;
    margin-bottom: 30px;
  }

  .cart-summary__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .cart-summary__label-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .subtotal-label {
    font-size: 20px;
    font-weight: 800;
    color: var(--cart-green);
  }

  .subtotal-tax-note {
    font-size: 12px;
    color: var(--cart-green);
    opacity: 0.7;
    line-height: 1.2;
  }

  .subtotal-value {
    font-size: 20px;
    font-weight: 900;
    color: var(--cart-green);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .cart-summary__totals .checkout-btn-3d {
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
  }

  .cart-summary__totals .checkout-btn-3d .submit-button__content {
    width: 100% !important;
    box-sizing: border-box;
    background-color: var(--color-accent-pink) !important;
  }

  .cart-summary__totals .checkout-btn-3d .submit-button__shadow {
    width: 100% !important;
    box-sizing: border-box;
  }

  .cart-summary__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .payment-icon {
    height: 24px;
    width: auto;
  }

  /* Empty cart state */
  .cart-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 40px 20px;
    text-align: center;
  }

  .cart-empty__container {
    max-width: 480px;
    background-color: var(--cart-card-bg);
    border-radius: 20px;
    padding: 48px 40px;
    box-sizing: border-box;
  }

  .cart-empty__image {
    margin-bottom: 24px;
    border-radius: 16px;
    overflow: hidden;
    background-color: #d8d4c7;
  }

  .cart-empty__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .cart-empty__title {
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 900;
    color: var(--cart-green);
    margin: 0 0 12px 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .cart-empty__description {
    font-size: 16px;
    color: var(--cart-green);
    opacity: 0.85;
    line-height: 1.5;
    margin: 0 0 24px 0;
  }

  .cart-empty__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 800;
    color: var(--cart-card-bg);
    background-color: var(--cart-green);
    border: 1px solid var(--cart-border);
    border-radius: 14px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cart-empty__link:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 1024px) {
    .cart-grid {
      flex-direction: column;
    }
    .cart-summary-column {
      width: 100%;
      position: static;
    }
  }

  @media screen and (max-width: 768px) {
    .custom-cart-section {
      padding: 12px 16px;
    }
    .cart-header-section {
      margin-bottom: 16px;
    }
    .cart-title-box {
      padding: 24px 20px;
      border-radius: 16px;
    }
    .cart-title-text {
      font-size: clamp(24px, 6vw, 36px);
    }
    .cart-subtitle-text {
      font-size: 14px;
    }
    .cart-item-card__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 16px;
    }
    .cart-item-card__image-wrap {
      width: 100%;
      max-width: 200px;
    }
    .cart-item-card__info {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .cart-item-card__top-row {
      width: 100%;
      flex-wrap: wrap;
      gap: 12px;
    }
    .cart-item-card__details {
      max-width: none;
      flex: 1 1 100%;
    }
    .cart-item-card__name {
      font-size: 18px;
    }
    .cart-item-card__variant {
      font-size: 12px;
    }
    .cart-item-card__quantity {
      width: 100%;
      max-width: 140px;
    }
    .cart-item-card__total {
      width: 100%;
      text-align: left;
      font-size: 18px;
    }
    .cart-item-card__actions .cart-item-action-btn .submit-button__content {
      padding: 12px 16px !important;
      font-size: 14px !important;
    }
    .cart-items-header-row {
      display: none;
    }
    .cart-summary-card {
      padding: 20px;
      border-radius: 16px;
    }
    .cart-summary-header {
      flex-wrap: wrap;
      gap: 8px;
    }
    .continue-shopping-text {
      font-size: 13px;
    }
    .cart-summary__note label {
      font-size: 14px;
    }
    .cart-note-input {
      height: 100px;
      font-size: 14px;
      padding: 12px;
    }
    .subtotal-label,
    .subtotal-value {
      font-size: 18px;
    }
    .subtotal-tax-note {
      font-size: 11px;
    }
    .cart-item-card__badge {
      width: 50px;
      height: 50px;
      top: -10px;
      left: -10px;
    }
    .cart-item-card__badge-text {
      font-size: 9px;
    }
    .cart-empty__container {
      padding: 24px 20px;
      text-align: center;
    }
    .cart-empty__title {
      font-size: clamp(22px, 5vw, 32px);
    }
    .cart-empty__description {
      font-size: 14px;
    }
    .cart-empty__link {
      padding: 14px 24px;
      font-size: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-cart-section {
      padding: 10px 12px;
    }
    .cart-title-box {
      padding: 20px 16px;
      border-radius: 14px;
    }
    .cart-title-text {
      font-size: 22px;
    }
    .cart-subtitle-text {
      font-size: 13px;
    }
    .cart-item-card__inner {
      padding: 14px;
      gap: 14px;
    }
    .cart-item-card__image-wrap {
      max-width: 100%;
    }
    .cart-item-card__image-container {
      border-radius: 14px;
    }
    .cart-item-card__name {
      font-size: 16px;
    }
    .cart-item-card__total {
      font-size: 16px;
    }
    .cart-item-card__actions {
      flex-direction: column;
      gap: 8px;
    }
    .cart-item-card__actions .cart-item-action-btn {
      width: 100%;
    }
    .cart-summary-card {
      padding: 16px;
      border-radius: 14px;
    }
    .cart-summary__subtotal-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .payment-icon {
      height: 20px;
    }
    .cart-empty__container {
      padding: 20px 16px;
    }
    .cart-empty__title {
      font-size: 20px;
    }
    .cart-empty__description {
      font-size: 13px;
    }
    .cart-empty__link {
      padding: 12px 20px;
      font-size: 13px;
      min-height: 44px;
      line-height: 1.3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="custom-cart-section">
  <div class="cart-container">
    {%- if cart != empty -%}
      <div class="cart-layout-container">
        <!-- Breadcrumbs & Heading -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'header' -%}
            <div class="cart-header-section">
              <div class="cart-title-box">
                {% render 'section-header',
                  id: block.id,
                  show_badge: block.settings.show_badge,
                  badge_text: block.settings.badge_text,
                  title: block.settings.title,
                  description: block.settings.subtitle,
                  title_alignment: block.settings.title_alignment,
                  title_font_size: block.settings.title_font_size,
                  title_font_weight: block.settings.title_font_weight,
                  title_line_height: block.settings.title_line_height,
                  title_letter_spacing: block.settings.title_letter_spacing,
                  title_text_transform: block.settings.title_text_transform,
                  title_margin_bottom: block.settings.title_margin_bottom,
                  header_padding_top: block.settings.header_padding_top,
                  header_padding_bottom: block.settings.header_padding_bottom,
                  header_padding_horizontal: block.settings.header_padding_horizontal,
                  description_font_size: block.settings.subtitle_font_size,
                  description_font_weight: block.settings.subtitle_font_weight,
                  description_line_height: block.settings.subtitle_line_height,
                  description_color: block.settings.subtitle_color,
                  description_margin_top: block.settings.subtitle_margin_top,
                  title_font_size_mobile: block.settings.title_font_size_mobile,
                  description_font_size_mobile: block.settings.subtitle_font_size_mobile,
                  background_color: block.settings.header_background_color,
                  border_radius: block.settings.header_border_radius
                %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="cart-grid">
          <!-- Left Column: Cart Items -->
          <div class="cart-items-column">
            <div class="cart-items-header-row">
              <span class="header-label-product">PRODUCT</span>
              <span class="header-label-quantity">QUANTITY</span>
              <span class="header-label-total">TOTAL</span>
            </div>

            <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form">
              <div class="cart-items-list">
                {%- for item in cart.items -%}
                  <div class="cart-item-card" id="CartItem-{{ item.index | plus: 1 }}">
                    <div class="cart-item-card__inner">
                      <!-- Image Section -->
                      <div class="cart-item-card__image-wrap">
                        {%- assign has_compare = false -%}
                        {%- assign discount_pct = 0 -%}
                        {%- if item.variant.compare_at_price != blank
                          and item.variant.compare_at_price > item.final_price
                        -%}
                          {%- assign has_compare = true -%}
                          {%- assign savings = item.variant.compare_at_price | minus: item.final_price -%}
                          {%- assign discount_pct = savings | times: 100 | divided_by: item.variant.compare_at_price -%}
                        {%- endif -%}
                        {%- if has_compare and discount_pct > 0 -%}
                          <div class="cart-item-card__badge">
                            <img
                              class="cart-item-card__badge-icon"
                              src="{{ 'sale-icons.svg' | asset_url }}"
                              alt=""
                              width="60"
                              height="60"
                              loading="lazy"
                            >
                            <span class="cart-item-card__badge-text">
                              {{- discount_pct }}%<br>
                              off</span
                            >
                          </div>
                        {%- endif -%}
                        <div class="cart-item-card__image-container">
                          {% if item.image %}
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              class="cart-item-card__image"
                              width="120"
                              height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                              loading="lazy"
                            >
                          {% endif %}
                        </div>
                      </div>

                      <!-- Content Section -->
                      <div class="cart-item-card__info">
                        <div class="cart-item-card__top-row">
                          <div class="cart-item-card__details">
                            <div class="cart-item-card__title-row">
                              <a href="{{ item.url }}" class="cart-item-card__name">
                                {{- item.product.title | upcase -}}
                              </a>
                              {%- unless item.product.has_only_default_variant -%}
                                <span class="cart-item-card__variant">{{ item.variant.title }}</span>
                              {%- endunless -%}
                            </div>
                          </div>

                          <!-- Quantity Selector -->
                          <div class="cart-item-card__quantity">
                            {% render 'quantity-selector', item: item %}
                          </div>

                          <!-- Total Price -->
                          <div
                            class="cart-item-card__total"
                            data-item-index="{{ item.index | plus: 1 }}"
                            data-unit-price="{{ item.final_price }}"
                            data-original-unit-price="{{ item.original_price }}"
                          >
                            {%- if item.original_line_price != item.final_line_price -%}
                              <s class="cart-item-card__old-price">{{ item.original_line_price | money }}</s>
                            {%- endif -%}
                            <span class="cart-item-card__current-price">{{ item.final_line_price | money }}</span>
                          </div>
                        </div>

                        <div class="cart-item-card__actions-separator" aria-hidden="true"></div>
                        <div class="cart-item-card__actions">
                          {% capture edit_btn_attrs %}data-open-cart-drawer-edit data-line-index="{{ item.index | plus: 1 }}" aria-label="Edit {{ item.product.title | escape }}"{% endcapture %}
                          {% render 'submit-button',
                            text: 'Edit',
                            class: 'cart-item-action-btn cart-item-edit-btn',
                            attributes: edit_btn_attrs
                          %}
                          {% render 'submit-button',
                            text: 'Remove',
                            url: item.url_to_remove,
                            class: 'cart-item-action-btn cart-item-remove-btn'
                          %}
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </form>
          </div>

          <!-- Right Column: Summary -->
          <aside class="cart-summary-column">
            <div class="cart-summary-card">
              <div class="cart-summary-header">
                <a href="{{ routes.all_products_collection_url }}" class="continue-shopping-text">Continue Shopping</a>
                {%- capture continue_arrow_svg -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                {%- endcapture -%}
                {% render 'submit-button',
                  text: '',
                  url: routes.all_products_collection_url,
                  class: 'continue-shopping-btn',
                  icon: continue_arrow_svg
                %}
              </div>

              <div class="cart-summary__note">
                <label for="Cart-note">Add a note to your order</label>
                <div class="cart-note-input-wrap">
                  <span class="cart-note-input__shadow" aria-hidden="true"></span>
                  <textarea
                    name="note"
                    form="cart"
                    id="Cart-note"
                    class="cart-note-input"
                    placeholder="Order Note"
                  >{{ cart.note }}</textarea>
                </div>
              </div>

              <div class="cart-summary__totals">
                <div class="cart-summary__subtotal-row">
                  <div class="cart-summary__label-group">
                    <span class="subtotal-label">SUBTOTAL</span>
                    <span class="subtotal-tax-note">Taxes And Shipping Calculated At Checkout</span>
                  </div>
                  <span class="subtotal-value" id="cart-subtotal">{{ cart.total_price | money }}</span>
                </div>

                {% render 'submit-button',
                  text: 'Proceed To Checkout',
                  type: 'submit',
                  class: 'checkout-btn-3d',
                  attributes: 'name=\"checkout\" form=\"cart\"'
                %}
              </div>

              <!-- Payment Icons -->
              <div class="cart-summary__payments">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {%- endfor -%}
              </div>
            </div>
          </aside>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <div class="cart-empty__container">
          {%- if section.settings.empty_cart_image != blank -%}
            <div class="cart-empty__image">
              <img
                src="{{ section.settings.empty_cart_image | image_url: width: 600 }}"
                alt="{{ section.settings.empty_cart_image.alt | escape }}"
                width="{{ section.settings.empty_cart_image.width }}"
                height="{{ section.settings.empty_cart_image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          <h1 class="cart-empty__title">
            {{ section.settings.empty_cart_title | default: 'Your cart is currently empty!' }}
          </h1>

          {%- if section.settings.empty_cart_description != blank -%}
            <p class="cart-empty__description">{{ section.settings.empty_cart_description }}</p>
          {%- else -%}
            <p class="cart-empty__description">No products in the cart.</p>
          {%- endif -%}

          <a href="{{ routes.all_products_collection_url }}" class="cart-empty__link">
            {{ section.settings.empty_cart_button_text | default: 'Return to shop' }}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  // Handle header hide on cart container scroll
  (function () {
    const customCart = document.querySelector('.custom-cart-section');
    if (!customCart) return;

    const desktopHeader = document.querySelector('.floating-dock-header');
    const mobileHeader = document.querySelector('.mobile-header');
    const scrollThreshold = 50;
    let lastScrollTop = 0;
    let desktopIsVisible = true;
    let mobileIsVisible = true;

    // Check if mobile device (disable animations on mobile)
    let isMobile = window.innerWidth <= 768;

    // Set initial styles if headers exist
    if (desktopHeader) {
      desktopHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
      desktopHeader.style.willChange = 'transform';
      desktopHeader.style.right = '20px';
    }
    if (mobileHeader) {
      if (isMobile) {
        // Disable animation on mobile - keep header always visible
        mobileHeader.style.transition = 'none';
        mobileHeader.style.willChange = 'auto';
        mobileHeader.style.transform = 'translateX(0)';
      } else {
        mobileHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
        mobileHeader.style.willChange = 'transform';
      }
    }

    // Update mobile detection on resize
    window.addEventListener(
      'resize',
      () => {
        isMobile = window.innerWidth <= 768;
        // Update mobile header styles based on new mobile state
        if (mobileHeader) {
          if (isMobile) {
            mobileHeader.style.transition = 'none';
            mobileHeader.style.willChange = 'auto';
            mobileHeader.style.transform = 'translateX(0)';
            mobileIsVisible = true;
          } else {
            mobileHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
            mobileHeader.style.willChange = 'transform';
          }
        }
      },
      { passive: true }
    );

    window.addEventListener(
      'scroll',
      () => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollingDown = scrollTop > lastScrollTop;
        lastScrollTop = scrollTop;

        // Desktop header
        if (desktopHeader) {
          if (scrollTop <= scrollThreshold) {
            // At top - slide back in
            if (!desktopIsVisible) {
              desktopIsVisible = true;
              desktopHeader.style.right = '20px';
              desktopHeader.style.transform = 'translateX(0)';
            }
          } else if (scrollTop > scrollThreshold) {
            // Scrolled past threshold - slide out to the right
            if (desktopIsVisible) {
              desktopIsVisible = false;
              const rect = desktopHeader.getBoundingClientRect();
              const distanceToRight = window.innerWidth - rect.left;
              desktopHeader.style.transform = `translateX(${distanceToRight + 20}px)`;
            }
          }
        }

        // Mobile header - disable animation on mobile devices
        if (mobileHeader) {
          if (isMobile) {
            // On mobile, keep header always visible (no animation)
            mobileHeader.style.transform = 'translateX(0)';
            mobileIsVisible = true;
          } else {
            // Desktop behavior - animate header
            if (scrollTop <= scrollThreshold) {
              // At top - slide back in
              if (!mobileIsVisible) {
                mobileIsVisible = true;
                mobileHeader.style.transform = 'translateX(0)';
              }
            } else if (scrollTop > scrollThreshold) {
              // Scrolled past threshold - slide out to the right
              if (mobileIsVisible) {
                mobileIsVisible = false;
                mobileHeader.style.transform = 'translateX(100%)';
              }
            }
          }
        }
      },
      { passive: true }
    );
  })();

  // Handle real-time cart updates with plus/minus buttons
  (function () {
    let initialized = false;

    function initQuantitySelectors() {
      if (initialized) return;

      const quantitySelectors = document.querySelectorAll('.cart-item__quantity-selector');
      const cartSubtotal = document.getElementById('cart-subtotal');

      if (!quantitySelectors.length) {
        setTimeout(initQuantitySelectors, 100);
        return;
      }

      if (!window.routes || !window.routes.cart_update_url) {
        return;
      }

      initialized = true;

      function formatMoney(cents, originalFormat) {
        if (typeof cents === 'string') {
          return cents; // Already formatted
        }

        // Get the original format from the page or use provided format
        const originalTotal = originalFormat || (cartSubtotal ? cartSubtotal.textContent.trim() : '');
        if (originalTotal) {
          // Extract currency symbol and format
          const currencyMatch = originalTotal.match(/^([^\d\s.,]+)/);
          const currencySymbol = currencyMatch ? currencyMatch[1] : '';

          // Extract number format (with or without decimals)
          const numberMatch = originalTotal.match(/[\d,]+\.?\d*/);
          if (numberMatch) {
            const numberStr = numberMatch[0];
            const hasDecimals = numberStr.includes('.');

            // Calculate new amount
            const amount = (cents / 100).toFixed(2);
            const parts = amount.split('.');
            const wholePart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            const decimalPart = parts[1];

            // Format based on original format
            if (currencySymbol) {
              return currencySymbol + ' ' + wholePart + (hasDecimals ? '.' + decimalPart : '');
            } else {
              return wholePart + (hasDecimals ? '.' + decimalPart : '');
            }
          }
        }

        // Fallback: simple format
        const amount = (cents / 100).toFixed(2);
        return 'Rs. ' + amount;
      }

      function updateUIOnly(itemIndex, newQuantity) {
        // Find the item row
        const selector = document.querySelector(
          `.cart-item-card__quantity .cart-item__quantity-selector[data-item-index="${itemIndex}"]`
        );
        if (!selector) return;

        const itemCard = selector.closest('.cart-item-card');
        const itemTotalCell = itemCard.querySelector(`.cart-item-card__total[data-item-index="${itemIndex}"]`);
        const quantityInput = selector.querySelector('.quantity__input');

        if (!itemTotalCell || !quantityInput) return;

        // Get unit price from data attribute
        const unitPrice = parseInt(itemTotalCell.getAttribute('data-unit-price')) || 0;
        const originalUnitPrice = parseInt(itemTotalCell.getAttribute('data-original-unit-price')) || 0;

        // Calculate new line total
        const newLineTotal = unitPrice * newQuantity;
        const newOriginalLineTotal = originalUnitPrice * newQuantity;

        // Update quantity display
        quantityInput.value = newQuantity;

        // Update item total
        const formattedPrice = formatMoney(newLineTotal);
        const currentPriceSpan = itemTotalCell.querySelector('.cart-item-card__current-price');
        const oldPriceSpan = itemTotalCell.querySelector('.cart-item-card__old-price');
        if (currentPriceSpan) {
          currentPriceSpan.textContent = formattedPrice;
        } else {
          itemTotalCell.textContent = formattedPrice;
        }

        // Update discounted item's original (strikethrough) line price, if present
        if (oldPriceSpan && originalUnitPrice && originalUnitPrice !== unitPrice) {
          const originalFormat = oldPriceSpan.textContent.trim();
          oldPriceSpan.textContent = formatMoney(newOriginalLineTotal, originalFormat);
        }

        // Recalculate cart totals
        recalculateCartTotals();
      }

      function recalculateCartTotals() {
        let totalPrice = 0;
        const allTotalCells = document.querySelectorAll('.cart-item-card__total[data-unit-price]');

        allTotalCells.forEach((cell) => {
          const unitPrice = parseInt(cell.getAttribute('data-unit-price')) || 0;
          const quantityInput = cell.closest('.cart-item-card').querySelector('.quantity__input');
          const quantity = parseInt(quantityInput?.value) || 0;
          totalPrice += unitPrice * quantity;
        });

        // Update sidebar totals
        if (cartSubtotal) {
          const originalFormat = cartSubtotal.textContent.trim();
          cartSubtotal.textContent = formatMoney(totalPrice, originalFormat);
        }
      }

      function updatePlusButtonState(selector) {
        const plusBtn = selector.querySelector('.cart-item__quantity-plus');
        const quantityInput = selector.querySelector('.quantity__input');
        if (!plusBtn || !quantityInput) return;
        const currentQty = parseInt(quantityInput.value.trim(), 10) || 0;
        const maxQty = quantityInput.getAttribute('data-max');
        const max = maxQty != null ? parseInt(maxQty, 10) : null;
        plusBtn.disabled = max != null && currentQty >= max;
      }

      quantitySelectors.forEach((selector) => {
        const minusBtn = selector.querySelector('.cart-item__quantity-minus');
        const plusBtn = selector.querySelector('.cart-item__quantity-plus');
        const quantityInput = selector.querySelector('.quantity__input');
        const itemIndex = selector.getAttribute('data-item-index');

        if (!minusBtn || !plusBtn || !quantityInput || !itemIndex) {
          return;
        }

        updatePlusButtonState(selector);

        // Add event listeners
        minusBtn.addEventListener(
          'click',
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            const currentQty = parseInt(quantityInput.value.trim()) || 0;
            const newQty = Math.max(0, currentQty - 1);
            if (newQty !== currentQty) {
              updateUIOnly(itemIndex, newQty);
              updatePlusButtonState(selector);
            }
          },
          false
        );

        plusBtn.addEventListener(
          'click',
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            const currentQty = parseInt(quantityInput.value.trim()) || 0;
            const maxQty = quantityInput.getAttribute('data-max');
            const max = maxQty != null ? parseInt(maxQty, 10) : null;
            const newQty = max != null ? Math.min(currentQty + 1, max) : currentQty + 1;
            if (newQty !== currentQty) {
              updateUIOnly(itemIndex, newQty);
              updatePlusButtonState(selector);
            }
          },
          false
        );
      });
    }

    // Initialize when DOM is ready
    function startInit() {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(initQuantitySelectors, 100);
        });
      } else {
        setTimeout(initQuantitySelectors, 100);
      }
    }

    startInit();

    // Also try after a short delay in case elements load later
    setTimeout(() => {
      if (!initialized) {
        initQuantitySelectors();
      }
    }, 500);
  })();

  // Handle checkout button - update cart via API first, then redirect
  (function () {
    const checkoutButton = document.querySelector('.checkout-btn-3d');
    const cartForm = document.getElementById('cart');
    const checkoutUrl = (checkoutButton && checkoutButton.getAttribute('href')) || '/checkout';

    if (checkoutButton && cartForm && window.routes && window.routes.cart_update_url) {
      checkoutButton.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        // Build updates object
        const updates = {};
        const quantityInputs = cartForm.querySelectorAll('input[name="updates[]"]');

        quantityInputs.forEach((input) => {
          const line = input.getAttribute('data-index');
          const quantity = parseInt(input.value) || 0;
          if (line) {
            updates[line] = quantity;
          }
        });

        const noteInput = document.getElementById('Cart-note');
        const note = noteInput ? noteInput.value.trim() : '';

        // Update cart via API (quantities + note)
        const body = JSON.stringify({ updates: updates, note: note });

        fetch(`${window.routes.cart_update_url}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: body,
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error('Failed to update cart');
            }
            window.location.href = checkoutUrl;
          })
          .catch(() => {
            window.location.href = checkoutUrl;
          });
      });
    }
  })();
</script>

