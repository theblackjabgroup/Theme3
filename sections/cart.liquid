{{ 'component-quantity.css' | asset_url | stylesheet_tag }}
{{ 'component-global-btn.css' | asset_url | stylesheet_tag }}
{%- style -%}
    .custom-cart-section {
      font-family: var(--font-body-family);
      background-color: var(--color-bg);
      min-height: 100vh;
      color: var(--color-text);
    }

    .cart-layout-container {
      max-width: 1400px;
      margin: 0 auto;
    }

    /* Header Section */
    .cart-header-section {
      text-align: center;
      margin-bottom: var(--bento-gap);
    }

    .cart-title-box {
      background-color: var(--color-card-bg);
      border-radius: 20px;
      padding: 40px;
      margin: 0 auto;
    }

    .cart-title-text {
      font-family: var(--font-heading-family);
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: var(--font-weight-black, 900);
      color: var(--color-heading);
      margin: 0 0 15px 0;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .cart-subtitle-text {
      font-size: 18px;
      color: var(--color-heading);
      margin: 0;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.4;
    }

    /* Grid Layout */
    .cart-grid {
      display: flex;
      gap: var(--bento-gap);
      align-items: flex-start;
    }

    .cart-items-column {
      flex: 1;
    }

    .cart-summary-column {
      width: 400px;
      flex-shrink: 0;
      position: sticky;
      top: 40px;
    }

    /* Items Header */
    .cart-items-header-row {
      display: flex;
      padding: 20px 40px;
      background-color: var(--color-card-bg);
      border-radius: 16px;
      margin-bottom: var(--bento-gap);
      font-weight: 800;
      font-size: 14px;
      color: var(--color-text);
    }

    .header-label-product {
      flex: 1;
    }
    .header-label-quantity {
      flex: .55;
    }
    .header-label-total {
  text-align: right;
    }

    /* Item Card */
    .cart-items-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .cart-item-card {
      background-color: var(--color-card-bg);
      border-radius: 20px;
      overflow: visible; /* allow global-btn 3D shadow to show */
    }

    .cart-item-card__inner {
      display: flex;
      padding: 25px;
      align-items: center;
      gap: 30px;
    }

    .cart-item-card__image-wrap {
      position: relative;
      width: 180px;
      flex-shrink: 0;
    }

    .cart-item-card__image-container {
      background-color: var(--color-bg);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1;
    }

    .cart-item-card__image {
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }

    /* Sale badge - sale icon with X% off centered */
    .cart-item-card__badge {
      position: absolute;
      top: -15px;
      left: -15px;
      width: {{ settings.sale_badge_size }}px;
      height: {{ settings.sale_badge_size }}px;
      z-index: 2;
    }

    .cart-item-card__badge-icon {
      display: block;
      width: 100%;
      height: 100%;
      color: var(--sale-badge-bg, #F5A30A);
    }

    .cart-item-card__badge-text {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-weight: 950;
      color: var(--sale-badge-text, #000000);
      transform: rotate({{ settings.sale_badge_rotation }}deg);
      line-height: 1.1;
    }

    .cart-item-card__badge-text span:first-child {
      font-size: {{ settings.sale_badge_percent_size }}px;
      letter-spacing: -0.02em;
    }

    .cart-item-card__badge-text span:last-child {
      font-size: {{ settings.sale_badge_label_size }}px;
      text-transform: uppercase;
      margin-top: 1px;
    }

    .cart-item-card__info {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 20px;
    }

    /* First row: product name, variant, quantity, price – full width */
    .cart-item-card__top-row {
      display: flex;
      align-items: center;
      gap: 20px;
      width: 100%;
      flex-basis: 100%;
      min-width: 0;
    }

    .cart-item-card__details {
      flex: 1;
      min-width: 0;
      max-width: 200px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    .cart-item-card__name {
      display: block;
      font-family: var(--font-heading-family);
      font-size: 16px;
      font-weight: 900;
      color: var(--color-text);
      text-decoration: none;
      line-height: 1.1;
      margin-bottom: 5px;
    }

    .cart-item-card__variant {
      font-size: 13px;
      color: var(--color-text);
      opacity: 0.7;
      display: block;
    }

    /* Separator above Edit/Remove – full width under quantity and price */
    .cart-item-card__actions-separator {
      flex-basis: 100%;
      width: 100%;

      border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
      order: 10;
    }

    /* Buttons handling – Edit and Remove match */
    .cart-item-card__actions {
      flex-basis: 100%;
      width: 100%;
      display: flex;
      gap: 10px;
      order: 11;
    }

    /* Edit / Remove: global-btn primary – fill flex space so face and shadow match */
    .cart-item-card__actions .cart-item-action-btn.global-btn {
      flex: 1;
      min-width: 0;
      width: 100%;
      display: flex;
    }

    .cart-item-action-btn.global-btn .global-btn__content {
      width: 100%;
      padding: 12px 20px;
      font-size: 15px;
      border-radius: 14px;
    }

    .cart-item-action-btn.global-btn .global-btn__shadow {
      border-radius: 14px;
    }

    /* Quantity selector (snippet) – using snippet defaults */
    .cart-item-card__quantity {
      display: flex;
      align-items: center;
    }

    .cart-item-card__total {
      width: fit-content;
      max-width: 100%;
      margin-left: auto;
      text-align: right;
      font-size: 18px;
      color: var(--color-text);
      white-space: nowrap;
    }

    .cart-item-card__total .cart-item-card__current-price,
    .cart-item-card__total .cart-item-card__old-price {
      white-space: nowrap;
    }

    .cart-item-card__total .cart-item-card__old-price {
      font-size: 12px;
      font-weight: 400;
      text-decoration: line-through;
      opacity: 0.8;
      margin-right: 0.4em;
    }

    .cart-item-card__total .cart-item-card__current-price {
      font-size: 16px;
      font-weight: 700;
    }

    /* Summary Card */
    .cart-summary-card {
      background-color: var(--color-card-bg);
      border-radius: 20px;
      padding: 30px;
    }

    .cart-summary-header {
      margin-bottom: 25px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
    }

    .continue-shopping-text {
      font-size: 14px;
      font-weight: 800;
      color: var(--color-heading);
      text-decoration: none;
    }

    .continue-shopping-text:hover {
      text-decoration: underline;
    }

    /* Continue Shopping – global-btn tertiary icon-only, layout only */
    .continue-shopping-btn.global-btn.global-btn--tertiary {
      width: 42px;
      height: 42px;
      flex-shrink: 0;
    }

    .continue-shopping-btn.global-btn .global-btn__content {
      padding: 10px;
      width: 42px;
      height: 42px;
      border-radius: 14px;
      box-sizing: border-box;
    }

    .continue-shopping-btn.global-btn .global-btn__shadow {
      border-radius: 14px;
    }

    .continue-shopping-btn.global-btn .global-btn__icon svg {
      width: 20px;
      height: 20px;
    }

    .cart-summary__note {
      margin-bottom: 20px;
    }

    .cart-summary__note label {
      display: block;
      font-size: 16px;
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: 10px;
    }

    /* Order note – input-box snippet (no shadow) */
    .cart-summary__note .input-box__input {
      width: 100%;
      min-height: 120px;
      box-sizing: border-box;
      background-color: var(--color-card-bg);
      border: 1px solid var(--color-text);
      border-radius: 14px;
      padding: 15px;
      font-family: inherit;
      font-size: 14px;
      color: var(--color-text);
      resize: vertical;
    }

    .cart-summary__note .input-box__input::placeholder {
      color: var(--color-text);
      opacity: 0.7;
    }

    .cart-summary__note .input-box__input:focus {
      outline: none;
      box-shadow: none;
    }

    .cart-summary__totals {
      padding-top: 16px;
      margin-bottom: 30px;
      border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    }

    .cart-summary__subtotal-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .cart-summary__label-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .subtotal-label {
      font-size: 16px;
      font-weight: 800;
      color: var(--color-text);
    }

    .subtotal-tax-note {
      font-size: 12px;
      color: var(--color-text);
      opacity: 0.7;
      line-height: 1.2;
    }

    .subtotal-value {
      font-size: 20px;
      font-weight: 900;
      color: var(--color-text);
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    /* Proceed To Checkout: global-btn tertiary, full width – no color overrides */
    .cart-summary__totals .checkout-btn-3d.global-btn {
      width: 100%;
      max-width: 100%;
      display: block;
    }

    .cart-summary__totals .checkout-btn-3d.global-btn .global-btn__content {
      width: 100%;
      box-sizing: border-box;
      justify-content: center;
    }

    .cart-summary__totals .checkout-btn-3d.global-btn .global-btn__shadow {
      width: 100%;
      box-sizing: border-box;
    }

    .cart-summary__payments {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .payment-icon {
      height: 24px;
      width: auto;
    }

    /* Empty cart state */
    .cart-empty {
      display: flex !important;
      align-items: start !important;
      justify-content: start !important;
      min-height: calc(100vh - 40px) !important;
      text-align: center;
      box-sizing: border-box;
    }

    .cart-empty__container {
      flex-grow: 1;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      max-width: 100% !important;
      height: 100% !important;
      min-height: 95vh !important;
      background-color: var(--color-card-bg) !important;
      border-radius: var(--radius-2xl);
      box-sizing: border-box;
    }

    .cart-empty__image {
      margin-bottom: 40px !important;
      border-radius: var(--radius-none);
      background-color: transparent !important;
      max-width: 400px;
    }

    .cart-empty__image img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .cart-empty__title {
      font-family: var(--font-heading-family) !important;
      font-size: clamp(32px, 5vw, 56px) !important;
      font-weight: 900 !important;
      color: var(--color-heading) !important;
      margin: 0 !important;
      max-width: 500px !important;
      line-height: 1 !important;
      letter-spacing: -0.04em !important;
      text-transform: uppercase !important;
    }

    .cart-empty__description {
      font-family: var(--font-body-family) !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      color: var(--color-heading) !important;
          max-width: 350px !important;

      margin-top: 20px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.1em !important;
      opacity: 0.9;
      line-height: 1.5;
    }

    .cart-empty__link {
      display: none !important;
    }


    /* Tablet: stack columns, constrain summary width for readability */
    @media screen and (max-width: 1124px) {
        .header-label-quantity {
      flex: 0.35;
    }
      .custom-cart-section {
        padding: 16px 20px;
      }
      .cart-layout-container {
        max-width: 100%;
      }

      .cart-grid {
        flex-direction: column;
        gap: 24px;
        align-items: stretch;
      }
      .cart-items-column {
        min-width: 0;
      }
      .cart-summary-column {
        width: 100%;
        margin: 0 auto;
        position: static;
        order: 2;
      }
      .cart-header-section {
        margin-bottom: 18px;
      }
      .cart-title-box {
        padding: 32px 24px;
        border-radius: 18px;
      }
      .cart-title-text {
        font-size: clamp(28px, 5vw, 44px);
      }
      .cart-subtitle-text {
        font-size: 16px;
      }
      .cart-items-header-row {
        padding: 16px 24px;
        font-size: 13px;
        border-radius: 16px;
      }
      .cart-item-card__inner {
        padding: 20px 22px;
        gap: 24px;
      }
      .cart-item-card__image-wrap {
        width: 160px;
        flex-shrink: 0;
      }
      .cart-item-card__details {
        max-width: 100%;
      }
      .cart-item-card__name {
        font-size: 20px;
      }
      .cart-summary-card {
        padding: 24px;
        border-radius: 18px;
      }
      .cart-summary__totals {
        padding-top: 20px;
        margin-bottom: 24px;
      }
      .subtotal-label,
      .subtotal-value {
        font-size: 19px;
      }
    }

    @media screen and (max-width: 749px) {
      .custom-cart-section {
        padding: 12px 16px;
      }
      .cart-grid {
        gap: 20px;
      }
      .cart-summary-column {
        max-width: 100%;
      }
      .cart-header-section {
        margin-bottom: 16px;
      }
      .cart-title-box {
        padding: 24px 20px;
        border-radius: 16px;
      }
      .cart-title-text {
        font-size: clamp(24px, 6vw, 36px);
      }
      .cart-subtitle-text {
        font-size: 14px;
      }
      .cart-item-card__inner {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        padding: 16px;
      }
      .cart-item-card__image-wrap {
        width: 100%;
        max-width: 200px;
      }
      .cart-item-card__info {
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      .cart-item-card__top-row {
        width: 100%;
        flex-wrap: wrap;
        gap: 12px;
      }
      .cart-item-card__details {
        max-width: none;
        flex: 1 1 100%;
      }
      .cart-item-card__name {
        font-size: 18px;
      }
      .cart-item-card__variant {
        font-size: 12px;
      }
      .cart-item-card__quantity {
        width: 100%;
        max-width: 140px;
      }
      .cart-item-card__total {
        width: 100%;
        text-align: left;
        font-size: 18px;
      }
      .cart-item-card__actions .cart-item-action-btn.global-btn .global-btn__content {
        padding: 12px 16px;
        font-size: 14px;
      }
      .cart-items-header-row {
        display: none;
      }
      .cart-summary-card {
        padding: 20px;
        border-radius: 16px;
      }
      .cart-summary-header {
        flex-wrap: wrap;
        gap: 8px;
      }
      .continue-shopping-text {
        font-size: 13px;
      }
      .cart-summary__note label {
        font-size: 14px;
      }
      .cart-summary__note .input-box__input {
        min-height: 100px;
        font-size: 14px;
        padding: 12px;
      }
      .subtotal-label,
      .subtotal-value {
        font-size: 18px;
      }
      .subtotal-tax-note {
        font-size: 0.75rem;
      }
      .cart-item-card__badge {
        width: 50px;
        height: 50px;
        top: -10px;
        left: -10px;
      }
      .cart-item-card__badge-text {
        font-size: 0.75rem;
      }
      .cart-empty__container {
        padding: 24px 20px;
        text-align: center;
      }
      .cart-empty__title {
        font-size: clamp(1.375rem, 5vw, 2rem);
      }
      .cart-empty__description {
        font-size: 14px;
      }
      .cart-empty__link {
        padding: 14px 24px;
        font-size: 14px;
      }
    }
{%- endstyle -%}

<div class="custom-cart-section color-{{ section.settings.color_scheme }}">
  <div class="cart-container">
    {%- if cart != empty -%}
      <div class="cart-layout-container">
        <!-- Breadcrumbs & Heading -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'header' -%}
            <div class="cart-header-section">
              <div class="cart-title-box">
                {% render 'section-header',
                  id: block.id,
                  show_badge: block.settings.show_badge,
                  badge_text: block.settings.badge_text,
                  title: block.settings.title,
                  description: block.settings.subtitle,
                  title_alignment: block.settings.title_alignment,
                  title_font_size: block.settings.title_font_size,
                  title_font_weight: block.settings.title_font_weight,
                  title_line_height: block.settings.title_line_height,
                  title_letter_spacing: block.settings.title_letter_spacing,
                  title_text_transform: block.settings.title_text_transform,
                  title_margin_bottom: block.settings.title_margin_bottom,
                  header_padding_top: block.settings.header_padding_top,
                  header_padding_bottom: block.settings.header_padding_bottom,
                  header_padding_horizontal: block.settings.header_padding_horizontal,
                  description_font_size: block.settings.subtitle_font_size,
                  description_font_weight: block.settings.subtitle_font_weight,
                  description_line_height: block.settings.subtitle_line_height,
                  description_margin_top: block.settings.subtitle_margin_top,
                  title_font_size_mobile: block.settings.title_font_size_mobile,
                  description_font_size_mobile: block.settings.subtitle_font_size_mobile,
                  border_radius: block.settings.header_border_radius
                %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="cart-grid">
          <!-- Left Column: Cart Items -->
          <div class="cart-items-column">
            <div class="cart-items-header-row">
              <span class="header-label-product">PRODUCT</span>
              <span class="header-label-quantity">QUANTITY</span>
              <span class="header-label-total">TOTAL</span>
            </div>

            <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form">
              <div class="cart-items-list">
                {%- for item in cart.items -%}
                  <div class="cart-item-card" id="CartItem-{{ item.index | plus: 1 }}">
                    <div class="cart-item-card__inner">
                      <!-- Image Section -->
                      <div class="cart-item-card__image-wrap">
                        {%- assign has_compare = false -%}
                        {%- assign discount_pct = 0 -%}
                        {%- if item.variant.compare_at_price != blank
                          and item.variant.compare_at_price > item.final_price
                        -%}
                          {%- assign has_compare = true -%}
                          {%- assign savings = item.variant.compare_at_price | minus: item.final_price -%}
                          {%- assign discount_pct = savings | times: 100 | divided_by: item.variant.compare_at_price -%}
                        {%- endif -%}
                        {%- if has_compare and discount_pct > 0 -%}
                          <div class="cart-item-card__badge">
                            <svg
                              class="cart-item-card__badge-icon"
                              viewBox="0 0 73 72"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M35.4998 0.192998C35.2716 0.281184 33.9937 1.42531 32.66 2.73551L30.235 5.11767L27.1847 3.84233C23.928 2.48044 23.381 2.36984 22.345 2.86378C21.6431 3.19852 21.1746 4.05584 19.6395 7.81496L18.8248 9.80986L15.2277 9.86009C11.2814 9.91539 11.2098 9.93273 10.3732 11.0364C10.0563 11.4545 10.0274 11.7503 9.98095 15.0406L9.93068 18.5935L6.78384 19.8784C3.04052 21.4069 2.64762 21.7184 2.64762 23.1572C2.64762 23.8877 2.86216 24.542 3.8907 26.95L5.13377 29.86L2.74054 32.2389C1.42413 33.5473 0.267503 34.8246 0.170108 35.0774C-0.0593592 35.6723 -0.0562067 36.5867 0.176745 37.0397C0.27779 37.2362 1.4384 38.4689 2.75597 39.7787L5.15135 42.1604L3.80442 45.2597C2.59553 48.0414 2.46843 48.4309 2.56383 49.0612C2.75481 50.3237 3.27065 50.6987 6.78285 52.1297L9.93068 53.4119L9.98078 56.9684C10.0274 60.2624 10.0563 60.5582 10.3732 60.9763C11.2098 62.08 11.2814 62.0973 15.2277 62.1529L18.8248 62.2035L19.9863 64.9957C20.625 66.5315 21.3183 68.036 21.5267 68.3395C21.9295 68.9259 22.9758 69.5465 23.5615 69.5465C23.9476 69.5465 27.0256 68.3811 29.0816 67.4564L30.3786 66.8731L32.8148 69.2653C35.2612 71.6674 35.7369 72.0011 36.7135 72C37.5132 71.9992 38.104 71.5594 40.5507 69.1439C41.785 67.9256 42.823 66.9287 42.8578 66.9287C42.8925 66.9287 44.2564 67.4942 45.8887 68.1851C49.0481 69.5228 49.7352 69.6636 50.6984 69.1717C51.4113 68.8075 51.6157 68.4503 52.9963 65.1576L54.2089 62.2658L57.7546 62.184C61.7078 62.0929 61.9388 62.0337 62.7183 60.9131C63.1141 60.3437 63.1269 60.2317 63.1785 56.8582L63.2316 53.389L65.7503 52.3627C69.5439 50.8169 69.8175 50.6627 70.1855 49.8635C70.3594 49.4859 70.5014 48.9561 70.5014 48.6862C70.5012 48.4162 69.9477 46.8015 69.2713 45.0982L68.0415 42.001L70.3383 39.6866C73.9094 36.0882 73.9059 35.8838 70.2142 32.2076L67.7961 29.7996L69.0695 26.8586C70.4725 23.6184 70.5984 22.9548 69.9938 21.9902C69.585 21.338 69.0051 21.0303 65.5727 19.6445L63.0425 18.6231V15.324C63.0425 12.2279 63.0196 11.98 62.6691 11.2956C62.4231 10.8151 62.0695 10.4414 61.6321 10.2002C61.0053 9.85436 60.7787 9.83391 57.5459 9.83129L54.1233 9.82867L52.9205 6.97465C51.4984 3.60019 51.2836 3.2247 50.5643 2.8574C49.5603 2.34448 48.9063 2.47749 45.7251 3.84086L42.7599 5.11178L40.409 2.81322C37.625 0.0913965 36.843 -0.325974 35.4998 0.192998Z" fill="currentColor"/>
                            </svg>
                            <span class="cart-item-card__badge-text">
                              <span>{{- discount_pct }}%</span>
                              <span>off</span>
                            </span>
                          </div>
                        {%- endif -%}
                        <div class="cart-item-card__image-container">
                          {% if item.image %}
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              class="cart-item-card__image"
                              width="196"
                              height="{{ 196 | divided_by: item.image.aspect_ratio | ceil }}"
                              loading="lazy"
                            >
                          {% endif %}
                        </div>
                      </div>

                      <!-- Content Section -->
                      <div class="cart-item-card__info">
                        <div class="cart-item-card__top-row">
                          <div class="cart-item-card__details">
                            <div class="cart-item-card__title-row">
                              <a href="{{ item.url }}" class="cart-item-card__name">
                                {{- item.product.title | upcase -}}
                              </a>
                              {%- unless item.product.has_only_default_variant -%}
                                <span class="cart-item-card__variant">{{ item.variant.title }}</span>
                              {%- endunless -%}
                            </div>
                          </div>

                          <!-- Quantity Selector -->
                          <div class="cart-item-card__quantity">
                            {% render 'quantity-selector', item: item %}
                          </div>

                          <!-- Total Price (strikethrough original/compare_at when sale or discounted) -->
                          {%- liquid
                            assign show_old_price = false
                            assign old_line_price = item.original_line_price
                            if item.variant.compare_at_price != blank and item.variant.compare_at_price > item.final_price
                              assign compare_at_line = item.variant.compare_at_price | times: item.quantity
                              assign show_old_price = true
                              assign old_line_price = compare_at_line
                            elsif item.original_line_price > item.final_line_price
                              assign show_old_price = true
                              assign old_line_price = item.original_line_price
                            endif
                          -%}
                          <div
                            class="cart-item-card__total"
                            data-item-index="{{ item.index | plus: 1 }}"
                            data-unit-price="{{ item.final_price }}"
                            data-original-unit-price="{{ item.original_price }}"
                            {% if item.variant.compare_at_price != blank
                              and item.variant.compare_at_price > item.final_price
                            %}
                              data-compare-at-unit-price="{{ item.variant.compare_at_price }}"
                            {% endif %}
                          >
                            {%- if show_old_price -%}
                              <s class="cart-item-card__old-price" aria-label="Original price">
                                {{- old_line_price | money -}}
                              </s>
                            {%- endif -%}
                            <span class="cart-item-card__current-price">{{ item.final_line_price | money }}</span>
                          </div>
                        </div>

                        <div class="cart-item-card__actions-separator" aria-hidden="true"></div>
                        <div class="cart-item-card__actions">
                          {% capture edit_btn_attrs %}data-open-cart-drawer-edit data-line-index="{{ item.index | plus: 1 }}" aria-label="Edit {{ item.product.title | escape }}"{% endcapture %}
                          {% render 'global-btn',
                            text: 'Edit',
                            type: 'button',
                            variant: 'primary',
                            class: 'cart-item-action-btn cart-item-edit-btn',
                            attributes: edit_btn_attrs
                          %}
                          {% capture remove_btn_attrs %}data-line-index="{{ item.index | plus: 1 }}" aria-label="Remove {{ item.product.title | escape }}"{% endcapture %}
                          {% render 'global-btn',
                            text: 'Remove',
                            variant: 'primary',
                            type: 'button',
                            class: 'cart-item-action-btn cart-item-remove-btn',
                            attributes: remove_btn_attrs
                          %}
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </form>
          </div>

          <!-- Right Column: Summary -->
          <aside class="cart-summary-column">
            <div class="cart-summary-card">
              <div class="cart-summary-header">
                <a href="{{ routes.all_products_collection_url }}" class="continue-shopping-text">Continue Shopping</a>
                {%- capture continue_arrow_svg -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                {%- endcapture -%}
                {% render 'global-btn',
                  text: '',
                  url: routes.all_products_collection_url,
                  variant: 'primary',
                  class: 'continue-shopping-btn',
                  icon: continue_arrow_svg,
                  icon_only: true,
                  fit_width: false
                %}
              </div>

              <div class="cart-summary__note">
                {% render 'input-box',
                  id: 'Cart-note',
                  name: 'note',
                  form: 'cart',
                  placeholder: 'Order Note',
                  value: cart.note,
                  label: 'Add a note to your order',
                  rows: 4
                %}
              </div>

              <div class="cart-summary__totals">
                <div class="cart-summary__subtotal-row">
                  <div class="cart-summary__label-group">
                    <span class="subtotal-label">SUBTOTAL</span>
                    <span class="subtotal-tax-note">Taxes And Shipping Calculated At Checkout</span>
                  </div>
                  <span class="subtotal-value" id="cart-subtotal">{{ cart.total_price | money }}</span>
                </div>

                {% render 'global-btn',
                  text: 'Proceed To Checkout',
                  type: 'submit',
                  variant: 'tertiary',
                  class: 'checkout-btn-3d',
                  attributes: 'name="checkout" form="cart"'
                %}
              </div>

              <!-- Payment Icons -->
              <div class="cart-summary__payments">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {%- endfor -%}
              </div>
            </div>
          </aside>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <div class="cart-empty__container">
          {%- if section.settings.empty_cart_image != blank -%}
            <div class="cart-empty__image">
              <img
                src="{{ section.settings.empty_cart_image | image_url: width: 600 }}"
                alt="{{ section.settings.empty_cart_image.alt | escape }}"
                width="{{ section.settings.empty_cart_image.width }}"
                height="{{ section.settings.empty_cart_image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          <h1 class="cart-empty__title">YOUR SHOPPING CART IS EMPTY</h1>

          <p class="cart-empty__description">BUT IT DOESN'T HAVE TO BE. LETS ADD SOME ITEMS.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  // Handle header hide on cart container scroll
  (function () {
    const customCart = document.querySelector('.custom-cart-section');
    if (!customCart) return;

    const desktopHeader = document.querySelector('.floating-dock-header');
    const mobileHeader = document.querySelector('.mobile-header');
    const scrollThreshold = 50;
    let lastScrollTop = 0;
    let desktopIsVisible = true;
    let mobileIsVisible = true;

    // Check if mobile device (disable animations on mobile)
    let isMobile = window.innerWidth <= 749;

    // Set initial styles if headers exist
    if (desktopHeader) {
      desktopHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
      desktopHeader.style.willChange = 'transform';
      desktopHeader.style.right = '20px';
    }
    if (mobileHeader) {
      if (isMobile) {
        // Disable animation on mobile - keep header always visible
        mobileHeader.style.transition = 'none';
        mobileHeader.style.willChange = 'auto';
        mobileHeader.style.transform = 'translateX(0)';
      } else {
        mobileHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
        mobileHeader.style.willChange = 'transform';
      }
    }

    // Update mobile detection on resize
    window.addEventListener(
      'resize',
      () => {
        isMobile = window.innerWidth <= 749;
        // Update mobile header styles based on new mobile state
        if (mobileHeader) {
          if (isMobile) {
            mobileHeader.style.transition = 'none';
            mobileHeader.style.willChange = 'auto';
            mobileHeader.style.transform = 'translateX(0)';
            mobileIsVisible = true;
          } else {
            mobileHeader.style.transition = 'transform 1s cubic-bezier(0.4, 0, 0.2, 1)';
            mobileHeader.style.willChange = 'transform';
          }
        }
      },
      { passive: true }
    );

    window.addEventListener(
      'scroll',
      () => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollingDown = scrollTop > lastScrollTop;
        lastScrollTop = scrollTop;

        // Desktop header
        if (desktopHeader) {
          if (scrollTop <= scrollThreshold) {
            // At top - slide back in
            if (!desktopIsVisible) {
              desktopIsVisible = true;
              desktopHeader.style.right = '20px';
              desktopHeader.style.transform = 'translateX(0)';
            }
          } else if (scrollTop > scrollThreshold) {
            // Scrolled past threshold - slide out to the right
            if (desktopIsVisible) {
              desktopIsVisible = false;
              const rect = desktopHeader.getBoundingClientRect();
              const distanceToRight = window.innerWidth - rect.left;
              desktopHeader.style.transform = `translateX(${distanceToRight + 20}px)`;
            }
          }
        }

        // Mobile header - disable animation on mobile devices
        if (mobileHeader) {
          if (isMobile) {
            // On mobile, keep header always visible (no animation)
            mobileHeader.style.transform = 'translateX(0)';
            mobileIsVisible = true;
          } else {
            // Desktop behavior - animate header
            if (scrollTop <= scrollThreshold) {
              // At top - slide back in
              if (!mobileIsVisible) {
                mobileIsVisible = true;
                mobileHeader.style.transform = 'translateX(0)';
              }
            } else if (scrollTop > scrollThreshold) {
              // Scrolled past threshold - slide out to the right
              if (mobileIsVisible) {
                mobileIsVisible = false;
                mobileHeader.style.transform = 'translateX(100%)';
              }
            }
          }
        }
      },
      { passive: true }
    );
  })();

  // Handle real-time cart updates with plus/minus buttons
  (function () {
    let initialized = false;

    function initQuantitySelectors() {
      if (initialized) return;

      const quantitySelectors = document.querySelectorAll('.cart-item-card__quantity .cart-item__quantity-selector');
      const cartSubtotal = document.getElementById('cart-subtotal');

      if (!quantitySelectors.length) {
        setTimeout(initQuantitySelectors, 100);
        return;
      }

      if (!window.routes || !window.routes.cart_update_url) {
        return;
      }

      initialized = true;

      function formatMoney(cents, originalFormat) {
        if (typeof cents === 'string') {
          return cents; // Already formatted
        }

        // Get the original format from the page or use provided format
        const originalTotal = originalFormat || (cartSubtotal ? cartSubtotal.textContent.trim() : '');
        if (originalTotal) {
          // Extract currency symbol and format
          const currencyMatch = originalTotal.match(/^([^\d\s.,]+)/);
          const currencySymbol = currencyMatch ? currencyMatch[1] : '';

          // Extract number format (with or without decimals)
          const numberMatch = originalTotal.match(/[\d,]+\.?\d*/);
          if (numberMatch) {
            const numberStr = numberMatch[0];
            const hasDecimals = numberStr.includes('.');

            // Calculate new amount
            const amount = (cents / 100).toFixed(2);
            const parts = amount.split('.');
            const wholePart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            const decimalPart = parts[1];

            // Format based on original format
            if (currencySymbol) {
              return currencySymbol + ' ' + wholePart + (hasDecimals ? '.' + decimalPart : '');
            } else {
              return wholePart + (hasDecimals ? '.' + decimalPart : '');
            }
          }
        }

        // Fallback: simple format
        const amount = (cents / 100).toFixed(2);
        return 'Rs. ' + amount;
      }

      function updateUIOnly(itemIndex, newQuantity) {
        // Find the item row
        const selector = document.querySelector(
          `.cart-item-card__quantity .cart-item__quantity-selector[data-item-index="${itemIndex}"]`
        );
        if (!selector) return;

        const itemCard = selector.closest('.cart-item-card');
        const itemTotalCell = itemCard.querySelector(`.cart-item-card__total[data-item-index="${itemIndex}"]`);
        const quantityInput = selector.querySelector('.quantity__input');

        if (!itemTotalCell || !quantityInput) return;

        // Get unit price and original/compare-at from data attributes
        const unitPrice = parseInt(itemTotalCell.getAttribute('data-unit-price')) || 0;
        const compareAtUnitPrice = parseInt(itemTotalCell.getAttribute('data-compare-at-unit-price')) || 0;
        const originalUnitPrice = parseInt(itemTotalCell.getAttribute('data-original-unit-price')) || 0;
        const oldUnitPrice = compareAtUnitPrice > 0 ? compareAtUnitPrice : originalUnitPrice;

        // Calculate new line total and original (strikethrough) line total
        const newLineTotal = unitPrice * newQuantity;
        const newOriginalLineTotal = oldUnitPrice * newQuantity;
        const showOldPrice = oldUnitPrice > 0 && oldUnitPrice !== unitPrice;

        // Update quantity display
        quantityInput.value = newQuantity;

        // Update item total
        const formattedPrice = formatMoney(newLineTotal);
        const currentPriceSpan = itemTotalCell.querySelector('.cart-item-card__current-price');
        let oldPriceSpan = itemTotalCell.querySelector('.cart-item-card__old-price');
        if (currentPriceSpan) {
          currentPriceSpan.textContent = formattedPrice;
        } else {
          itemTotalCell.textContent = formattedPrice;
        }

        // Update or add strikethrough (original/compare_at) line price when discounted
        if (showOldPrice) {
          const originalFormat = oldPriceSpan ? oldPriceSpan.textContent.trim() : null;
          const formattedOld = formatMoney(newOriginalLineTotal, originalFormat);
          if (oldPriceSpan) {
            oldPriceSpan.textContent = formattedOld;
          } else {
            const s = document.createElement('s');
            s.className = 'cart-item-card__old-price';
            s.setAttribute('aria-label', 'Original price');
            s.textContent = formattedOld;
            itemTotalCell.insertBefore(s, currentPriceSpan || itemTotalCell.firstChild);
          }
        } else if (oldPriceSpan) {
          oldPriceSpan.remove();
        }

        // Recalculate cart totals
        recalculateCartTotals();
      }

      function recalculateCartTotals() {
        let totalPrice = 0;
        const allTotalCells = document.querySelectorAll('.cart-item-card__total[data-unit-price]');

        allTotalCells.forEach((cell) => {
          const unitPrice = parseInt(cell.getAttribute('data-unit-price')) || 0;
          const quantityInput = cell.closest('.cart-item-card').querySelector('.quantity__input');
          const quantity = parseInt(quantityInput?.value) || 0;
          totalPrice += unitPrice * quantity;
        });

        // Update sidebar totals
        if (cartSubtotal) {
          const originalFormat = cartSubtotal.textContent.trim();
          cartSubtotal.textContent = formatMoney(totalPrice, originalFormat);
        }
      }

      const MIN_QUANTITY = 1;

      function updatePlusButtonState(selector) {
        const plusBtn = selector.querySelector('.cart-item__quantity-plus');
        const quantityInput = selector.querySelector('.quantity__input');
        if (!plusBtn || !quantityInput) return;
        const currentQty = parseInt(quantityInput.value.trim(), 10) || MIN_QUANTITY;
        const maxQty = quantityInput.getAttribute('data-max');
        const max = maxQty != null ? parseInt(maxQty, 10) : null;
        plusBtn.disabled = max != null && currentQty >= max;
      }

      function updateMinusButtonState(selector) {
        const minusBtn = selector.querySelector('.cart-item__quantity-minus');
        const quantityInput = selector.querySelector('.quantity__input');
        if (!minusBtn || !quantityInput) return;
        const currentQty = parseInt(quantityInput.value.trim(), 10) || MIN_QUANTITY;
        minusBtn.disabled = currentQty <= MIN_QUANTITY;
      }

      quantitySelectors.forEach((selector) => {
        const minusBtn = selector.querySelector('.cart-item__quantity-minus');
        const plusBtn = selector.querySelector('.cart-item__quantity-plus');
        const quantityInput = selector.querySelector('.quantity__input');
        const itemIndex = selector.getAttribute('data-item-index');

        if (!minusBtn || !plusBtn || !quantityInput || !itemIndex) {
          return;
        }

        updatePlusButtonState(selector);
        updateMinusButtonState(selector);

        // Add event listeners
        minusBtn.addEventListener(
          'click',
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            const currentQty = parseInt(quantityInput.value.trim(), 10) || MIN_QUANTITY;
            const newQty = Math.max(MIN_QUANTITY, currentQty - 1);
            if (newQty !== currentQty) {
              updateUIOnly(itemIndex, newQty);
              updatePlusButtonState(selector);
              updateMinusButtonState(selector);
            }
          },
          false
        );

        plusBtn.addEventListener(
          'click',
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            const currentQty = parseInt(quantityInput.value.trim()) || 0;
            const maxQty = quantityInput.getAttribute('data-max');
            const max = maxQty != null ? parseInt(maxQty, 10) : null;
            const newQty = max != null ? Math.min(currentQty + 1, max) : currentQty + 1;
            if (newQty !== currentQty) {
              updateUIOnly(itemIndex, newQty);
              updatePlusButtonState(selector);
              updateMinusButtonState(selector);
            }
          },
          false
        );

        quantityInput.addEventListener('change', function () {
          const maxQty = quantityInput.getAttribute('data-max');
          const max = maxQty != null ? parseInt(maxQty, 10) : null;
          let val = parseInt(quantityInput.value.trim(), 10);
          if (isNaN(val) || val < MIN_QUANTITY) val = MIN_QUANTITY;
          if (max != null && val > max) val = max;
          quantityInput.value = val;
          updateUIOnly(itemIndex, val);
          updatePlusButtonState(selector);
          updateMinusButtonState(selector);
        });
      });
    }

    // Initialize when DOM is ready
    function startInit() {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(initQuantitySelectors, 100);
        });
      } else {
        setTimeout(initQuantitySelectors, 100);
      }
    }

    startInit();

    // Also try after a short delay in case elements load later
    setTimeout(() => {
      if (!initialized) {
        initQuantitySelectors();
      }
    }, 500);
  })();

  // Remove button: use cart change.js API then reload (works in storefront and theme editor)
  (function () {
    function initRemoveHandler() {
      const cartForm = document.getElementById('cart');
      if (!cartForm) return;

      const changeUrl =
        window.routes && window.routes.cart_change_url
          ? window.routes.cart_change_url.replace(/\/change\/?(\?.*)?$/i, '/change.js')
          : '/cart/change.js';

      cartForm.addEventListener(
        'click',
        function (e) {
          const removeBtn = e.target.closest('.cart-item-remove-btn');
          if (!removeBtn) return;
          const line = removeBtn.getAttribute('data-line-index');
          if (!line) return;

          e.preventDefault();
          e.stopPropagation();

          fetch(changeUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ line: parseInt(line, 10), quantity: 0 }),
          })
            .then((res) => (res.ok ? res.json() : Promise.reject(new Error('Cart update failed'))))
            .then(() => {
              window.location.reload();
            })
            .catch(() => {
              window.location.reload();
            });
        },
        true
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRemoveHandler);
    } else {
      initRemoveHandler();
    }
  })();

  // Handle checkout button - update cart via API first, then redirect
  (function () {
    const checkoutButton = document.querySelector('.checkout-btn-3d');
    const cartForm = document.getElementById('cart');
    const checkoutUrl = (checkoutButton && checkoutButton.getAttribute('href')) || '/checkout';

    if (checkoutButton && cartForm && window.routes && window.routes.cart_update_url) {
      checkoutButton.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        // Build updates object
        const updates = {};
        const quantityInputs = cartForm.querySelectorAll('input[name="updates[]"]');

        quantityInputs.forEach((input) => {
          const line = input.getAttribute('data-index');
          const quantity = parseInt(input.value) || 0;
          if (line) {
            updates[line] = quantity;
          }
        });

        const noteInput = document.getElementById('Cart-note');
        const note = noteInput ? noteInput.value.trim() : '';

        // Update cart via API (quantities + note)
        const body = JSON.stringify({ updates: updates, note: note });

        fetch(`${window.routes.cart_update_url}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: body,
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error('Failed to update cart');
            }
            window.location.href = checkoutUrl;
          })
          .catch(() => {
            window.location.href = checkoutUrl;
          });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "enabled_on": {
    "templates": ["cart"]
  },
