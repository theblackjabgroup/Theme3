{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if request.visual_preview_mode -%}
    {%- assign section_selector = '.rte-rich-text[data-section-id="' | append: section.id | append: '"]' -%}
  {%- else -%}
    {%- assign section_selector = '#shopify-section-' | append: section.id -%}
  {%- endif -%}

  {{ section_selector }} {
    --rte-header-margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.side_margin | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.side_margin | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.side_margin }}px;
      padding-right: {{ section.settings.side_margin }}px;
    }
  }

  {{ section_selector }} .rte-rich-text__outer {
    background-color: var(--color-bg);
  }

  {{ section_selector }} .rte-rich-text__header-card,
  {{ section_selector }} .rte-rich-text__context-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-input-border);
    border-radius: {{ section.settings.content_border_radius }}px;
    max-width: {{ section.settings.content_max_width }}px;
    padding: {{ section.settings.content_padding }}px;
    {%- if section.settings.card_shadow != blank -%}
    box-shadow: {{ section.settings.card_shadow }};
    {%- endif -%}
  }

  {{ section_selector }} .rte-rich-text__header-card {
    margin-bottom: var(--rte-header-margin-bottom);
  }

  {{ section_selector }} .rte-rich-text__tag {
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border-color: var(--btn-primary-border);
    border-radius: {{ section.settings.tag_border_radius }}px;
    padding: {{ section.settings.tag_padding_vertical }}px {{ section.settings.tag_padding_horizontal }}px;
    font-size: {{ section.settings.tag_font_size }}px;
  }

  {{ section_selector }} .rte-rich-text__title {
    color: var(--color-heading);
    font-size: {{ section.settings.title_font_size }}px;
  }

  {{ section_selector }} .rte-rich-text__body {
    color: var(--color-text);
    font-size: {{ section.settings.body_font_size }}px;
    line-height: {{ section.settings.body_line_height }};
  }

  {{ section_selector }} .rte-rich-text__body h1,
  {{ section_selector }} .rte-rich-text__body h2,
  {{ section_selector }} .rte-rich-text__body h3 {
    color: var(--color-heading);
    font-size: {{ section.settings.heading_font_size }}px;
  }
{%- endstyle -%}

<div class="rte-rich-text color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="rte-rich-text__outer">
    <div class="rte-rich-text__header-card">
      <header class="rte-rich-text__header rte-rich-text__header--{{ section.settings.header_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.show_tag and section.settings.tag != blank -%}
          <span class="rte-rich-text__tag">{{ section.settings.tag | escape }}</span>
        {%- endif -%}
        {%- if page.title != blank -%}
          <h1 class="rte-rich-text__title">{{ page.title | escape }}</h1>
        {%- endif -%}
      </header>
    </div>

    <div class="rte-rich-text__context-card">
      <div class="rte-rich-text__body rte rte-rich-text__body--{{ section.settings.text_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Content border radius",
      "default": 12
    },
    {
      "type": "text",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": "0 4px 12px rgba(0, 0, 0, 0.08)",
      "info": "CSS box-shadow value for the cards"
    },
    {
      "type": "header",
      "content": "Block spacing"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Header to context margin",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "side_margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Side margin",
      "default": 24,
      "info": "Left and right margin for the entire section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag text",
      "info": "Optional tag shown above the page title"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show tag",
      "default": false
    },
    {
      "type": "range",
      "id": "tag_border_radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Tag border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "tag_padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Tag padding vertical",
      "default": 8
    },
    {
      "type": "range",
      "id": "tag_padding_horizontal",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Tag padding horizontal",
      "default": 16
    },
    {
      "type": "range",
      "id": "tag_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tag font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title font size",
      "default": 42
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "justify",
          "label": "Justify"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_line_height",
      "min": 1.3,
      "max": 2.2,
      "step": 0.1,
      "label": "Body line height",
      "default": 1.7
    }
  ]
}
{% endschema %}
