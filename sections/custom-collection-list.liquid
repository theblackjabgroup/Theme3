<style>
  /* Submit button styles for hover overlay button */
  .share-story-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-button-bg);
    color: var(--color-primary-button-text);
    border: 2px solid var(--color-primary-button-border);
    padding: 20px;
    border-radius: 100px;
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    box-shadow: 0px 4px 0px 0px var(--color-shadow);
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    margin-top: 5px;
    text-transform: none;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .share-story-submit:hover {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px 0px var(--color-shadow);
  }
  .custom-collection-list {
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% else %}
      background-color: var(--color-background);
    {% endif %}
    {% if section.settings.min_height != blank %}
      min-height: {{ section.settings.min_height }}vh;
    {% endif %}
  }

  .custom-collection-list__header-box {
    text-align: {{ section.settings.title_alignment }};
    padding-top: {{ section.settings.header_padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.header_padding_bottom | default: 40 }}px;
    {% if section.settings.title_margin_bottom != blank %}
      margin-bottom: {{ section.settings.title_margin_bottom }}px;
    {% endif %}
  }

  .custom-collection-list__header-box-title {
    {% if section.settings.title_font_size != blank %}
      font-size: {{ section.settings.title_font_size }}rem;
    {% endif %}
    {% if section.settings.title_font_weight != blank %}
      font-weight: {{ section.settings.title_font_weight }};
    {% endif %}
    line-height: {{ section.settings.title_line_height | default: 1.2 }};
    letter-spacing: {{ section.settings.title_letter_spacing | default: 0 }}px;
    text-transform: {{ section.settings.title_text_transform | default: 'none' }};
  }

  .custom-collection-list__header-box-description {
    font-size: {{ section.settings.header_description_font_size | default: 16 }}px;
    font-weight: {{ section.settings.header_description_font_weight | default: 400 }};
    line-height: {{ section.settings.header_description_line_height | default: 1.5 }};
    margin-top: {{ section.settings.header_description_margin_top | default: 10 }}px;
    {% if section.settings.header_description_color != blank %}
      color: {{ section.settings.header_description_color }};
    {% endif %}
  }

  .custom-collection-list__grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  .custom-collection-card {
    padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_horizontal }}px {{ section.settings.card_padding_bottom }}px;
    text-align: {{ section.settings.card_text_alignment }};
    align-items: {{ section.settings.card_content_alignment }};
  }

  .custom-collection-card__image-container {
    height: {{ section.settings.image_height }}px;
    {% if section.settings.image_margin_bottom != blank %}
      margin-bottom: {{ section.settings.image_margin_bottom }}px;
    {% endif %}
  }

  /* Card Typography & Spacing Variables - Using Theme Settings */
  .custom-collection-card__title {
    font-size: {{ settings.collection_card_title_font_size | default: 32 }}px;
    font-weight: {{ settings.collection_card_title_font_weight | default: 900 }};
    line-height: {{ settings.collection_card_title_line_height | default: 1 }};
    margin-top: {{ settings.collection_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.collection_card_title_margin_bottom | default: 12 }}px;
  }

  .custom-collection-card__description {
    font-size: {{ settings.collection_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.collection_card_description_font_weight | default: 400 }};
    line-height: {{ settings.collection_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.collection_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.collection_card_description_margin_bottom | default: 20 }}px;
  }

  .custom-collection-card__badge {
    font-size: {{ settings.collection_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.collection_card_badge_font_weight | default: 700 }};
    padding: {{ settings.collection_card_badge_padding_vertical | default: 4 }}px {{ settings.collection_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.collection_card_badge_margin_bottom | default: 10 }}px;
    {% if settings.collection_card_badge_background_color != blank %}
      background-color: {{ settings.collection_card_badge_background_color }};
    {% endif %}
    {% if settings.collection_card_badge_text_color != blank %}
      color: {{ settings.collection_card_badge_text_color }};
    {% endif %}
    {% if settings.collection_card_badge_border_color != blank %}
      border-color: {{ settings.collection_card_badge_border_color }};
    {% endif %}
    {% if settings.collection_card_badge_border_width != blank %}
      border-width: {{ settings.collection_card_badge_border_width }}px;
    {% endif %}
    {% if settings.collection_card_badge_border_radius != blank %}
      border-radius: {{ settings.collection_card_badge_border_radius }}px;
    {% endif %}
    {% if settings.collection_card_badge_text_transform != blank %}
      text-transform: {{ settings.collection_card_badge_text_transform }};
    {% endif %}
  }

  .custom-collection-card__hover-description {
    font-size: {{ settings.collection_card_hover_description_font_size | default: 14 }}px;
    font-weight: {{ settings.collection_card_hover_description_font_weight | default: 400 }};
  }

  .custom-collection-card__hover-button {
    /* Submit button snippet styles take precedence, these are overrides if needed */
    {% if settings.collection_card_hover_button_font_size != blank %}
      font-size: {{ settings.collection_card_hover_button_font_size }}px !important;
    {% endif %}
    {% if settings.collection_card_hover_button_font_weight != blank %}
      font-weight: {{ settings.collection_card_hover_button_font_weight }} !important;
    {% endif %}
    {% if settings.collection_card_hover_button_padding_vertical != blank or settings.collection_card_hover_button_padding_horizontal != blank %}
      padding: {{ settings.collection_card_hover_button_padding_vertical | default: 10 }}px {{ settings.collection_card_hover_button_padding_horizontal | default: 20 }}px !important;
    {% endif %}
  }

  .custom-collection-card__hover-content {
    gap: {{ settings.collection_card_hover_content_gap | default: 10 }}px;
  }

  @media screen and (max-width: 1200px) {
    .custom-collection-list__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 900px) {
    .custom-collection-list__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }

    .custom-collection-list {
      padding: {{ section.settings.section_padding_top_mobile }}px {{ section.settings.section_padding_horizontal_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px;
    }

    .custom-collection-list__header-box-title {
      font-size: {{ section.settings.title_font_size_mobile }}rem;
    }

    .custom-collection-list__header-box-description {
      font-size: {{ section.settings.header_description_font_size_mobile | default: 14 }}px;
    }

    .custom-collection-card {
      padding: {{ section.settings.card_padding_top_mobile }}px {{ section.settings.card_padding_horizontal_mobile }}px {{ section.settings.card_padding_bottom_mobile }}px;
    }

    .custom-collection-card__image-container {
      height: {{ section.settings.image_height_mobile }}px;
      margin-bottom: {{ section.settings.image_margin_bottom_mobile }}px;
    }

    .custom-collection-card__title {
      {% if settings.collection_card_title_font_size_mobile != blank %}
        font-size: {{ settings.collection_card_title_font_size_mobile }}px;
      {% endif %}
      {% if settings.collection_card_title_margin_top_mobile != blank %}
        margin-top: {{ settings.collection_card_title_margin_top_mobile }}px;
      {% endif %}
      {% if settings.collection_card_title_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.collection_card_title_margin_bottom_mobile }}px;
      {% endif %}
    }

    .custom-collection-card__description {
      {% if settings.collection_card_description_font_size_mobile != blank %}
        font-size: {{ settings.collection_card_description_font_size_mobile }}px;
      {% endif %}
      {% if settings.collection_card_description_margin_top_mobile != blank %}
        margin-top: {{ settings.collection_card_description_margin_top_mobile }}px;
      {% endif %}
      {% if settings.collection_card_description_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.collection_card_description_margin_bottom_mobile }}px;
      {% endif %}
    }

    .custom-collection-card__badge {
      {% if settings.collection_card_badge_font_size_mobile != blank %}
        font-size: {{ settings.collection_card_badge_font_size_mobile }}px;
      {% endif %}
      {% if settings.collection_card_badge_padding_vertical_mobile != blank %}
        padding-top: {{ settings.collection_card_badge_padding_vertical_mobile }}px;
        padding-bottom: {{ settings.collection_card_badge_padding_vertical_mobile }}px;
      {% endif %}
      {% if settings.collection_card_badge_padding_horizontal_mobile != blank %}
        padding-left: {{ settings.collection_card_badge_padding_horizontal_mobile }}px;
        padding-right: {{ settings.collection_card_badge_padding_horizontal_mobile }}px;
      {% endif %}
      {% if settings.collection_card_badge_margin_bottom_mobile != blank %}
        margin-bottom: {{ settings.collection_card_badge_margin_bottom_mobile }}px;
      {% endif %}
    }

    .custom-collection-card__hover-description {
      {% if settings.collection_card_hover_description_font_size_mobile != blank %}
        font-size: {{ settings.collection_card_hover_description_font_size_mobile }}px;
      {% endif %}
    }

    .custom-collection-card__hover-button {
      {% if settings.collection_card_hover_button_font_size_mobile != blank %}
        font-size: {{ settings.collection_card_hover_button_font_size_mobile }}px !important;
      {% endif %}
      {% if settings.collection_card_hover_button_padding_vertical_mobile != blank or settings.collection_card_hover_button_padding_horizontal_mobile != blank %}
        padding: {{ settings.collection_card_hover_button_padding_vertical_mobile | default: 8 }}px {{ settings.collection_card_hover_button_padding_horizontal_mobile | default: 16 }}px !important;
      {% endif %}
    }

    .custom-collection-card__hover-content {
      {% if settings.collection_card_hover_content_gap_mobile != blank %}
        gap: {{ settings.collection_card_hover_content_gap_mobile }}px;
      {% endif %}
    }
  }
</style>

<div class="custom-collection-list color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.show_title and section.settings.title != blank -%}
      <div class="custom-collection-list__header-box" style="text-align: {{ section.settings.title_alignment }};">
        {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
          <span class="custom-collection-card__badge">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}
        <h2 class="custom-collection-list__header-box-title">{{ section.settings.title | escape }}</h2>
        {%- if section.settings.header_box_description != blank -%}
          <p class="custom-collection-list__header-box-description">{{ section.settings.header_box_description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign paginate_by = section.settings.collections_per_page | default: 12
      assign modulo_result = paginate_by | modulo: section.settings.columns_desktop
      if modulo_result != 0
        assign paginate_by = paginate_by | plus: section.settings.columns_desktop | minus: modulo_result
      endif
    -%}
    {%- paginate collections by paginate_by -%}
      <ul class="custom-collection-list__grid" role="list">
        {%- for collection in collections -%}
          <li class="custom-collection-list__item">
            {% render 'card-collection-custom',
              collection: collection,
              show_badge: section.settings.show_card_badge,
              section_settings: section.settings
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Collection List",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Section Title",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (rem)",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 3.2
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Title Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title Letter Spacing (px)",
      "min": -5,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Title Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Title Bottom Margin (px)",
      "min": 0,
      "max": 100,
      "step": 5,
