{{ 'section-header.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  :root {
    --header-width: {{ section.settings.header_width | default: 280 }}px;
    --header-padding: {{ section.settings.header_padding | default: 24 }}px;
    --header-gap: {{ section.settings.header_gap | default: 24 }}px;

    /* Logo */
    --logo-padding-top: {{ section.settings.logo_padding_top | default: 16 }}px;
    --logo-padding-bottom: {{ section.settings.logo_padding_bottom | default: 16 }}px;
    --logo-padding-left: {{ section.settings.logo_padding_left | default: 20 }}px;
    --logo-padding-right: {{ section.settings.logo_padding_right | default: 20 }}px;
    --logo-padding: var(--logo-padding-top) var(--logo-padding-right) var(--logo-padding-bottom) var(--logo-padding-left);
    --logo-border-radius: {{ section.settings.logo_border_radius | default: 16 }}px;
    --logo-font-size: {{ section.settings.logo_font_size | default: 28 }}px;
    --logo-font-weight: {{ section.settings.logo_font_weight | default: 700 }};
    --logo-letter-spacing: {{ section.settings.logo_letter_spacing | default: -0.5 }}px;
    --logo-image-max-width: {{ section.settings.logo_image_max_width | default: 200 }}px;
    --logo-image-max-height: {{ section.settings.logo_image_max_height | default: 100 }}px;
    --logo-image-width: {% if section.settings.logo_image_width > 0 %}{{ section.settings.logo_image_width }}px{% else %}auto{% endif %};
    --logo-image-height: {% if section.settings.logo_image_height > 0 %}{{ section.settings.logo_image_height }}px{% else %}auto{% endif %};
    --logo-image-object-fit: {{ section.settings.logo_image_object_fit | default: 'contain' }};

    /* Action Buttons */
    --button-gap: {{ section.settings.button_gap | default: 12 }}px;
    --button-padding-top: {{ section.settings.button_padding_top | default: 14 }}px;
    --button-padding-bottom: {{ section.settings.button_padding_bottom | default: 14 }}px;
    --button-padding-left: {{ section.settings.button_padding_left | default: 18 }}px;
    --button-padding-right: {{ section.settings.button_padding_right | default: 18 }}px;
    --button-padding: var(--button-padding-top) var(--button-padding-right) var(--button-padding-bottom) var(--button-padding-left);
    --button-font-size: {{ section.settings.button_font_size | default: 16 }}px;
    --button-icon-size: {{ section.settings.button_icon_size | default: 20 }}px;

    /* Navigation */
    --nav-gap: {{ section.settings.nav_gap | default: 16 }}px;
    --nav-padding-top: {{ section.settings.nav_padding_top | default: 24 }}px;
    --nav-padding-bottom: {{ section.settings.nav_padding_bottom | default: 24 }}px;
    --nav-item-padding-top: {{ section.settings.nav_item_padding_top | default: 16 }}px;
    --nav-item-padding-bottom: {{ section.settings.nav_item_padding_bottom | default: 16 }}px;
    --nav-item-padding-left: {{ section.settings.nav_item_padding_left | default: 16 }}px;
    --nav-item-padding-right: {{ section.settings.nav_item_padding_right | default: 16 }}px;
    --nav-item-padding: var(--nav-item-padding-top) var(--nav-item-padding-right) var(--nav-item-padding-bottom) var(--nav-item-padding-left);
    --nav-font-size: {{ section.settings.nav_font_size | default: 16 }}px;
    --nav-font-weight: {{ section.settings.nav_font_weight | default: 700 }};
    --nav-letter-spacing: {{ section.settings.nav_letter_spacing | default: 0.5 }}px;
    --nav-icon-size: {{ section.settings.nav_icon_size | default: 20 }}px;
    {%- if section.settings.nav_show_borders -%}
      --nav-border: 1px solid var(--color-header-border, var(--color-headings, #365330));
    {%- else -%}
      --nav-border: none;
    {%- endif -%}

    /* Back to Top */
    --back-to-top-margin-top: {{ section.settings.back_to_top_margin_top | default: 12 }}px;
    --back-to-top-padding-top: {{ section.settings.back_to_top_padding_top | default: 14 }}px;
    --back-to-top-padding-bottom: {{ section.settings.back_to_top_padding_bottom | default: 14 }}px;
    --back-to-top-padding-left: {{ section.settings.back_to_top_padding_left | default: 18 }}px;
    --back-to-top-padding-right: {{ section.settings.back_to_top_padding_right | default: 18 }}px;
    --back-to-top-padding: var(--back-to-top-padding-top) var(--back-to-top-padding-right) var(--back-to-top-padding-bottom) var(--back-to-top-padding-left);
    --back-to-top-font-size: {{ section.settings.back_to_top_font_size | default: 16 }}px;
  }
</style>

<!-- Mega Menu Overlay -->
<div class="mega-menu-overlay"></div>

<!-- Desktop Header (Vertical Left Sidebar) -->
<header class="vertical-sidebar-header desktop-header" id="shopify-section-header">
  <div class="vertical-sidebar-inner">
    <!-- Logo Section -->
    <div class="vertical-sidebar-logo">
      <a
        href="{{ routes.root_url }}"
        class="vertical-sidebar-logo-link vertical-sidebar-logo-link--{{ section.settings.logo_alignment | default: 'left' }}"
      >
        {%- if section.settings.logo != blank -%}
          {%- assign logo_width = section.settings.logo_image_max_width | default: 200 -%}
          {{
            section.settings.logo
            | image_url: width: logo_width
            | image_tag: loading: 'eager', alt: shop.name, class: 'vertical-sidebar-logo-image'
          }}
        {%- else -%}
          <span class="vertical-sidebar-logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Profile and Cart Row -->
    <div class="vertical-sidebar-actions-row profile-cart-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'welcome' -%}
          {%-
            render 'submit-button',
            text: '',
            url: block.settings.login_url | default: routes.account_login_url,
            icon: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
            class: 'submit-button--header-icon header-action-button header-action-button--user',
            attributes: 'aria-label="Account"'
          -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'cart' -%}
          {%- if cart.item_count > 0 -%}
            {%- render 'submit-button',
              text: cart.item_count,
              url: routes.cart_url,
              icon: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 1H5L7.68 13.39C7.77144 13.8504 8.02191 14.264 8.38755 14.5583C8.75318 14.8526 9.2107 15.009 9.68 15H19.4C19.8693 15.009 20.3268 14.8526 20.6925 14.5583C21.0581 14.264 21.3086 13.8504 21.4 13.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
              class: 'submit-button--header-icon header-action-button header-action-button--cart',
              attributes: 'aria-label="Cart"'
            -%}
          {%- else -%}
            {%- render 'submit-button',
              text: '',
              url: routes.cart_url,
              icon: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 1H5L7.68 13.39C7.77144 13.8504 8.02191 14.264 8.38755 14.5583C8.75318 14.8526 9.2107 15.009 9.68 15H19.4C19.8693 15.009 20.3268 14.8526 20.6925 14.5583C21.0581 14.264 21.3086 13.8504 21.4 13.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
              class: 'submit-button--header-icon header-action-button header-action-button--cart',
              attributes: 'aria-label="Cart"'
            -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Search Button Row -->
    <div class="vertical-sidebar-actions-row search-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'search' -%}
          {%- render 'submit-button',
            text: '',
            url: '',
            icon: '<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
            class: 'submit-button--header-icon header-action-button header-action-button--search',
            attributes: 'aria-label="Search" data-spotlight-search-toggle',
            type: 'button'
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Navigation Links -->
    <nav class="vertical-sidebar-nav">
      <ul class="vertical-sidebar-nav-list">
        {%- comment -%} Set default navigation icon {%- endcomment -%}
        {%- assign default_icon_svg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>' -%}
        {%- for link in section.settings.menu.links -%}
          {%- comment -%} Check for custom icon for this specific link {%- endcomment -%}
          {%- assign custom_icon_block = null -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_icon' and block.settings.link_name == link.title -%}
              {%- assign custom_icon_block = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          
          {%- comment -%} Determine which icon to use for this link {%- endcomment -%}
          {%- assign nav_icon = default_icon_svg -%}
          {%- assign nav_icon_is_image = false -%}
          {%- if custom_icon_block != null -%}
            {%- comment -%} Use custom icon from block {%- endcomment -%}
            {%- if custom_icon_block.settings.icon_image != blank -%}
              {%- assign icon_size = section.settings.nav_icon_size | default: 20 -%}
              {%- assign nav_icon = custom_icon_block.settings.icon_image | image_url: width: icon_size | image_tag: loading: 'lazy', alt: link.title, class: 'nav-icon-image', width: icon_size, height: icon_size -%}
              {%- assign nav_icon_is_image = true -%}
            {%- elsif custom_icon_block.settings.icon_svg != blank -%}
              {%- assign nav_icon = custom_icon_block.settings.icon_svg -%}
            {%- endif -%}
          {%- elsif section.settings.nav_icon_image != blank -%}
            {%- comment -%} Use global default icon image {%- endcomment -%}
            {%- assign icon_size = section.settings.nav_icon_size | default: 20 -%}
            {%- assign nav_icon = section.settings.nav_icon_image | image_url: width: icon_size | image_tag: loading: 'lazy', alt: link.title, class: 'nav-icon-image', width: icon_size, height: icon_size -%}
            {%- assign nav_icon_is_image = true -%}
          {%- elsif section.settings.nav_icon_svg != blank -%}
            {%- comment -%} Use global default icon SVG {%- endcomment -%}
            {%- assign nav_icon = section.settings.nav_icon_svg -%}
          {%- endif -%}
          
          <li class="vertical-sidebar-nav-item">
            {%- if link.links != blank -%}
              {%- assign matching_block = null -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'mega_menu' and block.settings.link_name == link.title -%}
                  {%- assign matching_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <button
                class="header-nav-button header-nav-button--dropdown"
                aria-expanded="false"
                aria-controls="MegaMenu-{{ forloop.index }}"
                data-mega-menu-trigger
              >
                <span class="header-nav-button-icon {% if nav_icon_is_image %}header-nav-button-icon--image{% endif %}">{{ nav_icon }}</span>
                <span class="header-nav-button-text">{{ link.title | upcase }}</span>
              </button>

              <div id="MegaMenu-{{ forloop.index }}" class="mega-menu" data-mega-menu>
                <div class="mega-menu-inner">
                  <div class="mega-menu-nav">
                    <ul class="mega-menu-list">
                      {%- for childlink in link.links -%}
                        <li class="mega-menu-item">
                          <a href="{{ childlink.url }}" class="mega-menu-link">
                            {{ childlink.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- if matching_block != null -%}
                    <div class="mega-menu-featured">
                      <div class="mega-menu-grid">
                        {%- for i in (1..4) -%}
                          {%- assign img_key = 'image_' | append: i -%}
                          {%- assign label_key = 'label_' | append: i -%}
                          {%- assign link_key = 'link_' | append: i -%}
                          {%- assign img = matching_block.settings[img_key] -%}
                          {%- assign label = matching_block.settings[label_key] -%}
                          {%- assign url = matching_block.settings[link_key] -%}

                          {%- if img != blank -%}
                            {%- assign product_count = null -%}
                            {%- if url contains '/collections/' -%}
                              {%- assign url_parts = url | split: '/' -%}
                              {%- assign collection_handle = url_parts | last | split: '?' | first -%}
                              {%- assign product_count = collections[collection_handle].products_count -%}
                            {%- endif -%}

                            <a href="{{ url | default: '#' }}" class="mega-menu-featured-item">
                              <div class="mega-menu-image-wrapper">
                                {{ img | image_url: width: 400 | image_tag: loading: 'lazy', class: 'mega-menu-image' }}
                              </div>
                              {%- if label != blank -%}
                                <div class="mega-menu-label">
                                  {{ label }}
                                  {%- if product_count != null -%}
                                    <span class="mega-menu-count">({{ product_count }})</span>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              {%-
                render 'header-button',
                button_text: link.title | upcase,
                button_url: link.url,
                button_icon: nav_icon,
                button_icon_is_image: nav_icon_is_image,
                button_type: 'link',
                button_class: link.active | default: false | ternary: 'active', '',
                aria_label: link.title
              -%}
            {%- endif -%}
          </li>
        {%- endfor -%}

        <!-- Back to Top Button (inside scrollable nav) -->
        <li class="vertical-sidebar-nav-item vertical-sidebar-nav-item--back-to-top">
          <div class="vertical-sidebar-back-to-top">
            {%- render 'back-to-top' -%}
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Mobile/Tablet Header -->
<header class="mobile-header">
  <div class="mobile-header-container">
    <!-- Logo -->
    <div class="mobile-header-logo">
      {%- if section.settings.mobile_logo != blank -%}
        <a href="{{ routes.root_url }}" class="mobile-logo-link">
          {{
            section.settings.mobile_logo
            | image_url: width: 200
            | image_tag: loading: 'eager', alt: shop.name, class: 'mobile-logo-image'
          }}
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mobile-logo-link">
          <span class="mobile-logo-text">{{ section.settings.mobile_logo_text | default: shop.name }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Right Side Icons -->
    <div class="mobile-header-actions">
      {%- for block in section.blocks -%}
        {%- if block.type == 'cart' -%}
          <a
            href="{{ routes.cart_url }}"
            class="mobile-header-icon mobile-cart-icon"
            aria-label="Cart"
            {{ block.shopify_attributes }}
          >
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M1 1H5L7.68 13.39C7.77144 13.8504 8.02191 14.264 8.38755 14.5583C8.75318 14.8526 9.2107 15.009 9.68 15H19.4C19.8693 15.009 20.3268 14.8526 20.6925 14.5583C21.0581 14.264 21.3086 13.8504 21.4 13.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {%- if cart.item_count > 0 -%}
              <span class="mobile-cart-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if block.type == 'search' -%}
          <button
            type="button"
            class="mobile-header-icon mobile-search-icon"
            aria-label="Search"
            data-spotlight-search-toggle
            {{ block.shopify_attributes }}
          >
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if block.type == 'welcome' -%}
          <a
            href="{{ block.settings.login_url | default: routes.account_login_url }}"
            class="mobile-header-icon mobile-welcome-icon"
            aria-label="Account"
            {{ block.shopify_attributes }}
          >
            {%- assign avatar_size = block.settings.avatar_size | default: 32 -%}
            {%- assign avatar_shape = block.settings.avatar_shape | default: 'circle' -%}
            <div
              class="mobile-welcome-avatar mobile-welcome-avatar--{{ avatar_shape }}"
              style="width: {{ avatar_size }}px; height: {{ avatar_size }}px;"
            >
              {%- if block.settings.avatar_image != blank -%}
                {{
                  block.settings.avatar_image
                  | image_url: width: 128
                  | image_tag: loading: 'lazy', alt: block.settings.welcome_text, class: 'mobile-avatar-image'
                }}
              {%- else -%}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style="width: {{ avatar_size | times: 0.75 }}px; height: {{ avatar_size | times: 0.75 }}px;"
                >
                  <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}

        {%- if block.type == 'mobile_menu' -%}
          <button
            type="button"
            class="mobile-header-icon mobile-menu-toggle"
            aria-label="Menu"
            aria-expanded="false"
            data-mobile-menu-toggle
            {{ block.shopify_attributes }}
          >
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-drawer" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu-content">
      <nav class="mobile-menu-nav">
        <!-- Main Menu Links (Two Column Grid) -->
        <ul class="mobile-menu-list">
          {%- for link in section.settings.menu.links -%}
            {%- assign link_count = link.links.size -%}
            <li class="mobile-menu-item">
              {%- if link.links != blank -%}
                <button
                  class="mobile-menu-link mobile-menu-link--has-children"
                  data-mobile-submenu-toggle
                  data-parent-link="{{ link.title | handleize }}"
                >
                  <span class="mobile-menu-link-text">{{ link.title | upcase }}</span>
                  {%- if link_count > 0 -%}
                    <sup class="mobile-menu-link-count" data-count="{{ link_count }}">{{ link_count }}</sup>
                  {%- endif -%}
                </button>
              {%- else -%}
                <a href="{{ link.url }}" class="mobile-menu-link {% if link.active %}active{% endif %}">
                  <span class="mobile-menu-link-text">{{ link.title | upcase }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <!-- Separator Line -->
        <div class="mobile-menu-separator"></div>

        <!-- Submenu Links (Single Column - Shown when parent is clicked) -->
        <div class="mobile-submenu-container">
          {%- for link in section.settings.menu.links -%}
            {%- if link.links != blank -%}
              <ul class="mobile-submenu" data-parent="{{ link.title | handleize }}">
                {%- for childlink in link.links -%}
                  <li class="mobile-submenu-item">
                    <a href="{{ childlink.url }}" class="mobile-submenu-link">{{ childlink.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </nav>
    </div>
  </div>
</header>

{%- render 'spotlight-search', input_id: 'SpotlightSearchInput' -%}

<script>
  window.headerAnimationSpeed = {{ section.settings.scroll_animation_speed | default: 1 }};
</script>
<script src="{{ 'vertical-header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mobile-header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'spotlight-search.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Desktop Header Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Logo displayed in the vertical sidebar header"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "kokō",
      "info": "Text displayed if no logo image is uploaded"
    },
    {
      "type": "header",
      "content": "Header Layout"
    },
    {
      "type": "range",
      "id": "header_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Header Width",
      "default": 280,
      "info": "Width of the vertical sidebar header"
    },
    {
      "type": "range",
      "id": "header_padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Header Inner Padding",
      "default": 24,
      "info": "Padding around the header content"
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Header Section Gap",
      "default": 24,
      "info": "Gap between header sections (logo, buttons, nav)"
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "select",
      "id": "logo_alignment",
      "label": "Logo Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "info": "Horizontal alignment of the logo within the header"
    },
    {
      "type": "range",
      "id": "logo_padding_top",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_padding_bottom",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Bottom",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_padding_left",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_padding_right",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Right",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Logo Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Logo Font Size",
      "default": 28
    },
    {
      "type": "select",
      "id": "logo_font_weight",
      "label": "Logo Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "logo_letter_spacing",
      "min": -2,
      "max": 2,
      "step": 0.1,
      "unit": "px",
      "label": "Logo Letter Spacing",
      "default": -0.5
    },
    {
      "type": "header",
      "content": "Logo Image Settings"
    },
    {
      "type": "range",
      "id": "logo_image_max_width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo Image Max Width",
      "default": 200,
      "info": "Maximum width of the logo image"
    },
    {
      "type": "range",
      "id": "logo_image_max_height",
      "min": 30,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Image Max Height",
      "default": 100,
      "info": "Maximum height of the logo image"
    },
    {
      "type": "range",
      "id": "logo_image_width",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo Image Width",
      "default": 0,
      "info": "Fixed width of the logo image (0 = auto, uses max-width instead)"
    },
    {
      "type": "range",
      "id": "logo_image_height",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Image Height",
      "default": 0,
      "info": "Fixed height of the logo image (0 = auto, uses max-height instead)"
    },
    {
      "type": "select",
      "id": "logo_image_object_fit",
      "label": "Logo Image Object Fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" },
        { "value": "fill", "label": "Fill" },
        { "value": "none", "label": "None" },
        { "value": "scale-down", "label": "Scale Down" }
      ],
      "default": "contain",
      "info": "How the logo image should be resized to fit its container"
    },
    {
      "type": "header",
      "content": "Action Buttons Settings"
    },
    {
      "type": "range",
      "id": "button_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Button Gap",
      "default": 12,
      "info": "Gap between action buttons"
    },
    {
      "type": "range",
      "id": "button_padding_top",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button Padding Top",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_bottom",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button Padding Bottom",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_left",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button Padding Left",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_padding_right",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button Padding Right",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button Icon Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Navigation Settings"
    },
    {
      "type": "range",
      "id": "nav_gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Navigation Item Gap",
      "default": 16,
      "info": "Gap between navigation items"
    },
    {
      "type": "range",
      "id": "nav_padding_top",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Navigation Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "nav_padding_bottom",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Navigation Padding Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "nav_item_padding_top",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Nav Item Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "nav_item_padding_bottom",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Nav Item Padding Bottom",
      "default": 16
    },
    {
      "type": "range",
      "id": "nav_item_padding_left",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Nav Item Padding Left",
      "default": 16
    },
    {
      "type": "range",
      "id": "nav_item_padding_right",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Nav Item Padding Right",
      "default": 16
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Navigation Font Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "Navigation Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "nav_letter_spacing",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "px",
      "label": "Navigation Letter Spacing",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "nav_icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Navigation Icon Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Default Navigation Icon (Fallback)"
    },
    {
      "type": "image_picker",
      "id": "nav_icon_image",
      "label": "Default Navigation Icon Image",
      "info": "Upload a default icon image that will be used for all menu items unless overridden by a per-item icon. Recommended size: 20x20px to 32x32px. If both image and SVG are provided, image will be used."
    },
    {
      "type": "html",
      "id": "nav_icon_svg",
      "label": "Default Navigation Icon SVG Code",
      "info": "Paste SVG code for a default icon that will be used for all menu items unless overridden by a per-item icon. Use 'currentColor' for stroke/fill to match theme colors. Example: <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"...\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>"
    },
    {
      "type": "checkbox",
      "id": "nav_show_borders",
      "label": "Show Navigation Item Borders",
      "default": false,
      "info": "Enable borders around navigation items"
    },
    {
      "type": "header",
      "content": "Back to Top Button Settings"
    },
    {
      "type": "range",
      "id": "back_to_top_margin_top",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Back to Top Margin Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "back_to_top_padding_top",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Back to Top Padding Top",
      "default": 14
    },
    {
      "type": "range",
      "id": "back_to_top_padding_bottom",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Back to Top Padding Bottom",
      "default": 14
    },
    {
      "type": "range",
      "id": "back_to_top_padding_left",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Back to Top Padding Left",
      "default": 18
    },
    {
      "type": "range",
      "id": "back_to_top_padding_right",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Back to Top Padding Right",
      "default": 18
    },
    {
      "type": "range",
      "id": "back_to_top_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Back to Top Font Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Scroll Animation Settings"
    },
    {
      "type": "range",
      "id": "scroll_animation_speed",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "label": "Scroll Animation Speed",
      "default": 1,
      "info": "Speed of header slide animation when scrolling (in seconds)"
    },
    {
      "type": "header",
      "content": "Mobile Header Settings"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile Logo",
      "info": "Logo displayed on mobile and tablet devices"
    },
    {
      "type": "text",
      "id": "mobile_logo_text",
      "label": "Mobile Logo Text",
      "default": "Logo",
      "info": "Text displayed if no logo image is uploaded"
    }
  ],
  "blocks": [
    {
      "type": "search",
      "name": "Search",
      "limit": 1
    },
    {
      "type": "welcome",
      "name": "Welcome Block",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "welcome_text",
          "label": "Welcome Text",
          "default": "Welcome !"
        },
        {
          "type": "text",
          "id": "login_text",
          "label": "Login Text",
          "default": "Login"
        },
        {
          "type": "url",
          "id": "login_url",
          "label": "Login URL",
          "info": "Leave empty to use default login page"
        },
        {
          "type": "header",
          "content": "Avatar Settings"
        },
        {
          "type": "image_picker",
          "id": "avatar_image",
          "label": "Avatar Image",
          "info": "Upload a custom avatar image. If not provided, default icon will be used."
        },
        {
          "type": "range",
          "id": "avatar_size",
          "min": 24,
          "max": 64,
          "step": 2,
          "unit": "px",
          "label": "Avatar Size",
          "default": 32
        },
        {
          "type": "select",
          "id": "avatar_shape",
          "label": "Avatar Shape",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "rounded", "label": "Rounded" }
          ],
          "default": "circle"
        }
      ]
    },
    {
      "type": "cart",
      "name": "Cart Icon",
      "limit": 1
    },
    {
      "type": "mobile_menu",
      "name": "Mobile Menu Toggle",
      "limit": 1
    },
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        {
          "type": "text",
          "id": "link_name",
          "label": "Menu Item Title",
          "info": "Case-sensitive match with the menu item title"
        },
        {
          "type": "header",
          "content": "Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link_3",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Image 4"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link_4",
          "label": "Link"
        }
      ]
    },
    {
      "type": "nav_icon",
      "name": "Navigation Icon",
      "settings": [
        {
          "type": "text",
          "id": "link_name",
          "label": "Menu Item Title",
          "info": "Enter the exact menu item title (case-sensitive) to apply this icon to. Leave empty to skip."
        },
        {
          "type": "header",
          "content": "Icon Options"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Upload a custom icon image for this menu item. Recommended size: 20x20px to 32x32px. If both image and SVG are provided, image will be used."
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste your SVG code here for this menu item. Use 'currentColor' for stroke/fill to match theme colors. Example: <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"...\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>"
