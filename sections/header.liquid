{{ 'section-header.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  :root {
    --header-width: {{ section.settings.header_width | default: 230 }}px;
    --header-padding: {{ section.settings.header_padding | default: 24 }}px;
    --header-gap: {{ section.settings.header_gap | default: 24 }}px;

    /* Logo */
    --logo-padding-top: {{ section.settings.logo_padding_top | default: 26 }}px;
    --logo-padding-bottom: {{ section.settings.logo_padding_bottom | default: 26 }}px;
    --logo-padding-left: {{ section.settings.logo_padding_left | default: 20 }}px;
    --logo-padding-right: {{ section.settings.logo_padding_right | default: 20 }}px;
    --logo-padding: var(--logo-padding-top) var(--logo-padding-right) var(--logo-padding-bottom) var(--logo-padding-left);
    --logo-border-radius: {{ section.settings.logo_border_radius | default: 16 }}px;
    --logo-font-size: {{ section.settings.logo_font_size | default: 28 }}px;
    --logo-font-weight: {{ section.settings.logo_font_weight | default: 700 }};
    --logo-letter-spacing: {{ section.settings.logo_letter_spacing | default: -0.5 }}px;
    --color-header-logo-background: {{ section.settings.logo_background_color | default: '#306030' }};
    --logo-image-max-width: {{ section.settings.logo_image_max_width | default: 140 }}px;
    --logo-image-max-height: {{ section.settings.logo_image_max_height | default: 100 }}px;
    --logo-image-width: {% if section.settings.logo_image_width > 0 %}{{ section.settings.logo_image_width }}px{% else %}auto{% endif %};
    --logo-image-height: {% if section.settings.logo_image_height > 0 %}{{ section.settings.logo_image_height }}px{% else %}auto{% endif %};
    --logo-image-object-fit: {{ section.settings.logo_image_object_fit | default: 'contain' }};

    /* Action Buttons */
    --button-gap: {{ section.settings.button_gap | default: 12 }}px;
    --button-padding-top: {{ section.settings.button_padding_top | default: 14 }}px;
    --button-padding-bottom: {{ section.settings.button_padding_bottom | default: 14 }}px;
    --button-padding-left: {{ section.settings.button_padding_left | default: 18 }}px;
    --button-padding-right: {{ section.settings.button_padding_right | default: 18 }}px;
    --button-padding: var(--button-padding-top) var(--button-padding-right) var(--button-padding-bottom) var(--button-padding-left);
    --button-font-size: {{ section.settings.button_font_size | default: 16 }}px;
    --button-icon-size: {{ section.settings.button_icon_size | default: 20 }}px;

    /* Navigation */
    --nav-gap: {{ section.settings.nav_gap | default: 10 }}px;
    --nav-animation-speed: {{ section.settings.nav_animation_speed | default: 0.8 }}s;
    --nav-padding-top: {{ section.settings.nav_padding_top | default: 24 }}px;
    --nav-padding-bottom: {{ section.settings.nav_padding_bottom | default: 24 }}px;
    --nav-item-padding-top: {{ section.settings.nav_item_padding_top | default: 16 }}px;
    --nav-item-padding-bottom: {{ section.settings.nav_item_padding_bottom | default: 16 }}px;
    --nav-item-padding-left: {{ section.settings.nav_item_padding_left | default: 16 }}px;
    --nav-item-padding-right: {{ section.settings.nav_item_padding_right | default: 16 }}px;
    --nav-item-padding: var(--nav-item-padding-top) var(--nav-item-padding-right) var(--nav-item-padding-bottom) var(--nav-item-padding-left);
    --nav-font-size: {{ section.settings.nav_font_size | default: 16 }}px;
    --nav-font-weight: {{ section.settings.nav_font_weight | default: 700 }};
    --nav-letter-spacing: {{ section.settings.nav_letter_spacing | default: 0.5 }}px;
    --nav-icon-size: {{ section.settings.nav_icon_size | default: 20 }}px;
    --nav-caret-size: {{ section.settings.nav_caret_size | default: 10 }}px;
    --nav-hover-background: {{ section.settings.nav_hover_background_color | default: '#306030' }};
    --nav-default-background: var(--color-header-button-background, var(--color-header-background, var(--color-background, #eae7e1)));
    {%- if section.settings.nav_show_borders -%}
      --nav-border: 1px solid var(--color-header-border, var(--color-headings, #365330));
    {%- else -%}
      --nav-border: none;
    {%- endif -%}

    /* Mobile Header Logo */
    --mobile-logo-image-max-width: {{ section.settings.mobile_logo_image_max_width | default: 120 }}px;
    --mobile-logo-image-max-height: {{ section.settings.mobile_logo_image_max_height | default: 40 }}px;
    --mobile-logo-image-width: {% if section.settings.mobile_logo_image_width > 0 %}{{ section.settings.mobile_logo_image_width }}px{% else %}auto{% endif %};
    --mobile-logo-image-height: {% if section.settings.mobile_logo_image_height > 0 %}{{ section.settings.mobile_logo_image_height }}px{% else %}auto{% endif %};
    --mobile-logo-image-object-fit: {{ section.settings.mobile_logo_image_object_fit | default: 'contain' }};
    --mobile-logo-font-size: {{ section.settings.mobile_logo_font_size | default: 20 }}px;
    --mobile-logo-font-weight: {{ section.settings.mobile_logo_font_weight | default: 700 }};
  }
</style>

{%- assign search_popup_block = null -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'search_popup' -%}
    {%- assign search_popup_block = block -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign search_popup_id_param = 'HeaderSearchPopup' -%}

<!-- Mega Menu Overlay -->
<div class="mega-menu-overlay"></div>

<!-- Desktop Header (Vertical Left Sidebar) -->
<header class="vertical-sidebar-header desktop-header" id="shopify-section-header">
  <div class="vertical-sidebar-inner">
    <!-- Logo Section -->
    <div class="vertical-sidebar-logo">
      <a
        href="{{ routes.root_url }}"
        class="vertical-sidebar-logo-link vertical-sidebar-logo-link--{{ section.settings.logo_alignment | default: 'center' }}"
      >
        {%- if section.settings.logo != blank -%}
          {%- assign logo_width = section.settings.logo_image_max_width | default: 140 -%}
          {{
            section.settings.logo
            | image_url: width: logo_width
            | image_tag: loading: 'eager', alt: shop.name, class: 'vertical-sidebar-logo-image'
          }}
        {%- else -%}
          <span class="vertical-sidebar-logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Profile and Cart Row -->
    <div class="vertical-sidebar-actions-row profile-cart-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'welcome' -%}
          {%- comment -%} Determine icon for welcome button {%- endcomment -%}
          {%- assign welcome_icon = '' -%}
          {%- assign icon_size = section.settings.button_icon_size | default: 20 -%}
          {%- if block.settings.button_icon_image != blank -%}
            {%- assign welcome_icon = block.settings.button_icon_image
              | image_url: width: icon_size
              | image_tag:
                loading: 'lazy',
                alt: 'Account',
                class: 'button-icon-image',
                width: icon_size,
                height: icon_size
            -%}
          {%- elsif block.settings.button_icon_svg != blank -%}
            {%- assign welcome_icon = block.settings.button_icon_svg -%}
          {%- else -%}
            {%- assign welcome_icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
          {%- endif -%}
          {%- assign welcome_hover_icon = '' -%}
          {%- if block.settings.button_icon_image_hover != blank -%}
            {%- assign welcome_hover_icon = block.settings.button_icon_image_hover
              | image_url: width: icon_size
              | image_tag:
                loading: 'lazy',
                alt: 'Account',
                class: 'button-icon-image',
                width: icon_size,
                height: icon_size
            -%}
          {%- endif -%}
          {%-
            render 'header-button',
            button_text: block.settings.button_text | default: 'Account',
            button_url: block.settings.login_url | default: routes.account_login_url,
            button_icon: welcome_icon,
            button_icon_is_image: block.settings.button_icon_image != blank,
            button_hover_icon: welcome_hover_icon,
            button_hover_icon_is_image: block.settings.button_icon_image_hover != blank,
            button_type: 'link',
            button_class: 'header-action-button header-action-button--user',
            aria_label: 'Account',
            skip_nav_class: true
          -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'cart' -%}
          {%- comment -%} Determine icon for cart button {%- endcomment -%}
          {%- assign cart_icon = '' -%}
          {%- assign icon_size = section.settings.button_icon_size | default: 20 -%}
          {%- if block.settings.button_icon_image != blank -%}
            {%- assign cart_icon = block.settings.button_icon_image
              | image_url: width: icon_size
              | image_tag: loading: 'lazy', alt: 'Cart', class: 'button-icon-image', width: icon_size, height: icon_size
            -%}
          {%- elsif block.settings.button_icon_svg != blank -%}
            {%- assign cart_icon = block.settings.button_icon_svg -%}
          {%- else -%}
            {%- assign cart_icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 1H5L7.68 13.39C7.77144 13.8504 8.02191 14.264 8.38755 14.5583C8.75318 14.8526 9.2107 15.009 9.68 15H19.4C19.8693 15.009 20.3268 14.8526 20.6925 14.5583C21.0581 14.264 21.3086 13.8504 21.4 13.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
          {%- endif -%}
          {%- assign cart_hover_icon = '' -%}
          {%- if block.settings.button_icon_image_hover != blank -%}
            {%- assign cart_hover_icon = block.settings.button_icon_image_hover
              | image_url: width: icon_size
              | image_tag: loading: 'lazy', alt: 'Cart', class: 'button-icon-image', width: icon_size, height: icon_size
            -%}
          {%- endif -%}
          {%- if settings.cart_type == 'drawer' -%}
            {%- assign cart_button_id = 'cart-icon-bubble' -%}
            {%- assign cart_button_class = 'header-action-button header-action-button--cart cart-drawer-trigger' -%}
          {%- else -%}
            {%- assign cart_button_id = '' -%}
            {%- assign cart_button_class = 'header-action-button header-action-button--cart' -%}
          {%- endif -%}
          {%-
            render 'header-button',
            button_text: block.settings.button_text | default: 'Cart',
            button_url: routes.cart_url,
            button_icon: cart_icon,
            button_icon_is_image: block.settings.button_icon_image != blank,
            button_hover_icon: cart_hover_icon,
            button_hover_icon_is_image: block.settings.button_icon_image_hover != blank,
            button_type: 'link',
            button_class: cart_button_class,
            aria_label: 'Cart',
            skip_nav_class: true,
            button_id: cart_button_id
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Search Button Row -->
    <div class="vertical-sidebar-actions-row search-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'search' -%}
          {%- comment -%} Determine icon for search button {%- endcomment -%}
          {%- assign search_icon = '' -%}
          {%- assign icon_size = section.settings.button_icon_size | default: 20 -%}
          {%- if block.settings.button_icon_image != blank -%}
            {%- assign search_icon = block.settings.button_icon_image
              | image_url: width: icon_size
              | image_tag:
                loading: 'lazy',
                alt: 'Search',
                class: 'button-icon-image',
                width: icon_size,
                height: icon_size
            -%}
          {%- elsif block.settings.button_icon_svg != blank -%}
            {%- assign search_icon = block.settings.button_icon_svg -%}
          {%- else -%}
            {%- assign search_icon = '<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
          {%- endif -%}
          {%- assign search_hover_icon = '' -%}
          {%- if block.settings.button_icon_image_hover != blank -%}
            {%- assign search_hover_icon = block.settings.button_icon_image_hover
              | image_url: width: icon_size
              | image_tag:
                loading: 'lazy',
                alt: 'Search',
                class: 'button-icon-image',
                width: icon_size,
                height: icon_size
            -%}
          {%- endif -%}
          {%- if block.settings.button_url != blank -%}
            {%-
              render 'header-button',
              button_text: block.settings.button_text | default: 'Search',
              button_url: block.settings.button_url,
              button_icon: search_icon,
              button_icon_is_image: block.settings.button_icon_image != blank,
              button_hover_icon: search_hover_icon,
              button_hover_icon_is_image: block.settings.button_icon_image_hover != blank,
              button_type: 'link',
              button_class: 'header-action-button header-action-button--search',
              aria_label: 'Search',
              skip_nav_class: true,
              search_popup_id: search_popup_id_param
            -%}
          {%- else -%}
            {%-
              render 'header-button',
              button_text: block.settings.button_text | default: 'Search',
              button_url: '',
              button_icon: search_icon,
              button_icon_is_image: block.settings.button_icon_image != blank,
              button_hover_icon: search_hover_icon,
              button_hover_icon_is_image: block.settings.button_icon_image_hover != blank,
              button_type: 'button',
              button_class: 'header-action-button header-action-button--search',
              aria_label: 'Search',
              skip_nav_class: true,
              search_popup_id: search_popup_id_param
            -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Navigation Links -->
    <nav class="vertical-sidebar-nav">
      <ul class="vertical-sidebar-nav-list">
        {%- comment -%} Set default navigation icon {%- endcomment -%}
        {%- assign default_icon_svg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>' -%}
        {%- for link in section.settings.menu.links -%}
          {%- comment -%} Check for custom icon for this specific link {%- endcomment -%}
          {%- assign custom_icon_block = null -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_icon' and block.settings.link_name == link.title -%}
              {%- assign custom_icon_block = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Determine which default icon to use for this link {%- endcomment -%}
          {%- assign nav_icon = default_icon_svg -%}
          {%- assign nav_icon_is_image = false -%}
          {%- assign nav_hover_icon = '' -%}
          {%- assign nav_hover_icon_is_image = false -%}
          {%- assign icon_size = section.settings.nav_icon_size | default: 20 -%}

          {%- if custom_icon_block != null -%}
            {%- comment -%} Use custom icon from block {%- endcomment -%}
            {%- if custom_icon_block.settings.icon_image != blank -%}
              {%- assign nav_icon = custom_icon_block.settings.icon_image
                | image_url: width: icon_size
                | image_tag:
                  loading: 'lazy',
                  alt: link.title,
                  class: 'nav-icon-image',
                  width: icon_size,
                  height: icon_size
              -%}
              {%- assign nav_icon_is_image = true -%}
            {%- elsif custom_icon_block.settings.icon_svg != blank -%}
              {%- assign nav_icon = custom_icon_block.settings.icon_svg -%}
            {%- endif -%}
            {%- comment -%} Check for hover icon {%- endcomment -%}
            {%- if custom_icon_block.settings.hover_icon_image != blank -%}
              {%- assign nav_hover_icon = custom_icon_block.settings.hover_icon_image
                | image_url: width: icon_size
                | image_tag:
                  loading: 'lazy',
                  alt: link.title,
                  class: 'nav-icon-image',
                  width: icon_size,
                  height: icon_size
              -%}
              {%- assign nav_hover_icon_is_image = true -%}
            {%- elsif custom_icon_block.settings.hover_icon_svg != blank -%}
              {%- assign nav_hover_icon = custom_icon_block.settings.hover_icon_svg -%}
            {%- endif -%}
          {%- elsif section.settings.nav_icon_image != blank -%}
            {%- comment -%} Use global default icon image {%- endcomment -%}
            {%- assign nav_icon = section.settings.nav_icon_image
              | image_url: width: icon_size
              | image_tag:
                loading: 'lazy',
                alt: link.title,
                class: 'nav-icon-image',
                width: icon_size,
                height: icon_size
            -%}
            {%- assign nav_icon_is_image = true -%}
            {%- comment -%} Check for global hover icon {%- endcomment -%}
            {%- if section.settings.nav_hover_icon_image != blank -%}
              {%- assign nav_hover_icon = section.settings.nav_hover_icon_image
                | image_url: width: icon_size
                | image_tag:
                  loading: 'lazy',
                  alt: link.title,
                  class: 'nav-icon-image',
                  width: icon_size,
                  height: icon_size
              -%}
              {%- assign nav_hover_icon_is_image = true -%}
            {%- elsif section.settings.nav_hover_icon_svg != blank -%}
              {%- assign nav_hover_icon = section.settings.nav_hover_icon_svg -%}
            {%- endif -%}
          {%- elsif section.settings.nav_icon_svg != blank -%}
            {%- comment -%} Use global default icon SVG {%- endcomment -%}
            {%- assign nav_icon = section.settings.nav_icon_svg -%}
            {%- if section.settings.nav_hover_icon_svg != blank -%}
              {%- assign nav_hover_icon = section.settings.nav_hover_icon_svg -%}
            {%- elsif section.settings.nav_hover_icon_image != blank -%}
              {%- assign nav_hover_icon = section.settings.nav_hover_icon_image
                | image_url: width: icon_size
                | image_tag:
                  loading: 'lazy',
                  alt: link.title,
                  class: 'nav-icon-image',
                  width: icon_size,
                  height: icon_size
              -%}
              {%- assign nav_hover_icon_is_image = true -%}
            {%- endif -%}
          {%- endif -%}

          <li class="vertical-sidebar-nav-item">
            {%- if link.links != blank -%}
              {%- assign matching_block = null -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'mega_menu' and block.settings.link_name == link.title -%}
                  {%- assign matching_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Determine caret icon {%- endcomment -%}
              {%- assign caret_icon = '' -%}
              {%- assign caret_icon_is_image = false -%}
              {%- assign caret_size = section.settings.nav_caret_size | default: 10 -%}
              {%- if section.settings.nav_caret_icon_image != blank -%}
                {%- assign caret_icon = section.settings.nav_caret_icon_image
                  | image_url: width: caret_size
                  | image_tag:
                    loading: 'lazy',
                    alt: '',
                    class: 'caret-icon-image',
                    width: caret_size,
                    height: caret_size
                -%}
                {%- assign caret_icon_is_image = true -%}
              {%- elsif section.settings.nav_caret_icon_svg != blank -%}
                {%- assign caret_icon = section.settings.nav_caret_icon_svg -%}
              {%- else -%}
                {%- assign caret_icon = 'icon-caret.svg' | inline_asset_content -%}
              {%- endif -%}

              <button
                class="header-nav-button header-nav-button--dropdown{% if nav_hover_icon != blank %} has-hover-icon{% endif %}"
                aria-expanded="false"
                aria-controls="MegaMenu-{{ forloop.index }}"
                data-mega-menu-trigger
              >
                <span class="header-nav-button-icon {% if nav_icon_is_image %}header-nav-button-icon--image{% endif %}">
                  <span class="nav-icon-default">{{ nav_icon }}</span>
                  {%- if nav_hover_icon != blank -%}
                    <span class="nav-icon-hover {% if nav_hover_icon_is_image %}header-nav-button-icon--image{% endif %}">
                      {{- nav_hover_icon -}}
                    </span>
                  {%- endif -%}
                </span>
                <span class="header-nav-button-text">{{ link.title | upcase }}</span>
                <span
                  class="header-nav-button-caret icon-caret{% if caret_icon_is_image %} caret-icon--image{% endif %}"
                  style="width: {{ caret_size }}px; height: {{ caret_size | times: 0.6 }}px;"
                >
                  {{- caret_icon -}}
                </span>
              </button>
            {%- else -%}
              {%- if link.active -%}
                {%- assign nav_link_class = 'active' -%}
              {%- else -%}
                {%- assign nav_link_class = '' -%}
              {%- endif -%}
              {%-
                render 'header-button',
                button_text: link.title | upcase,
                button_url: link.url,
                button_icon: nav_icon,
                button_icon_is_image: nav_icon_is_image,
                button_hover_icon: nav_hover_icon,
                button_hover_icon_is_image: nav_hover_icon_is_image,
                button_type: 'link',
                button_class: nav_link_class,
                aria_label: link.title
              -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</header>

{%- comment -%} Desktop Mega Menus (Outside header to avoid overflow/positioning issues) {%- endcomment -%}
{%- for link in section.settings.menu.links -%}
  {%- if link.links != blank -%}
    {%- assign matching_block = null -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'mega_menu' and block.settings.link_name == link.title -%}
        {%- assign matching_block = block -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    <div id="MegaMenu-{{ forloop.index }}" class="mega-menu" data-mega-menu>
      <div class="mega-menu-inner">
        {%- comment -%} Main Title Section {%- endcomment -%}
        <div class="mega-menu-header">
          <h2 class="mega-menu-title">
            {{ matching_block.settings.main_title | default: link.title | default: 'Collection' }}
          </h2>
        </div>

        {%- comment -%} Featured Columns Section {%- endcomment -%}
        <div class="mega-menu-featured-columns">
          {%- assign total_links = link.links.size -%}
          {%- assign links_per_column = total_links | divided_by: 3.0 | ceil -%}

          {%- for i in (1..3) -%}
            {%- assign featured_title_key = 'featured_title_' | append: i -%}
            {%- assign featured_title = matching_block.settings[featured_title_key] | default: 'FEATURED' -%}
            {%- assign start_index = i | minus: 1 | times: links_per_column -%}
            {%- assign end_index = start_index | plus: links_per_column | minus: 1 -%}
            {%- if i == 3 -%}
              {%- assign end_index = total_links | minus: 1 -%}
            {%- endif -%}
            <div class="mega-menu-column">
              <h3 class="mega-menu-featured-header">
                <span class="mega-menu-featured-bullet"></span>
                {{ featured_title }}
              </h3>
              <ul class="mega-menu-column-list">
                {%- for j in (start_index..end_index) -%}
                  {%- if j >= 0 and j < total_links and link.links[j] -%}
                    <li class="mega-menu-column-item">
                      <a href="{{ link.links[j].url }}" class="mega-menu-column-link">
                        {{ link.links[j].title }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Image Cards Section {%- endcomment -%}
        {%- if matching_block != null -%}
          <div class="mega-menu-images">
            <div class="mega-menu-image-grid">
              {%- for i in (1..2) -%}
                {%- assign img_key = 'image_' | append: i -%}
                {%- assign link_key = 'link_' | append: i -%}
                {%- assign label_key = 'label_' | append: i -%}
                {%- assign img = matching_block.settings[img_key] -%}
                {%- assign url = matching_block.settings[link_key] -%}
                {%- assign label = matching_block.settings[label_key] -%}

                {%- if img != blank -%}
                  <a href="{{ url | default: '#' }}" class="mega-menu-image-card">
                    <div class="mega-menu-image-wrapper">
                      {{ img | image_url: width: 400 | image_tag: loading: 'lazy', class: 'mega-menu-image' }}
                    </div>
                    {%- if label != blank -%}
                      <div class="mega-menu-image-label">
                        {{ label }}
                      </div>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Search popup (mega-menu style) – enabled by default {%- endcomment -%}
{%- if search_popup_block != blank -%}
  {%- assign search_popup_title = search_popup_block.settings.main_title | default: 'Search' -%}
  {%- assign search_popup_placeholder = search_popup_block.settings.search_placeholder | default: '' -%}
  {%- if search_popup_placeholder == '' -%}
    {%- assign search_popup_placeholder = 'general.search.search' | t -%}
  {%- endif -%}
{%- else -%}
  {%- assign search_popup_title = 'Search' -%}
  {%- assign search_popup_placeholder = 'general.search.search' | t -%}
{%- endif -%}
<div
  id="HeaderSearchPopup"
  class="mega-menu"
  data-mega-menu
  aria-hidden="true"
  {% if search_popup_block != blank %}
    {{- search_popup_block.shopify_attributes -}}
  {% endif %}
>
  <div class="mega-menu-inner">
    <div class="mega-menu-header">
      <h2 class="mega-menu-title">{{ search_popup_title }}</h2>
    </div>

    {%- comment -%} Search field (same as mega menu styling) {%- endcomment -%}
    <div class="mega-menu-search-content">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="mega-menu-search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- else -%}
        <search-form class="mega-menu-search-form">
      {%- endif -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="mega-menu-search-form-inner">
        <div class="mega-menu-search-field">
          <label class="visually-hidden" for="HeaderSearchPopupInput">{{ search_popup_title }}</label>
          <button type="submit" class="mega-menu-search-submit" aria-label="{{ search_popup_title }}">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
              <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <input
            class="mega-menu-search-input"
            id="HeaderSearchPopupInput"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ search_popup_placeholder }}"
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="mega-menu-predictive-search-results"
              aria-controls="mega-menu-predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <button
            type="reset"
            class="mega-menu-search-reset{% if search.terms == blank %} hidden{% endif %}"
            aria-label="{{ 'general.search.reset' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-reset.svg' | inline_asset_content -}}
            </span>
          </button>
          <input type="hidden" name="options[prefix]" value="last">
        </div>
        {%- if settings.predictive_search_enabled -%}
          <div
            class="mega-menu-predictive-search"
            id="mega-menu-predictive-search-results"
            tabindex="-1"
            data-predictive-search
          >
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}
    </div>

    {%- comment -%} Featured columns and image cards {%- endcomment -%}
    {%- if search_popup_block != blank -%}
      {%- comment -%} Featured columns (same as mega menu) {%- endcomment -%}
      {%- if search_popup_block.settings.menu != blank -%}
        {%- assign search_popup_menu = linklists[search_popup_block.settings.menu] -%}
        {%- if search_popup_menu != blank and search_popup_menu.links != blank -%}
          {%- assign search_popup_total_links = search_popup_menu.links.size -%}
          {%- assign search_popup_links_per_column = search_popup_total_links | divided_by: 3.0 | ceil -%}
          <div class="mega-menu-featured-columns">
            {%- for i in (1..3) -%}
              {%- assign featured_title_key = 'featured_title_' | append: i -%}
              {%- assign featured_title = search_popup_block.settings[featured_title_key] | default: 'FEATURED' -%}
              {%- assign start_index = i | minus: 1 | times: search_popup_links_per_column -%}
              {%- assign end_index = start_index | plus: search_popup_links_per_column | minus: 1 -%}
              {%- if i == 3 -%}
                {%- assign end_index = search_popup_total_links | minus: 1 -%}
              {%- endif -%}
              <div class="mega-menu-column">
                <h3 class="mega-menu-featured-header">
                  <span class="mega-menu-featured-bullet"></span>
                  {{ featured_title }}
                </h3>
                <ul class="mega-menu-column-list">
                  {%- for j in (start_index..end_index) -%}
                    {%- if j >= 0 and j < search_popup_total_links and search_popup_menu.links[j] -%}
                      <li class="mega-menu-column-item">
                        <a href="{{ search_popup_menu.links[j].url }}" class="mega-menu-column-link">
                          {{ search_popup_menu.links[j].title }}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Image cards (same as mega menu) {%- endcomment -%}
      {%- liquid
        assign img_1 = search_popup_block.settings.image_1
        assign img_2 = search_popup_block.settings.image_2
      -%}
      {%- if img_1 != blank or img_2 != blank -%}
        <div class="mega-menu-images">
          <div class="mega-menu-image-grid">
            {%- for i in (1..2) -%}
              {%- liquid
                assign img_key = 'image_' | append: i
                assign link_key = 'link_' | append: i
                assign label_key = 'label_' | append: i
                assign img = search_popup_block.settings[img_key]
                assign url = search_popup_block.settings[link_key]
                assign label = search_popup_block.settings[label_key]
              -%}
              {%- if img != blank -%}
                <a href="{{ url | default: '#' }}" class="mega-menu-image-card">
                  <div class="mega-menu-image-wrapper">
                    {{ img | image_url: width: 400 | image_tag: loading: 'lazy', class: 'mega-menu-image' }}
                  </div>
                  {%- if label != blank -%}
                    <div class="mega-menu-image-label">
                      {{ label }}
                    </div>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<!-- Mobile/Tablet Header -->
<header class="mobile-header">
  <div class="mobile-header-container">
    <!-- Logo -->
    <div class="mobile-header-logo">
      {%- if section.settings.mobile_logo != blank -%}
        {%- assign mobile_logo_width = section.settings.mobile_logo_image_max_width | default: 120 | at_least: 100 -%}
        <a href="{{ routes.root_url }}" class="mobile-logo-link">
          {{
            section.settings.mobile_logo
            | image_url: width: mobile_logo_width
            | image_tag: loading: 'eager', alt: shop.name, class: 'mobile-logo-image'
          }}
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mobile-logo-link">
          <span class="mobile-logo-text">{{ section.settings.mobile_logo_text | default: shop.name }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Right Side Icons -->
    <div class="mobile-header-actions">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mobile_menu' -%}
          <button
            type="button"
            class="mobile-header-icon mobile-menu-toggle"
            aria-label="Menu"
            aria-expanded="false"
            data-mobile-menu-toggle
            {{ block.shopify_attributes }}
          >
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 12H21" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 6H10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 18H15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-drawer" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu-content">
      <!-- Close Button -->
      <button
        type="button"
        class="mobile-menu-close"
        aria-label="Close menu"
        data-mobile-menu-close
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <nav class="mobile-menu-nav">
        <!-- Main Menu Links (Single Column) -->
        <ul class="mobile-menu-list">
          {%- for link in section.settings.menu.links -%}
            <li class="mobile-menu-item">
              {%- if link.links != blank -%}
                {%- assign link_handle = link.title | handleize -%}
                <div class="mobile-menu-link-wrapper">
                  <a href="{{ link.url }}" class="mobile-menu-link {% if link.active %}active{% endif %}">
                    <span class="mobile-menu-link-text">{{ link.title | upcase }}</span>
                  </a>
                  <button
                    type="button"
                    class="mobile-menu-toggle-submenu"
                    data-mobile-submenu-toggle
                    data-parent-link="{{ link_handle }}"
                    aria-expanded="false"
                    aria-label="Toggle {{ link.title }} submenu"
                  >
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <ul class="mobile-submenu" data-parent="{{ link_handle }}">
                  {%- for childlink in link.links -%}
                    <li class="mobile-submenu-item">
                      <a
                        href="{{ childlink.url }}"
                        class="mobile-submenu-link {% if childlink.active %}active{% endif %}"
                      >
                        {{ childlink.title | upcase }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a href="{{ link.url }}" class="mobile-menu-link {% if link.active %}active{% endif %}">
                  <span class="mobile-menu-link-text">{{ link.title | upcase }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <!-- Footer: Account, Cart, Search (same icons as desktop) -->
        <div class="mobile-menu-footer">
          <div class="mobile-menu-footer-row mobile-menu-footer-row--top">
            {%- assign icon_size = section.settings.button_icon_size | default: 20 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'welcome' -%}
                {%- assign welcome_icon = '' -%}
                {%- if block.settings.button_icon_image != blank -%}
                  {%- assign welcome_icon = block.settings.button_icon_image
                    | image_url: width: icon_size
                    | image_tag:
                      loading: 'lazy',
                      alt: 'Account',
                      class: 'mobile-menu-footer-icon-img',
                      width: icon_size,
                      height: icon_size
                  -%}
                {%- elsif block.settings.button_icon_svg != blank -%}
                  {%- assign welcome_icon = block.settings.button_icon_svg -%}
                {%- else -%}
                  {%- assign welcome_icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
                {%- endif -%}
                <a
                  href="{{ block.settings.login_url | default: routes.account_login_url }}"
                  class="mobile-menu-footer-btn mobile-menu-footer-btn--account"
                  aria-label="Account"
                >
                  <span class="mobile-menu-footer-icon {% if block.settings.button_icon_image != blank %}mobile-menu-footer-icon--image{% endif %}">
                    {{- welcome_icon -}}
                  </span>
                </a>
              {%- endif -%}
            {%- endfor -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'cart' -%}
                {%- assign cart_icon = '' -%}
                {%- if block.settings.button_icon_image != blank -%}
                  {%- assign cart_icon = block.settings.button_icon_image
                    | image_url: width: icon_size
                    | image_tag:
                      loading: 'lazy',
                      alt: 'Cart',
                      class: 'mobile-menu-footer-icon-img',
                      width: icon_size,
                      height: icon_size
                  -%}
                {%- elsif block.settings.button_icon_svg != blank -%}
                  {%- assign cart_icon = block.settings.button_icon_svg -%}
                {%- else -%}
                  {%- assign cart_icon = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 1H5L7.68 13.39C7.77144 13.8504 8.02191 14.264 8.38755 14.5583C8.75318 14.8526 9.2107 15.009 9.68 15H19.4C19.8693 15.009 20.3268 14.8526 20.6925 14.5583C21.0581 14.264 21.3086 13.8504 21.4 13.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
                {%- endif -%}
                <a
                  href="{{ routes.cart_url }}"
                  class="mobile-menu-footer-btn mobile-menu-footer-btn--cart{% if settings.cart_type == 'drawer' %} cart-drawer-trigger{% endif %}"
                  aria-label="Cart"
                >
                  <span class="mobile-menu-footer-icon {% if block.settings.button_icon_image != blank %}mobile-menu-footer-icon--image{% endif %}">
                    {{- cart_icon -}}
                  </span>
                  {%- if cart.item_count > 0 -%}
                    <span class="mobile-menu-footer-badge">{{ cart.item_count }}</span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="mobile-menu-footer-row mobile-menu-footer-row--bottom">
            {%- for block in section.blocks -%}
              {%- if block.type == 'search' -%}
                {%- assign search_icon = '' -%}
                {%- if block.settings.button_icon_image != blank -%}
                  {%- assign search_icon = block.settings.button_icon_image
                    | image_url: width: icon_size
                    | image_tag:
                      loading: 'lazy',
                      alt: 'Search',
                      class: 'mobile-menu-footer-icon-img',
                      width: icon_size,
                      height: icon_size
                  -%}
                {%- elsif block.settings.button_icon_svg != blank -%}
                  {%- assign search_icon = block.settings.button_icon_svg -%}
                {%- else -%}
                  {%- assign search_icon = '<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
                {%- endif -%}
                {%- if block.settings.button_url != blank -%}
                  <a
                    href="{{ block.settings.button_url }}"
                    class="mobile-menu-footer-btn mobile-menu-footer-btn--search"
                    aria-label="Search"
                    data-mega-menu-trigger
                    aria-controls="HeaderSearchPopup"
                    aria-expanded="false"
                  >
                    <span class="mobile-menu-footer-icon {% if block.settings.button_icon_image != blank %}mobile-menu-footer-icon--image{% endif %}">
                      {{- search_icon -}}
                    </span>
                  </a>
                {%- else -%}
                  <button
                    type="button"
                    class="mobile-menu-footer-btn mobile-menu-footer-btn--search"
                    aria-label="Search"
                    data-mega-menu-trigger
                    aria-controls="HeaderSearchPopup"
                    aria-expanded="false"
                  >
                    <span class="mobile-menu-footer-icon {% if block.settings.button_icon_image != blank %}mobile-menu-footer-icon--image{% endif %}">
                      {{- search_icon -}}
                    </span>
                  </button>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  window.headerAnimationSpeed = {{ section.settings.scroll_animation_speed | default: 1 }};
</script>
<script src="{{ 'vertical-header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mobile-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Desktop Header Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Logo displayed in the vertical sidebar header"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "kokō",
      "info": "Text displayed if no logo image is uploaded"
    },
    {
      "type": "header",
      "content": "Header Layout"
    },
    {
      "type": "range",
      "id": "header_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Header Width",
      "default": 230,
      "info": "Width of the vertical sidebar header"
    },
    {
      "type": "range",
      "id": "header_padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Header Inner Padding",
      "default": 24,
      "info": "Padding around the header content"
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Header Section Gap",
      "default": 24,
      "info": "Gap between header sections (logo, buttons, nav)"
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "select",
      "id": "logo_alignment",
      "label": "Logo Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Horizontal alignment of the logo within the header"
    },
    {
      "type": "range",
      "id": "logo_padding_top",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Top",
      "default": 26
    },
    {
      "type": "range",
      "id": "logo_padding_bottom",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Bottom",
      "default": 26
    },
    {
      "type": "range",
      "id": "logo_padding_left",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_padding_right",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo Padding Right",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Logo Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Logo Font Size",
      "default": 28
    },
    {
      "type": "select",
      "id": "logo_font_weight",
