{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
{{ 'section-scrolling-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_bar = true
  if section.blocks.size == 0
    assign show_bar = false
  endif
-%}

{%- if show_bar -%}
  {%- liquid
    assign scheme = section.settings.color_scheme
    if scheme == blank
      assign scheme = settings.color_schemes | first
    endif

    # Calculate duration: speed setting 1-10 (1 is slow, 10 is fast)
    # Original formula: duration = 11 - speed * 4
    assign speed_val = section.settings.marquee_speed | default: 5
    assign duration = 11 | minus: speed_val | times: 4
  -%}

  <div
    class="announcement-bar marquee-scroll color-{{ scheme.id }}{% if section.settings.sticky %} is-sticky{% endif %}"
    id="section-{{ section.id }}"
    data-announcement-bar
    style="
      --section-padding-top: 0;
      --section-padding-bottom: 0;
      --section-margin-left: 0;
      --section-margin-right: 0;
      --ab-bar-py: {{ section.settings.bar_padding_y }}px;
      --ab-bar-px: {{ section.settings.bar_padding_x }}px;
      background-color: var(--color-bg);
    "
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'announcement' -%}
          {%
            render 'scrolling-text-item',
            id: block.id,
            shopify_attributes: block.shopify_attributes,
            speed: duration,
            direction: 'normal',
            pause_on_hover: section.settings.pause_on_hover,
            bg_color: 'transparent',
            border_radius: 0,
            padding: 0,
            text_size: section.settings.font_size,
            text_weight: section.settings.font_weight,
            pill_bg: 'var(--btn-secondary-bg)',
            pill_color: 'var(--btn-secondary-text)',
            pill_height: section.settings.bar_min_height | default: 44,
            pill_radius: section.settings.pill_border_radius,
            pill_padding_x: section.settings.pill_padding_x,
            pill_padding_y: section.settings.pill_padding_y,
            text_transform: section.settings.text_transform,
            item_gap: section.settings.separator_gap,
            orbit_text: block.settings.text,
            text: block.settings.text,
            circle_icon: section.settings.separator_image,
            circle_width: section.settings.separator_size,
            circle_height: section.settings.separator_size,
            circle_bg: 'var(--btn-tertiary-bg)',
            orbit_color: 'var(--btn-secondary-text)'
          %}
        {%- when 'countdown' -%}
          {%- comment -%} Legacy: countdown block type removed from schema; render label as static marquee for existing sections. {%- endcomment -%}
          {%
            render 'scrolling-text-item',
            id: block.id,
            shopify_attributes: block.shopify_attributes,
            speed: duration,
            direction: 'normal',
            pause_on_hover: section.settings.pause_on_hover,
            bg_color: 'transparent',
            border_radius: 0,
            padding: 0,
            text_size: section.settings.font_size,
            text_weight: section.settings.font_weight,
            pill_bg: 'var(--btn-secondary-bg)',
            pill_color: 'var(--btn-secondary-text)',
            pill_height: section.settings.bar_min_height | default: 44,
            pill_radius: section.settings.pill_border_radius,
            pill_padding_x: section.settings.pill_padding_x,
            pill_padding_y: section.settings.pill_padding_y,
            text_transform: section.settings.text_transform,
            item_gap: section.settings.separator_gap,
            orbit_text: block.settings.label | default: 'Ends in:',
            text: block.settings.label | default: 'Ends in:',
            circle_icon: section.settings.separator_image,
            circle_width: section.settings.separator_size,
            circle_height: section.settings.separator_size,
            circle_bg: 'var(--btn-tertiary-bg)',
            orbit_color: 'var(--btn-secondary-text)'
          %}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <script>
    (function () {
      function updateBarHeight() {
        const bar = document.querySelector('[data-announcement-bar]');
        if (bar) {
          document.documentElement.style.setProperty('--announcement-bar-height', bar.offsetHeight + 'px');
        } else {
          document.documentElement.style.setProperty('--announcement-bar-height', '0px');
        }
      }
      updateBarHeight();
      window.addEventListener('resize', updateBarHeight);
      document.addEventListener('shopify:section:load', updateBarHeight);
      document.addEventListener('shopify:section:unload', updateBarHeight);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": " Announcement",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Scroll Speed",
      "default": 5,
      "info": "1 = slowest, 10 = fastest"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_padding_y",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bar vertical padding",
      "default": 6
    },
    {
      "type": "range",
      "id": "bar_padding_x",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bar horizontal padding",
      "info": "Adds space on the left and right inside the bar",
      "default": 0
    },
    {
      "type": "range",
      "id": "bar_min_height",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bar min-height",
      "info": "Set to 0 to let content determine height",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "default": true,
      "label": "Sticky bar"
    },
    {
      "type": "header",
      "content": "Pill Style"
    },
    {
      "type": "range",
      "id": "pill_padding_x",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Pill horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "pill_padding_y",
      "min": 2,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Pill vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "pill_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Pill corner radius",
      "default": 50
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "image_picker",
      "id": "separator_image",
      "label": "Separator image",
      "info": "Displayed as a circle between each announcement pill. Leave blank to use a dot."
    },
    {
      "type": "range",
      "id": "separator_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Separator size",
      "default": 36
    },
    {
      "type": "range",
      "id": "separator_gap",
      "min": 4,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Gap around separator",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Free shipping worldwide",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": " Announcement",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
