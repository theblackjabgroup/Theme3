{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'tech-specs-animations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tech-specs-animations.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ section.settings.margin_horizontal | times: 0.75 | round: 0 }}px;
    margin-right: {{ section.settings.margin_horizontal | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      margin-left: {{ section.settings.margin_horizontal }}px;
      margin-right: {{ section.settings.margin_horizontal }}px;
    }
  }

  #shopify-section-{{ section.id }} .sc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sc-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .sc-heading {
    text-align: center;
    margin-bottom: 40px;
    color: var(--heading-color);
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-eyebrow,
  #shopify-section-{{ section.id }} .dc-textbox-eyebrow {
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-title,
  #shopify-section-{{ section.id }} .dc-textbox-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-text,
  #shopify-section-{{ section.id }} .dc-textbox-text {
    font-size: {{ section.settings.body_font_size }}px;
    font-weight: {{ section.settings.body_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-textbox-list li,
  #shopify-section-{{ section.id }} .dc-list-text {
    font-size: {{ section.settings.list_font_size }}px;
    font-weight: {{ section.settings.list_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-tooltip-content {
    font-size: {{ section.settings.tooltip_font_size }}px;
    font-weight: {{ section.settings.tooltip_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-goal-label {
    font-size: {{ section.settings.goal_label_font_size }}px;
    font-weight: {{ section.settings.goal_label_font_weight }};
  }

  #shopify-section-{{ section.id }} .dc-progress-bar-container {
    width: var(--dc-bar-track-width);
    {%- if section.settings.bar_track_width < 100 -%}
    margin-left: auto;
    margin-right: auto;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .dc-bar-track {
    height: {{ section.settings.bar_track_height }}px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .dc-tooltip-svg-wrapper {
    width: {{ section.settings.tooltip_height | times: 1.6 | round: 0 }}px;
    height: {{ section.settings.tooltip_height }}px;
  }

  #shopify-section-{{ section.id }} .dc-tooltip-svg-wrapper svg {
    width: 100%;
    height: 100%;
    display: block;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" style="max-width: 100%;">
  {%- if section.settings.heading != blank -%}
    <h2 class="sc-heading h1">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="sc-grid">
    {%- for block in section.blocks -%}
      <div
        class="sc-grid-item"
        style="
          --dc-bg-color: {{ block.settings.bg_color }};
          --dc-text-color: {{ block.settings.text_color }};
          --dc-tooltip-bg: {{ block.settings.tooltip_bg | default: '#ff0000' }};
          --dc-tooltip-text: {{ block.settings.tooltip_text | default: '#ffffff' }};
          --dc-bar-fill: {{ block.settings.progress_fill | default: '#ff0000' }};
          --dc-bar-track: {{ block.settings.progress_track | default: '#fce8e8' }};
          --dc-eyebrow-color: {{ block.settings.eyebrow_color }};
          --dc-bar-track-width: {{ section.settings.bar_track_width }}%;
          {%- if block.type == 'textbox' -%}
            --dc-card-border-radius: {{ block.settings.card_border_radius }}px;
          {%- elsif block.type == 'card' -%}
            --dc-card-border-radius: {{ block.settings.card_border_radius }}px;
            {%- if block.settings.image != blank -%}
              --dc-image-width: {{ block.settings.override_image_width }}px;
              --dc-image-height: {{ block.settings.override_image_height }}px;
              --dc-image-margin-top: {{ block.settings.override_image_margin_top }}px;
              --dc-image-margin-bottom: {{ block.settings.override_image_margin_bottom }}px;
            {%- else -%}
              --dc-image-width: {{ block.settings.product_image_width }}px;
              --dc-image-height: {{ block.settings.product_image_height }}px;
              --dc-image-margin-top: {{ block.settings.product_image_margin_top }}px;
              --dc-image-margin-bottom: {{ block.settings.product_image_margin_bottom }}px;
            {%- endif -%}
          {%- endif -%}
        "
        {{ block.shopify_attributes }}
      >
        {%- case block.type -%}
          {%- when 'textbox' -%}
            {% render 'card-textbox',
              eyebrow: block.settings.eyebrow,
              title: block.settings.title,
              text: block.settings.text,
              list_content: block.settings.list_content,
              custom_icon: block.settings.icon_custom
            %}
          {%- when 'card' -%}
            {%- liquid
              assign card_product = block.settings.product

              assign image = block.settings.image | default: card_product.featured_image
              assign title = block.settings.title
              if title == blank and card_product != blank
                assign title = card_product.title
              endif

              assign text = block.settings.text
              if text == blank and card_product != blank
                assign text = card_product.description | strip_html | truncatewords: 20
              endif

              assign raised = block.settings.raised
              if raised == 0 and card_product != blank and card_product.metafields.custom.raised != blank
                assign raised = card_product.metafields.custom.raised.value
              endif

              assign goal = block.settings.goal
              if goal == 100 and card_product != blank and card_product.metafields.custom.goal != blank
                assign goal = card_product.metafields.custom.goal.value
              endif
            -%}
            {% render 'product-card',
              eyebrow: block.settings.eyebrow,
              image: image,
              title: title,
              text: text,
              raised: raised,
              goal: goal,
              currency: section.settings.currency
            %}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

