{%- comment -%}
  Back to Top Section
  Appears when scrolling and provides a floating button to return to page top
{%- endcomment -%}

<style>
  .back-to-top-container {
    position: fixed;
    bottom: {{ section.settings.bottom_offset | default: 30 }}px;
    right: {{ section.settings.right_offset | default: 30 }}px;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .back-to-top-container.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top-button {
    width: {{ section.settings.button_size | default: 50 }}px !important;
    height: {{ section.settings.button_size | default: 50 }}px !important;
    padding: 0 !important;
    border-radius: {% if section.settings.border_radius != blank %}{{ section.settings.border_radius }}px{% else %}var(--radius-2xl){% endif %};
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: unset !important;
  }

  .back-to-top-button .global-btn__icon {
    width: {{ section.settings.icon_size | default: 60 }}%;
    height: {{ section.settings.icon_size | default: 60 }}%;
    margin: 0 !important;
  }

  .back-to-top-button .global-btn__text {
    display: none !important;
  }
</style>

<div class="back-to-top-container" data-back-to-top-container>
  {%- capture icon_svg -%}
    {%- if section.settings.icon_svg != blank -%}
      {{ section.settings.icon_svg }}
    {%- else -%}
      {{- 'icon-caret-up.svg' | inline_asset_content -}}
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.icon_image != blank -%}
    {%- assign icon_content = section.settings.icon_image
      | image_url: width: 40
      | image_tag: loading: 'lazy', alt: 'Back to top'
    -%}
  {%- else -%}
    {%- assign icon_content = icon_svg -%}
  {%- endif -%}

  {%- render 'global-btn',
    text: 'Back to top',
    url: '#',
    icon: icon_content,
    icon_only: true,
    variant: section.settings.button_variant | default: 'primary',
    class: 'back-to-top-button',
    attributes: 'data-back-to-top-trigger aria-label="Back to top"',
    type: 'button'
  -%}
</div>

<script>
  (function () {
    const container = document.querySelector('[data-back-to-top-container]');
    const trigger = document.querySelector('[data-back-to-top-trigger]');
    if (!container || !trigger) return;

    function handleScroll() {
      // Show button after threshold scroll
      if (window.scrollY > {{ section.settings.scroll_threshold | default: 50 }}) {
        container.classList.add('is-visible');
      } else {
        container.classList.remove('is-visible');
      }
    }

    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Run once on load
    handleScroll();
  })();
</script>

{% schema %}
{
  "name": "Back to Top",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "This section adds a floating 'Back to Top' button that appears when scrolling down."
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "default": "scheme-4",
      "info": "When the theme toggle is in dark mode, use this scheme for this section."
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom Icon Image",
      "info": "Upload an image to use as the icon. If left blank, the SVG/Default will be used."
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Custom SVG Icon",
      "info": "Paste custom SVG code here. Use 'currentColor' for stroke/fill to match button text color."
    },
    {
      "type": "select",
      "id": "button_variant",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" }
      ],
      "default": "primary",
      "info": "Uses the global button styles from your color scheme."
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 40,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Button Size",
      "default": 50
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Distance",
      "default": 30
    },
    {
      "type": "range",
      "id": "right_offset",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Right Distance",
      "default": 30
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 20,
      "info": "Set to 0 for a square, higher for rounded corners."
    },
    {
      "type": "range",
      "id": "scroll_threshold",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Show after scroll amount",
      "default": 50
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Icon Size (Relative to Button)",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Back to Top"
    }
  ]
}
{% endschema %}
