      "label": "Mixer Float Delay",
      "default": 1.8
    },
    {
      "type": "range",
      "id": "mobile_mixer_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Mobile: Mixer Bottom Position",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_mixer_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile: Mixer Right Position",
      "default": 2
    }
  ]
}
{% endschema %}
