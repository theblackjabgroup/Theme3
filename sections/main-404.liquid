      "unit": "%",
      "label": "Cylinders Bottom Position",
      "default": 25
    },
    {
      "type": "range",
      "id": "cylinders_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Cylinders Left Position",
