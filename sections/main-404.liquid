{{ 'section-scrolling-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_text = section.settings.background_text | default: "OOPS! YOU'RE"
  assign bg_color = 'var(--color-bg)'
  assign message_text = section.settings.message_text | default: "This is a 404 error, which means you've clicked on a bad link or entered an invalid URL. Maybe what you are looking for can be found on the homepage."
  assign button_text = section.settings.button_text | default: 'Take me to Home'

  assign hero_media_type = section.settings.hero_media_type | default: 'image'
  assign hero_image = section.settings.product_image
  if hero_media_type == 'image' and hero_image == blank and collections.all.products.size > 0
    assign first_product = collections.all.products.first
    if first_product.featured_media != blank
      assign hero_image = first_product.featured_media
    endif
  endif
  if hero_media_type == 'image' and hero_image == blank
    assign hero_image_placeholder = true
  endif
  assign hero_image_width = section.settings.image_max_width | default: 400 | times: 2

  assign youtube_url = section.settings.youtube_url | default: ''
  assign yt_id = ''
  if youtube_url != blank
    if youtube_url contains 'youtu.be/'
      assign yt_id = youtube_url | split: '/' | last | split: '?' | first
    elsif youtube_url contains 'watch?v='
      assign yt_id = youtube_url | split: 'v=' | last | split: '&' | first
    endif
  endif
-%}

{%- style -%}
  {%- if section.settings.scrolling_text_font != blank -%}
    {{ section.settings.scrolling_text_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.message_font != blank -%}
    {{ section.settings.message_font | font_face: font_display: 'swap' }}
  {%- endif -%}
{%- endstyle -%}

<style>
  .template-404 {
    height: 96vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: {{ bg_color }};
    position: relative;
    overflow: hidden;
    padding: 20px;
    margin: 20px;
    border-radius: 20px;
  }

  .template-404__scrolling-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .template-404__scrolling-bg .scrolling-text-strip {
    position: absolute;
    top: {{ section.settings.scrolling_text_vertical_position | default: 0 }}%;
    left: {{ section.settings.scrolling_text_horizontal_position | default: 50 }}%;
    transform: translateX(-50%);
    --bg-color: transparent;
    --text-color: var(--color-heading);
    --speed: {{ section.settings.background_text_speed | default: 30 }}s;
    --angle: 0deg;
    --item-font-size: clamp({{ section.settings.scrolling_text_font_size_min | default: 4 }}rem, {{ section.settings.scrolling_text_font_size_vw | default: 18 }}vw, {{ section.settings.scrolling_text_font_size_max | default: 12 }}rem);
    --direction: normal;
    --tilt-margin: 0;
    --item-gap: 0.15em;
    --strip-padding: 0.1em 0;
    --strip-width: 100%;
    --margin-left: 0;
    --margin-right: 0;
    --border-width: 0;
    --border-style: none;
    width: 100%;
    margin: 0;
    transform: translateX(-50%);
    font-weight: {{ section.settings.scrolling_text_font_weight | default: 700 }};
    text-transform: {{ section.settings.scrolling_text_text_transform | default: 'uppercase' }};
    letter-spacing: {{ section.settings.scrolling_text_letter_spacing | default: '-0.02em' }};
    line-height: 1.1;
  }

  .template-404__scrolling-bg .scrolling-text-inner {
    width: 100%;
  }

  .template-404__scrolling-bg .scrolling-text-item {
    font-family: {% if section.settings.scrolling_text_font != blank %}{{ section.settings.scrolling_text_font.family }}, {{ section.settings.scrolling_text_font.fallback_families }}{% else %}var(--font-heading-family), sans-serif{% endif %};
    font-style: {% if section.settings.scrolling_text_font != blank %}{{ section.settings.scrolling_text_font.style }}{% else %}normal{% endif %};
  }

  .template-404__content {
    text-align: center;
    z-index: 10;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 560px;
  }

  .template-404__image {
    width: 100%;
    max-width: {{ section.settings.image_max_width | default: 400 }}px;
    margin: 0 auto;
    {%- if section.settings.image_max_height and section.settings.image_max_height > 0 -%}
    max-height: {{ section.settings.image_max_height }}px;
    {%- endif -%}
  }

  .template-404__image img,
  .template-404__image .template-404__placeholder {
    width: 100%;
    height: auto;
    display: block;
    object-fit: {{ section.settings.image_object_fit | default: 'contain' }};
    {%- if section.settings.image_border_radius and section.settings.image_border_radius > 0 -%}
    border-radius: {{ section.settings.image_border_radius }}px;
    {%- endif -%}
  }

  .template-404__image video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: {{ section.settings.image_object_fit | default: 'contain' }};
    {%- if section.settings.image_border_radius and section.settings.image_border_radius > 0 -%}
    border-radius: {{ section.settings.image_border_radius }}px;
    {%- endif -%}
  }

  .template-404__image .template-404__video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    {%- if section.settings.image_border_radius and section.settings.image_border_radius > 0 -%}
    border-radius: {{ section.settings.image_border_radius }}px;
    {%- endif -%}
  }

  .template-404__image .template-404__video-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .template-404__video-placeholder {
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    color: var(--color-text);
    font-size: 0.9rem;
    background: var(--color-card-bg);
    border-radius: 12px;
  }

  .template-404__message {
    font-family: {% if section.settings.message_font != blank %}{{ section.settings.message_font.family }}, {{ section.settings.message_font.fallback_families }}{% else %}var(--font-body-family), sans-serif{% endif %};
    font-style: {% if section.settings.message_font != blank %}{{ section.settings.message_font.style }}{% else %}normal{% endif %};
    font-size: {{ section.settings.message_font_size | default: 16 }}px;
    font-weight: {{ section.settings.message_font_weight | default: 400 }};
    line-height: {{ section.settings.message_line_height | default: 1.6 }};
    color: var(--color-text);
    margin: 0;
  }

  .template-404__button {
    margin-top: {{ section.settings.button_margin_top | default: 4 }}px;
    margin-bottom: {{ section.settings.button_margin_bottom | default: 0 }}px;
    max-width: {% if section.settings.button_max_width and section.settings.button_max_width > 0 %}{{ section.settings.button_max_width }}px{% else %}100%{% endif %};
  }

  .template-404__button .share-story-submit {
    width: {% if section.settings.button_width == 'full' %}100%{% else %}fit-content{% endif %};
  }

  .template-404__button .share-story-submit .submit-button__content,
  .template-404__button .share-story-submit .submit-button__shadow {
    font-size: {{ section.settings.button_font_size | default: 16 }}px;
    font-weight: {{ section.settings.button_font_weight | default: 700 }};
    padding: {{ section.settings.button_padding_vertical | default: 16 }}px {{ section.settings.button_padding_horizontal | default: 28 }}px;
    border-radius: {{ section.settings.button_border_radius | default: 20 }}px;
    border-width: {{ section.settings.button_border_width | default: 2 }}px;
    letter-spacing: {{ section.settings.button_letter_spacing | default: '0.02em' }};
  }

  .template-404__button .share-story-submit .submit-button__content {
    border-style: solid;
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border-color: var(--btn-primary-border);
  }

  .template-404__button .share-story-submit .submit-button__shadow {
    background-color: var(--btn-primary-shadow);
  }

  @media (max-width: 768px) {
    .template-404 {
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 16px;
      margin: 12px;
      border-radius: 16px;
      align-items: {{ section.settings.content_vertical_position_mobile | default: 'center' }};
      padding-bottom: 2rem;
    }

    .template-404__content {
      gap: 1.25rem;
      max-width: 100%;
      padding: 0 0.5rem;
    }

    .template-404__image {
      max-width: min({{ section.settings.image_max_width | default: 400 }}px, 100%);
    }

    .template-404__scrolling-bg .scrolling-text-strip {
      top: {{ section.settings.scrolling_text_vertical_position_mobile | default: 0 }}%;
      left: {{ section.settings.scrolling_text_horizontal_position_mobile | default: 50 }}%;
      --item-font-size: clamp({{ section.settings.scrolling_text_font_size_min_mobile | default: 3 }}rem, {{ section.settings.scrolling_text_font_size_vw_mobile | default: 14 }}vw, {{ section.settings.scrolling_text_font_size_max_mobile | default: 8 }}rem);
    }

    .template-404__message {
      font-size: {{ section.settings.message_font_size_mobile | default: 15 }}px;
      line-height: 1.5;
    }

    .template-404__button {
      width: 100%;
      max-width: {% if section.settings.button_max_width_mobile and section.settings.button_max_width_mobile > 0 %}{{ section.settings.button_max_width_mobile }}px{% else %}320px{% endif %};
      margin-top: {{ section.settings.button_margin_top_mobile | default: 4 }}px;
      margin-bottom: {{ section.settings.button_margin_bottom_mobile | default: 0 }}px;
    }

    .template-404__button .share-story-submit {
      width: 100%;
    }

    .template-404__button .share-story-submit .submit-button__content,
    .template-404__button .share-story-submit .submit-button__shadow {
      font-size: {{ section.settings.button_font_size_mobile | default: 15 }}px;
      padding: {{ section.settings.button_padding_vertical_mobile | default: 14 }}px {{ section.settings.button_padding_horizontal_mobile | default: 24 }}px;
      border-radius: {{ section.settings.button_border_radius_mobile | default: 20 }}px;
    }

    .template-404__video-placeholder {
      min-height: 160px;
      padding: 1rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 389px) {
    .template-404 {
      padding: 12px;
      margin: 8px;
      border-radius: 12px;
    }

    .template-404__content {
      gap: 1rem;
    }

    .template-404__button {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .template-404__scrolling-bg .scrolling-text-track {
      animation: none;
    }
  }
</style>

<div class="template-404 color-{{ section.settings.color_scheme }}">
  <div class="template-404__scrolling-bg" aria-hidden="true">
    <div
      class="scrolling-text-strip"
      style="
        --bg-color: transparent;
        --text-color: var(--color-heading);
        --speed: {{ section.settings.background_text_speed | default: 30 }}s;
        --item-font-size: clamp({{ section.settings.scrolling_text_font_size_min | default: 4 }}rem, {{ section.settings.scrolling_text_font_size_vw | default: 18 }}vw, {{ section.settings.scrolling_text_font_size_max | default: 12 }}rem);
        --item-gap: 0.15em;
      "
    >
      <div class="scrolling-text-inner">
        {%- for i in (1..12) -%}
          <div class="scrolling-text-track">
            <span class="scrolling-text-item">{{ bg_text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="template-404__content">
    <div class="template-404__image">
      {%- case hero_media_type -%}
        {%- when 'image' -%}
          {%- if hero_image != blank -%}
            <img
              src="{{ hero_image | image_url: width: hero_image_width }}"
              alt=""
              width="{{ hero_image.width }}"
              height="{{ hero_image.height }}"
              loading="eager"
            >
          {%- elsif hero_image_placeholder -%}
            {{ 'product-1' | placeholder_svg_tag: 'template-404__placeholder' }}
          {%- endif -%}
        {%- when 'shopify_video' -%}
          {%- if section.settings.hero_video != blank -%}
            {{
              section.settings.hero_video
              | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: true
            }}
          {%- else -%}
            <div class="template-404__placeholder template-404__video-placeholder">
              Add a Shopify video in the section settings
            </div>
          {%- endif -%}
        {%- when 'youtube' -%}
          {%- if yt_id != '' -%}
            {%- assign yt_embed_url = 'https://www.youtube.com/embed/' | append: yt_id -%}
            <div class="template-404__video-wrap">
              <iframe
                src="{{ yt_embed_url }}?rel=0&modestbranding=1"
                title="YouTube video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          {%- else -%}
            <div class="template-404__placeholder template-404__video-placeholder">
              Add a YouTube URL in the section settings
            </div>
          {%- endif -%}
      {%- endcase -%}
    </div>

    <p class="template-404__message">{{ message_text }}</p>

    <div class="template-404__button">
      {%-
        render 'global-btn',
        text: button_text,
        url: section.settings.button_link | default: routes.root_url
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Scrolling background text"
    },
    {
      "type": "text",
      "id": "background_text",
      "label": "Background text",
      "default": "OOPS! YOU'RE"
    },
    {
      "type": "range",
      "id": "background_text_speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "scrolling_text_vertical_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Scrolling text vertical position",
      "info": "0 = top, 100 = bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "scrolling_text_horizontal_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Scrolling text horizontal position",
      "info": "50 = centered",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile positioning"
    },
    {
      "type": "paragraph",
      "content": "These apply only on screens 768px wide and below."
    },
    {
      "type": "range",
      "id": "scrolling_text_vertical_position_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Scrolling text vertical position (mobile)",
      "info": "0 = top, 100 = bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "scrolling_text_horizontal_position_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Scrolling text horizontal position (mobile)",
      "info": "50 = centered",
      "default": 50
    },
    {
      "type": "select",
      "id": "content_vertical_position_mobile",
      "label": "Content vertical position (mobile)",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "info": "Where the message and button sit vertically on mobile."
    },
    {
      "type": "header",
      "content": "Scrolling text typography"
    },
    {
      "type": "font_picker",
      "id": "scrolling_text_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_min",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "label": "Font size (min)",
      "default": 4
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_vw",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "vw",
      "label": "Font size (viewport)",
      "default": 18
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_max",
      "min": 6,
      "max": 20,
      "step": 0.5,
      "unit": "rem",
      "label": "Font size (max)",
      "default": 12
    },
    {
      "type": "range",
      "id": "scrolling_text_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "Font weight",
      "default": 700
    },
    {
      "type": "text",
      "id": "scrolling_text_letter_spacing",
      "label": "Letter spacing",
      "default": "-0.02em"
    },
    {
      "type": "select",
      "id": "scrolling_text_text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_min_mobile",
      "min": 1.5,
      "max": 6,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile font size (min)",
      "default": 3
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_vw_mobile",
      "min": 8,
      "max": 22,
      "step": 1,
      "unit": "vw",
      "label": "Mobile font size (viewport)",
      "default": 14
    },
    {
      "type": "range",
      "id": "scrolling_text_font_size_max_mobile",
      "min": 4,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile font size (max)",
      "default": 8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "hero_media_type",
      "label": "Hero media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "shopify_video",
          "label": "Shopify video"
        },
        {
          "value": "youtube",
          "label": "YouTube video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product / hero image",
      "info": "Used when Hero media type is Image. Leave blank to use the first product's image."
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Shopify video",
      "info": "Used when Hero media type is Shopify video. Upload or select a video from Settings > Files."
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "YouTube video URL",
      "info": "Used when Hero media type is YouTube. Paste a full URL (e.g. youtube.com/watch?v=... or youtu.be/...)"
    },
    {
      "type": "header",
      "content": "Image / video style"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 120,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Image max width",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_max_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Image max height",
      "info": "0 = no limit",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_object_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Message text (above button)"
    },
    {
      "type": "textarea",
      "id": "message_text",
      "label": "404 message",
      "default": "This is a 404 error, which means you've clicked on a bad link or entered an invalid URL. Maybe what you are looking for can be found on the homepage."
    },
    {
      "type": "font_picker",
      "id": "message_font",
      "label": "Message font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "message_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Message font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "message_font_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Message font size (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "message_font_weight",
      "min": 300,
      "max": 700,
      "step": 100,
      "label": "Message font weight",
      "default": 400
    },
    {
      "type": "range",
      "id": "message_line_height",
      "min": 1.2,
      "max": 2.2,
      "step": 0.1,
      "label": "Message line height",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Take me to Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Button styling"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "Font weight",
