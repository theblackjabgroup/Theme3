      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Mobile: Cylinders Bottom Position",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_cylinders_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
