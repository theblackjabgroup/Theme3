<style>
  .s404-bento {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--bento-gap, 16px);
    min-height: 90vh;
    box-sizing: border-box;
  }

  /* Left panel */
  .s404-left {
    background: var(--color-card-bg);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--bento-gap, 16px);
  }

  .s404-left__number {
    position: absolute;
    font-size: 4rem;
    bottom:300px;
    font-weight: 900;
    line-height: 1;
    color: var(--color-text);
    letter-spacing: -0.04em;
    user-select: none;
  }

  /* Right panel */
  .s404-right {
    background: var(--btn-secondary-bg, #1e4abd);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    padding: var(--bento-gap, 16px);
    padding-bottom: calc(var(--bento-gap, 16px) * 1.5);
    gap: 0;
    color: var(--btn-secondary-text, #fff);
  }

  .s404-right__top {
    display: flex;
    flex-direction: column;
    max-width:400px;
    gap: calc(var(--bento-gap, 16px) * 0.6);
  }

  .s404-right__spacer {
    flex: 1;
    min-height: calc(var(--bento-gap, 16px) * 2);
  }

  .s404-right__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--bento-gap, 16px) * 0.75);
  }

  .s404-right__label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--btn-secondary-text, #fff);
    opacity: 0.75;
    margin: 0;
  }

  .s404-right__heading {
    font-size: clamp(36px, 5.5vw, 80px);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--btn-secondary-text, #fff);
    margin: 0;
  }

  .s404-right__body {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--btn-secondary-text, #fff);
    opacity: 0.8;
    margin: 0;
  }

  .s404-right__divider {
    border: none;
    border-top: 1px solid var(--btn-secondary-text, #fff);
    opacity: 0.3;
    margin: calc(var(--bento-gap, 16px) * 0.25) 0;
    width: 100%;
    align-self: stretch;
  }

  .s404-stats {
    display: flex;
    align-self: stretch;
    gap: calc(var(--bento-gap, 16px) * 1.5);
  }

  .s404-stat__value {
    font-size: 28px;
    font-weight: 900;
    color: var(--btn-secondary-text, #fff);
    line-height: 1;
    display: block;
  }

  .s404-stat__label {
    font-size: 12px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--btn-secondary-text, #fff);
    opacity: 0.65;
    margin-top: 4px;
    display: block;
  }

  /* Mobile */

  @media (max-width: 749px) {
    .s404-left__number {
      position: relative;
      font-size: 4rem;
      bottom:unset;
      font-weight: 900;
      line-height: 1;
      color: var(--color-text);
      letter-spacing: -0.04em;
      user-select: none;
    }
    .s404-bento {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .s404-left {
      min-height: 220px;
    }

    .s404-left__number {
      font-size: clamp(100px, 30vw, 160px);
    }

    .s404-right__heading {
      font-size: clamp(32px, 9vw, 52px);
    }

    .s404-stats {
      gap: var(--bento-gap, 16px);
    }
  }
</style>

{%- liquid
  assign button_text = section.settings.button_text | default: 'TAKE ME TO HOME'
  assign button_link = section.settings.button_link | default: routes.root_url
  assign heading_text = section.settings.heading_text | default: 'GONE COLDER THAN US.'
  assign label_text = section.settings.label_text | default: 'HOUSTON, WE BREWED A PROBLEM'
  assign body_text = section.settings.body_text
  assign stat_1_value = section.settings.stat_1_value | default: '72h'
  assign stat_1_label = section.settings.stat_1_label | default: "Our brew time. Where to next?"
  assign stat_2_value = section.settings.stat_2_value | default: '0s'
  assign stat_2_label = section.settings.stat_2_label | default: "This page's lifespan"
  assign stat_3_value = section.settings.stat_3_value | default: '404'
  assign stat_3_label = section.settings.stat_3_label | default: 'Not Our Finest'
-%}

<div class="s404-bento">
  <div class="s404-left">
    <span class="s404-left__number">404</span>
  </div>

  <div class="s404-right">
    <div class="s404-right__top">
      <p class="s404-right__label">{{ label_text }}</p>
      <h1 class="s404-right__heading">{{ heading_text }}</h1>
      <p class="s404-right__body">
        {%- if body_text != blank -%}
          {{ body_text }}
        {%- else -%}
          This page doesn't exist.<br>The URL you followed went cold.<br>Its not coming back.
        {%- endif -%}
      </p>
    </div>

    <div class="s404-right__spacer"></div>

    <div class="s404-right__bottom">
      <hr class="s404-right__divider">

      <div class="s404-stats">
        <div class="s404-stat">
          <span class="s404-stat__value">{{ stat_1_value }}</span>
          <span class="s404-stat__label">{{ stat_1_label }}</span>
        </div>
        <div class="s404-stat">
          <span class="s404-stat__value">{{ stat_2_value }}</span>
          <span class="s404-stat__label">{{ stat_2_label }}</span>
        </div>
        <div class="s404-stat">
          <span class="s404-stat__value">{{ stat_3_value }}</span>
          <span class="s404-stat__label">{{ stat_3_label }}</span>
        </div>
      </div>

      {%- render 'global-btn',
        text: button_text,
        url: button_link,
        variant: 'tertiary',
        fit_width:false,
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Right panel copy"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Small label",
      "default": "HOUSTON, WE BREWED A PROBLEM"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "GONE COLDER THAN US."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "This page does not exist. The URL you followed went cold. Its not coming back."
    },
    {
      "type": "header",
      "content": "Stats row"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "72h"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "Our brew time. Where to next?"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "0s"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "This page's lifespan"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 value",
      "default": "404"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 label",
      "default": "Not Our Finest"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "TAKE ME TO HOME"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    }
  ]
}
{% endschema %}
