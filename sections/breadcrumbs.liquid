<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">

    {%- comment -%} HOME — always first {%- endcomment -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ routes.root_url }}">Home</a>
    </li>

    {%- if request.page_type == 'product' -%}

      {%- comment -%} Product: Home / Collection / Product Title {%- endcomment -%}
      {%- if collection -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ collection.url }}">{{ collection.title }}</a>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.collections_url }}">Shop</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ product.title }}
      </li>

    {%- elsif request.page_type == 'collection' -%}

      {%- comment -%} Collection: Home / Category / Subcollection {%- endcomment -%}
      {%- assign parent_handle = collection.metafields.custom.parent_collection -%}
      {%- if parent_handle != blank -%}
        {%- assign parent_col = collections[parent_handle] -%}
        {%- if parent_col -%}
          <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ parent_col.url }}">{{ parent_col.title }}</a>
          </li>
        {%- endif -%}
      {%- else -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.collections_url }}">Shop</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ collection.title }}
      </li>

    {%- elsif request.page_type == 'article' -%}

      {%- comment -%} Article: Home / Blog Title / Article Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="{{ blog.url }}">{{ blog.title }}</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ article.title }}
      </li>

    {%- elsif request.page_type == 'blog' -%}

      {%- comment -%} Blog: Home / Blog Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ blog.title }}
      </li>

    {%- elsif request.page_type == 'page' -%}

      {%- comment -%} Static page: Home / Page Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ page.title }}
      </li>

    {%- endif -%}

  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: var(--bento-gap) 0;
  }

  .breadcrumbs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .breadcrumbs__item {
    font-family: var(--font-body-family, 'Red Hat Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.3px;
    line-height: 1.4;
  }

  .breadcrumbs__item--sep {
    color: var(--crossed-grey, #8A8A8A);
    user-select: none;
  }

  .breadcrumbs__link {
    color: var(--crossed-grey, #8A8A8A);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumbs__link:hover {
    color: var(--color-text, #F8F3F8);
  }

  .breadcrumbs__item--current {
    color: var(--color-text, #F8F3F8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }

  @media (max-width: 749px) {
    .breadcrumbs {
      padding: 10px var(--breadcrumbs-px-mobile, 16px);
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumbs",
  "enabled_on": {
    "templates": ["product", "collection", "article", "blog", "page"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding (Mobile)",
      "default": 16
    }
  ]
}
{% endschema %}
