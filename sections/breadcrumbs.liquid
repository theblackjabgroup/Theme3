<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    {%- comment -%} HOME — always first {%- endcomment -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ routes.root_url }}">Home</a>
    </li>

    {%- if request.page_type == 'product' -%}
      {%- comment -%} Product: Home / Collection / Product Title {%- endcomment -%}
      {%- if collection -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.collections_url }}">Shop</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ product.title | escape }}
      </li>

    {%- elsif request.page_type == 'collection' -%}
      {%- comment -%} Collection: Home / Category / Subcollection {%- endcomment -%}
      {%- assign parent_handle = collection.metafields.custom.parent_collection -%}
      {%- if parent_handle != blank -%}
        {%- assign parent_col = collections[parent_handle] -%}
        {%- if parent_col -%}
          <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ parent_col.url }}">{{ parent_col.title | escape }}</a>
          </li>
        {%- endif -%}
      {%- else -%}
        <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.collections_url }}">Shop</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ collection.title | escape }}
      </li>

    {%- elsif request.page_type == 'article' -%}
      {%- comment -%} Article: Home / Blog Title / Article Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="{{ blog.url }}">{{ blog.title | escape }}</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ article.title | escape }}
      </li>

    {%- elsif request.page_type == 'blog' -%}
      {%- comment -%} Blog: Home / Blog Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ blog.title | escape }}
      </li>

    {%- elsif request.page_type == 'page' -%}
      {%- comment -%} Static page: Home / Page Title {%- endcomment -%}
      <li class="breadcrumbs__item breadcrumbs__item--sep" aria-hidden="true">/</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ page.title | escape }}
      </li>
    {%- endif -%}
  </ol>
</nav>

{{ 'section-breadcrumbs.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Breadcrumbs",
  "enabled_on": {
    "templates": ["product", "collection", "article", "blog", "page"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding (Mobile)",
      "default": 16
    }
  ]
}
{% endschema %}
