{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if request.visual_preview_mode -%}
    {%- assign section_selector = '.rte-rich-text[data-section-id="' | append: section.id | append: '"]' -%}
  {%- else -%}
    {%- assign section_selector = '#shopify-section-' | append: section.id -%}
  {%- endif -%}

  {{ section_selector }} {
    --rte-header-margin-bottom: {{ section.settings.header_margin_bottom }}px;
    --rte-context-block-spacing: {{ section.settings.context_block_spacing }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.side_margin | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.side_margin | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.side_margin }}px;
      padding-right: {{ section.settings.side_margin }}px;
    }
  }

  {{ section_selector }} .rte-rich-text__outer {
    background-color: {{ section.settings.outer_background }};
  }

  {{ section_selector }} .rte-rich-text__header-card,
  {{ section_selector }} .rte-rich-text__context-card {
    background-color: {{ section.settings.content_background }};
    border: 1px solid {{ section.settings.content_border }};
    border-radius: {{ section.settings.content_border_radius }}px;
    max-width: {{ section.settings.content_max_width }}px;
    padding: {{ section.settings.content_padding }}px;
    {%- if section.settings.card_shadow != blank -%}
    box-shadow: {{ section.settings.card_shadow }};
    {%- endif -%}
  }

  {{ section_selector }} .rte-rich-text__header-card {
    margin-bottom: var(--rte-header-margin-bottom);
  }

  {{ section_selector }} .rte-rich-text__context-card .rte-rich-text__body + .rte-rich-text__body,
  {{ section_selector }} .rte-rich-text__context-card .rte-rich-text__body + .rte-rich-text__image-wrapper,
  {{ section_selector }} .rte-rich-text__context-card .rte-rich-text__image-wrapper + .rte-rich-text__body,
  {{ section_selector }} .rte-rich-text__context-card .rte-rich-text__image-wrapper + .rte-rich-text__image-wrapper {
    margin-top: var(--rte-context-block-spacing);
  }

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'header' -%}
        {{ section_selector }} [data-block-id="{{ block.id }}"] .rte-rich-text__tag {
          background-color: {{ block.settings.tag_background | default: '#F5F4F0' }};
          color: {{ block.settings.tag_text_color | default: '#2a2a2a' }};
          border-color: {{ block.settings.tag_border | default: '#d4d4d4' }};
          border-radius: {{ block.settings.tag_border_radius | default: 6 }}px;
          padding: {{ block.settings.tag_padding_vertical | default: 8 }}px {{ block.settings.tag_padding_horizontal | default: 16 }}px;
          font-size: {{ block.settings.tag_font_size | default: 12 }}px;
        }
        {{ section_selector }} [data-block-id="{{ block.id }}"] .rte-rich-text__title {
          color: {{ block.settings.title_color | default: '#4A6E58' }};
          font-size: {{ block.settings.title_font_size | default: 42 }}px;
        }
      {%- when 'context_text' -%}
        {{ section_selector }} [data-block-id="{{ block.id }}"] {
          color: {{ block.settings.body_text_color | default: '#333333' }};
          font-size: {{ block.settings.body_font_size | default: 16 }}px;
          line-height: {{ block.settings.body_line_height | default: 1.7 }};
        }
        {{ section_selector }} [data-block-id="{{ block.id }}"] h1,
        {{ section_selector }} [data-block-id="{{ block.id }}"] h2,
        {{ section_selector }} [data-block-id="{{ block.id }}"] h3 {
          color: {{ block.settings.heading_color | default: '#4A6E58' }};
          font-size: {{ block.settings.heading_font_size | default: 18 }}px;
        }
      {%- when 'context_image' -%}
        {{ section_selector }} [data-block-id="{{ block.id }}"] .rte-rich-text__image-inner {
          height: {{ block.settings.image_max_height | default: 330 }}px;
          max-height: {{ block.settings.image_max_height | default: 330 }}px;
          border-radius: {{ block.settings.image_border_radius | default: 8 }}px;
        }
        {{ section_selector }} [data-block-id="{{ block.id }}"] .rte-rich-text__image-placeholder {
          background-color: {{ block.settings.image_placeholder_color | default: '#f5f5f5' }};
          border-radius: {{ block.settings.image_border_radius | default: 8 }}px;
          height: {{ block.settings.image_max_height | default: 330 }}px;
          min-height: {{ block.settings.image_min_height | default: 200 }}px;
          display: flex;
          align-items: center;
          justify-content: center;
        }
    {%- endcase -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="rte-rich-text section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="rte-rich-text__outer">
    {%- for block in section.blocks -%}
      {%- if block.type == 'header' -%}
        <div class="rte-rich-text__header-card" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          <header class="rte-rich-text__header rte-rich-text__header--{{ block.settings.header_alignment | default: 'center' }}">
            {%- if block.settings.show_tag != false and block.settings.tag != blank -%}
              <span class="rte-rich-text__tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h1 class="rte-rich-text__title">{{ block.settings.title | escape }}</h1>
            {%- endif -%}
          </header>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- assign has_context_blocks = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'context_text' or block.type == 'context_image' -%}
        {%- assign has_context_blocks = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_context_blocks -%}
      <div class="rte-rich-text__context-card">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'context_text' -%}
              <div
                class="rte-rich-text__body rte rte-rich-text__body--{{ block.settings.text_alignment | default: 'left' }}"
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.text }}
              </div>

            {%- when 'context_image' -%}
              <div class="rte-rich-text__image-wrapper" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="rte-rich-text__image-inner">
                    <img
                      srcset="
                        {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w{%- if block.settings.image.width >= 1100 -%}, {%- endif -%}{%- endif -%}
                        {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w{%- if block.settings.image.width >= 1500 -%}, {%- endif -%}{%- endif -%}
                        {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w{%- endif -%}
                        {%- if block.settings.image.width < 550 -%}{{ block.settings.image | image_url: width: block.settings.image.width }} {{ block.settings.image.width }}w{%- endif -%}
                      "
                      src="{{ block.settings.image | image_url: width: 1100 }}"
                      sizes="(min-width: 750px) {{ section.settings.content_max_width | minus: section.settings.content_padding | minus: section.settings.content_padding }}px, 100vw"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      class="rte-rich-text__image rte-rich-text__image--{{ block.settings.image_fit | default: 'cover' }}"
                    >
                  </div>
                {%- else -%}
                  <div class="rte-rich-text__image-inner rte-rich-text__image-placeholder" role="img" aria-label="{{ block.settings.placeholder_label | default: 'Image' | escape }}">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'rte-rich-text__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "outer_background",
      "label": "Outer background",
      "default": "#D2CDC4"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "default": "#EBE8DF"
    },
    {
      "type": "color",
      "id": "content_border",
      "label": "Content border color",
      "default": "#2a2a2a"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Content border radius",
      "default": 12
    },
    {
      "type": "text",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": "0 4px 12px rgba(0, 0, 0, 0.08)",
      "info": "CSS box-shadow value for the cards"
    },
    {
      "type": "header",
      "content": "Block spacing"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Header to context margin",
      "default": 32
    },
    {
      "type": "range",
      "id": "context_block_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Margin between context blocks",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "side_margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Side margin",
      "default": 24,
      "info": "Left and right margin for the entire section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Header",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Tag"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag text",
          "default": "CORE"
        },
        {
          "type": "checkbox",
          "id": "show_tag",
          "label": "Show tag",
          "default": true
        },
        {
          "type": "color",
          "id": "tag_background",
          "label": "Tag background",
          "default": "#F5F4F0"
        },
        {
          "type": "color",
          "id": "tag_text_color",
          "label": "Tag text color",
          "default": "#2a2a2a"
        },
        {
          "type": "color",
          "id": "tag_border",
          "label": "Tag border color",
          "default": "#d4d4d4"
        },
        {
          "type": "range",
          "id": "tag_border_radius",
          "min": 0,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Tag border radius",
          "default": 6
        },
        {
          "type": "range",
          "id": "tag_padding_vertical",
          "min": 4,
          "max": 20,
          "step": 2,
          "unit": "px",
          "label": "Tag padding vertical",
          "default": 8
        },
        {
          "type": "range",
          "id": "tag_padding_horizontal",
          "min": 8,
          "max": 32,
          "step": 2,
          "unit": "px",
          "label": "Tag padding horizontal",
          "default": 16
        },
        {
          "type": "range",
          "id": "tag_font_size",
          "min": 10,
          "max": 18,
          "step": 1,
          "unit": "px",
          "label": "Tag font size",
          "default": 12
        },
        {
          "type": "header",
          "content": "Title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TERMS AND SERVICE"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#4A6E58"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "min": 24,
          "max": 72,
          "step": 2,
          "unit": "px",
          "label": "Title font size",
          "default": 42
        },
        {
          "type": "select",
          "id": "header_alignment",
          "label": "Header alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "context_text",
      "name": "Context (Text)",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" },
            { "value": "justify", "label": "Justify" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Typography"
        },
        {
          "type": "color",
          "id": "body_text_color",
          "label": "Body text color",
          "default": "#333333"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color (h1, h2, h3)",
          "default": "#4A6E58"
        },
        {
          "type": "range",
          "id": "body_font_size",
          "min": 14,
          "max": 22,
          "step": 1,
          "unit": "px",
          "label": "Body font size",
          "default": 16
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "min": 16,
          "max": 28,
          "step": 1,
          "unit": "px",
          "label": "Heading font size",
          "default": 18
        },
        {
          "type": "range",
          "id": "body_line_height",
          "min": 1.3,
          "max": 2.2,
          "step": 0.1,
          "label": "Body line height",
          "default": 1.7
        }
      ]
    },
    {
      "type": "context_image",
      "name": "Context (Image)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave blank to show Shopify's default image placeholder"
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Placeholder label",
          "default": "Image",
          "info": "Shown when no image is selected"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            { "value": "cover", "label": "Cover" },
            { "value": "contain", "label": "Contain" }
          ],
          "default": "cover"
        },
        {
          "type": "header",
          "content": "Image size"
        },
        {
          "type": "range",
          "id": "image_max_height",
          "min": 150,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Image max height",
          "default": 330,
          "info": "Constrains both images and placeholder"
        },
        {
          "type": "range",
          "id": "image_min_height",
          "min": 120,
          "max": 400,
          "step": 20,
          "unit": "px",
          "label": "Placeholder min height",
          "default": 200
        },
        {
          "type": "header",
          "content": "Placeholder"
        },
        {
          "type": "color",
          "id": "image_placeholder_color",
          "label": "Placeholder background (when no image)",
          "default": "#f5f5f5"
        },
        {
          "type": "range",
          "id": "image_border_radius",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "label": "Image border radius",
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "header",
          "settings": {
            "tag": "CORE",
            "title": "TERMS AND SERVICE"
          }
        },
        {
          "type": "context_text",
          "settings": {
            "text": "<h2>SCOPE OF THIS NOTICE</h2><p>This Privacy Notice describes how The Mental Health Association (Coffee Foundation) collects, uses, and shares your personal data when you visit our website or use our services.</p><h2>1. SOURCES OF PERSONAL DATA</h2><p>We collect personal data from various sources including information you provide directly, data collected automatically when you use our services, and information from third parties.</p><h2>2. PERSONAL DATA THAT WE COLLECT ABOUT YOU AND HOW WE COLLECT IT</h2><p>We may collect identifiers, commercial information, internet or network activity, and other categories of personal data as described in this notice.</p>"
          }
        },
        {
          "type": "context_image"
        }
      ]
    }
  ]
}
{% endschema %}
