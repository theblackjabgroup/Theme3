{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign blog_handle = section.settings.blog
  assign primary_article = blank
  assign secondary_article = blank

  if blog_handle != blank and blog_handle.articles_count > 0
    assign primary_article = blog_handle.articles[0]
    if blog_handle.articles_count > 1
      assign secondary_article = blog_handle.articles[1]
    endif
  endif

  assign article_words = 0
  assign read_minutes = 4
  if primary_article != blank
    assign article_words = primary_article.content | strip_html | split: ' ' | size
    assign read_minutes = article_words | divided_by: 200
    if read_minutes < 1
      assign read_minutes = 1
    endif
  endif

  assign meta_date = 'now' | date: '%-d %B %Y' | upcase
  if primary_article != blank
    assign meta_date = primary_article.published_at | date: '%-d %B %Y' | upcase
  endif

  assign author_name = 'Mia Kato'
  if primary_article != blank and primary_article.author != blank
    assign author_name = primary_article.author
  endif
-%}

{%- comment -%} Serialize all articles as JSON for JS navigation {%- endcomment -%}
<script>
(function() {
  var articles = [];
  {%- if blog_handle != blank -%}
    {%- for article in blog_handle.articles limit: 20 -%}
      {%- assign a_words = article.content | strip_html | split: ' ' | size -%}
      {%- assign a_minutes = a_words | divided_by: 200 -%}
      {%- if a_minutes < 1 -%}{%- assign a_minutes = 1 -%}{%- endif -%}
      articles.push({
        title: {{ article.title | json }},
        url: {{ article.url | json }},
        excerpt: {{ article.excerpt | default: article.content | strip_html | truncate: 180 | json }},
        tags: [{% for tag in article.tags limit: 3 %}{{ tag | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
        image: {% if article.image != blank %}{{ article.image | image_url: width: 900 | json }}{% else %}null{% endif %},
        imageAlt: {{ article.title | json }},
        date: {{ article.published_at | date: '%-d %B %Y' | upcase | json }},
        author: {{ article.author | json }},
        readMinutes: {{ a_minutes }}
      });
    {%- endfor -%}
  {%- endif -%}
  window['__featuredBlogData_{{ section.id }}'] = {
    articles: articles,
    authorRole: {{ section.settings.author_role | json }}
  };
})();
</script>

<section
  class="featured-blog-v2 color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-featured-blog-section="{{ section.id }}"
>
  <div class="featured-blog-v2__wrap">
    <div class="featured-blog-v2__layout">
      <article class="featured-blog-v2__primary scroll-trigger reveal-up" style="--animation-order: 1;" data-fb-article="primary">
        <div class="featured-blog-v2__primary-main">
          <span class="featured-blog-v2__index" data-fb-field="index">01</span>

          <p class="featured-blog-v2__meta">
            <span>FEATURED</span>
            <span>•</span>
            <span data-fb-field="meta-date">{{ meta_date }}</span>
          </p>

          <h2 class="featured-blog-v2__title">
            {%- if primary_article != blank -%}
              <a href="{{ primary_article.url }}" data-fb-field="title-link">{{ primary_article.title }}</a>
            {%- else -%}
              <a href="#" data-fb-field="title-link">KOKO X TWO BIRDS: A MATCHA COLLAB</a>
            {%- endif -%}
          </h2>

          <p class="featured-blog-v2__excerpt" data-fb-field="excerpt">
            {%- if primary_article != blank -%}
              {{ primary_article.excerpt | default: primary_article.content | strip_html | truncate: 180 }}
            {%- else -%}
              We partnered with two birds to create something neither of us could have made alone. Here's the full story behind the collab - from first call to final blend.
            {%- endif -%}
          </p>

          <div class="featured-blog-v2__tags" data-fb-field="tags">
            {%- if primary_article != blank and primary_article.tags.size > 0 -%}
              {%- for tag in primary_article.tags limit: 3 -%}
                <span class="featured-blog-v2__tag">{{ tag }}</span>
              {%- endfor -%}
            {%- else -%}
              <span class="featured-blog-v2__tag">NEWS</span>
              <span class="featured-blog-v2__tag">COLLAB</span>
              <span class="featured-blog-v2__tag">MATCHA</span>
            {%- endif -%}
          </div>
        </div>

        <div class="featured-blog-v2__primary-side">
          <p class="featured-blog-v2__read-time" data-fb-field="read-time">{{ read_minutes }} MIN READ • {{ meta_date }}</p>

          <p class="featured-blog-v2__quote" data-fb-field="quote">
            {%- if secondary_article != blank -%}
              "{{ secondary_article.title }}"
            {%- elsif primary_article != blank -%}
              "{{ primary_article.title }}"
            {%- else -%}
              "Two brands, one obsession: doing something the right way regardless of how long it takes."
            {%- endif -%}
          </p>

          <div class="featured-blog-v2__author-row">
            <span data-fb-field="author-name">{{ author_name }}</span>
            <span>•</span>
            <span data-fb-field="author-role">{{ section.settings.author_role }}</span>
            {%- if primary_article != blank -%}
              <a class="featured-blog-v2__inline-arrow" href="{{ primary_article.url }}" aria-label="Read featured article" data-fb-field="article-link">
                {{ 'icon-caret-right.svg' | inline_asset_content }}
              </a>
            {%- else -%}
              <a class="featured-blog-v2__inline-arrow" href="#" aria-label="Read featured article" data-fb-field="article-link">
                {{ 'icon-caret-right.svg' | inline_asset_content }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </article>

      <article class="featured-blog-v2__secondary scroll-trigger reveal-up" style="--animation-order: 2;" data-fb-article="secondary">
        <a
          class="featured-blog-v2__secondary-image-wrap"
          href="{% if secondary_article != blank %}{{ secondary_article.url }}{% elsif primary_article != blank %}{{ primary_article.url }}{% else %}#{% endif %}"
          aria-label="Open secondary article"
          data-fb-field="image-link"
        >
          {%- if secondary_article != blank and secondary_article.image != blank -%}
            {{
              secondary_article.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(max-width: 749px) 100vw, 28vw',
                class: 'featured-blog-v2__secondary-image',
                alt: secondary_article.title
            }}
          {%- elsif primary_article != blank and primary_article.image != blank -%}
            {{
              primary_article.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(max-width: 749px) 100vw, 28vw',
                class: 'featured-blog-v2__secondary-image',
                alt: primary_article.title
            }}
          {%- else -%}
            {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-v2__secondary-image featured-blog-v2__secondary-image--placeholder' }}
          {%- endif -%}
        </a>

        <p class="featured-blog-v2__meta">
          <span>FEATURED</span>
          <span>•</span>
          <span data-fb-field="meta-date">{{ meta_date }}</span>
        </p>

        <h3 class="featured-blog-v2__secondary-title">
          {%- if secondary_article != blank -%}
            <a href="{{ secondary_article.url }}" data-fb-field="title-link">{{ secondary_article.title }}</a>
          {%- elsif primary_article != blank -%}
            <a href="{{ primary_article.url }}" data-fb-field="title-link">{{ primary_article.title }}</a>
          {%- else -%}
            <a href="#" data-fb-field="title-link">KOKO X TWO BIRDS: A MATCHA COLLAB</a>
          {%- endif -%}
        </h3>

        <div class="featured-blog-v2__secondary-footer">
          <span data-fb-field="author-name">{{ author_name }}</span>
          <span>•</span>
          <span data-fb-field="author-role">{{ section.settings.author_role }}</span>
          <a
            class="featured-blog-v2__inline-arrow"
            href="{% if secondary_article != blank %}{{ secondary_article.url }}{% elsif primary_article != blank %}{{ primary_article.url }}{% else %}#{% endif %}"
            aria-label="Read article"
            data-fb-field="article-link"
          >
            {{ 'icon-caret-right.svg' | inline_asset_content }}
          </a>
        </div>
      </article>
    </div>

    <div class="featured-blog-v2__nav scroll-trigger reveal-up" style="--animation-order: 3;">
      {%- render 'global-btn-2',
        text: '←',
        type: 'button',
        fit_width: false,
        class: 'featured-blog-v2__nav-btn',
        border_radius: '50%',
        no_border: true,
        attributes: 'aria-label="Previous article" data-fb-nav="prev"'
      -%}
      {%- render 'global-btn-2',
        text: '→',
        type: 'button',
        fit_width: false,
        class: 'featured-blog-v2__nav-btn',
        border_radius: '50%',
        no_border: true,
        attributes: 'aria-label="Next article" data-fb-nav="next"'
      -%}
    </div>
  </div>
</section>

<script src="{{ 'featured-blog-nav.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.featured-blog.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.post_limit.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.text_header.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.featured-blog.settings.heading.default",
      "label": "t:sections.featured-blog.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role label",
      "default": "Head of Product"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.layout_header.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_view_all.label",
      "info": "t:sections.featured-blog.settings.show_view_all.info"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_author.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "default": "scheme-4",
      "info": "When the theme toggle is in dark mode, use this scheme for this section."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-blog.presets.name"
    }
  ]
}
{% endschema %}
