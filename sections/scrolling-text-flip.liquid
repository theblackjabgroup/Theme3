        {
          "value": "rotateX(180deg)",
          "label": "Vertical (X-Axis)"
        },
        {
          "value": "rotate3d(1, 1, 0, 180deg)",
          "label": "Tilt (Diagonal)"
        }
      ],
      "default": "rotateY(180deg)"
    },
    {
      "type": "range",
      "id": "flip_duration",
      "min": 0.5,
      "max": 3.0,
      "step": 0.1,
      "unit": "s",
      "label": "Flip Duration",
      "default": 1.3
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Font Size",
      "default": 24
