{{ 'section-scrolling-text-flip.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    --section-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ScrollingFlip-{{ section.id }} {
    --flip-width: {{ section.settings.box_width }}px;
    --flip-height: {{ section.settings.box_height }}px;
    --flip-gap: {{ section.settings.gap }}px;
    --flip-speed: {{ section.settings.speed }}s;
    --flip-radius: {{ section.settings.border_radius }}px;
    --row-gap: {{ section.settings.row_gap }}px;
    --flip-transform: {{ section.settings.flip_direction }};
    --flip-duration: {{ section.settings.flip_duration }}s;
    --card-font-size: {{ section.settings.font_size }}px;
  }
{%- endstyle -%}

<div
  class="scrolling-text-flip-section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  id="ScrollingFlip-{{ section.id }}"
>
  <div class="scrolling-text-flip-wrapper" style="flex-direction: column; gap: var(--row-gap);">
    {%- for row in (1..section.settings.rows_count) -%}
      {%- liquid
        assign current_direction = section.settings.direction
        if section.settings.alternate_direction
          assign remainder = row | modulo: 2
          if remainder == 0
            if current_direction == 'normal'
              assign current_direction = 'reverse'
            else
              assign current_direction = 'normal'
            endif
          endif
        endif
      -%}
      <div
        class="scrolling-text-flip-track{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}"
        data-direction="{{ current_direction }}"
      >
        {%- assign min_items = 20 -%}
        {%- assign block_count = section.blocks.size -%}
        {%- if block_count > 0 -%}
          {%- assign repeat_count = min_items | divided_by: block_count | ceil | at_least: 2 -%}

          {%- for i in (1..repeat_count) -%}
            {%- for block in section.blocks -%}
              {%- style -%}
                .block-{{ block.id }} {
                  {%- if block.settings.card_bg != blank -%}
                    --card-bg: {{ block.settings.card_bg }};
                  {%- else -%}
                    --card-bg: var(--color-background);
                  {%- endif -%}
                  {%- if block.settings.card_text != blank -%}
                    --card-text: {{ block.settings.card_text }};
                  {%- else -%}
                    --card-text: var(--color-text);
                  {%- endif -%}
                  --icon-width: {{ block.settings.icon_width }}px;
                  --icon-height: {{ block.settings.icon_height }}px;
                  --back-image-width: {{ block.settings.back_image_width }}px;
                  --back-image-height: {{ block.settings.back_image_height }}px;
                }
              {%- endstyle -%}
              <div class="scrolling-text-flip-item block-{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="scrolling-text-flip-card">
                  <div class="scrolling-text-flip-front">
                    {%- if block.settings.front_image != blank -%}
                      {%- assign front_img_class = 'scrolling-text-flip-icon' -%}
                      {%- assign front_img_width = 500 -%}
                      {%- if block.settings.front_image_style == 'cover' -%}
                        {%- assign front_img_class = 'scrolling-text-flip-front-cover' -%}
                        {%- assign front_img_width = 800 -%}
                      {%- elsif block.settings.front_image_style == 'contain' -%}
                        {%- assign front_img_class = 'scrolling-text-flip-front-contain' -%}
                        {%- assign front_img_width = 800 -%}
                      {%- endif -%}
                      {{
                        block.settings.front_image
                        | image_url: width: front_img_width
                        | image_tag: loading: 'lazy', class: front_img_class
                      }}
                    {%- elsif block.settings.icon != 'none' -%}
                      <div class="scrolling-text-flip-icon">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                      </div>
                      <span class="visually-hidden">{{ block.settings.icon }}</span>
                    {%- endif -%}
                    <div class="scrolling-text-flip-text">
                      {{ block.settings.front_text }}
                    </div>
                  </div>
                  <div class="scrolling-text-flip-back">
                    {%- if block.settings.use_back_image -%}
                      {%- if block.settings.back_image != blank -%}
                        {%- assign back_img_class = 'scrolling-text-flip-back-image' -%}
                        {%- if block.settings.back_image_style == 'custom' -%}
                          {%- assign back_img_class = 'scrolling-text-flip-back-custom' -%}
                        {%- endif -%}
                        {{
                          block.settings.back_image
                          | image_url: width: 800
                          | image_tag: loading: 'lazy', class: back_img_class
                        }}
                      {%- endif -%}
                    {%- else -%}
                      {%- if block.settings.front_image != blank -%}
                        {%- assign front_img_class = 'scrolling-text-flip-icon' -%}
                        {%- assign front_img_width = 500 -%}
                        {%- if block.settings.front_image_style == 'cover' -%}
                          {%- assign front_img_class = 'scrolling-text-flip-front-cover' -%}
                          {%- assign front_img_width = 800 -%}
                        {%- elsif block.settings.front_image_style == 'contain' -%}
                          {%- assign front_img_class = 'scrolling-text-flip-front-contain' -%}
                          {%- assign front_img_width = 800 -%}
                        {%- endif -%}
                        {{
                          block.settings.front_image
                          | image_url: width: front_img_width
                          | image_tag: loading: 'lazy', class: front_img_class
                        }}
                      {%- elsif block.settings.icon != 'none' -%}
                        <div class="scrolling-text-flip-icon">
                          {% render 'icon-accordion', icon: block.settings.icon %}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    <div class="scrolling-text-flip-text">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="full-unstyled-link">
                      {%- endif -%}
                      {{ block.settings.back_text | default: block.settings.front_text }}
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..10) -%}
            <div class="scrolling-text-flip-item">
              <div class="scrolling-text-flip-card">
                <div class="scrolling-text-flip-front">
                  <div class="scrolling-text-flip-text">Front {{ i }}</div>
                </div>
                <div class="scrolling-text-flip-back">
                  <div class="scrolling-text-flip-text">Back {{ i }}</div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling Text Flip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
