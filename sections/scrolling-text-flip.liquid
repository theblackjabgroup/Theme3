      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Gap between rows",
      "default": 20
    },
    {
      "type": "range",
      "id": "box_width",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Box Width",
      "default": 200
    },
    {
      "type": "range",
      "id": "box_height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Box Height",
      "default": 200
    },
    {
      "type": "range",
      "id": "border_radius",
