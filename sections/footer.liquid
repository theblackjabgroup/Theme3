  html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .footer-box {
    --color-bg: {{ footer_scheme_obj.settings.color_bg }} !important;
    --color-background: {{ footer_scheme_obj.settings.color_bg }} !important;
    --color-card-bg: {{ footer_scheme_obj.settings.color_card_bg }} !important;
    --color-card-text: {{ footer_scheme_obj.settings.color_card_text | default: footer_scheme_obj.settings.color_text }} !important;
    --color-heading: {{ footer_scheme_obj.settings.color_heading }} !important;
    --color-headings: {{ footer_scheme_obj.settings.color_heading }} !important;
    --color-text: {{ footer_scheme_obj.settings.color_text }} !important;
    --color-link: {{ footer_scheme_obj.settings.color_link }} !important;
    --color-link-hover: {{ footer_scheme_obj.settings.color_link_hover }} !important;
    --color-input-border: {{ footer_scheme_obj.settings.color_input_border }} !important;
    --color-btn-shadow: {{ footer_scheme_obj.settings.color_btn_shadow }} !important;
  }
{%- endstyle -%}
{%- endif -%}
{%- if footer_dark_scheme_obj -%}
{%- style -%}
  html[data-global-theme-active="true"][data-active-scheme="color-{{ footer_dark_scheme_id }}"] #shopify-section-{{ section.id }} .footer-box {
    --color-bg: {{ footer_dark_scheme_obj.settings.color_bg }} !important;
    --color-background: {{ footer_dark_scheme_obj.settings.color_bg }} !important;
    --color-card-bg: {{ footer_dark_scheme_obj.settings.color_card_bg }} !important;
    --color-card-text: {{ footer_dark_scheme_obj.settings.color_card_text | default: footer_dark_scheme_obj.settings.color_text }} !important;
    --color-heading: {{ footer_dark_scheme_obj.settings.color_heading }} !important;
    --color-headings: {{ footer_dark_scheme_obj.settings.color_heading }} !important;
    --color-text: {{ footer_dark_scheme_obj.settings.color_text }} !important;
    --color-link: {{ footer_dark_scheme_obj.settings.color_link }} !important;
    --color-link-hover: {{ footer_dark_scheme_obj.settings.color_link_hover }} !important;
    --color-input-border: {{ footer_dark_scheme_obj.settings.color_input_border }} !important;
    --color-btn-shadow: {{ footer_dark_scheme_obj.settings.color_btn_shadow }} !important;
  }
{%- endstyle -%}
{%- endif -%}

<footer class="custom-footer color-{{ section.settings.color_scheme }} gradient">
  <div class="footer-container">
    <div class="footer-layout">
      <!-- LEFT COLUMN (blocks: newsletter, social – order in theme editor) -->
      <div class="footer-left">
        {%- if section.blocks.size == 0 -%}
          {%- comment -%} Fallback: add Newsletter and Social icon blocks in the theme editor {%- endcomment -%}
          <div class="footer-newsletter">
            {% form 'customer', id: 'FooterNewsletter', class: 'footer-newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-field">
                <label class="newsletter-label" for="FooterNewsletterInput-{{ section.id }}">SIGN UP FOR UPDATES</label>
                <input
                  id="FooterNewsletterInput-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="newsletter-input"
                  value="{{ form.email }}"
                  placeholder=""
                  required
                >
              </div>
            {% endform %}
          </div>
        {%- else -%}
          {%- assign in_social_grid = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'newsletter' -%}
                {%- if in_social_grid -%}
                  </div>
                  {%- assign in_social_grid = false -%}
                {%- endif -%}
                <div
                  class="footer-newsletter"
                  {{ block.shopify_attributes }}
                  style="
                    {%- if block.settings.newsletter_font -%}
                      --newsletter-font-family: {{ block.settings.newsletter_font.family }}, {{ block.settings.newsletter_font.fallback_families }};
                    {%- endif -%}
                    --newsletter-font-size: {{ block.settings.newsletter_font_size | default: 20 }}px;
                    --newsletter-font-size-mobile: {{ block.settings.newsletter_font_size_mobile | default: 20 }}px;
                    --newsletter-font-weight: {{ block.settings.newsletter_font_weight | default: 800 }};
                    --newsletter-letter-spacing: {{ block.settings.newsletter_letter_spacing | default: 0.1 }}em;
                    --newsletter-field-padding: {{ block.settings.newsletter_field_padding | default: 12 }}px;
                    --newsletter-field-padding-mobile: {{ block.settings.newsletter_field_padding_mobile | default: 12 }}px;
                  "
                >
                  {% form 'customer', id: 'FooterNewsletter', class: 'footer-newsletter-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="newsletter-field">
                      <input
                        id="FooterNewsletterInput-{{ section.id }}-{{ block.id }}"
                        type="email"
                        name="contact[email]"
                        class="newsletter-input"
                        value="{{ form.email }}"
                        placeholder="{{ block.settings.newsletter_heading | escape }}"
                        required
                      >
                    </div>
                  {% endform %}
                </div>
              {%- when 'social_icon' -%}
                {%- assign next_index = forloop.index0 | plus: 1 -%}
                {%- unless in_social_grid -%}
                  <div class="footer-social-grid footer-social-row" data-icons-per-row="{{ section.settings.social_icons_per_row | default: 2 }}" data-icons-per-row-mobile="{{ section.settings.social_icons_per_row_mobile | default: 4 }}">
                    {%- assign in_social_grid = true -%}
                {%- endunless -%}
                {%- render 'footer-social-box', block: block -%}
                {%- assign is_last_social = false -%}
                {%- if forloop.last -%}
                  {%- assign is_last_social = true -%}
                {%- elsif next_index >= section.blocks.size -%}
                  {%- assign is_last_social = true -%}
                {%- else -%}
                  {%- assign next_block = section.blocks[next_index] -%}
                  {%- if next_block.type != 'social_icon' -%}
                    {%- assign is_last_social = true -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if is_last_social -%}
                  </div>
                  {%- assign in_social_grid = false -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
          {%- if in_social_grid -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- RIGHT COLUMN (Green Box) -->
      <div class="footer-right">
        <div class="footer-box color-{{ section.settings.color_scheme }} gradient">
          <div class="footer-box__inner">
            <div class="footer-box__left">
              <h2 class="box-heading">{{ section.settings.main_heading }}</h2>
            </div>

            <div class="footer-box__right">
              <nav class="box-nav">
                {%- assign footer_menu_links = section.settings.menu.links -%}
                {%- if footer_menu_links == blank and section.settings.menu != blank -%}
                  {%- assign footer_menu = linklists[section.settings.menu] -%}
                  {%- if footer_menu != blank -%}
                    {%- assign footer_menu_links = footer_menu.links -%}
                  {%- endif -%}
                {%- endif -%}
                {%- assign menu_limit = section.settings.menu_limit | default: 30 -%}
                {%- assign link_count = 0 -%}
                {%- if footer_menu_links != blank -%}
                  {%- for link in footer_menu_links limit: menu_limit -%}
                    {%- assign link_count = link_count | plus: 1 -%}
                  {%- endfor -%}
                {%- endif -%}

                <ul class="box-nav-list{% if link_count <= 5 %} box-nav-list--single-column{% endif %}">
                  {%- if footer_menu_links != blank -%}
                    {%- for link in footer_menu_links limit: menu_limit -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | upcase }}</a>
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </nav>

              <div class="localization-pills">
                {%- if localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                      <div class="no-js-hidden">
                        {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
                {%- if localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                      <div class="no-js-hidden">
                        {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="{{ 'section-footer.js' | asset_url }}" defer="defer"></script>
