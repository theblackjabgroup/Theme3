{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "SIGN UP FOR UPDATES"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Your email..."
    },
    {
      "type": "header",
      "content": "Color Schemes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "box_color_scheme",
      "label": "Main Box Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "image_picker",
      "id": "social_1_image",
      "label": "Social Icon 1 (Image)"
    },
    {
      "type": "image_picker",
      "id": "social_1_image_hover",
      "label": "Social Icon 1 (Image on hover)"
    },
    {
      "type": "text",
      "id": "social_1_svg",
      "label": "Social Icon 1 (SVG fallback)"
    },
    {
      "type": "url",
      "id": "social_1_link",
      "label": "Social Link 1"
    },
    {
      "type": "image_picker",
      "id": "social_2_image",
      "label": "Social Icon 2 (Image)"
    },
    {
      "type": "image_picker",
      "id": "social_2_image_hover",
      "label": "Social Icon 2 (Image on hover)"
    },
    {
      "type": "text",
      "id": "social_2_svg",
      "label": "Social Icon 2 (SVG fallback)"
    },
    {
      "type": "url",
      "id": "social_2_link",
      "label": "Social Link 2"
    },
    {
      "type": "image_picker",
      "id": "social_3_image",
      "label": "Social Icon 3 (Image)"
    },
    {
      "type": "image_picker",
      "id": "social_3_image_hover",
      "label": "Social Icon 3 (Image on hover)"
    },
    {
      "type": "text",
      "id": "social_3_svg",
      "label": "Social Icon 3 (SVG fallback)"
    },
    {
      "type": "url",
      "id": "social_3_link",
      "label": "Social Link 3"
    },
    {
      "type": "image_picker",
      "id": "social_4_image",
      "label": "Social Icon 4 (Image)"
    },
    {
      "type": "image_picker",
      "id": "social_4_image_hover",
      "label": "Social Icon 4 (Image on hover)"
    },
    {
      "type": "text",
      "id": "social_4_svg",
      "label": "Social Icon 4 (SVG fallback)"
    },
    {
      "type": "url",
      "id": "social_4_link",
      "label": "Social Link 4"
    },
    {
      "type": "header",
      "content": "Main Box Content"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Lorem Ipsum"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 20
    }
  ]
}
{% endschema %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<footer class="custom-footer color-{{ section.settings.color_scheme }} gradient">
  <div class="footer-container">
    <div class="footer-layout">
      <!-- LEFT COLUMN -->
      <div class="footer-left">
        <!-- Newsletter -->
        <div class="footer-newsletter">
          {% form 'customer', id: 'FooterNewsletter', class: 'footer-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-field">
              <label class="newsletter-label" for="FooterNewsletterInput">
                {{- section.settings.newsletter_heading -}}
              </label>
              <input
                id="FooterNewsletterInput"
                type="email"
                name="contact[email]"
                class="newsletter-input"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder }}"
                required
              >
            </div>
          {% endform %}
        </div>

        <!-- Social Icons: two flex rows (same expansion logic as header profile/cart row) -->
        <div class="footer-social-grid">
          <div class="footer-social-row">
            {%- for i in (1..2) -%}
              {%- render 'footer-social-box', section: section, index: i -%}
            {%- endfor -%}
          </div>
          <div class="footer-social-row">
            {%- for i in (3..4) -%}
              {%- render 'footer-social-box', section: section, index: i -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN (Green Box) -->
      <div class="footer-right">
        <div class="footer-box color-{{ section.settings.box_color_scheme }} gradient">
          <div class="footer-box__inner">
            <div class="footer-box__left">
              <h2 class="box-heading">{{ section.settings.main_heading }}</h2>
              <div class="copyright">
                <span>
                  {{ 'now' | date: '%Y' | prepend: 'Copyright © ' | append: ', ' -}}
                  <a href="{{ routes.root_url }}">{{ shop.name }}</a>
                  {{ powered_by_link }}
                </span>
              </div>
            </div>

            <div class="footer-box__right">
              <nav class="box-nav">
                <ul class="box-nav-list">
                  {%- for link in linklists[section.settings.menu].links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title | upcase }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>

              <div class="localization-pills">
                {%- if localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                      <div class="no-js-hidden">
                        {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
                {%- if localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                      <div class="no-js-hidden">
                        {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="{{ 'section-footer.js' | asset_url }}" defer="defer"></script>
