{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign footer_scheme_ref = section.settings.color_scheme
  assign footer_scheme_id = footer_scheme_ref.id | default: footer_scheme_ref | append: ''
  assign footer_scheme_obj = null
  for s in settings.color_schemes
    assign sid = s.id | append: ''
    if sid == footer_scheme_id or s.id == footer_scheme_ref
      assign footer_scheme_obj = s
      break
    endif
  endfor
  assign footer_dark_scheme_id = null
  assign footer_dark_scheme_obj = null
  if section.settings.dark_mode_color_scheme != blank
    assign footer_dark_ref = section.settings.dark_mode_color_scheme
    assign footer_dark_scheme_id = footer_dark_ref.id | default: footer_dark_ref | append: ''
    for s in settings.color_schemes
      assign sid = s.id | append: ''
      if sid == footer_dark_scheme_id or s.id == footer_dark_ref
        assign footer_dark_scheme_obj = s
        break
      endif
    endfor
  endif
-%}

{%- capture newsletter_font_faces -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'newsletter' and block.settings.newsletter_font -%}
      {{ block.settings.newsletter_font | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if newsletter_font_faces != blank -%}
  {%- style -%}{{ newsletter_font_faces }}{%- endstyle -%}
{%- endif -%}

{%- style -%}
