{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'collection-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign list_scheme_ref = section.settings.color_scheme
  assign list_scheme_id = list_scheme_ref.id | default: list_scheme_ref | append: ''
  assign list_scheme_obj = null
  for s in settings.color_schemes
    assign sid = s.id | append: ''
    if sid == list_scheme_id or s.id == list_scheme_ref
      assign list_scheme_obj = s
      break
    endif
  endfor
  assign list_dark_scheme_id = null
  assign list_dark_scheme_obj = null
  if section.settings.dark_mode_color_scheme != blank
    assign list_dark_ref = section.settings.dark_mode_color_scheme
    assign list_dark_scheme_id = list_dark_ref.id | default: list_dark_ref | append: ''
    for s in settings.color_schemes
      assign sid = s.id | append: ''
      if sid == list_dark_scheme_id or s.id == list_dark_ref
        assign list_dark_scheme_obj = s
        break
      endif
    endfor
  endif
-%}

{%- comment -%} Collection list: light/dark color schemes when theme toggle is active {%- endcomment -%}
{%- if list_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .main-list-collections-section {
      --color-bg: {{ list_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ list_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ list_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ list_scheme_obj.settings.color_card_text | default: list_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ list_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ list_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ list_scheme_obj.settings.color_text }} !important;
      --color-link: {{ list_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ list_scheme_obj.settings.color_link_hover }} !important;
      --color-input-border: {{ list_scheme_obj.settings.color_input_border }} !important;
      --color-btn-shadow: {{ list_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}
{%- if list_dark_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"][data-active-scheme="color-{{ list_dark_scheme_id }}"] #shopify-section-{{ section.id }} .main-list-collections-section {
      --color-bg: {{ list_dark_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ list_dark_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ list_dark_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ list_dark_scheme_obj.settings.color_card_text | default: list_dark_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ list_dark_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ list_dark_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ list_dark_scheme_obj.settings.color_text }} !important;
      --color-link: {{ list_dark_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ list_dark_scheme_obj.settings.color_link_hover }} !important;
      --color-input-border: {{ list_dark_scheme_obj.settings.color_input_border }} !important;
      --color-btn-shadow: {{ list_dark_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}

<div class="main-list-collections-section section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <h1 class="title title--primary inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ section.settings.title }}
  </h1>
  {%- liquid
    case section.settings.sort
      when 'products_high', 'products_low'
        assign collections = collections | sort: 'all_products_count'
      when 'date', 'date_reversed'
        assign collections = collections | sort: 'published_at'
    endcase

    if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
      assign collections = collections | reverse
    endif

    assign modulo_result = 28 | modulo: section.settings.columns_desktop
    assign paginate_by = 30
    if modulo_result == 0
      assign paginate_by = 28
    endif
  -%}
  {%- paginate collections by paginate_by -%}
    <ul
      class="collection-list grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      role="list"
    >
      {%- for collection in collections -%}
        <li
          class="collection-list__item grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {% render 'card-collection', collection: collection, show_badge: true, section_settings: section.settings %}
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>
{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "t:sections.main-list-collections.settings.title.default"
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main-list-collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__3.label"
        },
        {
          "value": "date",
          "label": "t:sections.main-list-collections.settings.sort.options__4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.main-list-collections.settings.sort.options__5.label"
        },
        {
          "value": "products_low",
          "label": "t:sections.main-list-collections.settings.sort.options__6.label"
        }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-list-collections.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-list-collections.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Light mode color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "info": "When the theme toggle is in dark mode, use this scheme for the collection list section."
    }
  ]
}
{% endschema %}
