{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .newsletter-section-{{ section.id }} {
    --newsletter-bg: var(--color-bg);
    --newsletter-input-bg: var(--color-input-bg);
    --newsletter-heading-size: {{ section.settings.heading_size | default: 24 }}px;
    --newsletter-desc-size: {{ section.settings.desc_size | default: 15 }}px;
  }
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;

  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="newsletter-section newsletter-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="newsletter-section__inner ">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-section__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="newsletter-section__desc">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- capture newsletter_form_id -%}NewsletterSection-{{ section.id }}{%- endcapture -%}
    {%- form 'customer', id: newsletter_form_id, class: 'newsletter-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-section__row">
        <div class="newsletter-section__field">
          <div class="newsletter-section__input-3d">
            <span class="newsletter-section__input-shadow" aria-hidden="true"></span>
            <input
              type="email"
              name="contact[email]"
              id="NewsletterSectionEmail-{{ section.id }}"
              class="newsletter-section__input"
              placeholder="{{ section.settings.placeholder | default: 'Email Address' }}"
              aria-label="{{ section.settings.placeholder | default: 'Email Address' }}"
              required
              value="{{ form.email }}"
            >
          </div>
        </div>
        <div class="newsletter-section__submit-wrap">
          {%- capture submit_icon -%}{{ 'icon-caret-right.svg' | inline_asset_content }}{%- endcapture -%}
          {%- render 'global-btn-2',
            icon: submit_icon,
            icon_only: true,
            type: 'submit',
            fit_width: false,
            class: 'newsletter-section__submit-btn',
            variant: 'tertiary',
            border_radius: '50%',
            attributes: 'aria-label="Subscribe"'
          -%}
        </div>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter-section__success" tabindex="-1" autofocus>
          {{ 'newsletter.success' | t | default: 'Thanks for subscribing!' }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe To Our Newsletter"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to know about new collections and exclusive offers"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Margin left",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Margin right",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "default": "scheme-4",
      "info": "When the theme toggle is in dark mode, use this scheme for this section."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
