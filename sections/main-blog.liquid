{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.color_bg }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom Color Variables Scoped to Section */
  #BlogSlider-{{ section.id }} {
    --color-card-bg: {{ section.settings.card_bg }};
    --color-card-bg-hover: {{ section.settings.card_bg_hover }};
    --color-card-text: {{ section.settings.card_text }};
    --color-card-text-hover: {{ section.settings.card_text_hover }};
  }
{%- endstyle -%}

{%- paginate blog.articles by 6 -%}
  <div class="main-blog section-{{ section.id }}-padding">
    <div class="blog-slider-wrapper" id="BlogSlider-{{ section.id }}">
      <button class="blog-slider-nav-btn prev-arrow" aria-label="Previous">
        <svg viewBox="0 0 24 24">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>

      <button class="blog-slider-nav-btn next-arrow" aria-label="Next">
        <svg viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>

      <div class="blog-slider-container">
        <div class="blog-slider-track">
          {%- for article in blog.articles -%}
            <div class="blog-slider-item">
              {%- render 'article-card',
                article: article,
                show_image: false,
                show_badge: false,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_cta_button: true,
                custom_badge_text: article.tags.first,
                custom_class: 'article-card-slider'
              -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endpaginate -%}

<script>
  (function () {
    function initBlogSlider() {
      const wrapper = document.querySelector('#BlogSlider-{{ section.id }}');
      if (!wrapper) return;

      const container = wrapper.querySelector('.blog-slider-container');
      const track = container.querySelector('.blog-slider-track');

      const items = Array.from(track.children);
      const prevBtn = wrapper.querySelector('.prev-arrow');
      const nextBtn = wrapper.querySelector('.next-arrow');

      // Get interval from liquid (converted to ms)
      const intervalDuration = {{ section.settings.slider_interval | times: 1000 }};

      if (items.length === 0) return;

      const originalCount = items.length;

      // Clone items for infinite loop buffer
      // We need enough clones to cover the visible area and one full transition set
      if (track.getAttribute('data-cloned') !== 'true') {
        // Clone the entire set once or twice depending on length to ensure we have enough buffer
        const setsToClone = originalCount < 4 ? 2 : 1;
        for (let k = 0; k < setsToClone; k++) {
          items.forEach((item) => {
            const clone = item.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            track.appendChild(clone);
          });
        }
        track.setAttribute('data-cloned', 'true');
      }

      let currentIndex = 0;
      // Removed isHovering flag logic for autoplay blocking
      let intervalId;
      let isTransitioning = false;

      // Calculate width
      function getItemWidth() {
        if (!track.firstElementChild) return 380; // Fallback
        const itemWidth = track.firstElementChild.offsetWidth;
        const gap = 30; // Matches CSS
        return itemWidth + gap;
      }

      function updatePosition(useTransition = true) {
        const itemFullWidth = getItemWidth();
        track.style.transition = useTransition ? 'transform 0.5s ease-in-out' : 'none';
        track.style.transform = `translate3d(-${currentIndex * itemFullWidth}px, 0, 0)`;
      }

      function nextSlide() {
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex++;
        updatePosition(true);
      }

      function startAutoPlay() {
        clearInterval(intervalId);
        intervalId = setInterval(nextSlide, intervalDuration);
      }

      // Handle Transition End for Loop
      track.addEventListener('transitionend', () => {
        isTransitioning = false;
        // If we reached the end of the original set (start of clones), snap back
        if (currentIndex >= originalCount) {
          // Reset to 0 (or relative position if we jumped multiple, but usually we move 1 by 1)
          // To be perfectly safe if we overshoot:
          currentIndex = currentIndex % originalCount;

          // Snap instantly
          requestAnimationFrame(() => {
            updatePosition(false);
          });
        }
      });

      // Events
      // Removed mouseenter/mouseleave blocking logic for autoplay

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (isTransitioning) return;
          isTransitioning = true;
          currentIndex--;

          if (currentIndex < 0) {
            // Jump to end of original set instantly, then slide
            track.style.transition = 'none';
            currentIndex = originalCount;
            track.style.transform = `translate3d(-${currentIndex * getItemWidth()}px, 0, 0)`;

            // Force reflow
            track.getBoundingClientRect();

            // Now slide to last item (originalCount - 1)
            currentIndex = originalCount - 1;
            requestAnimationFrame(() => {
              updatePosition(true);
            });
          } else {
            updatePosition(true);
          }
          startAutoPlay(); // Reset timer
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (isTransitioning) return;
          nextSlide();
          startAutoPlay(); // Reset timer
        });
      }

      startAutoPlay();
    }

    // Initialize on Load
    window.addEventListener('load', initBlogSlider);

    // Initialize on Theme Editor Support
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initBlogSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Schemes"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Section Background",
      "default": "#FFF5F5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg_hover",
      "label": "Card Background (Hover)",
      "default": "#FF0000"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_text_hover",
      "label": "Card Text (Hover)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Settings"
    },

    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "range",
      "id": "slider_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slider Interval",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
