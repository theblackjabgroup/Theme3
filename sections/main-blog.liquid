{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
  assign blog_scheme_ref = section.settings.color_scheme
  assign blog_scheme_id = blog_scheme_ref.id | default: blog_scheme_ref | append: ''
  assign blog_scheme_obj = null
  for s in settings.color_schemes
    assign sid = s.id | append: ''
    if sid == blog_scheme_id or s.id == blog_scheme_ref
      assign blog_scheme_obj = s
      break
    endif
  endfor
  assign blog_dark_scheme_id = null
  assign blog_dark_scheme_obj = null
  if section.settings.dark_mode_color_scheme != blank
    assign blog_dark_ref = section.settings.dark_mode_color_scheme
    assign blog_dark_scheme_id = blog_dark_ref.id | default: blog_dark_ref | append: ''
    for s in settings.color_schemes
      assign sid = s.id | append: ''
      if sid == blog_dark_scheme_id or s.id == blog_dark_ref
        assign blog_dark_scheme_obj = s
        break
      endif
    endfor
  endif
-%}
{%- style -%}
  .section-{{ section.id }}-margin {
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    margin-left: {{ section.settings.margin_horizontal_mobile }}px;
    margin-right: {{ section.settings.margin_horizontal_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-margin {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      margin-left: {{ section.settings.margin_horizontal_desktop }}px;
      margin-right: {{ section.settings.margin_horizontal_desktop }}px;
    }
  }

  /* Mobile Font Sizes */
  #MainBlogContainer-{{ section.id }} .main-blog-card__title {
    font-size: {{ section.settings.title_size_mobile }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__excerpt {
    font-size: {{ section.settings.description_size_mobile }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__tag {
    font-size: {{ section.settings.tag_size_mobile }}px;
    border-radius: {{ section.settings.tag_border_radius_mobile }}px;
    padding: {{ section.settings.tag_padding_vertical_mobile }}px {{ section.settings.tag_padding_horizontal_mobile }}px;
  }

  /* Desktop Font Sizes */
  @media screen and (min-width: 750px) {
    #MainBlogContainer-{{ section.id }} .main-blog-card__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
    #MainBlogContainer-{{ section.id }} .main-blog-card__excerpt {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
    #MainBlogContainer-{{ section.id }} .main-blog-card__tag {
      font-size: {{ section.settings.tag_size_desktop }}px;
      border-radius: {{ section.settings.tag_border_radius_desktop }}px;
      padding: {{ section.settings.tag_padding_vertical_desktop }}px {{ section.settings.tag_padding_horizontal_desktop }}px;
    }

    #MainBlogContainer-{{ section.id }} .main-blog-slider__slide.is-active .main-blog-card__title {
       font-size: calc({{ section.settings.title_size_desktop }}px + 4px);
    }
  }

  #MainBlogContainer-{{ section.id }} .main-blog-card {
    border-radius: {{ section.settings.card_border_radius }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__image-wrapper {
    border-radius: {{ section.settings.image_border_radius }}px;
  }
  #MainBlogContainer-{{ section.id }} {
    --blog-card-transition-duration: {{ section.settings.animation_duration }}s;
  }

  .section-{{ section.id }}-margin .main-blog-slider__controls {
    padding-top: {{ section.settings.arrows_padding_top_mobile }}px;
    padding-bottom: {{ section.settings.arrows_padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-margin .main-blog-slider__controls {
      padding-top: {{ section.settings.arrows_padding_top_desktop }}px;
      padding-bottom: {{ section.settings.arrows_padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

{%- comment -%} Blog slider: respect theme light/dark toggle using section color schemes {%- endcomment -%}
{%- if blog_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"] #shopify-section-{{ section.id }} .main-blog-slider {
      --color-bg: {{ blog_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ blog_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ blog_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ blog_scheme_obj.settings.color_card_text | default: blog_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ blog_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ blog_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ blog_scheme_obj.settings.color_text }} !important;
      --color-link: {{ blog_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ blog_scheme_obj.settings.color_link_hover }} !important;
      --color-primary-button-bg: {{ blog_scheme_obj.settings.primary_button }} !important;
      --color-primary-button-text: {{ blog_scheme_obj.settings.on_primary_button }} !important;
      --color-primary-button-border: {{ blog_scheme_obj.settings.primary_button_border }} !important;
      --btn-primary-bg: {{ blog_scheme_obj.settings.btn_primary_bg | default: blog_scheme_obj.settings.primary_button }} !important;
      --btn-primary-text: {{ blog_scheme_obj.settings.btn_primary_text | default: blog_scheme_obj.settings.on_primary_button }} !important;
      --btn-primary-border: {{ blog_scheme_obj.settings.btn_primary_border | default: blog_scheme_obj.settings.primary_button_border }} !important;
      --btn-primary-shadow: {{ blog_scheme_obj.settings.btn_primary_shadow | default: blog_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}
{%- if blog_dark_scheme_obj -%}
  {%- style -%}
    html[data-global-theme-active="true"][data-active-scheme="color-{{ blog_dark_scheme_id }}"] #shopify-section-{{ section.id }} .main-blog-slider {
      --color-bg: {{ blog_dark_scheme_obj.settings.color_bg }} !important;
      --color-background: {{ blog_dark_scheme_obj.settings.color_bg }} !important;
      --color-card-bg: {{ blog_dark_scheme_obj.settings.color_card_bg }} !important;
      --color-card-text: {{ blog_dark_scheme_obj.settings.color_card_text | default: blog_dark_scheme_obj.settings.color_text }} !important;
      --color-heading: {{ blog_dark_scheme_obj.settings.color_heading }} !important;
      --color-headings: {{ blog_dark_scheme_obj.settings.color_heading }} !important;
      --color-text: {{ blog_dark_scheme_obj.settings.color_text }} !important;
      --color-link: {{ blog_dark_scheme_obj.settings.color_link }} !important;
      --color-link-hover: {{ blog_dark_scheme_obj.settings.color_link_hover }} !important;
      --color-primary-button-bg: {{ blog_dark_scheme_obj.settings.primary_button }} !important;
      --color-primary-button-text: {{ blog_dark_scheme_obj.settings.on_primary_button }} !important;
      --color-primary-button-border: {{ blog_dark_scheme_obj.settings.primary_button_border }} !important;
      --btn-primary-bg: {{ blog_dark_scheme_obj.settings.btn_primary_bg | default: blog_dark_scheme_obj.settings.primary_button }} !important;
      --btn-primary-text: {{ blog_dark_scheme_obj.settings.btn_primary_text | default: blog_dark_scheme_obj.settings.on_primary_button }} !important;
      --btn-primary-border: {{ blog_dark_scheme_obj.settings.btn_primary_border | default: blog_dark_scheme_obj.settings.primary_button_border }} !important;
      --btn-primary-shadow: {{ blog_dark_scheme_obj.settings.btn_primary_shadow | default: blog_dark_scheme_obj.settings.color_btn_shadow }} !important;
    }
  {%- endstyle -%}
{%- endif -%}

<div class="main-blog-slider color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-margin">
  <div class="main-blog-slider__container" id="MainBlogContainer-{{ section.id }}">
    <div class="main-blog-slider__track" id="MainBlogSliderTrack-{{ section.id }}">
      {%- if section.settings.blog != blank -%}
        {%- assign blog_obj = section.settings.blog -%}
      {%- elsif blog != blank -%}
        {%- assign blog_obj = blog -%}
      {%- endif -%}

      {%- if blog_obj != blank and blog_obj.articles_count > 0 -%}
        {%- assign articles = blog_obj.articles -%}
      {%- else -%}
        {%- assign articles = (1..5) -%}
      {%- endif -%}

      {%- for article in articles -%}
        <div class="main-blog-slider__slide" data-index="{{ forloop.index0 }}">
          {% render 'article-card',
            blog: blog_obj,
            article: article,
            media_height: 'fixed',
            media_aspect_ratio: 'fixed',
            show_image: true,
            show_date: false,
            show_author: false,
            show_badge: false,
            show_tags: true,
            placeholder_tag_text: section.settings.placeholder_tag_text,
            show_excerpt: true,
            show_read_more_button: true,
            cta_text: 'Read more',
            custom_class: 'main-blog-card',
            lazy_load: false
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="main-blog-slider__controls">
    {% render 'global-btn',
      variant: 'primary',
      icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      icon_only: true,
      fit_width: false,
      class: 'main-blog-slider__arrow main-blog-slider__arrow--prev',
      attributes: 'id="MainBlogPrev-{{ section.id }}" aria-label="Previous article"'
    %}
    {% render 'global-btn',
      variant: 'primary',
      icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      icon_only: true,
      fit_width: false,
      class: 'main-blog-slider__arrow main-blog-slider__arrow--next',
      attributes: 'id="MainBlogNext-{{ section.id }}" aria-label="Next article"'
    %}
  </div>
</div>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    window.mainBlogRegistry = window.mainBlogRegistry || {};

    if (window.mainBlogRegistry[sectionId]) {
      window.mainBlogRegistry[sectionId].cleanup();
    }

    let cleanupSlider;

    function initMainBlogSlider() {
      const track = document.getElementById('MainBlogSliderTrack-{{ section.id }}');
      if (!track) return;

      const container = document.getElementById('MainBlogContainer-{{ section.id }}');
      const sectionEl = document.querySelector('.section-{{ section.id }}-margin');
      const controlsEl = sectionEl ? sectionEl.querySelector('.main-blog-slider__controls') : null;

      const existingClones = track.querySelectorAll('.is-clone');
      existingClones.forEach((clone) => clone.remove());

      let cards = Array.from(track.querySelectorAll('.main-blog-slider__slide'));

      const cloneCount = 10;
      const cardCount = cards.length;

      if (cardCount > 0) {
        for (let i = 0; i < cloneCount; i++) {
          const sourceIndex = cardCount - 1 - (i % cardCount);
          const clone = cards[sourceIndex].cloneNode(true);
          clone.classList.add('is-clone');
          clone.dataset.index = -1 - i;
          track.insertBefore(clone, track.firstChild);
        }

        for (let i = 0; i < cloneCount; i++) {
          const sourceIndex = i % cardCount;
          const clone = cards[sourceIndex].cloneNode(true);
          clone.classList.add('is-clone');
          clone.dataset.index = cardCount + i;
          track.appendChild(clone);
        }
      }

       const allCards = Array.from(track.querySelectorAll('.main-blog-slider__slide'));
       let currentIndex = cloneCount;
       let isAnimating = false;
      let scrollTimeout;

      // Calculate dimensions once
      const getCardMetrics = () => {
        const firstCard = allCards[0];
        if (!firstCard) return { cardWidth: 0, gap: 0, totalRealWidth: 0, cloneWidth: 0 };

        const style = window.getComputedStyle(track);
        const gap = parseFloat(style.gap) || 30;
        const cardWidth = firstCard.offsetWidth + gap;
        const totalRealWidth = cardCount * cardWidth;
        const cloneWidth = cloneCount * cardWidth;

        return { cardWidth, gap, totalRealWidth, cloneWidth };
      };

      const animationDuration = {{ section.settings.animation_duration | times: 1000 }};

      requestAnimationFrame(() => {
        handleVisualUpdate(currentIndex, false);
      });

      function updateSlider(index) {
        if (isAnimating) return;
        isAnimating = true;

        handleVisualUpdate(index, true);
        currentIndex = index;

        setTimeout(() => {
          checkIndexBounds();
          isAnimating = false;
        }, animationDuration); // Matches CSS transition duration
      }

      function checkIndexBounds() {
        let newIndex = currentIndex;
        let jumped = false;

        // Button-based jump logic
        if (currentIndex < cloneCount || currentIndex >= cloneCount + cardCount) {
          const relativeIndex = (currentIndex - cloneCount) % cardCount;
          const adjustedRelativeIndex = relativeIndex < 0 ? relativeIndex + cardCount : relativeIndex;
          newIndex = cloneCount + adjustedRelativeIndex;
          jumped = true;
        }

        if (jumped) {
          performJump(newIndex);
        }
      }

      function performJump(newIndex) {
        container.classList.add('no-transition');
        void container.offsetHeight; // Force reflow

        handleVisualUpdate(newIndex, false);
        currentIndex = newIndex;

        void container.offsetHeight;

        requestAnimationFrame(() => {
          container.classList.remove('no-transition');
        });
      }

      function handleVisualUpdate(index, animate, skipScroll = false) {
        allCards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('is-active');
          } else {
            card.classList.remove('is-active');
          }
        });

        if (skipScroll) return;

        const activeCard = allCards[index];
        if (!activeCard) return;

        const containerWidth = container.offsetWidth;
        const cardWidth = activeCard.offsetWidth;
        const cardLeft = activeCard.offsetLeft;
        const scrollLeft = cardLeft - containerWidth / 2 + cardWidth / 2;

        container.scrollTo({
          left: scrollLeft,
          behavior: animate ? 'smooth' : 'auto',
        });
      }

      function checkInfiniteScroll() {
        const { totalRealWidth, cloneWidth, cardWidth } = getCardMetrics();
        if (totalRealWidth === 0) return;

        const scrollLeft = container.scrollLeft;
        const threshold = cardWidth; // Buffer of one card width

        // If scrolled into Left Clone Zone
        if (scrollLeft < cloneWidth - threshold) {
          container.classList.add('no-transition');
          void container.offsetHeight; // Force reflow
          container.scrollLeft += totalRealWidth;
          void container.offsetHeight;
          container.classList.remove('no-transition');
        }
        // If scrolled into Right Clone Zone
        else if (scrollLeft > cloneWidth + totalRealWidth + threshold) {
          container.classList.add('no-transition');
          void container.offsetHeight; // Force reflow
          container.scrollLeft -= totalRealWidth;
          void container.offsetHeight;
          container.classList.remove('no-transition');
        }
      }

      const onScroll = () => {
        if (isAnimating) return;

        checkInfiniteScroll();

        requestAnimationFrame(() => {
          if (isAnimating) return;

          const containerCenter = container.scrollLeft + container.offsetWidth / 2;
          let closestIndex = currentIndex;
          let minDiff = Infinity;

          allCards.forEach((card, index) => {
            const cardLeft = card.offsetLeft;
            const cardWidth = card.offsetWidth;
            const cardCenter = cardLeft + cardWidth / 2;
            const diff = Math.abs(containerCenter - cardCenter);

            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = index;
            }
          });

          if (closestIndex !== currentIndex) {
            currentIndex = closestIndex;
            handleVisualUpdate(currentIndex, false, true);
          }
        });
      };

      container.addEventListener('scroll', onScroll, { passive: true });

      function onControlsClick(e) {
        const prevArrow = e.target.closest('.main-blog-slider__arrow--prev');
        const nextArrow = e.target.closest('.main-blog-slider__arrow--next');
        if (prevArrow) {
          e.preventDefault();
          updateSlider(currentIndex - 1);
        } else if (nextArrow) {
          e.preventDefault();
          updateSlider(currentIndex + 1);
        }
      }
      if (controlsEl) {
        controlsEl.addEventListener('click', onControlsClick);
      }

      const resizeHandler = () => {
        handleVisualUpdate(currentIndex, false);
      };

      window.addEventListener('resize', resizeHandler);

      return () => {
        window.removeEventListener('resize', resizeHandler);
        container.removeEventListener('scroll', onScroll);
        if (controlsEl) {
          controlsEl.removeEventListener('click', onControlsClick);
        }
      };
    }

    const onLoad = (event) => {
      if (event.detail.sectionId === sectionId) {
        if (typeof cleanupSlider === 'function') cleanupSlider();
        cleanupSlider = initMainBlogSlider();
      }
    };

    const onUnload = (event) => {
      if (event.detail.sectionId === sectionId) {
        if (window.mainBlogRegistry[sectionId]) {
          window.mainBlogRegistry[sectionId].cleanup();
        }
      }
    };

    document.addEventListener('shopify:section:load', onLoad);
    document.addEventListener('shopify:section:unload', onUnload);

    window.mainBlogRegistry[sectionId] = {
      cleanup: () => {
        if (typeof cleanupSlider === 'function') cleanupSlider();
        document.removeEventListener('shopify:section:load', onLoad);
        document.removeEventListener('shopify:section:unload', onUnload);
        delete window.mainBlogRegistry[sectionId];
      },
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        cleanupSlider = initMainBlogSlider();
      });
    } else {
      cleanupSlider = initMainBlogSlider();
    }
  })();
</script>

{% schema %}
{
  "name": "Main Blog Slider",
  "disabled_on": {
    "groups": ["header", "footer"],
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dark_mode_color_scheme",
      "label": "Dark mode color scheme",
      "info": "When the theme toggle is in dark mode, use this color scheme for the blog slider. Leave blank to reuse the main color scheme."
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.5,
      "max": 4.0,
      "step": 0.1,
      "unit": "s",
      "label": "Animation Duration",
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Desktop Margin"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal_desktop",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal Margin",
      "default": 10
    },
    {
      "type": "header",
      "content": "Mobile Margin"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal Margin",
      "default": 0
    },
    {
      "type": "text",
      "id": "placeholder_tag_text",
      "label": "Placeholder Tag Text",
      "default": "Category"
    },
    {
      "type": "header",
      "content": "Desktop Typography"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Description Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tag_size_desktop",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tag Size",
      "default": 10
    },
    {
      "type": "header",
      "content": "Mobile Typography"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Description Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "tag_size_mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tag Size",
      "default": 9
    },
    {
      "type": "header",
      "content": "Arrows Padding"
    },
    {
      "type": "range",
      "id": "arrows_padding_top_desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Above Arrows (Desktop)",
      "default": 8
    },
    {
      "type": "range",
      "id": "arrows_padding_bottom_desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Below Arrows (Desktop)",
      "default": 8
    },
    {
      "type": "range",
      "id": "arrows_padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Above Arrows (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "arrows_padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Below Arrows (Mobile)",
      "default": 10
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "tag_border_radius_desktop",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Tag Border Radius (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "tag_border_radius_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Tag Border Radius (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "tag_padding_vertical_desktop",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
