{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-margin {
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    margin-left: {{ section.settings.margin_horizontal_mobile }}px;
    margin-right: {{ section.settings.margin_horizontal_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-margin {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      margin-left: {{ section.settings.margin_horizontal_desktop }}px;
      margin-right: {{ section.settings.margin_horizontal_desktop }}px;
    }
  }

  /* Mobile Font Sizes */
  #MainBlogContainer-{{ section.id }} .main-blog-card__title {
    font-size: {{ section.settings.title_size_mobile }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__excerpt {
    font-size: {{ section.settings.description_size_mobile }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__tag {
    font-size: {{ section.settings.tag_size_mobile }}px;
  }

  /* Desktop Font Sizes */
  @media screen and (min-width: 750px) {
    #MainBlogContainer-{{ section.id }} .main-blog-card__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
    #MainBlogContainer-{{ section.id }} .main-blog-card__excerpt {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
    #MainBlogContainer-{{ section.id }} .main-blog-card__tag {
      font-size: {{ section.settings.tag_size_desktop }}px;
    }

    #MainBlogContainer-{{ section.id }} .main-blog-card.is-active .main-blog-card__title {
       font-size: calc({{ section.settings.title_size_desktop }}px + 4px);
    }
  }

  #MainBlogContainer-{{ section.id }} .main-blog-card {
    border-radius: {{ section.settings.card_border_radius }}px;
  }
  #MainBlogContainer-{{ section.id }} .main-blog-card__image-wrapper {
    border-radius: {{ section.settings.image_border_radius }}px;
  }
{%- endstyle -%}

<div class="main-blog-slider color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-margin">
  <div class="main-blog-slider__container" id="MainBlogContainer-{{ section.id }}">
    <div class="main-blog-slider__track" id="MainBlogSliderTrack-{{ section.id }}">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- assign articles = section.settings.blog.articles -%}
      {%- else -%}
        {%- assign articles = (1..5) -%}
      {%- endif -%}

      {%- for article in articles -%}
        <div class="main-blog-card" data-index="{{ forloop.index0 }}">
          <div class="main-blog-card__image-wrapper">
            {%- if article.image -%}
              {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'main-blog-card__image' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'main-blog-card__image' }}
            {%- endif -%}
          </div>
          <div class="main-blog-card__content">
            {%- if article.tags.size > 0 -%}
              <span class="main-blog-card__tag">{{ article.tags.first }}</span>
            {%- elsif section.settings.placeholder_tag_text != blank -%}
              <span class="main-blog-card__tag">{{ section.settings.placeholder_tag_text }}</span>
            {%- endif -%}

            <h3 class="main-blog-card__title">
              {{ article.title | default: 'Default Title' }}
            </h3>

            <div class="main-blog-card__excerpt">
              {%- if article.excerpt.size > 0 -%}
                {{ article.excerpt | strip_html | truncatewords: 15 }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 15 }}
              {%- endif -%}
            </div>
          </div>

          {% render 'submit-button', text: 'Read more', url: article.url, class: 'main-blog-card__button' %}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="main-blog-slider__controls">
    <button class="main-blog-slider__arrow main-blog-slider__arrow--prev" id="MainBlogPrev-{{ section.id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="main-blog-slider__arrow main-blog-slider__arrow--next" id="MainBlogNext-{{ section.id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  (function () {
    let cleanupSlider;

    function initMainBlogSlider() {
      const track = document.getElementById('MainBlogSliderTrack-{{ section.id }}');
      if (!track) return;

      const container = document.getElementById('MainBlogContainer-{{ section.id }}');
      const prevBtn = document.getElementById('MainBlogPrev-{{ section.id }}');
      const nextBtn = document.getElementById('MainBlogNext-{{ section.id }}');

      const existingClones = track.querySelectorAll('.is-clone');
      existingClones.forEach((clone) => clone.remove());

      let cards = Array.from(track.querySelectorAll('.main-blog-card'));

      const cloneCount = 10;
      const cardCount = cards.length;

      if (cardCount > 0) {
        for (let i = 0; i < cloneCount; i++) {
          const sourceIndex = cardCount - 1 - (i % cardCount);
          const clone = cards[sourceIndex].cloneNode(true);
          clone.classList.add('is-clone');
          clone.dataset.index = -1 - i;
          track.insertBefore(clone, track.firstChild);
        }

        for (let i = 0; i < cloneCount; i++) {
          const sourceIndex = i % cardCount;
          const clone = cards[sourceIndex].cloneNode(true);
          clone.classList.add('is-clone');
          clone.dataset.index = cardCount + i;
          track.appendChild(clone);
        }
      }

      const allCards = Array.from(track.querySelectorAll('.main-blog-card'));
      let currentIndex = cloneCount;
      let isAnimating = false;
      let scrollTimeout;

      requestAnimationFrame(() => {
        handleVisualUpdate(currentIndex, false);
      });

      function updateSlider(index) {
        if (isAnimating) return;
        isAnimating = true;

        handleVisualUpdate(index, true);
        currentIndex = index;

        setTimeout(() => {
          checkIndexBounds();
          isAnimating = false;
        }, 800);
      }

      function checkIndexBounds() {
        let newIndex = currentIndex;
        let jumped = false;

        if (currentIndex < cloneCount) {
          newIndex = currentIndex + cardCount;
          jumped = true;
        } else if (currentIndex >= cloneCount + cardCount) {
          newIndex = currentIndex - cardCount;
          jumped = true;
        }

        if (jumped) {
          container.classList.add('no-transition');
          void container.offsetHeight;

          handleVisualUpdate(newIndex, false);
          currentIndex = newIndex;

          void container.offsetHeight;
          requestAnimationFrame(() => {
            container.classList.remove('no-transition');
          });
        }
      }

      function handleVisualUpdate(index, animate, skipScroll = false) {
        allCards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('is-active');
          } else {
            card.classList.remove('is-active');
          }
        });

        if (skipScroll) return;

        const activeCard = allCards[index];
        if (!activeCard) return;

        const containerWidth = container.offsetWidth;
        const cardWidth = activeCard.offsetWidth;
        const cardLeft = activeCard.offsetLeft;
        const scrollLeft = cardLeft - containerWidth / 2 + cardWidth / 2;

        container.scrollTo({
          left: scrollLeft,
          behavior: animate ? 'smooth' : 'auto',
        });
      }

      const onScroll = () => {
        if (isAnimating) return;

        requestAnimationFrame(() => {
          if (isAnimating) return;

          const containerCenter = container.scrollLeft + container.offsetWidth / 2;
          let closestIndex = currentIndex;
          let minDiff = Infinity;

          allCards.forEach((card, index) => {
            const cardLeft = card.offsetLeft;
            const cardWidth = card.offsetWidth;
            const cardCenter = cardLeft + cardWidth / 2;
            const diff = Math.abs(containerCenter - cardCenter);

            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = index;
            }
          });

          if (closestIndex !== currentIndex) {
            currentIndex = closestIndex;
            handleVisualUpdate(currentIndex, false, true); 
          }
        });
      };

      container.addEventListener('scroll', onScroll, { passive: true });

      const newPrevBtn = prevBtn.cloneNode(true);
      const newNextBtn = nextBtn.cloneNode(true);
      prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
      nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);

      newPrevBtn.addEventListener('click', () => {
        updateSlider(currentIndex - 1);
      });

      newNextBtn.addEventListener('click', () => {
        updateSlider(currentIndex + 1);
      });

      const resizeHandler = () => {
        handleVisualUpdate(currentIndex, false);
      };

      window.addEventListener('resize', resizeHandler);

      return () => {
        window.removeEventListener('resize', resizeHandler);
        container.removeEventListener('scroll', onScroll);
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        cleanupSlider = initMainBlogSlider();
      });
    } else {
      cleanupSlider = initMainBlogSlider();
    }

    const sectionId = '{{ section.id }}';

    const onLoad = (event) => {
      if (event.detail.sectionId === sectionId) {
        if (typeof cleanupSlider === 'function') cleanupSlider();
        cleanupSlider = initMainBlogSlider();
      }
    };

    const onUnload = (event) => {
      if (event.detail.sectionId === sectionId) {
        if (typeof cleanupSlider === 'function') cleanupSlider();
        document.removeEventListener('shopify:section:load', onLoad);
        document.removeEventListener('shopify:section:unload', onUnload);
      }
    };

    document.addEventListener('shopify:section:load', onLoad);
    document.addEventListener('shopify:section:unload', onUnload);
  })();
</script>

