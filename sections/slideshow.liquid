{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = 0
  assign preview_fallback_product = null
  if request.design_mode
    assign preview_fallback_product = collections.first.products.first
  endif
  for block in section.blocks
    if block.type == 'slide'
      assign block_product = block.settings.product
      if block_product == blank and preview_fallback_product != blank
        assign block_product = preview_fallback_product
      endif
      if block_product != blank
        assign slide_count = slide_count | plus: 1
      endif
    endif
  endfor
  assign product_card_radius = '20px'
  case settings.product_card_radius_token
    when 'radius_small'
      assign product_card_radius = '4px'
    when 'radius_medium'
      assign product_card_radius = '8px'
    when 'radius_large'
      assign product_card_radius = '20px'
  endcase

  assign product_card_shadow = 'none'
  case settings.product_card_shadow_token
    when 'shadow_1'
      assign product_card_shadow = '0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)'
    when 'shadow_2'
      assign product_card_shadow = '0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23)'
  endcase
-%}

<section
  class="bb-slideshow-section color-{{ section.settings.color_scheme }}"
  id="BBSlideshow-{{ section.id }}"
  data-bb-slideshow
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
>
  <div class="bb-slideshow">
    <div class="bb-slideshow__left">
      <div class="bb-slideshow__left-stage" data-left-stage>
        {%- assign valid_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if request.design_mode and product == blank and preview_fallback_product != blank -%}
            {%- assign product = preview_fallback_product -%}
          {%- endif -%}
          {%- if block.type == 'slide' and product != blank -%}
            {%- assign image_media = product.media[1] -%}
            {%- if image_media == blank -%}
              {%- assign image_media = product.featured_media -%}
            {%- endif -%}
            {%- liquid
              assign left_button_text_transform = 'none'
              if block.settings.left_button_uppercase
                assign left_button_text_transform = 'uppercase'
              endif
            -%}
            <article
              class="bb-slideshow__left-slide{% if valid_index == 0 %} is-active{% endif %}"
              data-left-slide
              data-slide-index="{{ valid_index }}"
              data-block-id="{{ block.id }}"
              style="
                --left-image-fit: {{ block.settings.left_image_fit }};
                --left-image-width-desktop: {{ block.settings.left_image_width_desktop }}%;
                --left-image-height-desktop: {{ block.settings.left_image_height_desktop }}%;
                --left-image-x-desktop: {{ block.settings.left_image_x_desktop }}%;
                --left-image-y-desktop: {{ block.settings.left_image_y_desktop }}%;
                --left-image-width-mobile: {{ block.settings.left_image_width_mobile }}%;
                --left-image-height-mobile: {{ block.settings.left_image_height_mobile }}%;
                --left-image-x-mobile: {{ block.settings.left_image_x_mobile }}%;
                --left-image-y-mobile: {{ block.settings.left_image_y_mobile }}%;
                --left-image-shadow-x: {{ block.settings.left_image_shadow_x }}px;
                --left-image-shadow-y: {{ block.settings.left_image_shadow_y }}px;
                --left-image-shadow-blur: {{ block.settings.left_image_shadow_blur }}px;
                --left-button-alignment: {{ block.settings.left_button_alignment }};
                --left-button-text-transform: {{ left_button_text_transform }};
                --left-button-bottom-desktop: {{ block.settings.left_button_bottom_desktop }}%;
                --left-button-x-desktop: {{ block.settings.left_button_x_desktop }}%;
                --left-button-y-desktop: {{ block.settings.left_button_y_desktop }}px;
                --left-button-min-width-desktop: {{ block.settings.left_button_min_width_desktop }}px;
                --left-button-height-desktop: {{ block.settings.left_button_height_desktop }}px;
                --left-button-padding-x-desktop: {{ block.settings.left_button_padding_x_desktop }}px;
                --left-button-font-size-desktop: {{ block.settings.left_button_font_size_desktop }}px;
                --left-button-font-size-mobile: {{ block.settings.left_button_font_size_mobile }}px;
                --left-button-font-weight: {{ block.settings.left_button_font_weight }};
                --left-button-letter-spacing: {{ block.settings.left_button_letter_spacing }}px;
                --left-button-radius: {{ block.settings.left_button_radius }}px;
                --left-button-shadow-offset: {{ block.settings.left_button_shadow_offset }}px;
                --left-button-bottom-mobile: {{ block.settings.left_button_bottom_mobile }}%;
                --left-button-x-mobile: {{ block.settings.left_button_x_mobile }}%;
                --left-button-y-mobile: {{ block.settings.left_button_y_mobile }}px;
                --left-button-min-width-mobile: {{ block.settings.left_button_min_width_mobile }}px;
                --left-button-height-mobile: {{ block.settings.left_button_height_mobile }}px;
                --left-button-padding-x-mobile: {{ block.settings.left_button_padding_x_mobile }}px;
              "
              {% if valid_index != 0 %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="bb-slideshow__left-chip">
                {{-
                  block.settings.badge_text
                  | default: product.type
                  | default: product.vendor
                  | default: 'Product'
                  | escape
                -}}
              </div>
              <div class="bb-slideshow__left-hero">
                <h2 class="bb-slideshow__left-title">{{ product.title | truncatewords: 2, '...' }}</h2>
                {%- if image_media != blank -%}
                  {%- assign img_aspect = image_media.aspect_ratio
                    | default: image_media.preview_image.aspect_ratio
                    | default: 1
                  -%}
                  <img
                    src="{{ image_media | image_url: width: 1400 }}"
                    alt="{{ image_media.alt | default: product.title | escape }}"
                    class="bb-slideshow__left-image"
                    loading="{% if valid_index == 0 %}eager{% else %}lazy{% endif %}"
                    width="1400"
                    height="{{ 1400 | divided_by: img_aspect }}"
                  >
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'bb-slideshow__placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="bb-slideshow__left-cta">
                {%-
                  render 'global-btn',
                  text: section.settings.shop_now_label | default: 'Shop now',
                  url: product.url,
                  class: 'bb-slideshow__shop-now'
                -%}
              </div>
            </article>
            {%- assign valid_index = valid_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if slide_count == 0 -%}
          <article
            class="bb-slideshow__left-slide is-active bb-slideshow__left-slide--placeholder"
            data-left-slide
            data-slide-index="0"
          >
            <h2 class="bb-slideshow__left-title">Add up to 5 products</h2>
            {{ 'product-apparel-2' | placeholder_svg_tag: 'bb-slideshow__placeholder-svg' }}
          </article>
        {%- endif -%}
      </div>
      <div class="bb-slideshow__stage-nav" aria-label="Slideshow controls">
        {%- assign left_prev_attrs = 'data-nav="prev" aria-label="Previous slide"' -%}
        {%- assign left_next_attrs = 'data-nav="next" aria-label="Next slide"' -%}
        {%- render 'global-btn',
          text: '←',
          type: 'button',
          class: 'bb-slideshow__stage-nav-button bb-slideshow__stage-nav-button--prev',
          attributes: left_prev_attrs
        -%}
        {%- render 'global-btn',
          text: '→',
          type: 'button',
          class: 'bb-slideshow__stage-nav-button bb-slideshow__stage-nav-button--next',
          attributes: left_next_attrs
        -%}
      </div>
    </div>

    <div class="bb-slideshow__right">
      <div class="bb-slideshow__view-more">
        {%-
          render 'global-btn',
          text: 'view more',
          url: section.settings.view_more_link | default: routes.collections_url,
          class: 'bb-slideshow__view-more-btn'
        -%}
      </div>

      <div class="bb-slideshow__card-stage" data-card-stage>
        {%- assign valid_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if request.design_mode and product == blank and preview_fallback_product != blank -%}
            {%- assign product = preview_fallback_product -%}
          {%- endif -%}
          {%- if block.type == 'slide' and product != blank -%}
            <div
              class="bb-slideshow__card-slide{% if valid_index == 0 %} is-active{% endif %}"
              data-card-slide
              data-slide-index="{{ valid_index }}"
              data-block-id="{{ block.id }}"
              {% if valid_index != 0 %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%
                render 'card-product',
                card_product: product,
                section_id: section.id,
                quick_add: 'none',
                show_badge: false,
                lazy_load: valid_index != 0
              %}
            </div>
            {%- assign valid_index = valid_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if slide_count == 0 -%}
          <div class="bb-slideshow__card-slide is-active" data-card-slide data-slide-index="0">
            <div class="bb-slideshow__right-placeholder">Select products in section settings.</div>
          </div>
        {%- endif -%}
      </div>

      <div class="bb-slideshow__right-nav">
        {%- assign right_prev_attrs = 'data-nav="prev" aria-label="Previous product"' -%}
        {%- assign right_next_attrs = 'data-nav="next" aria-label="Next product"' -%}
        {%- render 'global-btn',
          text: '←',
          type: 'button',
          class: 'bb-slideshow__right-nav-button',
          attributes: right_prev_attrs
        -%}
        {%- render 'global-btn',
          text: '→',
          type: 'button',
          class: 'bb-slideshow__right-nav-button',
          attributes: right_next_attrs
        -%}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bb-slideshow-section {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.left_column_width_percent }}%) minmax(0, calc(100% - {{ section.settings.left_column_width_percent }}%));
    gap: 16px;
    min-height: {{ section.settings.section_height }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left,
  #shopify-section-{{ section.id }} .bb-slideshow__card-stage,
  #shopify-section-{{ section.id }} .bb-slideshow__view-more {
    border-radius: var(--radius-2xl);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left {
    border: 1px solid var(--color-borders);
    background: var(--color-card-bg);
    padding: 18px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-stage {
    position: relative;
    height: {{ section.settings.section_height }}px;
    border-radius: var(--radius-xl);
    background: transparent;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-stage::before {
    content: '';
    position: absolute;
    left: 5px;
    right: 5px;
    bottom: 5px;
    height: 50%;
    background: var(--color-card-bg);
    border-radius: var(--radius-xl);
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide {
    position: absolute;
    inset: 0;
    padding: 20px 28px 24px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 16px;
    opacity: 0;
    pointer-events: none;
    background: transparent;
    z-index: 1;
    transform: translate3d(0, 0, 0);
    transform-origin: center center;
    backface-visibility: hidden;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-active {
    position: absolute;
    inset: 0;
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-leaving {
    opacity: 1;
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-next,
  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-prev {
    opacity: 1;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-exit-next {
    animation: bbSlideOutUp-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-next {
    animation: bbSlideInFromBottom-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-exit-prev {
    animation: bbSlideOutDown-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-prev {
    animation: bbSlideInFromTop-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  @keyframes bbSlideOutUp-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, -100%, 0); }
  }

  @keyframes bbSlideInFromBottom-{{ section.id }} {
    from { transform: translate3d(0, 100%, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes bbSlideOutDown-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, 100%, 0); }
  }

  @keyframes bbSlideInFromTop-{{ section.id }} {
    from { transform: translate3d(0, -100%, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-chip {
    border: 1px solid var(--color-link);
    border-radius: var(--radius-pill);
    color: var(--color-link);
    font-size: 1.1rem;
    line-height: 1;
    padding: 8px 16px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-title {
    margin: 0;
    text-align: center;
    font-size: clamp(3rem, 5vw, 8rem);
    line-height: 1.1;
    color: var(--color-heading);
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    z-index: 1;
    padding-inline: 20px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-hero {
    width: 100%;
    height: 100%;
    min-height: 0;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-image {
    width: var(--left-image-width-desktop, 100%);
    height: var(--left-image-height-desktop, 100%);
    max-width: none;
    max-height: none;
    object-fit: var(--left-image-fit, contain);
    object-position: center bottom;
    display: block;
    margin-inline: auto;
    z-index: 2;
    transform: translate(var(--left-image-x-desktop, 0%), var(--left-image-y-desktop, 0%));
    filter: drop-shadow(
      var(--left-image-shadow-x, 0px)
      var(--left-image-shadow-y, 20px)
      var(--left-image-shadow-blur, 18px)
      var(--left-image-shadow-color, var(--color-btn-shadow))
    );
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--left-button-bottom-desktop, 3%);
    display: flex;
    justify-content: var(--left-button-alignment, center);
    z-index: 3;
    transform: translate(var(--left-button-x-desktop, 0%), var(--left-button-y-desktop, 0px));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now .submit-button__content {
    min-width: var(--left-button-min-width-desktop, 208px);
    height: var(--left-button-height-desktop, 48px);
    padding: 0 var(--left-button-padding-x-desktop, 20px);
    font-size: var(--left-button-font-size-desktop, 14px);
    font-weight: var(--left-button-font-weight, 700);
    letter-spacing: var(--left-button-letter-spacing, 1px);
    border-radius: var(--left-button-radius, var(--radius-xl));
    border-color: var(--left-button-border-color, var(--btn-primary-border));
    background-color: var(--left-button-bg-color, var(--btn-primary-bg));
    color: var(--left-button-text-color, var(--btn-primary-text));
    text-transform: var(--left-button-text-transform, uppercase);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now .submit-button__shadow {
    background-color: var(--left-button-shadow-color, var(--btn-primary-shadow));
    border-radius: var(--left-button-radius, var(--radius-xl));
    top: var(--left-button-shadow-offset, 2px);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right-nav {
    display: flex;
    justify-content: center;
    gap: 14px;
  }
    #shopify-section-{{ section.id }} .bb-slideshow__stage-nav{
      display: flex;
    justify-content: space-between;
    gap: 14px;
       position: absolute;
    left: 20px;
    right: 20px;
    top: calc(40% - 10px);
    transform: none;
    margin-top: 0;
    z-index: 4;
    pointer-events: none;
    }


  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button {
    pointer-events: auto;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__content,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__content {
    width: 84px;
    min-width: 84px;
    height: 48px;
    padding: 0;
    font-size: 2.2rem;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__shadow,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__shadow {
    border-radius: var(--radius-l);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__text,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__text {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__view-more .bb-slideshow__view-more-btn {
    width: 100%;
    display: block;
  }
  .bb-slideshow__view-more-btn .global-btn__content {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__view-more .bb-slideshow__view-more-btn .submit-button__content {
    width: 100%;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage {
    background: var(--color-card-bg);
    border: 1px solid var(--color-borders);
    padding: 12px;
    position: relative;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage .custom-product-card {
    --card-hover-description-font-size: {{ settings.product_card_hover_description_font_size | default: 14 }}px;
    --card-hover-description-font-weight: {{ settings.product_card_hover_description_font_weight | default: 400 }};
    --card-hover-button-font-size: {{ settings.product_card_hover_button_font_size | default: 12 }}px;
    --card-hover-button-font-weight: {{ settings.product_card_hover_button_font_weight | default: 600 }};
    --card-hover-button-padding-vertical: {{ settings.product_card_hover_button_padding_vertical | default: 10 }}px;
    --card-hover-button-padding-horizontal: {{ settings.product_card_hover_button_padding_horizontal | default: 20 }}px;
    --card-hover-content-gap: {{ settings.product_card_hover_content_gap | default: 10 }}px;
    --card-hover-button-border-radius: {{ settings.product_card_hover_button_border_radius | default: 20 }}px;
    --card-price-button-border-radius: {{ settings.product_card_price_button_border_radius | default: 12 }}px;
    --card-price-font-size: {{ settings.product_card_price_font_size | default: 16 }}px;
    --card-price-font-weight: {{ settings.product_card_price_font_weight | default: 700 }};
    --card-price-padding-vertical: {{ settings.product_card_price_padding_vertical | default: 10 }}px;
    --card-price-padding-horizontal: {{ settings.product_card_price_padding_horizontal | default: 18 }}px;
    --card-price-border-width: {{ settings.product_card_price_border_width | default: 1 }}px;
    --card-price-border-radius: {{ settings.product_card_price_border_radius | default: 12 }}px;
    height: 100% !important;
    min-height: 0;
    border-radius: {{ product_card_radius }};
    box-shadow: {{ product_card_shadow }};
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage .custom-product-card__main-link {
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage .custom-product-card__title {
    font-size: {{ settings.product_card_title_font_size | default: 24 }}px !important;
    font-weight: {{ settings.product_card_title_font_weight | default: 900 }};
    line-height: {{ settings.product_card_title_line_height | default: 1 }};
    margin-top: {{ settings.product_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_title_margin_bottom | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage .custom-product-card__description {
    font-size: {{ settings.product_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_description_font_weight | default: 400 }};
    line-height: {{ settings.product_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.product_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.product_card_description_margin_bottom | default: 0 }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage .custom-product-card__badge {
    font-size: {{ settings.product_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.product_card_badge_font_weight | default: 700 }};
    padding: {{ settings.product_card_badge_padding_vertical | default: 4 }}px {{ settings.product_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.product_card_badge_margin_bottom | default: 10 }}px;
    background-color: {{ settings.product_card_badge_background_color | default: 'transparent' }};
