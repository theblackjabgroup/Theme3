{{ 'card-base.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'collection-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.first
  endif

  assign slideshow_products = collection.products
  assign slide_count = slideshow_products.size

  assign preview_fallback_product = null
  if request.design_mode and slideshow_products.size == 0
    assign preview_fallback_product = collections.first.products.first
  endif

  assign product_card_radius = '20px'
  case settings.product_card_radius_token
    when 'radius_small'
      assign product_card_radius = '4px'
    when 'radius_medium'
      assign product_card_radius = '8px'
    when 'radius_large'
      assign product_card_radius = '20px'
  endcase

  assign product_card_shadow = 'none'
  case settings.product_card_shadow_token
    when 'shadow_1'
      assign product_card_shadow = '0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)'
    when 'shadow_2'
      assign product_card_shadow = '0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23)'
  endcase
-%}

<section
  class="bb-slideshow-section color-{{ section.settings.color_scheme }}"
  id="BBSlideshow-{{ section.id }}"
  data-bb-slideshow
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
>
  <div class="bb-slideshow">
    <div class="bb-slideshow__left">
      <div class="bb-slideshow__left-stage" data-left-stage>
        {%- assign valid_index = 0 -%}
        {%- for product in slideshow_products -%}
          {%- if request.design_mode and product == blank and preview_fallback_product != blank -%}
            {%- assign product = preview_fallback_product -%}
          {%- endif -%}
          {%- if product != blank -%}
            {%- assign image_media = product.media[1] -%}
            {%- if image_media == blank -%}
              {%- assign image_media = product.featured_media -%}
            {%- endif -%}
            {%- liquid
              assign left_button_text_transform = 'none'
              if block.settings.left_button_uppercase
                assign left_button_text_transform = 'uppercase'
              endif
            -%}
            <article
              class="bb-slideshow__left-slide{% if valid_index == 0 %} is-active{% endif %}"
              data-left-slide
              data-slide-index="{{ valid_index }}"
              data-block-id="slide-{{ valid_index }}"
              style="
                --left-image-fit: contain;
                --left-image-width-desktop: 100%;
                --left-image-height-desktop: 100%;
                --left-image-x-desktop: 0%;
                --left-image-y-desktop: 0%;
                --left-image-width-mobile: 100%;
                --left-image-height-mobile: 100%;
                --left-image-x-mobile: 0%;
                --left-image-y-mobile: 0%;
                --left-image-shadow-x: 0px;
                --left-image-shadow-y: 20px;
                --left-image-shadow-blur: 18px;
                --left-button-alignment: center;
                --left-button-text-transform: uppercase;
                --left-button-bottom-desktop: 3%;
                --left-button-x-desktop: 0%;
                --left-button-y-desktop: 0px;
                --left-button-min-width-desktop: 208px;
                --left-button-height-desktop: 48px;
                --left-button-padding-x-desktop: 20px;
                --left-button-font-size-desktop: 14px;
                --left-button-font-size-mobile: 13px;
                --left-button-font-weight: 700;
                --left-button-letter-spacing: 1px;
                --left-button-radius: 16px;
                --left-button-shadow-offset: 2px;
                --left-button-bottom-mobile: 3%;
                --left-button-x-mobile: 0%;
                --left-button-y-mobile: 0px;
                --left-button-min-width-mobile: 180px;
                --left-button-height-mobile: 44px;
                --left-button-padding-x-mobile: 16px;
              "
              {% if valid_index != 0 %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="bb-slideshow__left-chip">
                {{-
                  block.settings.badge_text
                  | default: product.type
                  | default: product.vendor
                  | default: 'Product'
                  | escape
                -}}
              </div>
              <div class="bb-slideshow__left-hero">
                <h2 class="bb-slideshow__left-title">{{ product.title | truncatewords: 2, '...' }}</h2>
                {%- if image_media != blank -%}
                  {%- assign img_aspect = image_media.aspect_ratio
                    | default: image_media.preview_image.aspect_ratio
                    | default: 1
                  -%}
                  <img
                    src="{{ image_media | image_url: width: 1400 }}"
                    alt="{{ image_media.alt | default: product.title | escape }}"
                    class="bb-slideshow__left-image"
                    loading="{% if valid_index == 0 %}eager{% else %}lazy{% endif %}"
                    width="1400"
                    height="{{ 1400 | divided_by: img_aspect }}"
                  >
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'bb-slideshow__placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="bb-slideshow__left-cta">
                {%-
                  render 'global-btn',
                  text: section.settings.shop_now_label | default: 'Shop now',
                  url: product.url,
                  class: 'bb-slideshow__shop-now',
                  variant: 'tertiary',
                  fit_width: false
                -%}
              </div>
            </article>
            {%- assign valid_index = valid_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if slide_count == 0 -%}
          <article
            class="bb-slideshow__left-slide is-active bb-slideshow__left-slide--placeholder"
            data-left-slide
            data-slide-index="0"
          >
            <h2 class="bb-slideshow__left-title">Add up to 5 products</h2>
            {{ 'product-apparel-2' | placeholder_svg_tag: 'bb-slideshow__placeholder-svg' }}
          </article>
        {%- endif -%}
      </div>
      <div class="bb-slideshow__stage-nav" aria-label="Slideshow controls">
        {%- assign left_prev_attrs = 'data-nav="prev" aria-label="Previous slide"' -%}
        {%- assign left_next_attrs = 'data-nav="next" aria-label="Next slide"' -%}
        {%- render 'global-btn',
          text: '←',
          type: 'button',
          class: 'bb-slideshow__stage-nav-button bb-slideshow__stage-nav-button--prev',
          attributes: left_prev_attrs,
          fit_width: false
        -%}
        {%- render 'global-btn',
          text: '→',
          type: 'button',
          class: 'bb-slideshow__stage-nav-button bb-slideshow__stage-nav-button--next',
          attributes: left_next_attrs,
          fit_width: false
        -%}
      </div>
    </div>

    <div class="bb-slideshow__right">
      {% render 'card-collection', collection: collection %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bb-slideshow-section {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.left_column_width_percent }}%) minmax(0, calc(100% - {{ section.settings.left_column_width_percent }}%));
    gap: 16px;
    min-height: {{ section.settings.section_height }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left,
  #shopify-section-{{ section.id }} .bb-slideshow__right {
    border-radius: var(--radius-2xl);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left {
    border: 1px solid var(--color-borders);
    background: var(--color-card-bg);
    padding: 18px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right {
    border: 1px solid var(--color-borders);
    background: var(--color-card-bg);
    padding: 18px;
    border-radius: var(--radius-2xl);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-stage {
    position: relative;
    height: {{ section.settings.section_height }}px;
    border-radius: var(--radius-xl);
    background: transparent;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-stage::before {
    content: '';
    position: absolute;
    left: 5px;
    right: 5px;
    bottom: 5px;
    height: 50%;
    background: var(--color-card-bg);
    border-radius: var(--radius-xl);
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide {
    position: absolute;
    inset: 0;
    padding: 20px 28px 24px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 16px;
    opacity: 0;
    pointer-events: none;
    background: transparent;
    z-index: 1;
    transform: translate3d(0, 0, 0);
    transform-origin: center center;
    backface-visibility: hidden;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-active {
    position: absolute;
    inset: 0;
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-leaving {
    opacity: 1;
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-next,
  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-prev {
    opacity: 1;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-exit-next {
    animation: bbSlideOutUp-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-next {
    animation: bbSlideInFromBottom-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-exit-prev {
    animation: bbSlideOutDown-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-enter-prev {
    animation: bbSlideInFromTop-{{ section.id }} {{ section.settings.slide_transition_speed_ms }}ms cubic-bezier(0.27, 1.24, 0.52, 1) forwards;
  }

  @keyframes bbSlideOutUp-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, -100%, 0); }
  }

  @keyframes bbSlideInFromBottom-{{ section.id }} {
    from { transform: translate3d(0, 100%, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes bbSlideOutDown-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, 100%, 0); }
  }

  @keyframes bbSlideInFromTop-{{ section.id }} {
    from { transform: translate3d(0, -100%, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-chip {
    border: 1px solid var(--color-link);
    border-radius: var(--radius-pill);
    color: var(--color-link);
    font-size: 1.1rem;
    line-height: 1;
    padding: 8px 16px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-title {
    margin: 0;
    text-align: center;
    font-size: clamp(3rem, 5vw, 8rem);
    line-height: 1.1;
    color: var(--color-heading);
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    z-index: 1;
    padding-inline: 20px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-hero {
    width: 100%;
    height: 100%;
    min-height: 0;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-image {
    width: var(--left-image-width-desktop, 100%);
    height: var(--left-image-height-desktop, 100%);
    max-width: none;
    max-height: none;
    object-fit: var(--left-image-fit, contain);
    object-position: center bottom;
    display: block;
    margin-inline: auto;
    z-index: 2;
    transform: translate(var(--left-image-x-desktop, 0%), var(--left-image-y-desktop, 0%));
    filter: drop-shadow(
      var(--left-image-shadow-x, 0px)
      var(--left-image-shadow-y, 20px)
      var(--left-image-shadow-blur, 18px)
      var(--left-image-shadow-color, var(--color-btn-shadow))
    );
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--left-button-bottom-desktop, 3%);
    display: flex;
    justify-content: var(--left-button-alignment, center);
    z-index: 3;
    transform: translate(var(--left-button-x-desktop, 0%), var(--left-button-y-desktop, 0px));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now .submit-button__content {
    min-width: var(--left-button-min-width-desktop, 208px);
    height: var(--left-button-height-desktop, 48px);
    padding: 0 var(--left-button-padding-x-desktop, 20px);
    font-size: var(--left-button-font-size-desktop, 14px);
    font-weight: var(--left-button-font-weight, 700);
    letter-spacing: var(--left-button-letter-spacing, 1px);
    border-radius: var(--left-button-radius, var(--radius-xl));
    border-color: var(--left-button-border-color, var(--btn-primary-border));
    background-color: var(--left-button-bg-color, var(--btn-primary-bg));
    color: var(--left-button-text-color, var(--btn-primary-text));
    text-transform: var(--left-button-text-transform, uppercase);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now .submit-button__shadow {
    background-color: var(--left-button-shadow-color, var(--btn-primary-shadow));
    border-radius: var(--left-button-radius, var(--radius-xl));
    top: var(--left-button-shadow-offset, 2px);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right-nav {
    display: flex;
    justify-content: center;
    gap: 14px;
  }
    #shopify-section-{{ section.id }} .bb-slideshow__stage-nav{
      display: flex;
    justify-content: space-between;
    gap: 14px;
       position: absolute;
    left: 20px;
    right: 20px;
    top: calc(40% - 10px);
    transform: none;
    margin-top: 0;
    z-index: 4;
    pointer-events: none;
    }


  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button {
    pointer-events: auto;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__content,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__content {
    width: 84px;
    min-width: 84px;
    height: 48px;
    padding: 0;
    font-size: 2.2rem;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__shadow,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__shadow {
    border-radius: var(--radius-l);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__text,
  #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__text {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 14px;
  }

  /* Match collection-list card typography settings */
  #shopify-section-{{ section.id }} .custom-collection-card__title {
    font-size: {{ settings.collection_card_title_font_size | default: 32 }}px;
    font-weight: {{ settings.collection_card_title_font_weight | default: 900 }};
    line-height: {{ settings.collection_card_title_line_height | default: 1 }};
    margin-top: {{ settings.collection_card_title_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.collection_card_title_margin_bottom | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .custom-collection-card__description {
    font-size: {{ settings.collection_card_description_font_size | default: 12 }}px;
    font-weight: {{ settings.collection_card_description_font_weight | default: 400 }};
    line-height: {{ settings.collection_card_description_line_height | default: 1.4 }};
    margin-top: {{ settings.collection_card_description_margin_top | default: 0 }}px;
    margin-bottom: {{ settings.collection_card_description_margin_bottom | default: 20 }}px;
  }

  #shopify-section-{{ section.id }} .custom-collection-card__badge {
    font-size: {{ settings.collection_card_badge_font_size | default: 12 }}px;
    font-weight: {{ settings.collection_card_badge_font_weight | default: 700 }};
    padding: {{ settings.collection_card_badge_padding_vertical | default: 4 }}px {{ settings.collection_card_badge_padding_horizontal | default: 16 }}px;
    margin-bottom: {{ settings.collection_card_badge_margin_bottom | default: 10 }}px;
    background-color: var(--color-card-bg);
    color: var(--color-heading);
    border-color: var(--color-heading);
    {% if settings.collection_card_badge_border_width != blank %}border-width: {{ settings.collection_card_badge_border_width }}px;{% endif %}
    {% if settings.collection_card_badge_border_radius != blank %}border-radius: {{ settings.collection_card_badge_border_radius }}px;{% endif %}
    {% if settings.collection_card_badge_text_transform != blank %}text-transform: {{ settings.collection_card_badge_text_transform }};{% endif %}
  }

  #shopify-section-{{ section.id }} .custom-collection-card__hover-description {
    font-size: {{ settings.collection_card_hover_description_font_size | default: 14 }}px;
    font-weight: {{ settings.collection_card_hover_description_font_weight | default: 400 }};
  }

  #shopify-section-{{ section.id }} .custom-collection-card__hover-content {
    gap: {{ settings.collection_card_hover_content_gap | default: 10 }}px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__view-more .bb-slideshow__view-more-btn {
    width: 100%;
    display: block;
  }
  .bb-slideshow__view-more-btn .global-btn__content {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__view-more .bb-slideshow__view-more-btn .submit-button__content {
    width: 100%;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__card-stage {
    position: relative;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__right-placeholder {
    height: 100%;
    min-height: 0;
    border-radius: var(--radius-xl);
    border: 1px dashed var(--color-borders);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
  }

  #shopify-section-{{ section.id }} .bb-slideshow__placeholder-svg {
    width: 260px;
    height: auto;
  }

  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .bb-slideshow {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-stage {
      height: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-active {
      position: relative;
      inset: auto;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-slide.is-leaving {
      position: absolute;
      inset: 0;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-title {
      font-size: clamp(3rem, 9vw, 5rem);
      top: 14px;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__stage-nav-button .submit-button__content,
    #shopify-section-{{ section.id }} .bb-slideshow__right-nav-button .submit-button__content {
      width: 72px;
      min-width: 72px;
      height: 44px;
      font-size: 1.8rem;
    }
    .bb-slideshow__right-nav-button .global-btn__shadow {
    top:17%;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__right {
      height: auto;
    }
  }

  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .bb-slideshow__card-stage {
      order: 1;
    }
  }

  /* Tablet and mobile: same layout and styling (triggered as soon as desktop view ends) */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .bb-slideshow-section {
      padding: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px 16px {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left {
      padding: 10px;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-stage {
      height: auto;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-slide {
      padding: 14px;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-title {
      font-size: clamp(2.6rem, 11vw, 4.2rem);
      top: 12px;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-image {
      width: var(--left-image-width-mobile, 100%);
      height: var(--left-image-height-mobile, 100%);
      transform: translate(var(--left-image-x-mobile, 0%), var(--left-image-y-mobile, 0%));
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-cta {
      bottom: var(--left-button-bottom-mobile, 3%);
      transform: translate(var(--left-button-x-mobile, 0%), var(--left-button-y-mobile, 0px));
    }

    #shopify-section-{{ section.id }} .bb-slideshow__left-cta .bb-slideshow__shop-now .submit-button__content {
      min-width: var(--left-button-min-width-mobile, 180px);
      height: var(--left-button-height-mobile, 44px);
      font-size: var(--left-button-font-size-mobile, 13px);
      padding: 0 var(--left-button-padding-x-mobile, 16px);
    }

    #shopify-section-{{ section.id }} .bb-slideshow__card-stage {
      padding: 10px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__card-slide {
      inset: auto;
    }

    #shopify-section-{{ section.id }} .bb-slideshow__stage-nav {
      left: 10px;
      right: 10px;
    }
  }
</style>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const root = document.getElementById(`BBSlideshow-${sectionId}`);
    if (!root || root.dataset.initialized === 'true') return;

    const leftSlides = Array.from(root.querySelectorAll('[data-left-slide]'));
    const rightSlides = Array.from(root.querySelectorAll('[data-card-slide]'));
    const navButtons = Array.from(root.querySelectorAll('[data-nav]'));
    const total = Number(root.dataset.slideCount || 0);
    const transitionDuration = Number({{ section.settings.slide_transition_speed_ms | json }}) || 600;

    if (total <= 1) {
      navButtons.forEach((button) => {
        button.disabled = true;
      });
    }

    let activeIndex = 0;
    let isAnimating = false;

    const showRightSlide = (nextIndex) => {
      rightSlides.forEach((slide, index) => {
        const isActive = index === nextIndex;
        slide.classList.toggle('is-active', isActive);
        slide.hidden = !isActive;
      });
    };

    const showLeftSlide = (nextIndex, direction) => {
      const current = leftSlides[activeIndex];
      const next = leftSlides[nextIndex];
      if (!current || !next || current === next) return;

      isAnimating = true;
      current.classList.add('is-leaving');
      current.classList.add(direction === 'next' ? 'is-exit-next' : 'is-exit-prev');

      next.hidden = false;
      next.classList.add(direction === 'next' ? 'is-enter-next' : 'is-enter-prev');
      next.classList.add('is-active');

      let didCleanup = false;
      let fallbackTimer;
      const cleanup = () => {
        if (didCleanup) return;
        didCleanup = true;
        window.clearTimeout(fallbackTimer);
        current.classList.remove('is-active', 'is-leaving');
        current.hidden = true;
        current.classList.remove('is-exit-next', 'is-exit-prev');
        next.classList.remove('is-enter-next', 'is-enter-prev');
        isAnimating = false;
      };

      next.addEventListener('animationend', cleanup, { once: true });
      fallbackTimer = window.setTimeout(cleanup, transitionDuration + 120);
    };

    const goTo = (nextIndex, direction = 'next') => {
      if (isAnimating || total <= 1) return;
      if (nextIndex < 0 || nextIndex >= total || nextIndex === activeIndex) return;

      showLeftSlide(nextIndex, direction);
      showRightSlide(nextIndex);
      activeIndex = nextIndex;
    };

    const step = (direction) => {
      if (total <= 1) return;
      if (direction === 'next') {
        goTo((activeIndex + 1) % total, 'next');
      } else {
        goTo((activeIndex - 1 + total) % total, 'prev');
      }
    };

    navButtons.forEach((button) => {
      button.addEventListener('click', () => {
        step(button.dataset.nav);
      });
    });

    document.addEventListener('shopify:block:select', (event) => {
      if (!event.target.closest(`#shopify-section-${sectionId}`)) return;

      const blockId = event.target.dataset.blockId;
      if (!blockId) return;

      const index = leftSlides.findIndex((slide) => slide.dataset.blockId === blockId);
      if (index === -1 || index === activeIndex) return;

      goTo(index, index > activeIndex ? 'next' : 'prev');
    });

    root.dataset.initialized = 'true';
  })();
</script>

