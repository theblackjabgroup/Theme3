<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const root = document.getElementById(`BBSlideshow-${sectionId}`);
    if (!root || root.dataset.initialized === 'true') return;

    const leftSlides = Array.from(root.querySelectorAll('[data-left-slide]'));
    const rightSlides = Array.from(root.querySelectorAll('[data-card-slide]'));
    const navButtons = Array.from(root.querySelectorAll('[data-nav]'));
    const total = Number(root.dataset.slideCount || 0);
    const transitionDuration = Number({{ section.settings.slide_transition_speed_ms | json }}) || 600;

    if (total <= 1) {
      navButtons.forEach((button) => {
        button.disabled = true;
      });
    }

    let activeIndex = 0;
    let isAnimating = false;

    const showRightSlide = (nextIndex) => {
      rightSlides.forEach((slide, index) => {
        const isActive = index === nextIndex;
        slide.classList.toggle('is-active', isActive);
        slide.hidden = !isActive;
      });
    };

    const showLeftSlide = (nextIndex, direction) => {
      const current = leftSlides[activeIndex];
      const next = leftSlides[nextIndex];
      if (!current || !next || current === next) return;

      isAnimating = true;
      current.classList.add('is-leaving');
      current.classList.add(direction === 'next' ? 'is-exit-next' : 'is-exit-prev');

      next.hidden = false;
      next.classList.add(direction === 'next' ? 'is-enter-next' : 'is-enter-prev');
      next.classList.add('is-active');

      let didCleanup = false;
      let fallbackTimer;
      const cleanup = () => {
        if (didCleanup) return;
        didCleanup = true;
        window.clearTimeout(fallbackTimer);
        current.classList.remove('is-active', 'is-leaving');
        current.hidden = true;
        current.classList.remove('is-exit-next', 'is-exit-prev');
        next.classList.remove('is-enter-next', 'is-enter-prev');
        isAnimating = false;
      };

      next.addEventListener('animationend', cleanup, { once: true });
      fallbackTimer = window.setTimeout(cleanup, transitionDuration + 120);
    };

    const goTo = (nextIndex, direction = 'next') => {
      if (isAnimating || total <= 1) return;
      if (nextIndex < 0 || nextIndex >= total || nextIndex === activeIndex) return;

      showLeftSlide(nextIndex, direction);
      showRightSlide(nextIndex);
      activeIndex = nextIndex;
    };

    const step = (direction) => {
      if (total <= 1) return;
      if (direction === 'next') {
        goTo((activeIndex + 1) % total, 'next');
      } else {
        goTo((activeIndex - 1 + total) % total, 'prev');
      }
    };

    navButtons.forEach((button) => {
      button.addEventListener('click', () => {
        step(button.dataset.nav);
      });
    });

    document.addEventListener('shopify:block:select', (event) => {
      if (!event.target.closest(`#shopify-section-${sectionId}`)) return;

      const blockId = event.target.dataset.blockId;
      if (!blockId) return;

      const index = leftSlides.findIndex((slide) => slide.dataset.blockId === blockId);
      if (index === -1 || index === activeIndex) return;

      goTo(index, index > activeIndex ? 'next' : 'prev');
    });

    root.dataset.initialized = 'true';
  })();
</script>

