{{ 'section-subfooter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .subfooter-section {
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px;
    --margin-horizontal: {{ section.settings.margin_horizontal }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --border-radius: {{ section.settings.border_radius }}px;
    --font-size: {{ section.settings.font_size }}px;
    --mobile-font-size: {{ section.settings.mobile_font_size }}px;
    --icon-size-desktop: {{ section.settings.icon_size_desktop }}px;
    --icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --icon-gap-desktop: {{ section.settings.icon_gap_desktop }}px;
    --icon-gap-mobile: {{ section.settings.icon_gap_mobile }}px;
    --text-transform: {{ section.settings.text_transform }};
    --copyright-text-decoration: {{ section.settings.copyright_underline }};
    --shop-name-text-decoration: {{ section.settings.shop_name_underline }};
    --powered-by-text-decoration: {{ section.settings.powered_by_underline }};
  }
{%- endstyle -%}

<div class="subfooter-section color-{{ scheme.id }} gradient">
  <div class="subfooter-container">
    <!-- LEFT: Copyright & Powered By -->
    <div class="subfooter-left">
      <span class="subfooter-copyright">
        <span class="subfooter-copyright-text">Copyright © {{ 'now' | date: '%Y' }}</span>
        <span class="subfooter-shop-name"> {{ shop.name }}</span>
      </span>
      <span class="subfooter-powered">
        {{ powered_by_link }}
      </span>
    </div>

    <!-- RIGHT: Payment Icons -->
    <div class="subfooter-right">
      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subfooter",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Margin (Left/Right)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal Padding (Left/Right)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "none",
          "label": "Normal"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "copyright_underline",
      "label": "Copyright Underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shop_name_underline",
      "label": "Shop Name Underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "powered_by_underline",
      "label": "Powered By Underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size (Desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size (Mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Payment Icons (Desktop)"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon Height",
      "default": 30
    },
    {
      "type": "range",
      "id": "icon_gap_desktop",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Icons",
      "default": 8
    },
    {
      "type": "header",
      "content": "Payment Icons (Mobile)"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon Height",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_gap_mobile",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Icons",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Subfooter"
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
