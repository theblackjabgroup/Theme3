{{ 'section-subfooter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .subfooter-section {
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px;
    --margin-horizontal: {{ section.settings.margin_horizontal }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --border-radius: {{ section.settings.border_radius }}px;
    --font-size: {{ section.settings.font_size }}px;
    --mobile-font-size: {{ section.settings.mobile_font_size }}px;
    --icon-size: {{ section.settings.icon_size }}px;
    --icon-gap: {{ section.settings.icon_gap }}px;
  }
{%- endstyle -%}

<div class="subfooter-section color-{{ scheme.id }} gradient">
  <div class="subfooter-container">
    <!-- LEFT: Copyright & Powered By -->
    <div class="subfooter-left">
      <span class="subfooter-copyright">
        COPYRIGHT © {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}
      </span>
      <span class="subfooter-powered">
        POWERED BY SHOPIFY
      </span>
    </div>

    <!-- RIGHT: Payment Icons -->
    <div class="subfooter-right">
      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subfooter",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Margin (Left/Right)",
      "default": 10
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal Padding (Left/Right)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size (Desktop)",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size (Mobile)",
      "default": 11
    },
    {
      "type": "header",
      "content": "Payment Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon Height",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Icons",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Subfooter"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
