{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<div class="product-page-container">
  <!-- Left Column (50% Width) -->
  <div class="product-left-column">
    <!-- Card 1 (Header) -->
    <div class="product-bento-card product-header-card">
      {% if product.metafields.custom.tag != blank %}
        <div class="product-tag-pill">{{ product.metafields.custom.tag }}</div>
      {% else %}
        <div class="product-tag-pill">BEAR WITH ME</div>
      {% endif %}

      <h1 class="product-main-title">{{ product.title }}</h1>
      <!-- Image overlapping -->
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          width="600"
          height="600"
          class="product-hero-image"
          alt="{{ product.title | escape }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-1_large.png"
          width="600"
          height="600"
          class="product-hero-image"
          alt="Placeholder"
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- Card 2 (Product Purchase) -->
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign product_form_id = 'product-form-' | append: section.id %}
    <div class="product-bento-card product-purchase-card">
      <!-- Price -->
      <div class="product-price-container">
        <span class="price-compare">
          {% if current_variant.compare_at_price > current_variant.price %}
            {{ current_variant.compare_at_price | money_without_trailing_zeros }}
          {% endif %}
        </span>
        <span class="price-main">{{ current_variant.price | money_without_trailing_zeros }}</span>
      </div>

      <!-- Stock Badge -->
      <div class="stock-badge-wrapper">
        <span class="stock-badge">
          {% if product.available %}
            {% if current_variant.inventory_management == 'shopify'
              and current_variant.inventory_quantity > 0
              and current_variant.inventory_quantity <= 10
            %}
              Only {{ current_variant.inventory_quantity }} left in stock
            {% else %}
              In stock
            {% endif %}
          {% else %}
            Out of stock
          {% endif %}
        </span>
      </div>

      <!-- Variants -->
      {% unless product.has_only_default_variant %}
        <div class="variant-picker-wrapper">
          {% for option in product.options_with_values %}
            <fieldset class="product-form__input product-form__input--{{ option.name | downcase }}">
              <div class="variant-options-row">
                {% for value in option.values %}
                  {%- assign radio_id = section.id
                    | append: '-'
                    | append: option.position
                    | append: '-'
                    | append: forloop.index
                  -%}
                  {%- if option.selected_value == value -%}
                    {%- assign btn_variant = 'secondary' -%}
                  {%- else -%}
                    {%- assign btn_variant = 'primary' -%}
                  {%- endif -%}
                  <input
                    type="radio"
                    id="{{ radio_id }}"
                    name="{{ option.name }}"
                    value="{{ value | escape }}"
                    form="{{ product_form_id }}"
                    class="product-form__variant-radio visually-hidden"
                    style="display: none;"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  <label for="{{ radio_id }}" class="product-form__variant-option-label">
                    {% render 'global-btn-2',
                      text: value,
                      variant: btn_variant,
                      type: 'button',
                      class: 'product-form__variant-option-btn',
                      fit_width: false
                    %}
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- Promo Text -->
      <div class="sale-roasted-text">
        {{ product.metafields.custom.tagline | default: 'Single Origin · Cold Pressed' }}
      </div>

      <!-- Quantity and Add to Cart -->
      <div class="product-actions-row">
        {% render 'quantity-input',
          variant: current_variant,
          min: 1,
          is_product_form: true,
          product_form_id: product_form_id
        %}

        <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
        <product-form class="product-form">
          {% form 'product',
            product,
            id: product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% liquid
              if current_variant.available
                assign btn_text = 'products.product.add_to_cart' | t
                if btn_text contains 'Translation missing'
                  assign btn_text = 'ADD TO CART'
                endif
              else
                assign btn_text = 'products.product.sold_out' | t
                if btn_text contains 'Translation missing'
                  assign btn_text = 'SOLD OUT'
                endif
              endif
            %}
            {% render 'global-btn',
              text: btn_text,
              type: 'submit',
              variant: 'tertiary',
              class: 'product-form__submit',
              is_add_to_cart: true,
              fit_width: true
            %}
          {% endform %}
        </product-form>
      </div>

      <!-- Store Availability Link -->
      <button class="pickup-availability-button link link--text underlined-link">
        CHECK AVAILABILITY AT OTHER STORES
      </button>
    </div>
  </div>

  <!-- Right Column (Media Gallery) -->
  <div class="product-right-column">
    <div class="product-media-gallery">
      <!-- Main Image -->
      <div class="product-main-media">
        {% assign right_main_media = product.featured_media %}

        {% if right_main_media %}
          {{
            right_main_media
            | image_url: width: 1000
            | image_tag: class: 'main-media-img', id: 'ProductMainImage', loading: 'lazy'
          }}
        {% else %}
          <img
            src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-1_large.png"
            width="1000"
            height="1000"
            class="main-media-img"
            id="ProductMainImage"
            alt="Placeholder"
          >
        {% endif %}

        <div class="media-nav-buttons">
          {%- capture prev_icon -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          {%- endcapture -%}
          {%- capture next_icon -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {%- endcapture -%}
          {% render 'global-btn-2',
            icon: prev_icon,
            icon_only: true,
            fit_width: false,
            variant: 'white',
            class: 'media-nav-btn prev',
            attributes: 'aria-label="Previous image"'
          %}
          {% render 'global-btn-2',
            icon: next_icon,
            icon_only: true,
            fit_width: false,
            variant: 'white',
            class: 'media-nav-btn next',
            attributes: 'aria-label="Next image"'
          %}
        </div>
      </div>

      <!-- Thumbnails -->
      <div class="product-thumbnails">
        {% for media in product.media limit: 3 %}
          <div class="thumbnail-item" data-media-url="{{ media.preview_image | image_url: width: 1000 }}">
            {{ media.preview_image | image_url: width: 300 | image_tag: class: 'thumbnail-img', loading: 'lazy' }}
          </div>
        {% else %}
          <!-- Placeholders if no media -->
          <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
          <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
          <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
        {% endfor %}
      </div>
    </div>

    <!-- FAQ List -->
    <div class="product-faq-list">
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>Q1. What makes KOKO cold brew different?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>
            We cold press for 18 hours at low temperature, extracting a smoother, less acidic brew that keeps its
            natural sweetness without any added sugar.
          </p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>Q2. How should I store it?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>Keep it refrigerated at all times. Once opened, consume within 7 days for best taste. Do not freeze.</p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>Q3. Is this available for subscription?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>
            Yes! Save 15% with a weekly or bi-weekly subscription. You can pause or cancel anytime from your account
            dashboard.
          </p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>Q4. Do you ship internationally?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>
            Currently we ship within India only. International shipping is coming soon — sign up for our newsletter to
            be the first to know.
          </p>
        </div>
      </div>
    </div>

    <!-- Info Text Block -->
    <div class="product-info-card">
      <h3>THE KOKO PROMISE</h3>
      <p>
        Every cup we make is traceable to its source. We work directly with small farms, pay fair prices, and roast in
        small batches so nothing goes to waste. Good coffee shouldn't cost the planet.
      </p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Variant button active state
      document.querySelectorAll('.product-form__input').forEach(function (fieldset) {
        fieldset.querySelectorAll('.product-form__variant-radio').forEach(function (radio) {
          radio.addEventListener('change', function () {
            fieldset.querySelectorAll('.product-form__variant-option-btn').forEach(function (btn) {
              btn.classList.remove('global-btn-2--secondary');
              btn.classList.add('global-btn-2--primary');
              btn.setAttribute('data-btn-variant', 'primary');
            });
            var activeBtn = radio.nextElementSibling.querySelector('.product-form__variant-option-btn');
            if (activeBtn) {
              activeBtn.classList.remove('global-btn-2--primary');
              activeBtn.classList.add('global-btn-2--secondary');
              activeBtn.setAttribute('data-btn-variant', 'secondary');
            }
          });
        });
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-accordion-item').forEach(function (item) {
        item.querySelector('.faq-accordion-header').addEventListener('click', function () {
          const isOpen = item.classList.contains('is-open');
          // Close all
          document.querySelectorAll('.faq-accordion-item.is-open').forEach(function (open) {
            open.classList.remove('is-open');
            open.querySelector('.faq-accordion-body').style.maxHeight = '0';
          });
          // Open clicked if it was closed
          if (!isOpen) {
            const body = item.querySelector('.faq-accordion-body');
            item.classList.add('is-open');
            body.style.maxHeight = body.scrollHeight + 'px';
          }
        });
      });

      const mainImage = document.getElementById('ProductMainImage');
      const thumbnails = document.querySelectorAll('.thumbnail-item[data-media-url]');
      const prevBtn = document.querySelector('.media-nav-btn.prev');
      const nextBtn = document.querySelector('.media-nav-btn.next');

      if (!mainImage || thumbnails.length === 0) return;

      let currentIndex = 0;

      function updateMainImage(index) {
        if (index < 0) index = thumbnails.length - 1;
        if (index >= thumbnails.length) index = 0;
        currentIndex = index;
        const newSrc = thumbnails[currentIndex].getAttribute('data-media-url');
        if (!newSrc) return;
        mainImage.style.opacity = '0';
        setTimeout(function () {
          mainImage.src = newSrc;
          mainImage.srcset = newSrc;
          mainImage.style.opacity = '1';
        }, 300);
      }

      thumbnails.forEach((thumb, index) => {
        thumb.addEventListener('click', function () {
          updateMainImage(index);
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          updateMainImage(currentIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          updateMainImage(currentIndex + 1);
        });
      }
    });
  </script>
</div>

