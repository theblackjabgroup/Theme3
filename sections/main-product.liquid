{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'product-form-' | append: section.id %}

<div class="product-page-container">
  <!-- LEFT COLUMN: Image Gallery -->
  <div class="product-left-column">
    <div class="product-media-gallery{% if product.gift_card? %} product-media-gallery--gift-card{% endif %}">
      <!-- Main Image -->
      <div class="product-main-media">
        {% if product.featured_media %}
          {{
            product.featured_media
            | image_url: width: 1000
            | image_tag: class: 'main-media-img', id: 'ProductMainImage', loading: 'lazy'
          }}
        {% else %}
          <img
            src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-1_large.png"
            width="1000"
            height="1000"
            class="main-media-img"
            id="ProductMainImage"
            alt="Placeholder"
          >
        {% endif %}

        {% unless product.gift_card? %}
          <div class="media-nav-buttons">
            {%- capture prev_icon -%}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            {%- endcapture -%}
            {%- capture next_icon -%}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            {%- endcapture -%}
            {%
              render 'global-btn-2',
              icon: prev_icon,
              icon_only: true,
              fit_width: false,
              variant: 'primary',
              class: 'media-nav-btn prev',
              attributes: 'aria-label="Previous image"',
              no_border: true
            %}
            {%
              render 'global-btn-2',
              icon: next_icon,
              icon_only: true,
              fit_width: false,
              variant: 'primary',
              class: 'media-nav-btn next',
              attributes: 'aria-label="Next image"',
              no_border: true
            %}
          </div>
        {% endunless %}
      </div>

      {% unless product.gift_card? %}
        <!-- Thumbnails -->
        <div class="product-thumbnails">
          {% for media in product.media limit: 3 %}
            <div class="thumbnail-item" data-media-url="{{ media.preview_image | image_url: width: 1000 }}">
              {{ media.preview_image | image_url: width: 300 | image_tag: class: 'thumbnail-img', loading: 'lazy' }}
            </div>
          {% else %}
            <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
            <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
            <div class="thumbnail-item"><div class="placeholder-thumb"></div></div>
          {% endfor %}
        </div>
      {% endunless %}
    </div>
  </div>

  <!-- RIGHT COLUMN: Product Details + FAQ + Info -->
  <div class="product-right-column">
    <!-- Product Details Card -->
    <div class="product-details-card">
      <!-- Title Section -->
      <div class="product-details-header">
        <div class="product-badge-pill">
          {%- if product.gift_card? -%}
            GIFT CARD
          {%- else -%}
            {{- product.metafields.custom.tag | default: 'BEAR WITH ME' -}}
          {%- endif -%}
        </div>

        <h1 class="product-main-title">{{ product.title }}</h1>

        <div class="product-price-row">
          <span class="product-price-main">{{ current_variant.price | money_without_trailing_zeros }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="product-price-compare">
              {{- current_variant.compare_at_price | money_without_trailing_zeros -}}
            </span>
          {% endif %}
        </div>

        <!-- Star Rating -->
        <div class="product-rating-row">
          <div class="product-stars" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}
              <svg width="17" height="17" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#F5A30A"/>
              </svg>
            {% endfor %}
          </div>
          <span class="product-review-count">
            {{- product.metafields.reviews.rating_count | default: '3' }} reviews
          </span>
        </div>

        <p class="product-description">
          {{ product.description | strip_html | truncate: 200 }}
        </p>
      </div>

      <!-- Purchase Section -->
      <div class="product-purchase-section">
        <!-- Stock Status -->
        <div class="product-stock-row">
          <span class="product-stock-dot{% unless product.available %} product-stock-dot--out{% endunless %}"></span>
          <span class="product-stock-text">
            {% if product.available %}
              {% if current_variant.inventory_management == 'shopify'
                and current_variant.inventory_quantity > 0
                and current_variant.inventory_quantity <= 10
              %}
                Only {{ current_variant.inventory_quantity }} left in stock
              {% else %}
                In stock
              {% endif %}
            {% else %}
              Out of stock
            {% endif %}
          </span>
        </div>

        <!-- Variant Weight Options -->
        {% unless product.has_only_default_variant %}
          <div class="variant-picker-wrapper">
            {% for option in product.options_with_values %}
              <fieldset class="product-form__input product-form__input--{{ option.name | downcase }}">
                <div class="product-weight-options">
                  {% for value in option.values %}
                    {%- assign radio_id = section.id
                      | append: '-'
                      | append: option.position
                      | append: '-'
                      | append: forloop.index
                    -%}
                    {%- if option.selected_value == value -%}
                      {%- assign btn_variant = 'secondary' -%}
                    {%- else -%}
                      {%- assign btn_variant = 'primary' -%}
                    {%- endif -%}
                    <input
                      type="radio"
                      id="{{ radio_id }}"
                      name="{{ option.name }}"
                      value="{{ value | escape }}"
                      form="{{ product_form_id }}"
                      class="product-form__variant-radio visually-hidden"
                      style="display: none;"
                      {% if option.selected_value == value %}
                        checked
                      {% endif %}
                    >
                    <label for="{{ radio_id }}" class="product-form__variant-option-label">
                      {% render 'global-btn-2',
                        text: value,
                        variant: btn_variant,
                        type: 'button',
                        class: 'product-form__variant-option-btn',
                        fit_width: true
                      %}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}

        <!-- Quantity + Add to Cart -->
        <div class="product-atc-row">
          {% render 'quantity-input',
            variant: current_variant,
            min: 1,
            is_product_form: true,
            product_form_id: product_form_id
          %}

          <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
          <product-form class="product-form product-form--full">
            {% form 'product',
              product,
              id: product_form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- liquid
                if current_variant.available
                  assign btn_text = 'products.product.add_to_cart' | t
                  if btn_text contains 'Translation missing'
                    assign btn_text = 'ADD TO CART'
                  endif
                  assign btn_variant = 'tertiary'
                else
                  assign btn_text = 'products.product.sold_out' | t
                  if btn_text contains 'Translation missing'
                    assign btn_text = 'SOLD OUT'
                  endif
                  assign btn_variant = 'disabled'
                endif
              -%}
              {% render 'global-btn',
                text: btn_text,
                type: 'submit',
                variant: btn_variant,
                class: 'product-form__submit',
                is_add_to_cart: true,
                fit_width: true
              %}
            {% endform %}
          </product-form>
        </div>

        {% unless product.gift_card? %}
          <!-- Pickup Info -->
          <div class="product-pickup-info">
            <p class="product-pickup-store">Pickup available at Toronto-King street</p>
            <p class="product-pickup-time">Usually ready in 24 hours</p>
          </div>

          <!-- Check Availability -->
          <button class="product-availability-link" id="CheckAvailabilityBtn">Check availability at other stores</button>
        {% endunless %}
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="product-faq-list">
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>About Product</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>{{ product.description | strip_html }}</p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>What makes KOKO cold brew different?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>
            We cold press for 18 hours at low temperature, extracting a smoother, less acidic brew that keeps its
            natural sweetness without any added sugar.
          </p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>How should I store it?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>Keep it refrigerated at all times. Once opened, consume within 7 days for best taste. Do not freeze.</p>
        </div>
      </div>
      <div class="faq-accordion-item">
        <div class="faq-accordion-header">
          <span>Do you ship internationally?</span>
          <span class="faq-accordion-icon">+</span>
        </div>
        <div class="faq-accordion-body">
          <p>
            Currently we ship within India only. International shipping is coming soon — sign up for our newsletter to
            be the first to know.
          </p>
        </div>
      </div>
    </div>

    <!-- Product Info Card -->
    <div class="product-info-card">
      <div class="product-promise-section">
        <h3 class="product-info-heading">THE KOKO PROMISE</h3>
        <p class="product-info-body">
          Every cup we make is traceable to its source. We work directly with small farms, pay fair prices, and roast in
          small batches so nothing goes to waste. Good coffee shouldn't cost the planet.
        </p>
      </div>

      <div class="product-info-section">
        <div class="product-info-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div class="product-info-content">
          <h4 class="product-info-subheading">Delivery</h4>
          <p class="product-info-body">
            We haven't yet figured out how to make delivery teleport to your doorstep. So, while we'll do our best to
            get your order to you as quickly as possible, please be patient and remember that good things come to those
            who wait.
          </p>
          <a href="#" class="product-discover-link">Discover more</a>
        </div>
      </div>

      <div class="product-info-section">
        <div class="product-info-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div class="product-info-content">
          <h4 class="product-info-subheading">Customs and Import Duties</h4>
          <p class="product-info-body">
            Dealing with customs and import duties is as enjoyable as instant coffee, but it's necessary. The customer
            is solely responsible for any charges or delays. We're sorry, but we can't control the customs process.
          </p>
        </div>
      </div>
    </div>

    <!-- Scrolling Free Shipping Banner -->
    {% render 'scrolling-text-item',
      id: 'product-shipping-marquee',
      text: 'FREE SHIPPING WORLDWIDE',
      speed: 30,
      direction: 'normal',
      bg_color: 'var(--color-card-bg)',
      border_radius: 12,
      padding: 8,
      text_size: 24,
      text_weight: '700',
      pill_bg: 'var(--btn-secondary-bg)',
      pill_color: 'var(--btn-secondary-text)',
      pill_height: 44,
      pill_radius: 14,
      item_gap: 16,
      orbit_text: 'KOKO',
      orbit_speed: 20,
      orbit_font_size: 10,
      orbit_color: 'var(--btn-secondary-text)',
      circle_bg: 'var(--btn-tertiary-bg)',
      pause_on_hover: false
    %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Variant active state
      // Buttons inside <label> don't trigger the radio's for-association in browsers,
      // so we manually check the radio and dispatch change on click.
      document.querySelectorAll('.product-form__variant-option-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var label = btn.closest('label');
          if (!label) return;
          var radioId = label.getAttribute('for');
          var radio = radioId ? document.getElementById(radioId) : null;
          if (!radio || radio.checked) return;
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));

          // Update button styles within this fieldset
          var fieldset = label.closest('fieldset');
          if (!fieldset) return;
          fieldset.querySelectorAll('.product-form__variant-option-btn').forEach(function (b) {
            b.classList.remove('global-btn-2--secondary');
            b.classList.add('global-btn-2--primary');
            b.setAttribute('data-btn-variant', 'primary');
          });
          btn.classList.remove('global-btn-2--primary');
          btn.classList.add('global-btn-2--secondary');
          btn.setAttribute('data-btn-variant', 'secondary');
        });
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-accordion-item').forEach(function (item) {
        item.querySelector('.faq-accordion-header').addEventListener('click', function () {
          var isOpen = item.classList.contains('is-open');
          document.querySelectorAll('.faq-accordion-item.is-open').forEach(function (open) {
            open.classList.remove('is-open');
            open.querySelector('.faq-accordion-body').style.maxHeight = '0';
          });
          if (!isOpen) {
            var body = item.querySelector('.faq-accordion-body');
            item.classList.add('is-open');
            body.style.maxHeight = body.scrollHeight + 'px';
          }
        });
      });

      // Image gallery
      var mainImage = document.getElementById('ProductMainImage');
      var thumbnails = document.querySelectorAll('.thumbnail-item[data-media-url]');
      var prevBtn = document.querySelector('.media-nav-btn.prev');
      var nextBtn = document.querySelector('.media-nav-btn.next');

      if (!mainImage || thumbnails.length === 0) return;

      var currentIndex = 0;

      function updateMainImage(index) {
        if (index < 0) index = thumbnails.length - 1;
        if (index >= thumbnails.length) index = 0;
        currentIndex = index;
        var newSrc = thumbnails[currentIndex].getAttribute('data-media-url');
        if (!newSrc) return;
        mainImage.style.opacity = '0';
        setTimeout(function () {
          mainImage.src = newSrc;
          mainImage.srcset = newSrc;
          mainImage.style.opacity = '1';
        }, 300);
      }

      thumbnails.forEach(function (thumb, index) {
        thumb.addEventListener('click', function () {
          updateMainImage(index);
        });
      });

      if (prevBtn)
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          updateMainImage(currentIndex - 1);
        });
      if (nextBtn)
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          updateMainImage(currentIndex + 1);
        });

      // Sticky bar scroll trigger
      var stickyBar = document.getElementById('StickyCartBar');
      if (stickyBar) {
        window.addEventListener(
          'scroll',
          function () {
            stickyBar.classList.toggle('sticky-cart-bar--visible', window.scrollY > 400);
          },
          { passive: true }
        );

        // Sync sticky qty with main qty
        var mainQtyInput = document.querySelector('#product-form-{{ section.id }} .quantity__input');
        var stickyQtyDisplay = document.getElementById('StickyQtyDisplay');
        var stickyDecrement = document.getElementById('StickyDecrement');
        var stickyIncrement = document.getElementById('StickyIncrement');

        function getStickyQty() {
          return parseInt(stickyQtyDisplay.textContent, 10) || 1;
        }

        if (stickyDecrement) {
          stickyDecrement.addEventListener('click', function () {
            var q = Math.max(1, getStickyQty() - 1);
            stickyQtyDisplay.textContent = q;
            if (mainQtyInput) mainQtyInput.value = q;
          });
        }
        if (stickyIncrement) {
          stickyIncrement.addEventListener('click', function () {
            var q = getStickyQty() + 1;
            stickyQtyDisplay.textContent = q;
            if (mainQtyInput) mainQtyInput.value = q;
          });
        }

        var stickyAtcBtn = document.getElementById('StickyAddToCart');
        if (stickyAtcBtn) {
          stickyAtcBtn.addEventListener('click', function () {
            var mainSubmit = document.querySelector('#{{ product_form_id }} [type="submit"]');
            if (mainSubmit) mainSubmit.click();
          });
        }
      }

      // Pickup Availability Drawer
      var checkAvailBtn = document.getElementById('CheckAvailabilityBtn');
      var pickupDrawer = document.getElementById('PickupDrawer');
      var drawerClose = document.getElementById('PickupDrawerClose');
      var drawerOverlay = document.getElementById('PickupDrawerOverlay');

      function openPickupDrawer() {
        pickupDrawer.classList.add('active');
        document.body.classList.add('pickup-drawer-open');
        drawerClose.focus();
      }

      function closePickupDrawer() {
        pickupDrawer.classList.remove('active');
        document.body.classList.remove('pickup-drawer-open');
        if (checkAvailBtn) checkAvailBtn.focus();
      }

      if (checkAvailBtn && pickupDrawer) {
        checkAvailBtn.addEventListener('click', openPickupDrawer);
        drawerClose.addEventListener('click', closePickupDrawer);
        if (drawerOverlay) drawerOverlay.addEventListener('click', closePickupDrawer);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && document.body.classList.contains('pickup-drawer-open')) closePickupDrawer();
        });
      }
    });
  </script>
</div>

<!-- Sticky Add to Cart Bar -->
<div class="sticky-cart-bar" id="StickyCartBar">
  <div class="sticky-cart-bar__inner">
    <div class="sticky-cart-bar__product">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 160 }}"
          width="80"
          height="68"
          class="sticky-cart-bar__img"
          alt="{{ product.title | escape }}"
          loading="lazy"
        >
      {% endif %}
      <div class="sticky-cart-bar__info">
        <p class="sticky-cart-bar__name">{{ product.title }}</p>
        <div class="sticky-cart-bar__meta">
          {% if current_variant.title != 'Default Title' %}
            {% render 'global-btn-2',
              text: current_variant.title,
              variant: 'primary',
              type: 'button',
              class: 'sticky-cart-bar__variant',
              fit_width: false
            %}
          {% endif %}
          <span class="sticky-cart-bar__price">{{ current_variant.price | money_without_trailing_zeros }}</span>
        </div>
      </div>
    </div>

    <div class="sticky-cart-bar__actions">
      <!-- Standalone qty selector — NOT bound to the main product form -->
      <div class="sticky-qty-selector">
        <button type="button" class="sticky-qty-btn" id="StickyDecrement" aria-label="Decrease quantity">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <span class="sticky-qty-display" id="StickyQtyDisplay">1</span>
        <button type="button" class="sticky-qty-btn" id="StickyIncrement" aria-label="Increase quantity">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
      </div>
      {%- liquid
        if current_variant.available
          assign sticky_btn_text = 'ADD TO CART'
          assign sticky_btn_variant = 'tertiary'
        else
          assign sticky_btn_text = 'SOLD OUT'
          assign sticky_btn_variant = 'disabled'
        endif
      -%}
      {% render 'global-btn',
        text: sticky_btn_text,
        type: 'button',
        variant: sticky_btn_variant,
        fit_width: true,
        attributes: 'id="StickyAddToCart"'
      %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sprite_sheet",
      "label": "Enable Sprite Sheet Hero",
      "default": false
    },
    {
      "type": "number",
      "id": "sprite_sheet_frames",
      "label": "Sprite Sheet Frames",
      "default": 1,
      "info": "Total number of frames in the sprite sheet strip."
    },
    {
      "type": "range",
      "id": "hero_image_max_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Hero Image Max Width",
      "default": 400
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Margin (Mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Margin (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal Margin (Left/Right)",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Margin Mobile (Left/Right)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
