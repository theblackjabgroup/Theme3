{% assign product_form_id = 'product-form-' | append: section.id %}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<div class="product-split-container">
  <!-- HERO SECTION (Floating Absolute) -->
  {% render 'product-hero-image', product: product %}

  <!-- LEFT COLUMN -->
  {% render 'product-left-column', product: product, section: section, product_form_id: product_form_id %}

  <!-- RIGHT COLUMN -->
  {% render 'product-right-column', product: product, section: section %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ---------------------------------------------------------
    // IMAGE SLIDER LOGIC
    // ---------------------------------------------------------
    const track = document.getElementById('ProductMediaTrack');
    if (track) {
      const slides = Array.from(track.children);
      const prevBtn = document.querySelector('.media-nav.prev');
      const nextBtn = document.querySelector('.media-nav.next');
      let index = 0;

      function updateButtons() {
        if (prevBtn) {
          if (index === 0) {
            prevBtn.style.opacity = '0.3';
            prevBtn.style.pointerEvents = 'none';
          } else {
            prevBtn.style.opacity = '1';
            prevBtn.style.pointerEvents = 'auto';
          }
        }
        if (nextBtn) {
          if (slides.length === 0 || index === slides.length - 1) {
            nextBtn.style.opacity = '0.3';
            nextBtn.style.pointerEvents = 'none';
          } else {
            nextBtn.style.opacity = '1';
            nextBtn.style.pointerEvents = 'auto';
          }
        }
      }

      function scrollToSlide(i) {
        if (!slides[i]) return;
        slides[i].scrollIntoView({ behavior: 'smooth', inline: 'center' });
        updateButtons();
      }

      prevBtn?.addEventListener('click', () => {
        index = Math.max(index - 1, 0);
        scrollToSlide(index);
      });
      nextBtn?.addEventListener('click', () => {
        index = Math.min(index + 1, slides.length - 1);
        scrollToSlide(index);
      });
      updateButtons();
    }

    // ---------------------------------------------------------
    // SCROLL ANIMATION
    // ---------------------------------------------------------
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.feature-row').forEach((row) => {
      observer.observe(row);
    });

    // ---------------------------------------------------------
    // VARIANT SELECTION LOGIC
    // ---------------------------------------------------------
    const productVariants = {{ product.variants | json }};
    const productOptions = {{ product.options_with_values | json }};
    
    // Select all radio inputs for variants
    const variantRadios = document.querySelectorAll('.product-form__input input[type="radio"]');
    
    // Function to get currently selected options
    function getSelectedOptions() {
      const fieldsets = Array.from(document.querySelectorAll('.product-form__input'));
      // Map each fieldset to its selected radio value
      return fieldsets.map(fieldset => {
        const checkedInput = fieldset.querySelector('input:checked');
        return checkedInput ? checkedInput.value : null;
      });
    }

    // Function to find matching variant
    function findMatchingVariant(selectedOptions) {
      return productVariants.find(variant => {
        // Compare variant.options (array of values) with selectedOptions
        // variant.options looks like ["Small", "Red"]
        // selectedOptions looks like ["Small", "Red"]
        return variant.options.every((option, index) => {
          return option === selectedOptions[index];
        });
      });
    }

    // Update Form State
    function updateProductState() {
      const selectedOptions = getSelectedOptions();
      const currentVariant = findMatchingVariant(selectedOptions);

      const formInputId = document.querySelector('form[action*="/cart/add"] input[name="id"]');
      const submitBtn = document.querySelector('.product-form__submit');
      
      if (!currentVariant) {
        // Variant doesn't exist
        if (submitBtn) {
          submitBtn.textContent = 'Unavailable';
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.5';
          submitBtn.style.cursor = 'not-allowed';
        }
      } else {
        // Variant exists
        // 1. Update hidden ID input
        if (formInputId) {
          formInputId.value = currentVariant.id;
        }

        // 2. Update URL (HISTORY API)
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('variant', currentVariant.id);
        window.history.replaceState({ path: newUrl.toString() }, '', newUrl);

        // 3. Update Button State (Price + Status)
             // 3. Update Button State (Price + Status)
        if (submitBtn) {
           if (currentVariant.available) {
             // Get currency symbol from liquid injection or inferred from initial state
             const shopCurrency = {{ cart.currency.symbol | json }} || '$';
             
             // Format price
             let formattedPrice = shopCurrency + (currentVariant.price / 100).toFixed(0);
             if (currentVariant.price % 100 !== 0) {
                formattedPrice = shopCurrency + (currentVariant.price / 100).toFixed(2);
             }
             
             submitBtn.textContent = `Buy ${formattedPrice}`;
             
             // Ensure it's active
             submitBtn.disabled = false;
             submitBtn.style.opacity = '1';
             submitBtn.style.cursor = 'pointer';
           } else {
             submitBtn.textContent = 'Sold Out';
             submitBtn.disabled = true;
             submitBtn.style.opacity = '0.5';
             submitBtn.style.cursor = 'not-allowed';
           }
        }
      }
    }

    // Attach listeners
    variantRadios.forEach(radio => {
      radio.addEventListener('change', updateProductState);
    });
  });
</script>

