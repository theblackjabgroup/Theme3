{% assign product_form_id = 'product-form-' | append: section.id %}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{%- assign has_pickup_block = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'pickup_availability' -%}
    {%- assign has_pickup_block = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_pickup_block -%}
  {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = settings.color_schemes | first
  endif

  assign add_to_cart_height = 38
  assign quantity_height = 44
  assign variant_height = 46
  assign media_arrows_height = 38

  for block in section.blocks
    if block.type == 'quantity_selector'
      assign add_to_cart_height = block.settings.add_to_cart_height | default: 38
      assign quantity_height = block.settings.quantity_height | default: 44
    elsif block.type == 'variant_picker'
      assign variant_height = block.settings.variant_height | default: 46
    elsif block.type == 'product_media'
      assign media_arrows_height = block.settings.media_arrows_height | default: 38
    endif
  endfor
-%}

<div
  class="product-split-container color-{{ scheme.id }} gradient{% if product.selected_or_first_available_variant.available == false %} product-variant-sold-out{% endif %}"
  id="ProductSection-{{ section.id }}"
  style="
    --hero-image-max-width: {{ section.settings.hero_image_max_width }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    --section-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
    --section-margin-horizontal: {{ section.settings.margin_horizontal }}px;
    --section-margin-horizontal-mobile: {{ section.settings.margin_horizontal_mobile }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --section-padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile }}px;
    --section-border-radius: {{ section.settings.border_radius }}px;
    --product-add-to-cart-height: {{ add_to_cart_height }}px;
    --product-quantity-height: {{ quantity_height }}px;
    --product-variant-height: {{ variant_height }}px;
    --product-media-arrows-height: {{ media_arrows_height }}px;
  "
>
  <!-- HERO SECTION (Floating Absolute) -->
  {% render 'product-hero-image', product: product, section: section %}

  <!-- LEFT COLUMN -->
  {% render 'product-left-column',
    product: product,
    section: section,
    product_form_id: product_form_id,
    block_gap: section.settings.block_gap
  %}

  <!-- RIGHT COLUMN -->
  {% render 'product-right-column', product: product, section: section, block_gap: section.settings.right_block_gap %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionContainer = document.getElementById('ProductSection-{{ section.id }}');
    if (!sectionContainer) return;

    // ---------------------------------------------------------
    // IMAGE SLIDER LOGIC
    // ---------------------------------------------------------
    const wrappers = sectionContainer.querySelectorAll('.product-media-wrapper');
    wrappers.forEach(wrapper => {
      const track = wrapper.querySelector('.product-media-track');
      if (!track) return;

      const getSlides = () => Array.from(track.children).filter(slide => slide.offsetParent !== null);
      
      let index = 0;

      function updateButtons() {
        const slides = getSlides();
        const prevBtn = wrapper.querySelector('.media-nav.prev');
        const nextBtn = wrapper.querySelector('.media-nav.next');

        if (prevBtn) {
          if (index <= 0) {
            prevBtn.style.opacity = '0.3';
            prevBtn.style.pointerEvents = 'none';
          } else {
            prevBtn.style.opacity = '1';
            prevBtn.style.pointerEvents = 'auto';
          }
        }
        if (nextBtn) {
          // If slides are empty or index at end
          const maxIdx = slides.length > 0 ? slides.length - 1 : 0;
          if (index >= maxIdx) {
            nextBtn.style.opacity = '0.3';
            nextBtn.style.pointerEvents = 'none';
          } else {
            nextBtn.style.opacity = '1';
            nextBtn.style.pointerEvents = 'auto';
          }
        }
      }

      function scrollToSlide(i) {
        const slides = getSlides();
        const maxIdx = slides.length > 0 ? slides.length - 1 : 0;
        
        if (i < 0) i = 0;
        if (i > maxIdx) i = maxIdx;
        
        index = i;
        
        if (slides[index]) {
          slides[index].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
        updateButtons();
      }

      const prevBtn = wrapper.querySelector('.media-nav.prev');
      const nextBtn = wrapper.querySelector('.media-nav.next');

      prevBtn?.addEventListener('click', () => {
        scrollToSlide(index - 1);
      });
      nextBtn?.addEventListener('click', () => {
        scrollToSlide(index + 1);
      });

      // Update on resize
      window.addEventListener('resize', () => {
        scrollToSlide(index);
      });

      updateButtons();
    });

    // ---------------------------------------------------------
    // SCROLL ANIMATION
    // ---------------------------------------------------------
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1 }
    );
    sectionContainer.querySelectorAll('.feature-row').forEach((row) => {
      observer.observe(row);
    });

    // ---------------------------------------------------------
    // SCROLL HIJACKING (Desktop Only)
    // ---------------------------------------------------------
    const desktopContainer = document.querySelector('.product-split-container');
    const rightColumn = document.querySelector('.product-split-right');
    
    if (desktopContainer && rightColumn) {
      desktopContainer.addEventListener('wheel', (e) => {
        // Only active on desktop
        if (window.innerWidth < 990) return;

        // Allow zooming (Ctrl/Cmd + Scroll)
        if (e.ctrlKey || e.metaKey) return;

        const scrollTop = rightColumn.scrollTop;
        const scrollHeight = rightColumn.scrollHeight;
        const clientHeight = rightColumn.clientHeight;
        const delta = e.deltaY;
        const isScrollDown = delta > 0;

        // Determine if we can scroll the element
        // 1px buffer to account for rounding errors
        const canScrollDown = scrollTop + clientHeight < scrollHeight - 1;
        const canScrollUp = scrollTop > 0;

        if ((isScrollDown && canScrollDown) || (!isScrollDown && canScrollUp)) {
            // We can scroll the inner content, so prevent window scroll
            e.preventDefault();
            rightColumn.scrollTop += delta;
        }
          // Else: let the event bubble to window (default behavior)
      }, { passive: false }); // Passive false required for preventDefault
    }

    // ---------------------------------------------------------
    // VARIANT SELECTION LOGIC
    // ---------------------------------------------------------
    const productVariants = {{ product.variants | json }};
    const productOptions = {{ product.options_with_values | json }};
    const moneyFormat = {{ shop.money_with_currency_format | json }};
    
    // Create a map of inventory quantities since they aren't in the default JSON
    const inventoryInfo = {
      {% for variant in product.variants %}
        "{{ variant.id }}": {
        "quantity": {{ variant.inventory_quantity | default: 0 }},
          "management": "{{ variant.inventory_management }}",
          "policy": "{{ variant.inventory_policy }}"
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    function formatMoney(cents, format) {
      if (typeof cents == 'string') { cents = cents.replace('.',''); }
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const formatString = format || moneyFormat;

      function defaultOption(opt, def) {
         return (typeof opt == 'undefined' ? def : opt);
      }

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');

        if (isNaN(number) || number == null) { return 0; }

        number = (number/100.0).toFixed(precision);

        var parts   = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands),
            cents   = parts[1] ? (decimal + parts[1]) : '';

        return dollars + cents;
      }

      const match = formatString.match(placeholderRegex);
      if (!match) return formatString; // Fallback

      switch(match[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
      }

      return formatString.replace(placeholderRegex, value);
    }
    
    // Select all radio inputs for variants WITHIN this section
    const variantRadios = sectionContainer.querySelectorAll('.product-form__input input[type="radio"]');
    
    // Function to get currently selected options
    function getSelectedOptions() {
      const fieldsets = Array.from(sectionContainer.querySelectorAll('.product-form__input'));
      // Map each fieldset to its selected radio value
      return fieldsets.map(fieldset => {
        const checkedInput = fieldset.querySelector('input:checked');
        return checkedInput ? checkedInput.value : null;
      });
    }

    // Function to find matching variant
    function findMatchingVariant(selectedOptions) {
      return productVariants.find(variant => {
        return variant.options.every((option, index) => {
          return option === selectedOptions[index];
        });
      });
    }

    // Update Form State
    function updateProductState() {
      const selectedOptions = getSelectedOptions();
      const currentVariant = findMatchingVariant(selectedOptions);

      // Select specific elements within THIS section using the unique ID
      const formInputId = sectionContainer.querySelector('input[name="id"]');
      const submitBtn = sectionContainer.querySelector('.product-form__submit');
      
      if (!currentVariant) {
        sectionContainer.classList.add('product-variant-sold-out');
        // Variant doesn't exist
        if (submitBtn) {
          const btnText = submitBtn.querySelector('.submit-button__text');
          if (btnText) {
            btnText.textContent = 'Unavailable';
          } else {
            submitBtn.textContent = 'Unavailable';
          }
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.8';
          submitBtn.style.cursor = 'not-allowed';
        }
      } else {
        // Variant exists
        // 1. Update hidden ID input
        if (formInputId) {
          formInputId.value = currentVariant.id;
        }

        // 2. Update URL (HISTORY API)
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('variant', currentVariant.id);
        window.history.replaceState({ path: newUrl.toString() }, '', newUrl);

        // 3. Update sold-out state (variant + quantity styling)
        if (currentVariant.available) {
          sectionContainer.classList.remove('product-variant-sold-out');
        } else {
          sectionContainer.classList.add('product-variant-sold-out');
        }

        // 4. Update Button State (Status Only)
        if (submitBtn) {
           const btnText = submitBtn.querySelector('.submit-button__text');
           
           if (currentVariant.available) {
             if (btnText) {
                btnText.textContent = 'ADD TO CART';
             } else {
                submitBtn.textContent = 'ADD TO CART';
             }
             
             // Ensure it's active
             submitBtn.disabled = false;
             submitBtn.style.opacity = '1';
             submitBtn.style.cursor = 'pointer';
           } else {
             if (btnText) {
                btnText.textContent = 'Sold Out';
             } else {
                submitBtn.textContent = 'Sold Out';
             }
             submitBtn.disabled = true;
             submitBtn.style.opacity = '0.8';
             submitBtn.style.cursor = 'not-allowed';
           }
        }

        // 5. Update Price Display
        const priceMain = sectionContainer.querySelector('.price-main');
        const priceCompare = sectionContainer.querySelector('.price-compare');
        
        if (priceMain) {
            priceMain.innerHTML = formatMoney(currentVariant.price, moneyFormat);
        }
        
        if (priceCompare) {
            if (currentVariant.compare_at_price > currentVariant.price) {
                priceCompare.innerHTML = formatMoney(currentVariant.compare_at_price, moneyFormat);
                priceCompare.style.display = 'inline';
            } else {
                priceCompare.style.display = 'none';
            }
        }

        // 6. Update Stock Badge
        const stockBadge = sectionContainer.querySelector('.stock-badge');
        const invStats = inventoryInfo[currentVariant.id];

        if (stockBadge) {
           stockBadge.style.display = 'inline-block';
           
           if (currentVariant.available) {
             if (invStats && invStats.management === 'shopify' && invStats.quantity > 0 && invStats.quantity <= 10) {
               stockBadge.textContent = `Only ${invStats.quantity} left in stock`;
             } else {
               stockBadge.textContent = 'In stock';
             }
           } else {
             stockBadge.textContent = 'Out of stock';
           }
        }

        // 7. Update Quantity Max
        const qtyInput = sectionContainer.querySelector('.quantity__input');
        if (qtyInput) {
          let maxQty = null;
          
          // Check inventory policy
          if (invStats && invStats.management === 'shopify' && invStats.policy === 'deny') {
             maxQty = invStats.quantity;
          }

          // Check quantity rules (if available in variant object)
          if (currentVariant.quantity_rule && currentVariant.quantity_rule.max) {
             if (maxQty === null || currentVariant.quantity_rule.max < maxQty) {
                maxQty = currentVariant.quantity_rule.max;
             }
          }

          if (maxQty !== null) {
            qtyInput.max = maxQty;
            qtyInput.dataset.max = maxQty;
            // Optional: Clamp current value if it exceeds new max
            if (parseInt(qtyInput.value) > maxQty) {
              qtyInput.value = maxQty;
            }
          } else {
            qtyInput.removeAttribute('max');
            delete qtyInput.dataset.max;
          }

          // 8. Update Quantity Min & Step
          if (currentVariant.quantity_rule) {
             const minQty = currentVariant.quantity_rule.min || 1;
             const stepQty = currentVariant.quantity_rule.increment || 1;

             qtyInput.min = minQty;
             qtyInput.dataset.min = minQty;
             qtyInput.step = stepQty;

             // Ensure current value satisfies min
             if (parseInt(qtyInput.value) < minQty) {
               qtyInput.value = minQty;
             }
          }
        }

        // 9. Update Pickup Availability
        const pickupAvailability = sectionContainer.querySelector('pickup-availability');
        if (pickupAvailability) {
          pickupAvailability.dataset.variantId = currentVariant.id;
          if (typeof pickupAvailability.update === 'function') {
            pickupAvailability.update(currentVariant);
          }
        }
      }
    }

    // Attach listeners
    variantRadios.forEach(radio => {
      radio.addEventListener('change', updateProductState);
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const spriteContainer = document.querySelector('.product-hero-sprite-container');
    if (!spriteContainer) return;

    const img = spriteContainer.querySelector('.product-hero-sprite-img');
    const frames = parseInt(spriteContainer.dataset.frames || 1, 10);

    if (!img || frames <= 1) return;

    // Function to update aspect ratio
    function updateAspectRatio() {
      if (img.naturalWidth && img.naturalHeight) {
        const frameWidth = img.naturalWidth / frames;
        const aspectRatio = frameWidth / img.naturalHeight;
        spriteContainer.style.aspectRatio = `${aspectRatio}`;
      }
    }

    img.onload = updateAspectRatio;
    if (img.complete) {
      updateAspectRatio();
    }

    // Interaction Logic: Scroll Based
    const scrollTarget = document.querySelector('.product-split-right');

    function updateFrame() {
      if (!scrollTarget) return;

      const scrollTop = scrollTarget.scrollTop;
      const maxScroll = scrollTarget.scrollHeight - scrollTarget.clientHeight;

      // Avoid division by zero
      if (maxScroll <= 0) return;

      const scrollPercent = scrollTop / maxScroll;

      // Calculate index
      let index = Math.floor(scrollPercent * frames);

      // Clamp
      if (index < 0) index = 0;
      if (index >= frames) index = frames - 1;

      // Translate
      const translatePercent = (index / frames) * 100;
      img.style.transform = `translateX(-${translatePercent}%)`;
    }

    if (scrollTarget) {
      scrollTarget.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateFrame);
      });
      // Initial call to set starting frame
      updateFrame();
    }
  });
</script>

