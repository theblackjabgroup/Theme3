{{ 'section-blog-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: var(--page-layout-padding);
    padding-bottom: var(--page-layout-padding);
    background-color: var(--color-card-bg) ;
    border-radius: var(--radius-l);
    {% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;{% endif %}

    --eyebrow-color: {{ section.settings.color_scheme.settings.accent_red }};
    --heading-color: {{ section.settings.color_scheme.settings.headings }};
    --text-color: {{ section.settings.color_scheme.settings.text }};
    --content-max-width: {{ section.settings.content_max_width }}%;
    --content-padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --content-padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile }}px;
    --eyebrow-font-size: {{ section.settings.eyebrow_font_size }}px;
    --eyebrow-font-size-mobile: {{ section.settings.eyebrow_font_size_mobile }}px;
    --eyebrow-line-height: {{ section.settings.eyebrow_line_height | divided_by: 100.0 }};
    --eyebrow-line-height-mobile: {{ section.settings.eyebrow_line_height_mobile | divided_by: 100.0 }};
    --eyebrow-font-weight: {{ section.settings.eyebrow_font_weight }};
    --eyebrow-font-weight-mobile: {{ section.settings.eyebrow_font_weight_mobile }};
    --eyebrow-padding-vertical: {{ section.settings.eyebrow_padding_vertical }}px;
    --eyebrow-padding-horizontal: {{ section.settings.eyebrow_padding_horizontal }}px;
    --eyebrow-padding-vertical-mobile: {{ section.settings.eyebrow_padding_vertical_mobile }}px;
    --eyebrow-padding-horizontal-mobile: {{ section.settings.eyebrow_padding_horizontal_mobile }}px;
    --eyebrow-border-radius: {{ section.settings.eyebrow_border_radius }}px;
    --eyebrow-border-radius-mobile: {{ section.settings.eyebrow_border_radius_mobile }}px;
    --heading-font-size: {{ section.settings.heading_font_size }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --heading-line-height-mobile: {{ section.settings.heading_line_height_mobile | divided_by: 100.0 }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};
    --heading-font-weight-mobile: {{ section.settings.heading_font_weight_mobile }};
    --heading-margin-top: {{ section.settings.heading_margin_top }}px;
    --heading-margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    --heading-margin-top-mobile: {{ section.settings.heading_margin_top_mobile }}px;
    --heading-margin-bottom-mobile: {{ section.settings.heading_margin_bottom_mobile }}px;
    --text-font-size: {{ section.settings.text_font_size }}px;
    --text-font-size-mobile: {{ section.settings.text_font_size_mobile }}px;
    --text-line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    --text-line-height-mobile: {{ section.settings.text_line_height_mobile | divided_by: 100.0 }};
    --text-font-weight: {{ section.settings.text_font_weight }};
    --text-font-weight-mobile: {{ section.settings.text_font_weight_mobile }};
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      margin: {{ section.settings.margin_vertical_mobile }}px {{ section.settings.margin_horizontal_mobile }}px;
      {% if section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}'); background-size: cover; background-position: center;
      {% elsif section.settings.use_desktop_image_on_mobile and section.settings.bg_image != blank %}
        background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;
      {% else %}
        background-image: none;
      {% endif %}
    }
  }
{%- endstyle -%}

<div class="section-content-hero section-{{ section.id }}-padding">
  {%- if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank -%}
    <div
      class="content-hero__overlay content-hero__overlay--desktop"
      style="background-color: {{ section.settings.color_scheme.settings.background }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>
    <div
      class="content-hero__overlay content-hero__overlay--mobile"
      style="background-color: {{ section.settings.color_scheme.settings.background }}; opacity: {{ section.settings.overlay_opacity_mobile | divided_by: 100.0 }};"
    ></div>
  {%- endif -%}
  <div class="content-hero__container content-hero__container--{{ section.settings.text_alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <div class="content-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="content-hero__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="content-hero__text">
        {{ section.settings.text | newline_to_br }}
      </div>
    {%- endif -%}
  </div>
</div>

