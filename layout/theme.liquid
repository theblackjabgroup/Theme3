<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {% endstyle %}

    <style>
      :root {
        /* ─── Essential Static Tokens ─── */
        --color-white: #FFFFFF;
        --color-black: #000000;
        --page-layout-gap: {{ settings.page_layout_gap }}px;
        --bento-gap: {{ settings.bento_gap | default: 12 }}px;
        --page-layout-padding: {{ settings.page_layout_padding | default: 24 }}px;
        --padding-medium: 16px;
        --padding-large: 24px;
        --height-button: 48px;
        --border-width-medium: 2px;
        --shadow-elevation-1: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24);
        --shadow-elevation-2: 0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23);
        --shadow-elevation-3: 0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23);

        /* ─── Root Palette (default = scheme 1) ─── */
        {%- assign default_scheme = settings.color_schemes | first -%}

        --color-bg: {{ default_scheme.settings.color_bg }};
        --color-card-bg: {{ default_scheme.settings.color_card_bg }};
        --color-card-text: {{ default_scheme.settings.color_card_text }};
        --color-heading: {{ default_scheme.settings.color_heading }};
        --color-text: {{ default_scheme.settings.color_text }};
        --color-link: {{ default_scheme.settings.color_link }};
        --color-link-hover: {{ default_scheme.settings.color_link_hover }};
        --color-accent: {{ default_scheme.settings.color_accent | default: '#F5A30A' }};
        --color-accent-2: {{ default_scheme.settings.color_accent_2 | default: '#D4872A' }};
        --color-btn-border: {{ default_scheme.settings.color_btn_border }};
        --color-btn-shadow: {{ default_scheme.settings.color_btn_shadow }};

        /* ─── Input Fields ─── */
        --color-input-bg: {{ default_scheme.settings.color_input_bg }};
        --color-input-text: {{ default_scheme.settings.color_input_text }};
        --color-input-border: {{ default_scheme.settings.color_input_border }};

        /* ─── Primary Button ─── */
        --btn-primary-bg: {{ default_scheme.settings.btn_primary_bg }};
        --btn-primary-text: {{ default_scheme.settings.btn_primary_text }};
        --btn-primary-border: {{ default_scheme.settings.btn_primary_border }};
        --btn-primary-shadow: {{ default_scheme.settings.btn_primary_shadow }};

        /* ─── Secondary Button ─── */
        --btn-secondary-bg: {{ default_scheme.settings.btn_secondary_bg }};
        --btn-secondary-text: {{ default_scheme.settings.btn_secondary_text }};
        --btn-secondary-border: {{ default_scheme.settings.btn_secondary_border }};
        --btn-secondary-shadow: {{ default_scheme.settings.btn_secondary_shadow }};

        /* ─── Tertiary Button ─── */
        --btn-tertiary-bg: {{ default_scheme.settings.btn_tertiary_bg }};
        --btn-tertiary-text: {{ default_scheme.settings.btn_tertiary_text }};
        --btn-tertiary-border: {{ default_scheme.settings.btn_tertiary_border }};
        --btn-tertiary-shadow: {{ default_scheme.settings.btn_tertiary_shadow }};

        /* ─── Disabled Button ─── */
        --btn-disabled-bg: {{ default_scheme.settings.btn_disabled_bg }};
        --btn-disabled-text: {{ default_scheme.settings.btn_disabled_text }};
        --btn-disabled-border: {{ default_scheme.settings.btn_disabled_border }};
        --btn-disabled-shadow: {{ default_scheme.settings.btn_disabled_shadow }};

        /* ─── Font Variables ─── */
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.type_header_font.weight }};

        /* Legacy font variables for backward compatibility */
        --font-family-primary: var(--font-body-family);
        --font-body-size: 16px;

        /* ─── Spacing ─── */
        --spacing-xs: 4px;
        --spacing-s: 8px;
        --spacing-m: 16px;
        --spacing-l: 24px;
        --spacing-xl: 32px;
        --spacing-xxl: 48px;

        --border-width-thin: 1px;

        /* ─── Sale Badge (cart + product cards, from color scheme) ─── */
        --sale-badge-bg: {{ default_scheme.settings.sale_badge_bg | default: '#F5A30A' }};
        --sale-badge-text: {{ default_scheme.settings.sale_badge_text | default: '#000000' }};
        --sale-badge-size: {{ settings.sale_badge_size }}px;
        --sale-badge-rotation: {{ settings.sale_badge_rotation }}deg;
        --sale-badge-percent-size: {{ settings.sale_badge_percent_size }}px;
        --sale-badge-label-size: {{ settings.sale_badge_label_size }}px;

        /* ─── Product card (price button border radius – used by product-card.css) ─── */
        --card-price-button-border-radius: {{ settings.product_card_price_button_border_radius | default: 12 }}px;
        --card-price-border-radius: {{ settings.product_card_price_border_radius | default: 12 }}px;

        /* ─── Transitions ─── */
        --transition-short: 0.2s ease;
        --transition-medium: 0.3s ease;
        --transition-long: 0.5s ease;
        --color-btn-disabled-shadow: {{ default_scheme.settings.btn_disabled_shadow }};

        /* ─── Aliases for base.css ─── */
        --color-background: var(--color-bg);
        --color-headings: var(--color-heading);
        --body-color: var(--color-text);
      }

      html, body {
        background-color: var(--color-bg);
        color: var(--color-text);
        margin: 0;
        overflow-x: hidden;
        width: 100%;
      }


      {%- for scheme in settings.color_schemes -%}
        .color-{{ scheme.id }} {
          --color-bg: {{ scheme.settings.color_bg }};
          --color-background: var(--color-bg);
          --color-card-bg: {{ scheme.settings.color_card_bg }};
          --color-card-text: {{ scheme.settings.color_card_text }};
          --color-heading: {{ scheme.settings.color_heading }};
          --color-headings: var(--color-heading);
          --color-text: {{ scheme.settings.color_text }};
          --body-color: var(--color-text);
          --color-link: {{ scheme.settings.color_link }};
          --color-link-hover: {{ scheme.settings.color_link_hover }};
          --color-accent: {{ scheme.settings.color_accent | default: '#1e4abd' }};
          --color-accent-2: {{ scheme.settings.color_accent_2 | default: '#D4872A' }};
          --color-btn-border: {{ scheme.settings.color_btn_border }};
          --color-btn-shadow: {{ scheme.settings.color_btn_shadow }};
          --color-input-bg: {{ scheme.settings.color_input_bg }};
          --color-input-text: {{ scheme.settings.color_input_text }};
          --color-input-border: {{ scheme.settings.color_input_border }};
          --btn-primary-bg: {{ scheme.settings.btn_primary_bg }};
          --btn-primary-text: {{ scheme.settings.btn_primary_text }};
          --btn-primary-border: {{ scheme.settings.btn_primary_border }};
          --btn-primary-shadow: {{ scheme.settings.btn_primary_shadow }};
          --btn-secondary-bg: {{ scheme.settings.btn_secondary_bg }};
          --btn-secondary-text: {{ scheme.settings.btn_secondary_text }};
          --btn-secondary-border: {{ scheme.settings.btn_secondary_border }};
          --btn-secondary-shadow: {{ scheme.settings.btn_secondary_shadow }};
          --btn-tertiary-bg: {{ scheme.settings.btn_tertiary_bg }};
          --btn-tertiary-text: {{ scheme.settings.btn_tertiary_text }};
          --btn-tertiary-border: {{ scheme.settings.btn_tertiary_border }};
          --btn-tertiary-shadow: {{ scheme.settings.btn_tertiary_shadow }};
          --btn-disabled-bg: {{ scheme.settings.btn_disabled_bg }};
          --btn-disabled-text: {{ scheme.settings.btn_disabled_text }};
          --btn-disabled-border: {{ scheme.settings.btn_disabled_border }};
          --btn-disabled-shadow: {{ scheme.settings.btn_disabled_shadow }};
          --sale-badge-bg: {{ scheme.settings.sale_badge_bg | default: '#F5A30A' }};
          --sale-badge-text: {{ scheme.settings.sale_badge_text | default: '#000000' }};
        }

        /* Global Theme Override: When active, force everything to this scheme's variables */
        html[data-global-theme-active="true"][data-active-scheme="color-{{ scheme.id }}"] {
          --global-bg: {{ scheme.settings.color_bg }};
          --global-card-bg: {{ scheme.settings.color_card_bg }};
          --global-card-text: {{ scheme.settings.color_card_text }};
          --global-heading: {{ scheme.settings.color_heading }};
          --global-text: {{ scheme.settings.color_text }};
          --global-link: {{ scheme.settings.color_link }};
          --global-link-hover: {{ scheme.settings.color_link_hover }};
          --global-accent: {{ scheme.settings.color_accent | default: '#F5A30A' }};
          --global-accent-2: {{ scheme.settings.color_accent_2 | default: '#D4872A' }};
          --global-btn-border: {{ scheme.settings.color_btn_border }};
          --global-btn-shadow: {{ scheme.settings.color_btn_shadow }};
          --global-input-bg: {{ scheme.settings.color_input_bg }};
          --global-input-text: {{ scheme.settings.color_input_text }};
          --global-input-border: {{ scheme.settings.color_input_border }};
          --global-btn-primary-bg: {{ scheme.settings.btn_primary_bg }};
          --global-btn-primary-text: {{ scheme.settings.btn_primary_text }};
          --global-btn-primary-border: {{ scheme.settings.btn_primary_border }};
          --global-btn-primary-shadow: {{ scheme.settings.btn_primary_shadow }};
          --global-btn-secondary-bg: {{ scheme.settings.btn_secondary_bg }};
          --global-btn-secondary-text: {{ scheme.settings.btn_secondary_text }};
          --global-btn-secondary-border: {{ scheme.settings.btn_secondary_border }};
          --global-btn-secondary-shadow: {{ scheme.settings.btn_secondary_shadow }};
          --global-btn-tertiary-bg: {{ scheme.settings.btn_tertiary_bg }};
          --global-btn-tertiary-text: {{ scheme.settings.btn_tertiary_text }};
          --global-btn-tertiary-border: {{ scheme.settings.btn_tertiary_border }};
          --global-btn-tertiary-shadow: {{ scheme.settings.btn_tertiary_shadow }};
          --global-btn-disabled-bg: {{ scheme.settings.btn_disabled_bg }};
          --global-btn-disabled-text: {{ scheme.settings.btn_disabled_text }};
          --global-btn-disabled-border: {{ scheme.settings.btn_disabled_border }};
          --global-btn-disabled-shadow: {{ scheme.settings.btn_disabled_shadow }};
          --sale-badge-bg: {{ scheme.settings.sale_badge_bg | default: '#F5A30A' }};
          --sale-badge-text: {{ scheme.settings.sale_badge_text | default: '#000000' }};
        }
      {%- endfor -%}

      html[data-global-theme-active="true"] [class*="color-"],
      html[data-global-theme-active="true"] body,
      html[data-global-theme-active="true"] .bento-grid-container,
      html[data-global-theme-active="true"] .vertical-sidebar-logo-link {
        --color-bg: var(--global-bg) !important;
        --color-background: var(--global-bg) !important;
        --color-card-bg: var(--global-card-bg) !important;
        --color-card-text: var(--global-card-text) !important;
        --color-heading: var(--global-heading) !important;
        --color-headings: var(--global-heading) !important;
        --color-text: var(--global-text) !important;
        --body-color: var(--global-text) !important;
        --color-link: var(--global-link) !important;
        --color-link-hover: var(--global-link-hover) !important;
        --color-accent: var(--global-accent) !important;
        --color-accent-2: var(--global-accent-2) !important;
        --color-btn-border: var(--global-btn-border) !important;
        --color-btn-shadow: var(--global-btn-shadow) !important;
        --color-input-bg: var(--global-input-bg) !important;
        --color-input-text: var(--global-input-text) !important;
        --color-input-border: var(--global-input-border) !important;
        --btn-primary-bg: var(--global-btn-primary-bg) !important;
        --btn-primary-text: var(--global-btn-primary-text) !important;
        --btn-primary-border: var(--global-btn-primary-border) !important;
        --btn-primary-shadow: var(--global-btn-primary-shadow) !important;
        --btn-secondary-bg: var(--global-btn-secondary-bg) !important;
        --btn-secondary-text: var(--global-btn-secondary-text) !important;
        --btn-secondary-border: var(--global-btn-secondary-border) !important;
        --btn-secondary-shadow: var(--global-btn-secondary-shadow) !important;
        --btn-tertiary-bg: var(--global-btn-tertiary-bg) !important;
        --btn-tertiary-text: var(--global-btn-tertiary-text) !important;
        --btn-tertiary-border: var(--global-btn-tertiary-border) !important;
        --btn-tertiary-shadow: var(--global-btn-tertiary-shadow) !important;
        --btn-disabled-bg: var(--global-btn-disabled-bg) !important;
        --btn-disabled-text: var(--global-btn-disabled-text) !important;
        --btn-disabled-border: var(--global-btn-disabled-border) !important;
        --btn-disabled-shadow: var(--global-btn-disabled-shadow) !important;

        /* Forced Logo Overrides */
        --color-header-logo-background: var(--global-heading) !important;
        --color-header-logo-text: var(--global-card-bg) !important;
      }

      /* Smooth theme transition when toggle changes scheme */
      html[data-global-theme-active="true"],
      html[data-global-theme-active="true"] body,
      html[data-global-theme-active="true"] .bento-grid-container,
      html[data-global-theme-active="true"] [class*="color-"],
      html[data-global-theme-active="true"] .vertical-sidebar-logo-link {
        transition: background-color 0.6s ease, color 0.6s ease, border-color 0.6s ease, box-shadow 0.6s ease, fill 0.6s ease, stroke 0.6s ease;
      }

      /* ============================================
         GLOBAL SCROLLBAR STYLES
         ============================================ */

      html {
        scrollbar-width: thin;
        /* Match header scrollbar: [Thumb Color] [Track Color] */
        scrollbar-color: var(--color-heading) var(--color-bg);
      }

      /* For Chrome, Safari, and Edge */
      ::-webkit-scrollbar,
      html::-webkit-scrollbar,
      body::-webkit-scrollbar {
        width: 3px !important;
        height: 3px !important;
      }

      ::-webkit-scrollbar-track,
      html::-webkit-scrollbar-track,
      body::-webkit-scrollbar-track {
        background: var(--color-bg) !important;
      }

      ::-webkit-scrollbar-thumb,
      html::-webkit-scrollbar-thumb,
      body::-webkit-scrollbar-thumb {
        background: var(--color-heading) !important;
        border-radius: var(--radius-m);
      }

      ::-webkit-scrollbar-thumb:hover,
      html::-webkit-scrollbar-thumb:hover,
      body::-webkit-scrollbar-thumb:hover {
        background: var(--color-heading) !important;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'component-global-btn.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      <link
        rel="stylesheet"
        href="{{ 'component-localization-form.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
      <noscript><link rel="stylesheet" href="{{ 'component-localization-form.css' | asset_url }}"></noscript>
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
      <noscript>
        <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}">
      </noscript>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  {%- assign default_scheme = settings.color_schemes | first -%}
  <body class="color-{{ default_scheme.id }}">
    <script>
      (function () {
        const savedScheme = localStorage.getItem('global-theme-scheme');
        if (savedScheme) {
          document.documentElement.setAttribute('data-global-theme-active', 'true');
          document.documentElement.setAttribute('data-active-scheme', savedScheme);
        }
      })();
    </script>
    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      (function () {
        window.shopUrl = '{{ request.origin }}';
        window.routes = {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          cart_url: '{{ routes.cart_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}',
        };
        window.cartStrings = {
          error: `{{ 'sections.cart.cart_error' | t }}`,
          quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
        };
        window.variantStrings = {
          addToCart: `{{ 'products.product.add_to_cart' | t }}`,
          soldOut: `{{ 'products.product.sold_out' | t }}`,
          unavailable: `{{ 'products.product.unavailable' | t }}`,
          unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
        };
        window.quickOrderListStrings = {
          itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
          itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
          itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
          itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
          viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
          each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
          min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
          max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
          step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
        };
        window.accessibilityStrings = {
          imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
          shareSuccess: `{{ 'general.share.success_message' | t }}`,
          pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
          playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
          recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
          recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
          countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
          languageSelectorSearchCount: `{{ 'localization.language_results_count' | t: count: '[count]' }}`,
        };
      })();
    </script>

    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- if settings.predictive_search_enabled -%}
      <script>
        (function(){
          if (!document.querySelector('predictive-search')) return;
          var url = {{ 'predictive-search.js' | asset_url | json }};
          function load(){ var s=document.createElement('script'); s.src=url; s.defer=true; document.body.appendChild(s); }
          document.addEventListener('focusin', function fn(e){
            if (e.target && e.target.closest && e.target.closest('predictive-search') && e.target.matches('input')) {
              document.removeEventListener('focusin', fn);
              load();
            }
          }, true);
        })();
      </script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script>
        (function(){
          var url = {{ 'cart-drawer.js' | asset_url | json }};
          var done = false;
          function load(triggerEl){
            if(done)return;
            done=true;
            var s=document.createElement('script');
            s.src=url;
            s.defer=true;
            if(triggerEl){
              s.onload=function(){
                var drawer=document.querySelector('cart-drawer');
                if(drawer&&typeof drawer.open==='function') drawer.open(triggerEl);
              };
            }
            document.body.appendChild(s);
          }
          document.addEventListener('click', function fn(e){
            var trigger = e.target && e.target.closest && (e.target.closest('a[href*="/cart"]') || e.target.closest('.cart-drawer-trigger') || e.target.closest('[data-open-cart-drawer]'));
            if (trigger) {
              e.preventDefault();
              e.stopPropagation();
              document.removeEventListener('click', fn);
              load(trigger);
            }
          }, true);
          (window.requestIdleCallback||setTimeout)(function(){ load(); }, 2500);
        })();
      </script>
    {%- endif -%}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script>
      window.themeAnimationsRevealOnScroll = {{ settings.animations_reveal_on_scroll | json }};
      window.themeScrollAnimationSettings = {
        enabled: {{ settings.animations_reveal_on_scroll | json }},
        triggerPoint: {{ settings.scroll_animation_trigger_point | default: 12 | json }},
        speed: {{ settings.scroll_animation_speed | default: 2000 | json }},
        startScalePercent: {{ settings.scroll_animation_start_scale | default: 82 | json }},
        disableOnMobile: {{ settings.animations_disable_on_mobile | json }},
        mobileTriggerPoint: {{ settings.scroll_animation_mobile_trigger_point | default: 5 | json }},
      };
    </script>
    {%- if settings.animations_reveal_on_scroll -%}
      <script>
        (function(){
          var url = {{ 'animations.js' | asset_url | json }};
          var load = function(){ var s=document.createElement('script'); s.src=url; s.defer=true; document.body.appendChild(s); };
          if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', load);
          } else {
            (window.requestIdleCallback || function(fn) { setTimeout(fn, 0); })(load);
          }
        })();
      </script>
    {%- endif -%}
  </body>
</html>
