{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        /* CSS Variables from Theme Settings */
        --gc-bg: {{ settings.gift_card_bg }};
        --gc-panel-bg: {{ settings.gift_card_panel_bg }};
        --gc-text-color: {{ settings.gift_card_text }};
        --gc-green: {{ settings.gift_card_accent }};

        /* Font Sizes */
        --gc-title-size: {{ settings.gift_card_title_size }}px;
        --gc-value-size: {{ settings.gift_card_value_size }}px;
        --gc-footer-size: {{ settings.gift_card_footer_size }}px;

        /* Mobile Font Sizes */
        --gc-title-size-mobile: {{ settings.gift_card_title_size_mobile }}px;
        --gc-value-size-mobile: {{ settings.gift_card_value_size_mobile }}px;
        --gc-footer-size-mobile: {{ settings.gift_card_footer_size_mobile }}px;

        /* Button Colors (Reversed/Customizable) */
        --gc-btn-bg: {{ settings.gift_card_button_bg }};
        --gc-btn-text: {{ settings.gift_card_button_text }};
        --gc-btn-border: {{ settings.gift_card_button_bg }}; /* Match bg for solid look or add separate setting */
        --gc-btn-hover-bg: {{ settings.gift_card_button_text }}; /* Invert on hover logic or add separate setting if needed */
        --gc-btn-hover-text: {{ settings.gift_card_button_bg }};

        --gc-radius: var(--{{ settings.button_radius_token }}, 9999px);

        /* Animation Settings */
        {% if settings.gift_card_animation_enabled %}
          --gc-animation-duration: {{ settings.gift_card_animation_duration }}s;
          --gc-animation-name: bounce;
        {% else %}
          --gc-animation-duration: 0s;
          --gc-animation-name: none;
        {% endif %}
      }

      /* Apply Font Sizes */
      .gc-title { font-size: var(--gc-title-size); }
      .gc-card-value { font-size: var(--gc-value-size); }
      .gc-footer-text { font-size: var(--gc-footer-size); }

      /* Mobile Overrides */
      @media (max-width: 600px) {
        .gc-title { font-size: var(--gc-title-size-mobile); }
        .gc-card-value { font-size: var(--gc-value-size-mobile); }
        .gc-footer-text { font-size: var(--gc-footer-size-mobile); }
      }

      /* Apply Button Hover Logic (using variables derived above) */
      .gc-print-btn__shadow { background-color: var(--gc-btn-bg); opacity: 0.5; } /* Shadow usually darker/distinct */
    </style>

    {%- comment -%}
      Refining shadow logic:
      If user picks Green for BG and Beige for Text:
      - Button Face: Green
      - Text: Beige
      - Shadow: Needs to be distinct. Let's use opacity or a derived color if we can't add more settings.
      For now, using the Button BG as shadow base but maybe text color for hover?
      Actually, let's stick to the variables defined in CSS but map them correctly.
    {%- endcomment -%}

    {%- unless settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}

    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}
  </head>

  <body>
    <div class="gc-container">
      <!-- LEFT PANEL -->
      <div class="gc-panel gc-left">
        <h1 class="gc-title">{{ settings.gift_card_title }}</h1>

        <div class="gc-envelope-container">
          <!-- BACK SVG LAYERS (Top Flap + Inside) -->
          <svg
            class="gc-envelope-svg gc-envelope-layer-back"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 578 319"
            fill="none"
          >
            <!-- Use separate color for envelope back as requested -->
            <path d="M283.98 3.21932C287.886 1.20004 292.529 1.20003 296.435 3.21932L431.516 73.0492C444.14 79.5753 439.499 98.657 425.288 98.657H155.127C140.916 98.657 136.275 79.5753 148.9 73.0492L283.98 3.21932Z" fill="{{ settings.gift_card_envelope_back }}"/>
            <path d="M246.474 31.1906L83.0625 112.896L282.072 190.872H298.006L495.998 112.557L343.436 31.1906H246.474Z" fill="{{ settings.gift_card_envelope_back }}"/>
          </svg>

          <!-- Card (Inside) -->
          <div
            class="gc-card"
            style="background-color: {{ settings.gift_card_accent }}; color: {{ settings.gift_card_bg }};"
          >
            <div class="gc-card-top">
              <span class="gc-card-label">{{ settings.gift_card_card_label }}</span>
            </div>
            <div class="gc-card-value">
              {% if settings.currency_code_enabled %}
                {{ gift_card.balance | money_with_currency }}
              {% else %}
                {{ gift_card.balance | money }}
              {% endif %}
            </div>
            <div class="gc-card-visual">
              <span class="gc-logo-text">{{ shop.name }}</span>
            </div>
          </div>

          <!-- FRONT SVG LAYERS (Bottom + Side Flaps) -->
          <svg
            class="gc-envelope-svg gc-envelope-layer-front"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 578 319"
            fill="none"
          >
             <!-- Outer envelope usually lighter/different. Using panel bg or fixed color? Let's keep hardcoded or use a secondary variable if we had one.
                  For now, preserving original paths but could verify if user wants ALL colors custom.
                  Keeping original D2CDC4 for contrast unless mapped to input bg? -->
            <path d="M287.278 188.214C288.936 187.528 290.799 187.528 292.457 188.214L497.002 272.753C503.862 275.588 501.835 285.8 494.412 285.8H85.3228C77.9004 285.8 75.8733 275.588 82.7329 272.753L287.278 188.214Z" fill="#D2CDC4"/>
            <path opacity="0.7" d="M289.47 205.327C283.711 203.083 283.711 194.935 289.47 192.691L492.347 113.647C496.792 111.915 501.589 115.194 501.589 119.965L501.589 278.053C501.589 282.824 496.792 286.103 492.347 284.371L289.47 205.327Z" fill="#D2CDC4"/>
            <path opacity="0.7" d="M288.229 205.327C293.988 203.083 293.988 194.935 288.229 192.691L85.3525 113.647C80.907 111.915 76.1104 115.194 76.1104 119.965L76.1104 278.053C76.1104 282.824 80.907 286.103 85.3525 284.371L288.229 205.327Z" fill="#D2CDC4"/>
          </svg>
        </div>

        <p class="gc-footer-text">{{ settings.gift_card_subtext }}</p>
      </div>

      <!-- RIGHT PANEL -->
      <div class="gc-panel gc-right">
        <div class="gc-qr-container">
          <div class="gc-qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
        </div>

        <div class="gc-code-action-area">
          <input
            type="text"
            class="gc-code-input"
            value="{{ gift_card.code | format_code }}"
            readonly
            id="gift-card-code"
          >
          <button class="gc-copy-btn">COPY CODE</button>
        </div>

        <style>
          /* Only re-declaring specific overrides if needed, mainly leveraging root vars now */
        </style>

        <button class="gc-print-btn" onclick="window.print();">
          <span class="gc-print-btn__shadow"></span>
          <span class="gc-print-btn__content">PRINT</span>
        </button>
      </div>
    </div>

    <!-- Hidden element for accessibility if needed, though we moved away from standard structure -->
    <div hidden>
      <span id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</span>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qrCodeContainer = document.querySelector('.gc-qr-code');
        if (qrCodeContainer) {
          new QRCode(qrCodeContainer, {
            text: qrCodeContainer.dataset.identifier,
            width: 150,
            height: 150,
          });
        }

        const copyBtn = document.querySelector('.gc-copy-btn');
        const codeInput = document.getElementById('gift-card-code');

        copyBtn.addEventListener('click', function () {
          navigator.clipboard.writeText(codeInput.value).then(function () {
            const originalText = copyBtn.innerText;
            copyBtn.innerText = 'COPIED';
            setTimeout(function () {
              copyBtn.innerText = originalText;
            }, 2000);
          });
        });
      });
    </script>
  </body>
</html>
